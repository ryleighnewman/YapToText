    "Your dictation will appear here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيظهر إملاؤك هنا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš diktát se objeví zde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din diktering vises her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Diktat erscheint hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dictado aparecerá aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanelusi ilmestyy tähän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre dictée apparaîtra ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההכתבה שלך תופיע כאן."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktálásod itt jelenik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte Anda akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua dettatura apparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにディクテーションが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기 결과가 여기에 나타나요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteringen din vises her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dictee verschijnt hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dyktowanie pojawi się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu ditado aparecerá aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша диктовка появится здесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš diktát sa zobrazí tu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din diktering visas här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การพิมพ์ด้วยเสียงของคุณจะปรากฏที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteniz burada görünecek."
          }
