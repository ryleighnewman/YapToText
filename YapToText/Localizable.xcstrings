          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案不是支援的模型。語音模型為 whisper.cpp 的 GGML .bin 檔，清理模型則為 llama.cpp 的 GGUF 檔。"
          }
        }
      }
    },
    "That means a lot to a one-person app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يعني الكثير لتطبيق يطوره شخص واحد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro aplikaci, kterou vytváří jeden člověk, to hodně znamená."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det betyder meget for en app, der er lavet af én person."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das bedeutet einer Einzelperson-App sehr viel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso significa mucho para una app de una sola persona."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se merkitsee paljon yhden ihmisen sovellukselle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela compte beaucoup pour une app développée par une seule personne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה חשוב מאוד לאפליקציה של אדם אחד."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez sokat jelent egy egyszemélyes alkalmazásnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu sangat berarti bagi aplikasi yang dibuat satu orang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per un'app realizzata da una sola persona significa molto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 人で作っているアプリにとって、とても励みになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 사람이 만드는 앱에는 정말 큰 힘이 돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det betyr mye for en app laget av én person."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat betekent veel voor een app van één persoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wiele znaczy dla aplikacji tworzonej przez jedną osobę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso significa muito para um app feito por uma pessoa só."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для приложения одного человека это много значит."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre aplikáciu jedného človeka to veľa znamená."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det betyder mycket för en app som görs av en person."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งนั้นมีความหมายมากสำหรับแอปที่ทำโดยคนคนเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek kişilik bir uygulama için bu çok şey ifade ediyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для застосунку однієї людини це багато важить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều đó có ý nghĩa rất lớn với một ứng dụng do một người làm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于一人开发的应用来说，这意义非凡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對一個人開發的 App 來說，這意義非凡。"
          }
        }
      }
    },
    "That mode has no cleanup engine available right now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الوضع لا يملك محرك تنظيف متاحاً الآن."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento režim právě nemá dostupný motor úprav."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne tilstand har ingen oprydningsmotor tilgængelig lige nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Modus ist gerade keine Bereinigungs-Engine verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese modo no tiene ningún motor de limpieza disponible en este momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä tilalla ei ole tällä hetkellä käytettävissä olevaa siistintämoottoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce mode n'a pas de moteur de nettoyage disponible pour le moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למצב הזה אין כרגע מנוע ניקוי זמין."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehhez a módhoz jelenleg nincs elérhető tisztító motor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode itu saat ini tidak punya mesin pembersihan yang tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa modalità non ha al momento un motore di pulizia disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのモードは、現在利用できるクリーンアップエンジンがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 모드에서 지금 사용할 수 있는 정리 엔진이 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den modusen har ingen opprydningsmotor tilgjengelig akkurat nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die modus heeft op dit moment geen opschoonengine beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten tryb nie ma teraz dostępnego silnika czyszczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modo não tem um mecanismo de limpeza disponível agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого режима сейчас нет доступного движка очистки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento režim momentálne nemá k dispozícii žiadny engine úpravy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det läget har ingen rensningsmotor tillgänglig just nu."
