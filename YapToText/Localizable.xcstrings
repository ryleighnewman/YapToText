    "'%@' isn't downloaded yet. Download it on the AI Models page.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تنزيل '%@' بعد. نزّله من صفحة نماذج الذكاء الاصطناعي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ještě není stažený. Stáhněte jej na stránce Modely AI."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' er ikke hentet endnu. Hent den på siden AI-modeller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ist noch nicht heruntergeladen. Lade es auf der Seite „KI-Modelle“ herunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' todavía no se ha descargado. Descárgalo en la página Modelos de IA."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” ei ole vielä ladattu. Lataa se AI-mallit-sivulta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' n'est pas encore téléchargé. Téléchargez-le sur la page Modèles d'IA."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המודל '%@' עדיין לא הורד. הורד אותו בדף מודלי ה-AI."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” még nincs letöltve. Töltsd le az AI modellek oldalon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' belum diunduh. Unduh di halaman Model AI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' non è ancora stato scaricato. Scaricalo dalla pagina Modelli IA."
