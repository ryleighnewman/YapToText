        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ook %lld gelijkklinkende woorden gekoppeld aan “%@”"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatkowo przypisano %lld podobnie brzmiących słów do „%@”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também associei %lld palavras parecidas a “%@”"
          }
        },
        "ru": {
          "stringUnit": {
