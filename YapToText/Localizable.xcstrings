    "The audio track can't be decoded.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فك ترميز المسار الصوتي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvukovou stopu nelze dekódovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydsporet kan ikke afkodes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audiospur kann nicht dekodiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede decodificar la pista de audio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänirataa ei voida purkaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La piste audio ne peut pas être décodée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לפענח את רצועת האודיו."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hangsáv nem dekódolható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Track audio tidak dapat didekode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile decodificare la traccia audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声トラックをデコードできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 트랙을 디코딩할 수 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydsporet kan ikke dekodes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het audiospoor kan niet worden gedecodeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zdekodować ścieżki audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A faixa de áudio não pôde ser decodificada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удаётся декодировать аудиодорожку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvukovú stopu sa nepodarilo dekódovať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudspåret kan inte avkodas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถถอดรหัสแทร็กเสียงได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses parçası çözümlenemiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіодоріжку не вдалося декодувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể giải mã luồng âm thanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解码该音轨。"
