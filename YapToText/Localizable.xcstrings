    "Accessibility not sticking? Reveal the app to drag it into the list.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُحفظ إمكانية الوصول؟ أظهر التطبيق لتسحبه إلى القائمة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístupnost se nedrží? Zobrazte aplikaci a přetáhněte ji do seznamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hænger Tilgængelighed ikke fast? Vis appen, så du kan trække den ind på listen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen werden nicht übernommen? Zeige die App im Finder, um sie in die Liste zu ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Accesibilidad no se mantiene? Muestra la app para arrastrarla a la lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Eikö saavutettavuus pysy päällä? Näytä sovellus, jotta voit vetää sen listaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accessibilité ne s'applique pas ? Affichez l'app pour la faire glisser dans la liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנגישות לא נשמרת? חשוף את האפליקציה כדי לגרור אותה לרשימה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem marad meg az Akadálymentesítés engedély? Jelenítsd meg az alkalmazást, és húzd a listába."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksesibilitas tidak tersimpan? Tampilkan aplikasi untuk menyeretnya ke daftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Accessibilità non si attiva? Mostra l'app per trascinarla nell'elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティが反映されませんか? アプリを表示して、リストにドラッグしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용이 적용되지 않나요? 앱을 드러내서 목록으로 끌어다 놓으세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgjengelighet holder seg ikke? Vis appen for å dra den inn i listen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegankelijkheid blijft niet hangen? Toon de app om hem naar de lijst te slepen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostępność nie zapisuje się? Pokaż aplikację, aby przeciągnąć ją na listę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Acessibilidade não pegou? Mostre o app para arrastá-lo para a lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Универсальный доступ не сохраняется? Покажите приложение, чтобы перетащить его в список."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostupnosť sa nedrží? Zobrazte aplikáciu a presuňte ju do zoznamu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastnar inte tillgänglighet? Visa appen för att dra in den i listan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงไม่ติดใช่ไหม แสดงแอปเพื่อลากเข้าไปในรายการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik kalıcı olmuyor mu? Uygulamayı listeye sürüklemek için uygulamayı gösterin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступність не зберігається? Покажіть програму, щоб перетягнути її в список."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền Trợ năng không được ghi nhận? Hiện ứng dụng để kéo nó vào danh sách."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能权限没有生效？在访达中显示该应用，然后将其拖入列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用權限無法生效？請顯示 App，並將它拖曳到清單中。"
          }
        }
      }
    },
