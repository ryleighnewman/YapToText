    "You're on a %lld-day streak. Your best is %lld days.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت في سلسلة متتالية من %lld يوماً. أفضل سلسلة لديك %lld يوماً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte sérii %lld dní. Vaše nejdelší je %lld dní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er i en række på %lld dage. Din bedste er %lld dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist auf einer %lld-Tage-Serie. Deine beste sind %lld Tage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevas una racha de %lld días. Tu mejor racha es de %lld días."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Putkesi on %lld päivää. Paras putkesi on %lld päivää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes sur une série de %lld jours. Votre meilleure est de %lld jours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה ברצף של %lld ימים. הטוב ביותר שלך הוא %lld ימים."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld napos sorozatban vagy. A legjobb eredményed %lld nap."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sedang punya rangkaian %lld hari. Rekor terbaik Anda %lld hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei a una serie di %lld giorni. La tua migliore è di %lld giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 日連続中です。最長記録は %lld 日です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld일 연속 기록 중이에요. 최고 기록은 %lld일이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er på en %lld-dagers rekke. Din beste er %lld dager."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zit op een reeks van %lld dagen. Je beste is %lld dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz passę %lld dni. Twoja najlepsza to %lld dni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está numa sequência de %lld dias. Sua melhor é de %lld dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас серия из %lld дн. Ваш рекорд: %lld дн."
