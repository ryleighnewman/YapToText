    "This version of macOS has no Apple Intelligence; AI modes use the bundled on-device model instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الإصدار من macOS لا يملك Apple Intelligence، لذلك تستخدم أوضاع الذكاء الاصطناعي النموذج المدمج على الجهاز بدلاً منه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato verze macOS nemá Apple Intelligence; režimy AI místo toho používají vestavěný model na zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne version af macOS har ingen Apple Intelligence; AI-tilstande bruger i stedet den medfølgende model på enheden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese macOS-Version hat kein Apple Intelligence; KI-Modi verwenden stattdessen das mitgelieferte Modell auf dem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de macOS no tiene Apple Intelligence; los modos de IA usan en su lugar el modelo incluido en el dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä macOS-versiossa ei ole Apple Intelligence -ominaisuutta. AI-tilat käyttävät sen sijaan sovelluksen mukana tulevaa laitteen mallia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de macOS n'a pas Apple Intelligence ; les modes IA utilisent à la place le modèle local intégré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרסת macOS הזו אינה כוללת Apple Intelligence; מצבי AI משתמשים במקום זאת במודל המקומי המצורף."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a macOS-verzió nem tartalmaz Apple Intelligence-t; az AI módok helyette a beépített helyi modellt használják."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi macOS ini tidak memiliki Apple Intelligence; mode AI memakai model di perangkat bawaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione di macOS non ha Apple Intelligence; le modalità IA usano invece il modello incluso sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この macOS バージョンには Apple Intelligence がないため、AI モードは代わりに同梱のオンデバイスモデルを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 macOS 버전에는 Apple Intelligence가 없어요. AI 모드는 대신 포함된 기기 내 모델을 사용해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne versjonen av macOS har ikke Apple Intelligence; KI-moduser bruker den innebygde modellen på enheten i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze versie van macOS heeft geen Apple Intelligence; AI-modi gebruiken in plaats daarvan het ingebouwde model op het apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wersja macOS nie ma Apple Intelligence; tryby AI używają zamiast tego dołączonego modelu na urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do macOS não tem a Apple Intelligence; os modos de IA usam o modelo incluído no dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой версии macOS нет Apple Intelligence, поэтому режимы с ИИ используют встроенную модель на устройстве."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto verzia macOS nemá Apple Intelligence; režimy AI namiesto toho používajú vstavaný model v zariadení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här versionen av macOS har ingen Apple Intelligence; AI-lägena använder i stället den medföljande modellen på enheten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS เวอร์ชันนี้ไม่มี Apple Intelligence โหมด AI จึงใช้โมเดลในเครื่องที่มาพร้อมแอปแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu macOS sürümünde Apple Intelligence yok; YZ modları bunun yerine dahili cihaz içi modeli kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цій версії macOS немає Apple Intelligence; режими ШІ натомість використовують вбудовану модель на пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản macOS này không có Apple Intelligence; các chế độ AI dùng mô hình trên thiết bị đi kèm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 macOS 没有 Apple Intelligence；AI 模式将改用内置的本机模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 macOS 沒有 Apple Intelligence；AI 模式會改用內建的裝置端模型。"
          }
        }
      }
    },
