            "value": "Sửa bằng giọng nói: “xóa cái đó”, “thay X bằng Y”, “thêm cái này vào từ điển của tôi”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音更正：“scratch that”、“replace X with Y”、“add this to my dictionary”"
          }
        },
