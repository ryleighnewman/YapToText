        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמלול מהיר ומילולי עם פיסוק בסיסי. ללא AI."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyors, szó szerinti beszédfelismerés alapvető írásjelekkel. AI nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
