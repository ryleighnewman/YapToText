        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stlačte kláves…"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en tangent…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่ม…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tuşa dokunun…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть клавішу…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn một phím…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下一个按键…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請按下按鍵…"
          }
        }
      }
    },
    "Tap again. The result replaces your selection.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مجدداً. تحل النتيجة محل تحديدك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte znovu. Výsledek nahradí váš výběr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk igen. Resultatet erstatter din markering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe erneut. Das Ergebnis ersetzt deine Markierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa de nuevo. El resultado reemplaza tu selección."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta uudelleen. Tulos korvaa valintasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez à nouveau. Le résultat remplace votre sélection."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש שוב. התוצאה מחליפה את הבחירה שלך."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints újra. Az eredmény lecseréli a kijelölésedet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk lagi. Hasilnya menggantikan pilihan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca di nuovo. Il risultato sostituisce la tua selezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度押してください。結果が選択範囲を置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 탭하세요. 결과가 선택 영역을 대체해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk igjen. Resultatet erstatter markeringen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik opnieuw. Het resultaat vervangt je selectie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij ponownie. Wynik zastąpi zaznaczenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque de novo. O resultado substitui sua seleção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ещё раз. Результат заменит выделенное."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite znova. Výsledok nahradí váš výber."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck igen. Resultatet ersätter din markering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะอีกครั้ง ผลลัพธ์จะแทนที่ข้อความที่เลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar dokunun. Sonuç seçiminizin yerini alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть ще раз. Результат замінить ваше виділення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn lại. Kết quả sẽ thay thế vùng đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次轻按。结果会替换你所选的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再按一次。結果會取代你的選取內容。"
          }
        }
      }
    },
    "Tap one, fill in your real value, and then saying “insert phone number” types the actual number.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على واحد، واملأ قيمتك الحقيقية، ثم عند قول “insert phone number” يُكتب الرقم الفعلي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na jednu, vyplňte svou skutečnou hodnotu a pak vyslovení „insert phone number“ napíše skutečné číslo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en, udfyld din rigtige værdi, og når du så siger “insert phone number”, skrives det rigtige nummer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine, trage deinen echten Wert ein, und wenn du „insert phone number“ sagst, wird die echte Nummer getippt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa uno, rellena tu valor real, y entonces al decir “insertar número de teléfono” se escribe el número real."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta yhtä, täytä oikea arvo, ja kun sanot ”insert phone number”, oikea numero kirjoitetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez-en un, saisissez votre vraie valeur, et dire “insère numéro de téléphone” tape le numéro réel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על אחד, מלא את הערך האמיתי שלך, ואז אמירת “insert phone number” תקליד את המספר בפועל."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egyre, add meg a valódi értéket, és ezután a „insert phone number” kimondása begépeli a tényleges számot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk satu, isi nilai asli Anda, lalu ucapkan “insert phone number” untuk mengetik nomor sebenarnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca uno, inserisci il tuo valore reale, e poi dire “insert phone number” scrive il numero vero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一つタップして、実際の値を入力してください。そうすると「insert phone number」と言うだけで、実際の番号が入力されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나를 탭하고 실제 값을 입력하면, “insert phone number”라고 말할 때 실제 번호가 입력돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en, fyll inn din egen verdi, og så skriver «insert phone number» det faktiske tallet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik er een aan, vul je echte waarde in, en als je dan “insert phone number” zegt, typt het het echte nummer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij jeden, wpisz swoją prawdziwą wartość, a wtedy powiedzenie „wstaw numer telefonu” wpisze właściwy numer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um, preencha seu valor real, e então dizer “inserir número de telefone” digita o número de verdade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите одну, введите ваше настоящее значение, и тогда фраза «вставь номер телефона» напечатает настоящий номер."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na jednu, vyplňte svoju skutočnú hodnotu a potom povedanie „vlož telefónne číslo“ napíše skutočné číslo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en, fyll i ditt riktiga värde, så skriver ”infoga telefonnummer” det faktiska numret."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะหนึ่งรายการ กรอกค่าจริงของคุณ แล้วเมื่อพูดว่า “insert phone number” ระบบจะพิมพ์หมายเลขจริงออกมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birine dokunun, gerçek değerinizi girin; sonra “telefon numarası ekle” demek gerçek numarayı yazar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть один, введіть справжнє значення, і тоді, сказавши «вставити номер телефону», надрукується реальний номер."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn một mục, điền giá trị thật, và sau đó nói “chèn số điện thoại” sẽ gõ số thật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按一项并填入你的实际值，之后说“insert phone number”就会输入真实的号码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選一個項目，填入你的實際值，之後說「insert phone number」就會輸入實際的號碼。"
          }
        }
      }
    },
    "Tap the Quick Edit key (Right Option) and say the change: shorter, fix the grammar, bullet points, Spanish.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مفتاح التحرير السريع (⌥ الأيمن) وقل التغيير: أقصر، صحّح القواعد، نقاط تعداد، بالإسبانية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na klávesu Rychlých úprav (pravý Option) a řekněte změnu: kratší, oprav gramatiku, odrážky, španělsky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på tasten for hurtig redigering (højre Option) og sig ændringen: kortere, ret grammatikken, punktopstilling, spansk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Taste für Schnellbearbeitung (rechte Option) und sag die Änderung: kürzer, Grammatik korrigieren, Aufzählungspunkte, Spanisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa la tecla de Edición rápida (Opción derecha) y di el cambio: más corto, corregir la gramática, viñetas, español."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta pikamuokkausnäppäintä (oikea Option) ja sano muutos: lyhyemmin, korjaa kielioppi, luetelmakohdat, espanjaksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur la touche Édition rapide (Option droite) et dites la modification : plus court, corrige la grammaire, puces, en espagnol."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על מקש העריכה המהירה (Option הימני) ואמור את השינוי: קצר יותר, תקן דקדוק, נקודות תבליט, ספרדית."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a Gyors szerkesztés billentyűjére (jobb Option), és mondd el a módosítást: rövidebben, javítsd a nyelvtant, felsorolás, spanyolul."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tombol Quick Edit (Option Kanan) dan ucapkan perubahannya: lebih pendek, perbaiki tata bahasa, poin-poin, bahasa Spanyol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il tasto Modifica rapida (Right Option) e di' la modifica: più breve, correggi la grammatica, elenco puntato, spagnolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイック編集キー(右 Option)を押して変更内容を話してください。例: 「shorter」「fix the grammar」「bullet points」「Spanish」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Edit 키(오른쪽 Option)를 탭하고 바꿀 내용을 말하세요: 더 짧게, 문법 고치기, 글머리 기호, 스페인어로."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk hurtigredigeringstasten (høyre Alternativ) og si endringen: kortere, rett grammatikken, punktlister, spansk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de toets Snel bewerken (rechter Optie) en zeg de wijziging: korter, grammatica corrigeren, opsommingstekens, Spaans."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij klawisz Szybkiej edycji (prawy Option) i powiedz zmianę: krócej, popraw gramatykę, punkty, po hiszpańsku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na tecla de Edição rápida (⌥ direito) e diga a mudança: mais curto, corrija a gramática, marcadores, espanhol."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите клавишу быстрого редактирования (правый Option) и скажите правку: короче, исправь грамматику, маркированный список, по-испански."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na kláves Rýchlej úpravy (pravý Option) a povedzte zmenu: kratšie, oprav gramatiku, odrážky, španielsky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på snabbredigeringstangenten (höger Option) och säg ändringen: kortare, rätta grammatiken, punktlista, spanska."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่มแก้ไขด่วน (Option ขวา) แล้วพูดการเปลี่ยนแปลง: สั้นลง แก้ไวยากรณ์ รายการหัวข้อย่อย ภาษาสเปน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı Düzenleme tuşuna (Sağ Option) dokunun ve değişikliği söyleyin: daha kısa, dilbilgisini düzelt, madde işaretleri, İspanyolca."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть клавішу швидкого редагування (праву Option) і скажіть зміну: коротше, виправ граматику, маркіровані пункти, іспанською."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn phím Chỉnh sửa nhanh (Option phải) và nói thay đổi: ngắn hơn, sửa ngữ pháp, gạch đầu dòng, tiếng Tây Ban Nha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻按快速编辑键（右 Option）并说出修改内容：更简短、修正语法、项目符号、西班牙语。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕按快速編輯按鍵（右側 Option），然後說出變更內容：縮短、修正文法、項目符號、翻譯成西班牙文。"
          }
        }
      }
    },
    "Tap the key to talk; tap again to process and insert your words.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط المفتاح للتحدث، واضغطه مجدداً لمعالجة كلماتك وإدراجها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na klávesu a mluvte; dalším klepnutím zpracujete a vložíte slova."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på tasten for at tale; tryk igen for at behandle og indsætte dine ord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke die Taste zum Sprechen; drücke erneut, um deine Worte zu verarbeiten und einzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa la tecla para hablar; púlsala de nuevo para procesar e insertar tus palabras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta näppäintä puhuaksesi. Napauta uudelleen käsitelläksesi ja lisätäksesi sanasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur la touche pour parler ; appuyez à nouveau pour traiter et insérer vos mots."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על המקש כדי לדבר; הקש שוב כדי לעבד ולהכניס את המילים שלך."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a billentyűre a beszédhez; újabb koppintás feldolgozza és beszúrja a szavaidat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tombol untuk bicara; ketuk lagi untuk memproses dan menyisipkan kata-kata Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il tasto per parlare; toccalo di nuovo per elaborare e inserire le parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを押して話し、もう一度押すと処理して言葉を挿入します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 눌러 말하고, 다시 누르면 말을 처리해서 삽입해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk tasten for å snakke; trykk igjen for å behandle og sette inn ordene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de toets om te praten; tik opnieuw om je woorden te verwerken en in te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij klawisz, aby mówić; naciśnij ponownie, aby przetworzyć i wstawić słowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na tecla para falar; toque de novo para processar e inserir suas palavras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите клавишу, чтобы говорить. Нажмите ещё раз, чтобы обработать и вставить слова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknutím na kláves začnete rozprávať; ďalším ťuknutím spracujete a vložíte slová."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på tangenten för att prata; tryck igen för att bearbeta och infoga dina ord."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่มเพื่อพูด แตะอีกครั้งเพื่อประมวลผลและแทรกคำของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşmak için tuşa dokunun; sözcüklerinizi işleyip eklemek için tekrar dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть клавішу, щоб говорити; натисніть ще раз, щоб обробити і вставити слова."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn phím để nói; nhấn lần nữa để xử lý và chèn lời bạn nói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下此键开始说话；再次按下即可处理并插入你的文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下按鍵開始說話；再按一次即可處理並插入你的文字。"
          }
        }
      }
    },
    "Tap to start / stop": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط للبدء / الإيقاف"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím spustit / zastavit"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at starte / stoppe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antippen zum Starten / Stoppen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsar para iniciar / detener"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta aloittaaksesi tai lopettaaksesi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyer pour démarrer / arrêter"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש כדי להתחיל / לעצור"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintás: indítás / leállítás"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk mulai / berhenti"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per avviare / fermare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップで開始 / 停止"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하여 시작 / 중지"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å starte / stoppe"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om te starten / stoppen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, aby zacząć / zatrzymać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para iniciar / parar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажатие для запуска / остановки"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknutím spustíte / zastavíte"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att starta / stoppa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพื่อเริ่ม / หยุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlatmak / durdurmak için dokunun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть, щоб почати / зупинити"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn để bắt đầu / dừng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻按开始 / 停止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕按開始／停止"
          }
        }
      }
    },
    "Tap to start listening, tap again to apply. Double-tap to cancel a running edit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لبدء الاستماع، واضغط مجدداً للتطبيق. اضغط مرتين لإلغاء التعديل الجاري."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím začnete poslouchat, klepnutím znovu použijete. Dvojím klepnutím zrušíte probíhající úpravu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at begynde at lytte, tryk igen for at anvende. Dobbeltryk for at annullere en igangværende redigering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe zum Zuhören, tippe erneut zum Übernehmen. Doppeltippen bricht eine laufende Bearbeitung ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa para empezar a escuchar y vuelve a pulsar para aplicar. Pulsa dos veces para cancelar una edición en curso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta aloittaaksesi kuuntelun, napauta uudelleen ottaaksesi käyttöön. Kaksoisnapautus peruuttaa käynnissä olevan muokkauksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez pour commencer l'écoute, appuyez à nouveau pour appliquer. Double-appuyez pour annuler une modification en cours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש כדי להתחיל להקשיב, הקש שוב כדי להחיל. הקש פעמיים כדי לבטל עריכה שרצה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a hallgatás indításához, újabb koppintással alkalmazd. Dupla koppintással megszakíthatod a futó szerkesztést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk mulai mendengarkan, ketuk lagi untuk menerapkan. Ketuk dua kali untuk membatalkan suntingan yang sedang berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per iniziare ad ascoltare, toccalo di nuovo per applicare. Tocca due volte per annullare una modifica in corso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして聞き取りを開始し、もう一度タップして適用します。ダブルタップで実行中の編集をキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하면 듣기 시작하고, 다시 탭하면 적용해요. 진행 중인 편집을 취소하려면 두 번 탭하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å begynne å lytte, trykk igjen for å bruke. Dobbelttrykk for å avbryte en kjørende redigering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om te luisteren, tik opnieuw om toe te passen. Dubbel tikken annuleert een lopende bewerking."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, aby zacząć słuchać, stuknij ponownie, aby zastosować. Dwukrotne stuknięcie anuluje trwającą edycję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para começar a ouvir, toque de novo para aplicar. Toque duas vezes para cancelar uma edição em andamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы начать слушать, и ещё раз, чтобы применить. Двойное нажатие отменяет текущую правку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknutím začnite počúvať, ďalším ťuknutím použite. Dvojitým ťuknutím zrušíte bežiacu úpravu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att börja lyssna, tryck igen för att tillämpa. Dubbeltryck för att avbryta en pågående redigering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพื่อเริ่มฟัง แตะอีกครั้งเพื่อใช้งาน แตะสองครั้งเพื่อยกเลิกการแก้ไขที่กำลังทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlemeye başlamak için dokunun, uygulamak için tekrar dokunun. Çalışan bir düzenlemeyi iptal etmek için çift dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть, щоб почати слухати, натисніть ще раз, щоб застосувати. Подвійне натискання скасовує редагування, що виконується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn để bắt đầu nghe, nhấn lại để áp dụng. Nhấn đúp để hủy chỉnh sửa đang chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻按开始聆听，再次轻按即可应用。双击可取消正在进行的编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕按開始聆聽，再按一次即可套用。連按兩下可取消正在執行的編輯。"
          }
        }
      }
    },
    "Tap to start listening, tap again to apply. Press Escape to cancel a running edit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مرة لبدء الاستماع، واضغط مرة أخرى للتطبيق. اضغط Escape لإلغاء تعديل قيد التشغيل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím spustíte poslouchání, dalším klepnutím změnu použijete. Stisknutím klávesy Escape zrušíte probíhající úpravu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk én gang for at begynde at lytte, og tryk igen for at anvende. Tryk på Escape for at annullere en igangværende redigering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie zum Starten der Aufnahme, und ein zweites Mal, um sie anzuwenden. Drücken Sie Escape, um eine laufende Bearbeitung abzubrechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para empezar a escuchar y vuelve a tocar para aplicar. Pulsa Escape para cancelar una edición en curso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita kuuntelu napauttamalla ja ota muutos käyttöön napauttamalla uudelleen. Peru käynnissä oleva muokkaus painamalla Escape."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez pour commencer l'écoute, puis appuyez à nouveau pour appliquer. Appuyez sur Escape pour annuler une modification en cours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש כדי להתחיל להקשיב, והקש שוב כדי להחיל. לחץ על Escape כדי לבטל עריכה שרצה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson a figyelés indításához, majd újra a módosítás alkalmazásához. Futó szerkesztés megszakításához nyomja meg az Escape billentyűt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk mulai mendengarkan, ketuk lagi untuk menerapkan. Tekan Escape untuk membatalkan pengeditan yang sedang berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per iniziare ad ascoltare, tocca di nuovo per applicare. Premi Escape per annullare una modifica in corso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして聞き取りを開始し、もう一度タップすると適用されます。実行中の編集を取り消すには Escape を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하여 듣기를 시작하고, 다시 탭하면 적용됩니다. 진행 중인 편집을 취소하려면 Escape를 누르세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å begynne å lytte, trykk igjen for å bruke. Trykk Escape for å avbryte en pågående redigering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om te beginnen met luisteren en tik opnieuw om toe te passen. Druk op Escape om een lopende bewerking te annuleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, aby zacząć słuchać, i stuknij ponownie, aby zastosować. Naciśnij Escape, aby anulować trwającą edycję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para começar a ouvir e toque de novo para aplicar. Pressione Escape para cancelar uma edição em andamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы начать запись, и нажмите снова, чтобы применить. Нажмите Escape, чтобы отменить выполняющуюся правку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím spustíte počúvanie, ďalším klepnutím použijete zmenu. Stlačením Escape zrušíte prebiehajúcu úpravu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att börja lyssna och tryck igen för att tillämpa. Tryck på Escape för att avbryta en pågående redigering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพื่อเริ่มฟัง แตะอีกครั้งเพื่อนำไปใช้ กด Escape เพื่อยกเลิกการแก้ไขที่กำลังทำงานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlemeye başlamak için dokunun, uygulamak için yeniden dokunun. Çalışan bir düzenlemeyi iptal etmek için Escape tuşuna basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться, щоб почати слухати, і торкніться знову, щоб застосувати. Натисніть Escape, щоб скасувати правку, що виконується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm để bắt đầu nghe, chạm lần nữa để áp dụng. Nhấn Escape để hủy một chỉnh sửa đang chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按开始聆听，再次点按即可应用。按 Escape 可取消正在运行的编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕按開始聆聽，再次輕按即可套用。按 Escape 可取消正在執行的編輯。"
          }
        }
      }
    },
