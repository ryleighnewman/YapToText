    "Erase all data and start from scratch": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح كل البيانات وابدأ من جديد"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymazat všechna data a začít od začátku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet alle data og start forfra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Daten löschen und von vorn beginnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar todos los datos y empezar de cero"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista kaikki tiedot ja aloita alusta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer toutes les données et repartir de zéro"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחק את כל הנתונים והתחל מאפס"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden adat törlése és újrakezdés"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus semua data dan mulai dari awal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella tutti i dati e ricomincia da zero"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデータを消去して最初からやり直す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 데이터를 지우고 처음부터 시작"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slett alle data og start på nytt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gegevens wissen en opnieuw beginnen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymaż wszystkie dane i zacznij od zera"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar todos os dados e começar do zero"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стереть все данные и начать заново"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymazať všetky údaje a začať od nuly"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera all data och börja om från början"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบข้อมูลทั้งหมดและเริ่มใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm verileri silin ve sıfırdan başlayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стерти всі дані і почати спочатку"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa toàn bộ dữ liệu và bắt đầu lại từ đầu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抹掉所有数据并从头开始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抹除所有資料並重新開始"
          }
        }
      }
    },
