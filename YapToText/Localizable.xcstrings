          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Väčšie rozloženie"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Större layout"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลย์เอาต์ใหญ่ขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha büyük düzen"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більший макет"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bố cục lớn hơn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较大布局"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "較大版面"
          }
        }
