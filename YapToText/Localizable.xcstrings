    "Give one command several phrases, like “exclamation point, exclamation, bang”. Type \\n in the Inserts box for a line break.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعطِ أمراً واحداً عدة عبارات، مثل “exclamation point, exclamation, bang”. اكتب \\n في مربع الإدراجات لكسر السطر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednomu příkazu přiřaďte několik frází, například „exclamation point, exclamation, bang“. Pro zalomení řádku napište do pole Vložení \\n."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv én kommando flere udtryk, f.eks. “exclamation point, exclamation, bang”. Skriv \\n i feltet Indsæt for et linjeskift."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einem Befehl mehrere Formulierungen, etwa „exclamation point, exclamation, bang“. Gib \\n im Feld Einfügungen für einen Zeilenumbruch ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna a un comando varias frases, como “signo de exclamación, exclamación, admiración”. Escribe \\n en el cuadro Insertos para un salto de línea."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna yhdelle komennolle useita ilmaisuja, kuten ”huutomerkki, huudahdus, bang”. Kirjoita Lisäykset-kenttään \\n rivinvaihtoa varten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez à une commande plusieurs formulations, comme “point d'exclamation, exclamation, bang”. Tapez \\n dans la zone Insertions pour un saut de ligne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תן לפקודה אחת כמה ביטויים, כמו “exclamation point, exclamation, bang”. הקלד \\n בתיבת ההוספות לשבירת שורה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy parancshoz több kifejezést is megadhatsz, például „exclamation point, exclamation, bang”. Sortöréshez írd be a \\n jelölést a Beszúrások mezőbe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri satu perintah beberapa frasa, seperti “exclamation point, exclamation, bang”. Ketik \\n di kotak Sisipan untuk ganti baris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna a un comando più frasi, come “exclamation point, exclamation, bang”. Scrivi \\n nella casella Inserimenti per andare a capo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 つのコマンドに複数の言い方を設定できます。例: 「exclamation point, exclamation, bang」。改行には挿入欄に \\n と入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령 하나에 여러 문구를 연결하세요. 예: “exclamation point, exclamation, bang”. 줄바꿈은 삽입 상자에 \\n을 입력하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi én kommando flere fraser, som «exclamation point, exclamation, bang». Skriv \\n i feltet Innsettinger for et linjeskift."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef één opdracht meerdere zinnen, zoals “exclamation point, exclamation, bang”. Typ \\n in het vak Invoegingen voor een regeleinde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypisz jednemu poleceniu kilka fraz, na przykład „wykrzyknik, wykrzyknik, buch”. Wpisz \\n w polu Wstawki, aby dodać podział wiersza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê a um comando várias frases, como “ponto de exclamação, exclamação, bang”. Digite \\n na caixa Inserções para uma quebra de linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте одной команде несколько фраз, например «восклицательный знак, восклицание, знак». Введите \\n в поле вставок, чтобы сделать перенос строки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednému príkazu dajte viac fráz, napríklad „výkričník, výkrik, vykrik“. Do poľa Vložky napíšte \\n pre zalomenie riadku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge ett kommando flera fraser, till exempel ”utropstecken, utrop, smäll”. Skriv \\n i rutan Infogningar för en radbrytning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้คำสั่งหนึ่งคำมีหลายวลี เช่น “exclamation point, exclamation, bang” พิมพ์ \\n ในช่องแทรกเพื่อขึ้นบรรทัดใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir komuta birkaç ifade verin, örneğin “ünlem işareti, ünlem”. Satır sonu için Ekle kutusuna \\n yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте одній команді кілька фраз, наприклад «знак оклику, оклик, bang». Введіть \\n у полі «Вставки», щоб отримати перенесення рядка."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gán một lệnh nhiều cụm từ, như “dấu chấm than, chấm than, bang”. Gõ \\n trong ô Chèn để xuống dòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为一个命令设置多个说法，例如“exclamation point, exclamation, bang”。在“插入”框中输入 \\n 即可换行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為一個指令設定多個說法，例如「exclamation point, exclamation, bang」。在「插入」欄位中輸入 \\n 即可換行。"
          }
        }
      }
    },
    "Give one emoji several phrases, like “fire emoji, flame emoji, lit emoji”.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعطِ رمزاً تعبيرياً واحداً عدة عبارات، مثل “fire emoji, flame emoji, lit emoji”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednomu emoji přiřaďte více frází, například „fire emoji, flame emoji, lit emoji“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv én emoji flere udtryk, f.eks. “fire emoji, flame emoji, lit emoji”."
          }
        },
        "de": {
          "stringUnit": {
