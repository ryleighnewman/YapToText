    "Don't forget: you can edit each mode's prompt in Modes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تنسَ: يمكنك تحرير أمر كل وضع من الأوضاع."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezapomeňte: prompt každého režimu můžete upravit v Režimech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Husk: du kan redigere hver tilstands prompt under Tilstande."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht vergessen: Du kannst den Prompt jedes Modus unter Modi bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No olvides que puedes editar el prompt de cada modo en Modos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muista: voit muokata jokaisen tilan kehotetta Tilat-kohdassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'oubliez pas : vous pouvez modifier l'invite de chaque mode dans Modes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אל תשכח: אפשר לערוך את ההנחיה של כל מצב במצבים."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne feledd: minden mód utasítását a Módok részben szerkesztheted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan lupa: Anda bisa mengedit prompt setiap mode di Mode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non dimenticare: puoi modificare il prompt di ogni modalità in Modalità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お忘れなく: 各モードのプロンプトはモードで編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잊지 마세요. 모드에서 각 모드의 프롬프트를 편집할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Husk at du kan redigere prompten til hver modus under Moduser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergeet niet: je kunt de prompt van elke modus bewerken onder Modi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamiętaj: prompt każdego trybu możesz edytować w sekcji Tryby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
