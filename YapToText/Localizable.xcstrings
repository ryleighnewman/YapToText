        }
      }
    },
    "Drop any audio or video file on the Utility page to transcribe it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسقط أي ملف صوتي أو مرئي على صفحة الأدوات لنسخه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepsání provedete přetažením libovolného zvukového nebo video souboru na stránku Nástroje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slip en hvilken som helst lyd- eller videofil på siden Værktøj for at transskribere den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe eine beliebige Audio- oder Videodatei auf die Seite Hilfsprogramme, um sie zu transkribieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta cualquier archivo de audio o video en la página Utilidades para transcribirlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pudota mikä tahansa ääni- tai videotiedosto Työkalut-sivulle litteroidaksesi sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez n'importe quel fichier audio ou vidéo sur la page Utilitaires pour le transcrire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרור כל קובץ אודיו או וידאו לדף הכלי העזר כדי לתמלל אותו."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzz bármely hang- vagy videófájlt a Segédeszközök oldalra az átíráshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan file audio atau video apa pun di halaman Utilitas untuk mentranskripsinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un file audio o video qualsiasi nella pagina Utilità per trascriverlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーティリティページに任意の音声または動画ファイルをドロップすると書き起こします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유틸리티 페이지에 오디오나 비디오 파일을 끌어다 놓으면 전사해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slipp en hvilken som helst lyd- eller videofil på Verktøy-siden for å transkribere den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet elk audio- of videobestand op de pagina Hulpprogramma's om het te transcriberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upuść dowolny plik audio lub wideo na stronie Narzędzia, aby go przetranskrybować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte qualquer arquivo de áudio ou vídeo na página Utilitários para transcrevê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите любой аудио- или видеофайл на страницу «Утилиты», чтобы расшифровать его."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na stránke Nástroje presuňte ľubovoľný zvukový alebo video súbor a prepíšte ho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp valfri ljud- eller videofil på sidan Verktyg för att transkribera den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางไฟล์เสียงหรือวิดีโอใดก็ได้ในหน้าเครื่องมือเพื่อถอดเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazıya dökmek için Yardımcı sayfasına herhangi bir ses veya video dosyası bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть будь-який аудіо- чи відеофайл на сторінку «Утиліти», щоб транскрибувати його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thả bất kỳ tệp âm thanh hoặc video nào vào trang Tiện ích để phiên âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将任意音频或视频文件拖到“实用工具”页面即可转写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將任何音訊或影片檔案拖放到「工具」頁面即可轉錄。"
          }
        }
      }
    },
    "Drop or choose any audio or video file, including Voice Memos, and get the text.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسقط أو اختر أي ملف صوتي أو مرئي، بما في ذلك Voice Memos، واحصل على النص."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetáhněte nebo vyberte libovolný zvukový nebo video soubor, včetně Hlasových poznámek, a získejte text."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slip eller vælg en hvilken som helst lyd- eller videofil, inklusive Stemmememoer, og få teksten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe eine beliebige Audio- oder Videodatei hierher oder wähle sie aus, auch Sprachmemos, und erhalte den Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta o elige cualquier archivo de audio o video, incluidas las Notas de voz, y obtén el texto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pudota tai valitse mikä tahansa ääni- tai videotiedosto, myös Äänimuistiot, ja saa teksti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez ou choisissez n'importe quel fichier audio ou vidéo, y compris les Mémos vocaux, et obtenez le texte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרור או בחר כל קובץ אודיו או וידאו, כולל הקלטות קוליות, וקבל את הטקסט."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzz vagy válassz bármely hang- vagy videófájlt, például hangjegyzeteket is, és kapd meg a szöveget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan atau pilih file audio atau video apa pun, termasuk Voice Memos, dan dapatkan teksnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina o scegli un file audio o video qualsiasi, comprese le Note vocali, e ottieni il testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボイスメモを含む任意の音声または動画ファイルをドロップするか選ぶと、テキストを取得できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 메모를 포함한 오디오나 비디오 파일을 끌어다 놓거나 골라서 텍스트를 받으세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slipp eller velg en hvilken som helst lyd- eller videofil, inkludert Talememoer, og få teksten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet of kies elk audio- of videobestand, inclusief Spraakmemo's, en krijg de tekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upuść lub wybierz dowolny plik audio lub wideo, także Notatki głosowe, i otrzymaj tekst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte ou escolha qualquer arquivo de áudio ou vídeo, inclusive Memorandos de Voz, e obtenha o texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите или выберите любой аудио- или видеофайл, включая «Голосовые заметки», и получите текст."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Presuňte alebo vyberte ľubovoľný zvukový alebo video súbor vrátane Hlasových poznámok a získajte text."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp eller välj vilken ljud- eller videofil som helst, inklusive Röstmemon, och få texten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางหรือเลือกไฟล์เสียงหรือวิดีโอใดก็ได้ รวมถึงบันทึกเสียง แล้วรับข้อความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli Notlar dahil herhangi bir ses veya video dosyasını bırakın ya da seçin ve metnini alın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть або оберіть будь-який аудіо- чи відеофайл, зокрема голосові нотатки, і отримайте текст."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thả hoặc chọn bất kỳ tệp âm thanh hoặc video nào, kể cả Ghi chú thoại, để lấy văn bản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖放或选择任意音频或视频文件（包括语音备忘录），即可获得文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖放或選擇任何音訊或影片檔案（包括語音備忘錄），即可取得文字。"
          }
        }
      }
    },
