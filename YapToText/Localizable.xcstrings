          "stringUnit": {
            "state": "translated",
            "value": "מקליד בדיוק את מה שאתה אומר, מילה במילה"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szó szerint, pontosan azt írja, amit mondasz"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengetik persis apa yang Anda ucapkan, kata demi kata"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrive esattamente quello che dici, parola per parola"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した言葉を一語一句そのまま入力"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말한 그대로 한 단어씩 입력"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriver nøyaktig det du sier, ord for ord"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typt precies wat je zegt, woord voor woord"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisuje dokładnie to, co mówisz, słowo w słowo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita exatamente o que você diz, palavra por palavra"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Печатает ровно то, что вы сказали, слово в слово"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Píše presne to, čo poviete, slovo po slove"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriver exakt det du säger, ord för ord"
