    "Saved. Click the box to change it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ. انقر الحقل لتغييره."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženo. Kliknutím do pole ji změníte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemt. Klik i feltet for at ændre det."
          }
        },
        "de": {
          "stringUnit": {
