        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen sovellus käyttää jo tätä pikanäppäintä. Valitse toinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce raccourci est déjà utilisé par une autre app. Choisissez-en un autre."
