    "Types exactly what you say, word for word": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتب ما تقوله تماماً، كلمة بكلمة"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíše přesně to, co řeknete, slovo za slovem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriver præcis det, du siger, ord for ord"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt genau das, was du sagst, Wort für Wort"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe exactamente lo que dices, palabra por palabra"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoittaa täsmälleen sanomasi, sana sanalta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tape exactement ce que vous dites, mot pour mot"
          }
        },
