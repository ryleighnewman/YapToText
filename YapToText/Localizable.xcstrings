          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naprawiono awarię, gdy inteligentne wstawianie przywracało schowek po powolnej aplikacji, na przykład Gmailu w Safari"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
