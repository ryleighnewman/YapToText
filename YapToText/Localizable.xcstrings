    "Dictations are used once and never stored.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم الإملاءات مرة واحدة ولا تُخزَّن أبداً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktáty se použijí jednou a nikdy se neukládají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktater bruges én gang og gemmes aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktate werden einmalig verwendet und nie gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dictados se usan una vez y nunca se guardan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanelut käytetään kerran eikä niitä tallenneta koskaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dictées sont utilisées une seule fois et jamais stockées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכתבות נמצאות בשימוש פעם אחת ולעולם לא נשמרות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktálások egyszer kerülnek felhasználásra, és soha nem tárolódnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte dipakai sekali dan tidak pernah disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dettature vengono usate una sola volta e non vengono mai salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディクテーションは一度だけ使われ、保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기는 한 번 사용하고 저장하지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteringer brukes én gang og lagres aldri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictees worden eenmalig gebruikt en nooit opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowania są używane jednorazowo i nigdy nie są przechowywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ditados são usados uma vez e nunca armazenados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовки используются один раз и никогда не сохраняются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktáty sa použijú raz a nikdy sa neukladajú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteringar används en gång och sparas aldrig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การพิมพ์ด้วยเสียงจะถูกใช้ครั้งเดียวและจะไม่ถูกเก็บไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteler bir kez kullanılır ve hiçbir zaman saklanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовки використовуються один раз і ніколи не зберігаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần đọc chính tả chỉ dùng một lần và không bao giờ được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听写内容只使用一次，从不存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽寫內容只會使用一次，且永遠不會儲存。"
          }
        }
      }
    },
    "Dictations longer than 30 seconds no longer lose words at each 30-second mark, or their final second: the audio is now cut at pauses before transcription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإملاءات الأطول من 30 ثانية لم تعد تفقد كلمات عند كل علامة 30 ثانية أو ثانيتها الأخيرة: يُقطع الصوت الآن عند فترات التوقف قبل النسخ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktáty delší než 30 sekund už neztrácejí slova na každé 30sekundové hranici ani svou poslední sekundu: zvuk se nyní před přepisem rozděluje v pauzách"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteringer på over 30 sekunder mister ikke længere ord ved hvert 30-sekunders mærke eller deres sidste sekund: lyden klippes nu ved pauser før transskription"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktate über 30 Sekunden verlieren keine Wörter mehr an jeder 30-Sekunden-Marke oder in ihrer letzten Sekunde: Die Aufnahme wird jetzt vor der Transkription an Pausen geteilt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dictados de más de 30 segundos ya no pierden palabras en cada marca de 30 segundos ni en su último segundo: el audio ahora se corta en las pausas antes de la transcripción"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yli 30 sekunnin saneluista ei enää katoa sanoja jokaisen 30 sekunnin kohdalla eikä viimeisen sekunnin aikana: ääni leikataan nyt taukojen kohdalta ennen litterointia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dictées de plus de 30 secondes ne perdent plus de mots à chaque marque de 30 secondes ni leur dernière seconde : l'audio est désormais découpé aux pauses avant la transcription"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכתבות ארוכות מ-30 שניות כבר לא מאבדות מילים בכל נקודת 30 שניות או בשנייה האחרונה שלהן: השמע נחתך כעת בהפסקות לפני התמלול"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A 30 másodpercnél hosszabb diktálások már nem veszítenek szavakat minden 30 másodperces határnál vagy az utolsó másodpercükben: a hang mostantól a szünetekben lesz felvágva az átírás előtt"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte yang lebih dari 30 detik tidak lagi kehilangan kata di setiap tanda 30 detik atau detik terakhirnya: audio kini dipotong pada jeda sebelum transkripsi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dettature più lunghe di 30 secondi non perdono più parole a ogni soglia di 30 secondi né nel loro ultimo secondo: l'audio ora viene tagliato nelle pause prima della trascrizione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30秒を超える口述で、30秒ごとの区切りや最後の1秒の単語が失われなくなりました。音声は文字起こしの前に、間(ま)の位置で分割されるようになりました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30초가 넘는 받아쓰기에서 30초 구간마다 또는 마지막 1초의 단어가 더 이상 사라지지 않습니다. 이제 오디오는 전사 전에 멈춤 구간에서 나뉩니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteringer på over 30 sekunder mister ikke lenger ord ved hvert 30-sekundersmerke eller i sitt siste sekund: lyden kuttes nå ved pauser før transkripsjon"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictaten langer dan 30 seconden verliezen geen woorden meer bij elke 30-secondengrens of in hun laatste seconde: de audio wordt nu vóór de transcriptie bij pauzes geknipt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowania dłuższe niż 30 sekund nie tracą już słów na każdej 30-sekundowej granicy ani w ostatniej sekundzie: dźwięk jest teraz cięty w pauzach przed transkrypcją"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditados com mais de 30 segundos não perdem mais palavras a cada marca de 30 segundos nem no último segundo: o áudio agora é cortado nas pausas antes da transcrição"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовки длиннее 30 секунд больше не теряют слова на каждой 30-секундной отметке и в последней секунде: звук теперь разрезается на паузах перед расшифровкой"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktáty dlhšie ako 30 sekúnd už nestrácajú slová na každej 30-sekundovej hranici ani vo svojej poslednej sekunde: zvuk sa teraz pred prepisom rozdeľuje v pauzách"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteringar längre än 30 sekunder tappar inte längre ord vid varje 30-sekundersmärke eller i sin sista sekund: ljudet klipps nu vid pauser före transkriptionen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบอกเล่าที่ยาวกว่า 30 วินาทีจะไม่สูญเสียคำที่จุดครบทุก 30 วินาทีหรือในวินาทีสุดท้ายอีกต่อไป: ตอนนี้เสียงจะถูกตัดตรงช่วงหยุดพักก่อนถอดความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 saniyeden uzun dikteler artık her 30 saniyelik işarette veya son saniyelerinde sözcük kaybetmiyor: ses artık yazıya dökülmeden önce duraklamalardan kesiliyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктування довше за 30 секунд більше не втрачає слова на кожній 30-секундній позначці та в останній секунді: звук тепер розрізається на паузах перед розшифровкою"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài đọc dài hơn 30 giây không còn mất từ tại mỗi mốc 30 giây hay ở giây cuối cùng: âm thanh giờ được cắt tại các khoảng dừng trước khi chuyển thành văn bản"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过 30 秒的听写不再在每个 30 秒处或最后一秒丢失词语:音频现在会在转写之前于停顿处切分"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過 30 秒的聽寫不再在每個 30 秒處或最後一秒遺失字詞:音訊現在會在轉錄之前於停頓處切分"
          }
        }
      }
    },
