    "Input volume raised. Try a quiet sentence.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفع مستوى إدخال الصوت. جرّب جملة هادئة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasitost vstupu zvýšena. Zkuste tiše větu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indgangslydstyrken er hævet. Prøv en stille sætning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingangslautstärke erhöht. Probiere einen leisen Satz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen de entrada subido. Prueba una frase suave."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syöttöäänenvoimakkuutta nostettiin. Kokeile hiljaista lausetta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume d'entrée augmenté. Essayez une phrase à voix basse."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוצמת הקלט הועלתה. נסה משפט שקט."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bemeneti hangerő megemelve. Próbálj ki egy halk mondatot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume masukan dinaikkan. Coba satu kalimat pelan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume di ingresso alzato. Prova una frase sommessa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力音量を上げました。小さめの声で一文話してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 볼륨을 올렸어요. 작은 목소리로 한 문장 말해 보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Inngangsvolumet er hevet. Prøv en stille setning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingangsvolume verhoogd. Probeer een zachte zin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podniesiono głośność wejścia. Spróbuj cichego zdania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume de entrada aumentado. Tente uma frase baixinha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Громкость входа повышена. Попробуйте сказать тихую фразу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasitosť vstupu zvýšená. Skúste tichú vetu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingångsvolymen höjd. Prova en tyst mening."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มระดับเสียงอินพุตแล้ว ลองพูดประโยคเบา ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş sesi yükseltildi. Sessiz bir cümle deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гучність входу збільшено. Спробуйте тихе речення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tăng âm lượng đầu vào. Thử một câu nhỏ."
