    "Run different models depending on whether this Mac is plugged in": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل نماذج مختلفة حسب ما إذا كان Mac متصلاً بالكهرباء"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používat různé modely podle toho, zda je Mac připojen k napájení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kør forskellige modeller afhængigt af, om denne Mac er tilsluttet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiedene Modelle verwenden, je nachdem, ob dieser Mac am Netz hängt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa modelos distintos según si este Mac está conectado a la corriente"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä eri malleja sen mukaan, onko tämä Mac kytketty virtalähteeseen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser des modèles différents selon que ce Mac est branché ou non"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרץ מודלים שונים בהתאם לשאלה אם ה-Mac מחובר לחשמל"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Különböző modellek futtatása aszerint, hogy a Mac hálózaton van-e"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan model berbeda tergantung apakah Mac ini tersambung listrik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa modelli diversi a seconda che questo Mac sia collegato o meno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac が電源に接続されているかどうかで、異なるモデルを使う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 전원 연결 여부에 따라 다른 모델 실행"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjør ulike modeller avhengig av om denne Macen er tilkoblet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschillende modellen draaien, afhankelijk van of deze Mac is aangesloten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamiaj różne modele w zależności od tego, czy Mac jest podłączony do zasilania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use modelos diferentes conforme o Mac esteja ligado na tomada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускать разные модели в зависимости от того, подключён ли этот Mac к сети"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spúšťať rôzne modely podľa toho, či je tento Mac pripojený k napájaniu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kör olika modeller beroende på om den här Mac:en är ansluten"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้โมเดลต่างกันตามว่า Mac เครื่องนี้เสียบปลั๊กอยู่หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'in takılı olup olmamasına göre farklı modeller çalıştır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускати різні моделі залежно від того, підключено цей Mac до живлення чи ні"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy các mô hình khác nhau tùy theo Mac này có cắm sạc hay không"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据此 Mac 是否接通电源，运行不同的模型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依照此 Mac 是否接上電源，執行不同的模型"
          }
        }
      }
    },
    "Run one of your saved AI actions on any text.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل أحد إجراءات الذكاء الاصطناعي المحفوظة لديك على أي نص."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spusťte jednu z uložených akcí AI na libovolném textu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kør en af dine gemte AI-handlinger på en hvilken som helst tekst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe eine deiner gespeicherten KI-Aktionen auf beliebigem Text aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta una de tus acciones de IA guardadas sobre cualquier texto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suorita yksi tallennetuista AI-toiminnoistasi mihin tahansa tekstiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez l'une de vos actions IA enregistrées sur n'importe quel texte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעל אחת מפעולות ה-AI השמורות שלך על כל טקסט."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Futtasd bármelyik mentett AI műveletedet bármely szövegen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan salah satu aksi AI yang tersimpan pada teks apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui una delle tue azioni IA salvate su qualsiasi testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意のテキストに、保存した AI アクションを実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 AI 작업 중 하나를 아무 텍스트에나 실행하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjør en av de lagrede KI-handlingene dine på en hvilken som helst tekst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een van je opgeslagen AI-acties uit op elke tekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom jedną z zapisanych akcji AI na dowolnym tekście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute uma das suas ações de IA salvas em qualquer texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите одно из сохранённых действий с ИИ для любого текста."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustiť jednu z uložených akcií AI na ľubovoľnom texte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kör en av dina sparade AI-åtgärder på valfri text."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้การทำงานของ AI ที่บันทึกไว้กับข้อความใดก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmiş YZ eylemlerinizden birini herhangi bir metinde çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустіть одну зі збережених дій ШІ для будь-якого тексту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy một hành động AI đã lưu trên bất kỳ văn bản nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对任意文字运行你保存的某个 AI 操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對任何文字執行一項已儲存的 AI 動作。"
          }
        }
      }
    },
    "Run these on any text from the Utility page. To rewrite SELECTED text in another app, use the menu bar's Regenerate menu and pick a mode.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل هذه على أي نص من صفحة الأدوات. لإعادة كتابة النص المحدد في تطبيق آخر، استخدم قائمة إعادة التوليد في شريط القوائم واختر وضعاً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto akce spusťte nad libovolným textem na stránce Nástroje. Chcete-li přepsat OZNAČENÝ text v jiné aplikaci, použijte v liště menu nabídku Přegenerovat a vyberte režim."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kør disse på en hvilken som helst tekst fra siden Værktøj. For at omskrive MARKERET tekst i en anden app, brug menuen Generér igen i menulinjen og vælg en tilstand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe diese auf beliebigem Text auf der Seite Hilfsprogramme aus. Um MARKIERTEN Text in einer anderen App umzuschreiben, nutze das Menü Neu erzeugen in der Menüleiste und wähle einen Modus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecútalas sobre cualquier texto de la página Utilidades. Para reescribir texto SELECCIONADO en otra app, usa el menú Regenerar de la barra de menús y elige un modo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suorita nämä mihin tahansa tekstiin Työkalut-sivulta. Jos haluat kirjoittaa valitun tekstin uudelleen toisessa sovelluksessa, käytä valikkopalkin Luo uudelleen -valikkoa ja valitse tila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez-les sur n'importe quel texte depuis la page Utilitaires. Pour réécrire le texte SÉLECTIONNÉ dans une autre app, utilisez le menu Régénérer de la barre des menus et choisissez un mode."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעל את אלה על כל טקסט מדף הכלי העזר. כדי לכתוב מחדש טקסט נבחר באפליקציה אחרת, השתמש בתפריט צור מחדש בשורת התפריטים ובחר מצב."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezeket bármely szövegen futtathatod a Segédeszközök oldalról. Másik alkalmazásban kijelölt szöveg átírásához használd a menüsáv Újragenerálás menüjét, és válassz módot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan ini pada teks apa pun dari halaman Utilitas. Untuk menulis ulang teks yang DIPILIH di aplikasi lain, gunakan menu Buat Ulang di bilah menu dan pilih mode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eseguili su qualsiasi testo dalla pagina Utilità. Per riscrivere il testo SELEZIONATO in un'altra app, usa il menu Rigenera della barra dei menu e scegli una modalità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーティリティページの任意のテキストに対して実行できます。他のアプリで選択したテキストを書き直すには、メニューバーの「再生成」メニューからモードを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유틸리티 페이지에서 아무 텍스트에나 실행할 수 있어요. 다른 앱에서 선택한 텍스트를 다시 쓰려면 메뉴 막대의 다시 생성 메뉴에서 모드를 고르세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjør disse på en hvilken som helst tekst fra Verktøy-siden. For å skrive om MARKERT tekst i en annen app, bruk menylinjens Lag på nytt-meny og velg en modus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer deze uit op elke tekst vanaf de pagina Hulpprogramma's. Om GESELECTEERDE tekst in een andere app te herschrijven, gebruik je het menu Opnieuw genereren in de menubalk en kies je een modus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamiaj je na dowolnym tekście ze strony Narzędzia. Aby przepisać ZAZNACZONY tekst w innej aplikacji, użyj menu Generuj ponownie na pasku menu i wybierz tryb."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute estes em qualquer texto da página Utilitários. Para reescrever o texto SELECIONADO em outro app, use o menu Regenerar da barra de menus e escolha um modo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускайте их для любого текста на странице «Утилиты». Чтобы переписать ВЫДЕЛЕННЫЙ текст в другом приложении, используйте меню «Пересоздать» в строке меню и выберите режим."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spúšťajte ich na ľubovoľnom texte zo stránky Nástroje. Na prepísanie OZNAČENÉHO textu v inej aplikácii použite ponuku Pregenerovať na paneli ponuky a vyberte režim."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kör dessa på valfri text från sidan Verktyg. För att skriva om MARKERAD text i en annan app, använd menyradens Skapa om-meny och välj ett läge."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียกใช้สิ่งเหล่านี้กับข้อความใดก็ได้จากหน้าเครื่องมือ หากต้องการเขียนข้อความที่เลือกในแอปอื่นใหม่ ให้ใช้เมนูสร้างใหม่ในแถบเมนูแล้วเลือกโหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunları Yardımcı sayfasındaki herhangi bir metinde çalıştırın. Başka bir uygulamada SEÇİLİ metni yeniden yazmak için menü çubuğunun Yeniden Oluştur menüsünü kullanıp bir mod seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускайте їх для будь-якого тексту на сторінці «Утиліти». Щоб переписати ВИДІЛЕНИЙ текст в іншій програмі, скористайтеся меню «Згенерувати повторно» в рядку меню і оберіть режим."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy các mục này trên bất kỳ văn bản nào từ trang Tiện ích. Để viết lại văn bản ĐÃ CHỌN trong ứng dụng khác, dùng menu Tạo lại trên thanh menu và chọn một chế độ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可对“实用工具”页面中的任意文字运行这些操作。若要改写其他应用中的所选文字，请使用菜单栏中的“重新生成”菜单并选择一种模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可在「工具」頁面對任何文字執行這些動作。若要改寫其他 App 中選取的文字，請使用選單列的「重新產生」選單並選擇模式。"
          }
        }
      }
    },
    "Runs the mode system after each dictation - formatting, cleanup, and Auto. Leave it on to use modes; turn it off any time for the fastest raw transcription.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل نظام الأوضاع بعد كل إملاء: التنسيق والتنظيف والتلقائي. اتركه مفعّلاً لاستخدام الأوضاع، وأوقفه في أي وقت للحصول على النسخ الخام الأسرع."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spouští systém režimů po každém diktátu: formátování, úpravy a Auto. Nechte zapnuté, pokud chcete režimy používat; kdykoli ji vypněte pro nejrychlejší čistý přepis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kører tilstandssystemet efter hver diktering - formatering, oprydning og Auto. Lad den være til for at bruge tilstande; slå den fra når som helst for den hurtigste rå transskription."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt nach jedem Diktat das Modussystem aus, also Formatierung, Bereinigung und Automatik. Lass es eingeschaltet, um Modi zu nutzen; schalte es jederzeit aus für die schnellste rohe Transkription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta el sistema de modos tras cada dictado: formato, limpieza y automático. Déjalo activado para usar modos; desactívalo cuando quieras para la transcripción sin procesar más rápida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suorittaa tilajärjestelmän jokaisen sanelun jälkeen: muotoilun, siistinnän ja automaattitilan. Pidä se päällä käyttääksesi tiloja. Voit kytkeä sen pois milloin tahansa nopeinta raakalitterointia varten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance le système de modes après chaque dictée : mise en forme, nettoyage et automatique. Laissez-le activé pour utiliser les modes ; désactivez-le à tout moment pour une transcription brute des plus rapides."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפעיל את מערכת המצבים אחרי כל הכתבה - עיצוב, ניקוי ואוטומטי. השאר פעיל כדי להשתמש במצבים; כבה אותו בכל עת לתמלול גולמי מהיר ביותר."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden diktálás után lefuttatja a módrendszert: formázás, tisztítás és automatikus mód. Hagyd bekapcsolva a módok használatához; bármikor kikapcsolhatod a leggyorsabb nyers átíráshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjalankan sistem mode setelah setiap dikte - pemformatan, pembersihan, dan Otomatis. Biarkan aktif untuk memakai mode; matikan kapan saja untuk transkripsi mentah tercepat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegue il sistema delle modalità dopo ogni dettatura: formattazione, pulizia e Automatico. Lascialo attivo per usare le modalità; disattivalo in qualsiasi momento per la trascrizione grezza più veloce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディクテーションのたびにモードシステム(整形、クリーンアップ、自動)を実行します。モードを使うならオンのままにし、最も速いそのままの書き起こしを使いたいときはいつでもオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기마다 모드 시스템(서식, 정리, 자동)을 실행해요. 모드를 쓰려면 켜 두고, 가장 빠른 원문 전사를 원하면 언제든 끄세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjører modussystemet etter hver diktering - formatering, opprydding og Auto. La det være på for å bruke moduser; slå det av når som helst for den raskeste rene transkripsjonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draait het modussysteem na elk dictee: opmaak, opschoning en Automatisch. Laat het aan om modi te gebruiken; zet het op elk moment uit voor de snelste ruwe transcriptie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamia system trybów po każdym dyktowaniu: formatowanie, czyszczenie i Auto. Zostaw włączone, aby używać trybów; w każdej chwili możesz wyłączyć, aby uzyskać najszybszą surową transkrypcję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa o sistema de modos após cada ditado: formatação, limpeza e Automático. Deixe ligado para usar modos; desligue a qualquer momento para a transcrição bruta mais rápida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает систему режимов после каждой диктовки: оформление, очистку и автоматический режим. Оставьте включённым, чтобы использовать режимы. Выключите в любой момент для самой быстрой необработанной расшифровки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spúšťa systém režimov po každom diktáte: formátovanie, úpravu a Automaticky. Nechajte zapnuté na používanie režimov; kedykoľvek ho vypnite pre najrýchlejší surový prepis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kör lägessystemet efter varje diktering: formatering, rensning och Auto. Låt det vara på för att använda lägen; stäng av det när som helst för snabbast rå transkription."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำงานระบบโหมดหลังการพิมพ์ด้วยเสียงแต่ละครั้ง ได้แก่ การจัดรูปแบบ การทำความสะอาด และอัตโนมัติ เปิดไว้เพื่อใช้โหมด ปิดเมื่อใดก็ได้เพื่อการถอดเสียงแบบดิบที่เร็วที่สุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her dikteden sonra mod sistemini çalıştırır - biçimlendirme, temizleme ve Otomatik. Modları kullanmak için açık bırakın; en hızlı ham yazıya dökme için istediğiniz zaman kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускає систему режимів після кожної диктовки: форматування, очищення і Авто. Залиште увімкненою, щоб користуватися режимами; вимкніть будь-коли для найшвидшої необробленої транскрибації."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy hệ thống chế độ sau mỗi lần đọc chính tả: định dạng, làm sạch và Tự động. Để bật để dùng chế độ; tắt bất cứ lúc nào để có phiên âm thô nhanh nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每次听写后运行模式系统，包括格式化、清理和自动。保持开启即可使用模式；随时关闭即可获得最快的原始转写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次聽寫後執行模式系統，包括排版、清理與自動模式。保持開啟即可使用模式；隨時關閉即可獲得最快的原始轉錄。"
          }
        }
      }
    },
