    "Ask the on-device model for likely mishearings of “%@” and map them here": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من نموذج الجهاز الأخطاء السمعية المحتملة لـ “%@” واربطها هنا"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádat model na zařízení o pravděpodobné přeslechy „%@“ a přiřadit je zde"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bed modellen på enheden om sandsynlige misforståelser af “%@” og knyt dem her"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass das Modell auf dem Gerät mögliche Verhörer von „%@“ vorschlagen und ordne sie hier zu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir al modelo del dispositivo las confusiones probables de “%@” y asociarlas aquí"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyydä laitteen mallia arvaamaan ”%@” mahdolliset väärinkuulemiset ja yhdistä ne tähän"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander au modèle local les erreurs d'écoute probables de “%@” et les associer ici"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקש ממודל המכשיר טעויות שמיעה סבירות של “%@” ומפה אותן כאן"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérd meg a helyi modellt, hogy adja meg a(z) „%@” szó valószínű félreértéseit, és térképezd őket ide"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minta model di perangkat untuk kemungkinan salah dengar dari “%@” dan petakan di sini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi al modello sul dispositivo le probabili parole fraintese di “%@” e associale qui"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の聞き間違いの候補をオンデバイスモデルに求めて、ここに割り当てる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 모델에 “%@”을(를) 잘못 들을 만한 말을 물어보고 여기에 연결하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Be modellen på enheten om sannsynlige feilhøringer av «%@» og koble dem hit"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag het model op het apparaat om waarschijnlijke verkeerde verstaanders van “%@” en koppel ze hier"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poproś model na urządzeniu o prawdopodobne przesłyszenia „%@” i przypisz je tutaj"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir ao modelo no dispositivo as prováveis confusões de “%@” e associá-las aqui"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросить модель на устройстве подобрать вероятные ошибки распознавания «%@» и сопоставить их здесь"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opýtať sa modelu v zariadení na pravdepodobné nesprávne rozpoznania „%@“ a priradiť ich sem"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Be modellen på enheten om troliga felhörningar av ”%@” och koppla dem här"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้โมเดลในเครื่องหาคำที่อาจฟังผิดของ “%@” แล้วจับคู่ไว้ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz içi modelden “%@” için olası yanlış duyulmaları isteyin ve buraya eşleyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросити модель на пристрої знайти ймовірні помилки розпізнавання «%@» і зіставити їх тут"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu mô hình trên thiết bị tìm các cách nghe nhầm có thể có của “%@” và ánh xạ tại đây"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让本机模型推测“%@”可能被听错的形式，并在此处建立映射"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請裝置端模型找出「%@」可能被聽錯的情況，並在此對應"
          }
        }
      }
    },
