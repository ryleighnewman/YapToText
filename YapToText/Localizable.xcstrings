    "About %@ saved versus typing everything at 40 words a minute.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توفير نحو %@ مقارنة بالكتابة بسرعة 40 كلمة في الدقيقة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ušetřeno zhruba %@ oproti psaní všeho rychlostí 40 slov za minutu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca. %@ sparet i forhold til at skrive alt med 40 ord i minuttet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa %@ gespart gegenüber dem Tippen aller Worte mit 40 Wörtern pro Minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos %@ ahorrados frente a escribir todo a 40 palabras por minuto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Noin %@ säästetty verrattuna kirjoittamiseen 40 sanaa minuutissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %@ économisées par rapport à la frappe de tout à 40 mots par minute."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בערך %@ נחסכו לעומת הקלדה של הכול ב-40 מילים בדקה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Körülbelül %@ megtakarítás ahhoz képest, mintha percenként 40 szóval gépelnél."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekitar %@ dihemat dibanding mengetik semuanya dengan 40 kata per menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa %@ risparmiati rispetto a scrivere tutto a 40 parole al minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎分 40 語でタイプする場合と比べて、約 %@ 節約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분당 40단어로 직접 타이핑하는 것에 비해 약 %@을(를) 아꼈어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca. %@ spart sammenlignet med å skrive alt i 40 ord i minuttet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeveer %@ bespaard ten opzichte van alles typen met 40 woorden per minuut."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Około %@ zaoszczędzone w porównaniu z pisaniem wszystkiego z prędkością 40 słów na minutę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de %@ economizados em comparação com digitar tudo a 40 palavras por minuto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерно %@ сэкономлено по сравнению с печатью всего на скорости 40 слов в минуту."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ušetrené približne %@ oproti písaniu všetkého rýchlosťou 40 slov za minútu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungefär %@ sparat jämfört med att skriva allt i 40 ord per minut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประหยัดเวลาได้ประมาณ %@ เมื่อเทียบกับการพิมพ์ทุกคำด้วยความเร็ว 40 คำต่อนาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dakikada 40 kelimeyle her şeyi yazmaya kıyasla yaklaşık %@ kazanıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заощаджено близько %@ порівняно з друком усього зі швидкістю 40 слів на хвилину."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiết kiệm khoảng %@ so với gõ mọi thứ với tốc độ 40 từ mỗi phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相比以每分钟 40 字打字，约节省 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相較於以每分鐘 40 字打字，約節省 %@。"
          }
        }
      }
    },
