    "Regenerate your last dictation as an email straight from the menu bar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد توليد آخر إملاء لك كبريد إلكتروني مباشرة من شريط القوائم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přegenerujte poslední diktát jako e-mail přímo z lišty menu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Generér din sidste diktering igen som en e-mail direkte fra menulinjen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzeuge dein letztes Diktat direkt aus der Menüleiste als E-Mail neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regenera tu último dictado como correo directamente desde la barra de menús."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo viimeisin sanelu uudelleen sähköpostina suoraan valikkopalkista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Régénérez votre dernière dictée en e-mail directement depuis la barre des menus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צור מחדש את ההכתבה האחרונה שלך כאימייל ישירות משורת התפריטים."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utolsó diktálásod újragenerálása e-mailként, közvetlenül a menüsávból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat ulang dikte terakhir sebagai email langsung dari bilah menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rigenera l'ultima dettatura come email direttamente dalla barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーから、直前のディクテーションをすぐにメールとして作り直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 바로 마지막 받아쓰기를 이메일로 다시 생성하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lag din siste diktering på nytt som e-post rett fra menylinjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Genereer je laatste dictee direct vanuit de menubalk opnieuw als e-mail."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygeneruj ponownie ostatnie dyktowanie jako e-mail prosto z paska menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Regenere seu último ditado como e-mail direto pela barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пересоздайте последнюю диктовку как письмо прямо из строки меню."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Priamo z panela ponuky pregenerujte posledný diktát ako e-mail."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa om din senaste diktering som ett e-postmeddelande direkt från menyraden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างการพิมพ์ด้วยเสียงล่าสุดของคุณใหม่เป็นอีเมลได้จากแถบเมนูทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son diktenizi doğrudan menü çubuğundan e-posta olarak yeniden oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Згенеруйте свою останню диктовку як лист просто з рядка меню."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo lại lần đọc chính tả gần nhất thành email ngay từ thanh menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接从菜单栏将你上一次的听写内容重新生成为邮件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接從選單列將你上一次的聽寫內容重新產生為電子郵件。"
          }
        }
      }
    },
