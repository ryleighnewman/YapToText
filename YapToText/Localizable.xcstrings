        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องพูดคำว่า “insert” ก่อนคำสั่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir komuttan önce “insert” (ekle) kelimesini iste"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимагати слово «вставити» перед командою"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu có từ “chèn” trước lệnh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令前需要说出“insert”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指令前須先說「insert」"
          }
        }
      }
    },
