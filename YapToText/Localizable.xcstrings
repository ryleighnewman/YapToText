    "YapToText is built on the same foundation as InputConfig, my accessibility tool for input mapping.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بُني YapToText على الأساس نفسه لـ InputConfig، أداة إمكانية الوصول الخاصة بي لربط المدخلات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText stojí na stejných základech jako InputConfig, můj nástroj pro přístupnost a mapování vstupů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText er bygget på det samme fundament som InputConfig, mit tilgængelighedsværktøj til inputmapping."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText basiert auf derselben Grundlage wie InputConfig, meinem Bedienungshilfen-Werkzeug zur Eingabezuordnung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText se basa en la misma base que InputConfig, mi herramienta de accesibilidad para asignar entradas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText perustuu samaan pohjaan kuin InputConfig, saavutettavuustyökaluni syötteiden kartoitukseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText repose sur les mêmes fondations qu'InputConfig, mon outil d'accessibilité pour le mappage des entrées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText בנוי על אותו בסיס כמו InputConfig, כלי הנגישות שלי למיפוי קלט."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A YapToText ugyanarra az alapra épül, mint az InputConfig, a bemenet-leképezési akadálymentesítő eszközöm."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText dibangun di atas fondasi yang sama dengan InputConfig, alat aksesibilitas saya untuk pemetaan input."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText è costruito sulle stesse basi di InputConfig, il mio strumento di accessibilità per la mappatura degli input."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText は、入力のマッピングのためのアクセシビリティツール InputConfig と同じ基盤で作られています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText는 입력 매핑용 손쉬운 사용 도구인 InputConfig와 같은 기반 위에 만들어졌어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText er bygget på samme grunnlag som InputConfig, mitt tilgjengelighetsverktøy for inndatakobling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText is gebouwd op dezelfde basis als InputConfig, mijn toegankelijkheidshulpmiddel voor invoerkoppeling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText powstał na tych samych podstawach co InputConfig, moje narzędzie dostępności do mapowania wejścia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O YapToText usa a mesma base do InputConfig, minha ferramenta de acessibilidade para mapeamento de entradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText построен на той же основе, что и InputConfig, моя программа для настройки устройств ввода."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText je postavený na rovnakom základe ako InputConfig, nástroj dostupnosti na mapovanie vstupov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText bygger på samma grund som InputConfig, mitt tillgänglighetsverktyg för indatamappning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText สร้างบนรากฐานเดียวกับ InputConfig เครื่องมือการเข้าถึงสำหรับการจับคู่อินพุตของฉัน"
          }
        },
        "tr": {
          "stringUnit": {
