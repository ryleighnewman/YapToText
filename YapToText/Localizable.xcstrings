          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk %@ for å starte, trykk igjen for å stoppe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op %@ om te starten, tik opnieuw om te stoppen."
