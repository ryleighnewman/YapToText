          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na %@ pro začátek, klepněte znovu pro zastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på %@ for at starte, tryk igen for at stoppe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe %@ zum Starten, tippe erneut zum Stoppen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa %@ para empezar y vuelve a pulsar para detener."
