        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš naformátovaný text se objeví zde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din formaterede tekst lander her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein formatierter Text landet hier."
          }
        },
        "es": {
