          "stringUnit": {
            "state": "translated",
            "value": "עזרה נמצאת תמיד בתחתית הסרגל הצדדי."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A súgó mindig az oldalsáv alján található."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantuan selalu ada di bagian bawah bilah sisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aiuto si trova sempre in fondo alla barra laterale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルプは常にサイドバーの一番下にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도움말은 항상 사이드바 맨 아래에 있어요."
