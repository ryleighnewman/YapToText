          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rensningsmodellen kunde inte starta (slut på minne?)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลทำความสะอาดเริ่มทำงานไม่ได้ (หน่วยความจำไม่พอหรือไม่)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizleme modeli başlatılamadı (bellek yetersiz olabilir mi?)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель очищення не запустилася (недостатньо пам'яті?)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình làm sạch không khởi động được (có thể hết bộ nhớ?)."
          }
        },
        "zh-Hans": {
