    "Bigger models hear better; smaller ones are lighter on battery and memory.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النماذج الأكبر تسمع بشكل أفضل، والأصغر أخف على البطارية والذاكرة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Větší modely lépe slyší; menší jsou šetrnější k baterii a paměti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Større modeller hører bedre; mindre er lettere på batteri og hukommelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größere Modelle hören besser; kleinere schonen Akku und Speicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos más grandes oyen mejor; los más pequeños consumen menos batería y memoria."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suuremmat mallit kuulevat paremmin, pienemmät ovat kevyempiä akulle ja muistille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles plus grands entendent mieux ; les plus petits consomment moins de batterie et de mémoire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מודלים גדולים שומעים טוב יותר; קטנים יותר קלים על הסוללה והזיכרון."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nagyobb modellek jobban hallanak; a kisebbek kevesebb akkumulátort és memóriát használnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model yang lebih besar lebih peka; yang lebih kecil lebih ringan untuk baterai dan memori."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli più grandi sentono meglio; quelli più piccoli sono più leggeri per batteria e memoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きいモデルほど聞き取りが正確です。小さいモデルはバッテリーとメモリにやさしいです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 모델은 더 잘 듣고, 작은 모델은 배터리와 메모리를 덜 써요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Større modeller hører bedre; mindre er lettere på batteri og minne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grotere modellen horen beter; kleinere zijn zuiniger met batterij en geheugen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Większe modele lepiej słyszą; mniejsze są lżejsze dla baterii i pamięci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelos maiores ouvem melhor; os menores gastam menos bateria e memória."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большие модели лучше слышат, маленькие легче для батареи и памяти."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Väčšie modely počujú lepšie; menšie sú ľahšie na batériu a pamäť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Större modeller hör bättre; mindre är lättare på batteri och minne."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลใหญ่ฟังได้ดีกว่า โมเดลเล็กใช้แบตเตอรี่และหน่วยความจำน้อยกว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük modeller daha iyi duyar; küçük olanlar pil ve bellek açısından daha hafiftir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більші моделі краще чують; менші економніші до батареї та пам'яті."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình lớn nghe tốt hơn; mô hình nhỏ nhẹ hơn cho pin và bộ nhớ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型越大识别越准确；越小则越省电、占用的内存越少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "較大的模型聽力較好；較小的模型則較省電、也較省記憶體。"
          }
        }
      }
    },
