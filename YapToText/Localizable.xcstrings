    "Require pressing Escape twice to cancel": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب الضغط على Escape مرتين للإلغاء"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro zrušení vyžadovat dvojí stisk Esc"
          }
        },
        "da": {
