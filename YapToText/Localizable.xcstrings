          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리 모델을 시작할 수 없었어요(메모리 부족일 수 있어요)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprydningsmodellen kunne ikke starte (for lite minne?)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het opschoonmodel kon niet starten (geen geheugen meer?)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model czyszczenia nie mógł się uruchomić (brak pamięci?)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de limpeza não pôde iniciar (sem memória?)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель очистки не запустилась (возможно, не хватило памяти)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
