          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua scorciatoia personalizzata qui sotto avvia e ferma ogni dettatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のカスタムショートカットで、ディクテーションを開始・停止します。"
