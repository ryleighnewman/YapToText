          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено. Нажмите в поле, чтобы изменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené. Kliknutím na pole ho zmeníte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparat. Klicka i rutan för att ändra."
