          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางไฟล์เสียงหรือวิดีโอที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ses veya video dosyasını buraya bırakın"
          }
        },
        "uk": {
          "stringUnit": {
