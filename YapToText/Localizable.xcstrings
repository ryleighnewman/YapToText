    "The handful of things that fix almost everything.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حفنة من الأشياء التي تُصلح كل شيء تقريباً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Několik věcí, které opraví téměř vše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En håndfuld ting, der løser næsten alt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die paar Dinge, die fast alles beheben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas pocas cosas que arreglan casi todo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutama asia, joka korjaa lähes kaiken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une poignée de réglages qui résolvent presque tout."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קומץ הדברים שמתקנים כמעט הכול."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Néhány dolog, amely szinte mindent megold."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa hal yang memperbaiki hampir semuanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le poche cose che risolvono quasi tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほとんどの問題を解決する、いくつかの重要な項目です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거의 모든 문제를 해결하는 몇 가지."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De få tingene som fikser nesten alt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De handvol dingen die bijna alles oplossen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Garstka rzeczy, które naprawiają niemal wszystko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os poucos itens que resolvem quase tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несколько вещей, которые решают почти всё."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hŕstka vecí, ktoré opravia takmer všetko."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Några få saker som löser nästan allt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่กี่อย่างที่แก้ปัญหาได้เกือบทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen her şeyi düzelten birkaç şey."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кілька речей, які виправляють майже все."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vài điều đơn giản giải quyết gần như mọi vấn đề."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "几项能解决几乎所有问题的关键设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幾個幾乎能解決所有問題的關鍵重點。"
          }
        }
      }
    },
    "The icon stays monochrome in every state and adapts to the menu bar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الأيقونة أحادية اللون في كل حالة وتتكيف مع شريط القوائم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikona zůstává v každém stavu jednobarevná a přizpůsobuje se liště menu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikonet forbliver monokromt i alle tilstande og tilpasser sig menulinjen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Symbol bleibt in jedem Zustand einfarbig und passt sich der Menüleiste an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El icono se mantiene monocromático en todos los estados y se adapta a la barra de menús."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvake pysyy yksivärisenä kaikissa tiloissa ja mukautuu valikkopalkkiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'icône reste monochrome dans chaque état et s'adapte à la barre des menus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסמל נשאר מונוכרומטי בכל מצב ומתאים את עצמו לשורת התפריטים."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ikon minden állapotban egyszínű marad, és igazodik a menüsávhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikon tetap monokrom di setiap keadaan dan menyesuaikan dengan bilah menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'icona resta monocromatica in ogni stato e si adatta alla barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンはどの状態でもモノクロのままで、メニューバーに合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘은 모든 상태에서 단색을 유지하고 메뉴 막대에 맞춰져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikonet forblir enfarget i alle tilstander og tilpasser seg menylinjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het pictogram blijft in elke status monochroom en past zich aan de menubalk aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikona pozostaje jednokolorowa w każdym stanie i dostosowuje się do paska menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone fica monocromático em todos os estados e se adapta à barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок остаётся монохромным в любом состоянии и подстраивается под строку меню."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikona zostáva v každom stave jednofarebná a prispôsobuje sa paneli ponuky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikonen förblir enfärgad i varje tillstånd och anpassar sig till menyraden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไอคอนจะเป็นขาวดำในทุกสถานะและปรับตามแถบเมนู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simge her durumda tek renk kalır ve menü çubuğuna uyum sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Піктограма в усіх станах лишається монохромною і пристосовується до рядка меню."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biểu tượng giữ một màu ở mọi trạng thái và thích ứng với thanh menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图标在所有状态下都保持单色，并会适应菜单栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示在每種狀態下都保持單色，並會配合選單列調整。"
          }
        }
      }
    },
    "The icon tints with the dictation state: red while recording, green on insert.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتلون الأيقونة بحسب حالة الإملاء: أحمر أثناء التسجيل، وأخضر عند الإدراج."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikona se barví podle stavu diktování: červeně při nahrávání, zeleně při vložení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikonet får farve efter diktertilstanden: rødt under optagelse, grønt ved indsættelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Symbol färbt sich je nach Diktatstatus: rot während der Aufnahme, grün beim Einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El icono cambia de color según el estado del dictado: rojo al grabar, verde al insertar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvake värjäytyy sanelun tilan mukaan: punainen nauhoituksen aikana, vihreä lisäyksessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'icône prend la couleur de l'état de la dictée : rouge pendant l'enregistrement, vert à l'insertion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסמל מתכלל לפי מצב ההכתבה: אדום בזמן הקלטה, ירוק בהכנסה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ikon a diktálás állapotát tükrözi: pirosan felvétel közben, zölden beszúrásnál."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikon berubah warna sesuai status dikte: merah saat merekam, hijau saat disisipkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'icona cambia colore secondo lo stato della dettatura: rosso durante la registrazione, verde all'inserimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンはディクテーションの状態に合わせて色づきます。録音中は赤、挿入時は緑です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘은 받아쓰기 상태에 따라 색이 입혀져요. 녹음 중에는 빨간색, 삽입되면 초록색이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikonet farges etter dikteringstilstanden: rødt under opptak, grønt ved innsetting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het pictogram kleurt mee met de dicteerstatus: rood tijdens opnemen, groen bij invoegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikona zmienia kolor zależnie od stanu dyktowania: czerwony podczas nagrywania, zielony przy wstawianiu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone muda de cor conforme o estado do ditado: vermelho ao gravar, verde ao inserir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок окрашивается по состоянию диктовки: красный во время записи, зелёный при вставке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikona sa zafarbí podľa stavu diktovania: červená pri nahrávaní, zelená pri vložení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikonen färgas efter diktertillståndet: röd under inspelning, grön vid infogning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไอคอนจะเปลี่ยนสีตามสถานะการพิมพ์ด้วยเสียง สีแดงขณะบันทึก สีเขียวเมื่อแทรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simge, dikte durumuna göre renk alır: kayıt sırasında kırmızı, eklenirken yeşil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Піктограма змінює колір залежно від стану диктовки: червоний під час запису, зелений під час вставлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biểu tượng đổi màu theo trạng thái đọc chính tả: đỏ khi ghi, xanh lá khi chèn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图标会随听写状态着色：录音时为红色，插入时为绿色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示會依聽寫狀態變色：錄音時為紅色，插入時為綠色。"
          }
        }
      }
    },
    "The live bars use this color.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم الأشرطة الحية هذا اللون."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Živé sloupce používají tuto barvu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydbjælkerne i live bruger denne farve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Balken verwenden diese Farbe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las barras en vivo usan este color."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaaliaikaiset palkit käyttävät tätä väriä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les barres en direct utilisent cette couleur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפסים החיים משתמשים בצבע הזה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az élő sávok ezt a színt használják."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batang langsung memakai warna ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le barre dal vivo usano questo colore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブのバーにはこの色を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 막대는 이 색을 사용해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søylene i live bruker denne fargen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De live balken gebruiken deze kleur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słupki na żywo używają tego koloru."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As barras ao vivo usam esta cor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Живые полоски используют этот цвет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Živé stĺpce používajú túto farbu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Livestaplarna använder den här färgen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบสดจะใช้สีนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı çubuklar bu rengi kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Живі смужки використовують цей колір."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thanh trực tiếp dùng màu này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时条形使用此颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時音量條會使用此顏色。"
          }
        }
      }
    },
    "The live bars use your accent color. Pick any color to override it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم الأشرطة الحية لون التمييز لديك. اختر أي لون لتجاوزه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Živé sloupce používají vaši barvu zvýraznění. Vyberte libovolnou barvu, která ji přepíše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydbjælkerne i live bruger din accentfarve. Vælg en vilkårlig farve for at overskrive den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Balken verwenden deine Akzentfarbe. Wähle eine beliebige Farbe, um sie zu überschreiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las barras en vivo usan tu color de acento. Elige cualquier color para cambiarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaaliaikaiset palkit käyttävät korostusväriäsi. Valitse mikä tahansa väri ohittaaksesi sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les barres en direct utilisent votre couleur d'accent. Choisissez une couleur pour la remplacer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפסים החיים משתמשים בצבע ההדגשה שלך. בחר כל צבע כדי לעקוף אותו."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az élő sávok a kiemelőszínedet használják. Bármely színt választhatsz felülírásnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batang langsung memakai warna aksen Anda. Pilih warna apa pun untuk menggantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le barre dal vivo usano il tuo colore di accento. Scegli un colore qualsiasi per sostituirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブのバーはアクセント色を使います。任意の色を選んで上書きできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 막대는 강조 색을 사용해요. 다른 색을 골라 덮어쓸 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søylene i live bruker aksentfargen din. Velg en hvilken som helst farge for å overstyre den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De live balken gebruiken je accentkleur. Kies een kleur om die te overschrijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słupki na żywo używają koloru akcentu. Wybierz dowolny kolor, aby to nadpisać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As barras ao vivo usam a sua cor de destaque. Escolha qualquer cor para substituí-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Живые полоски используют ваш цвет акцента. Выберите любой цвет, чтобы его переопределить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Živé stĺpce používajú vašu farbu zvýraznenia. Vyberte ľubovoľnú farbu, aby ju prepísala."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Livestaplarna använder din accentfärg. Välj valfri färg för att åsidosätta den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบสดใช้สีเน้นของคุณ เลือกสีใดก็ได้เพื่อแทนที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı çubuklar vurgu renginizi kullanır. Geçersiz kılmak için herhangi bir renk seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Живі смужки використовують ваш акцентний колір. Виберіть будь-який колір, щоб замінити його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thanh trực tiếp dùng màu nhấn của bạn. Chọn màu bất kỳ để ghi đè."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时条形使用你的强调色。选择任意颜色即可覆盖它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時音量條會使用你的強調色。選擇任一顏色即可覆寫。"
          }
        }
      }
    },
