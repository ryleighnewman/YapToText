    "Drag this card anywhere and it opens there next time. It closes on its own.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب هذه البطاقة إلى أي مكان وستُفتح هناك في المرة القادمة. تُغلق تلقائياً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetáhněte tuto kartu kamkoli a příště se otevře tam. Zavře se sama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk dette kort hvor som helst hen, og det åbner der næste gang. Det lukker af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe diese Karte irgendwohin, dann öffnet sie sich beim nächsten Mal dort. Sie schließt sich von selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra esta tarjeta a cualquier lugar y se abrirá allí la próxima vez. Se cierra sola."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä tämä kortti mihin tahansa, ja se avautuu siihen seuraavalla kerralla. Se sulkeutuu itsestään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser cette carte où vous voulez, elle s'ouvrira là la prochaine fois. Elle se ferme d'elle-même."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרור את הכרטיס לכל מקום והוא ייפתח שם בפעם הבאה. הוא נסגר מעצמו."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd a kártyát bárhová, és legközelebb ott nyílik meg. Magától záródik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret kartu ini ke mana saja dan akan terbuka di sana lain kali. Menutup sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina questa scheda ovunque e la prossima volta si aprirà lì. Si chiude da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカードはどこへでもドラッグでき、次回もそこに開きます。自動的に閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 카드를 어디로든 끌어다 놓으면 다음에 그 자리에서 열려요. 저절로 닫혀요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra dette kortet hvor som helst, så åpnes det der neste gang. Det lukkes av seg selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep deze kaart waar je wilt en hij opent daar de volgende keer. Hij sluit vanzelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij tę kartę w dowolne miejsce, a następnym razem otworzy się tam. Zamyka się sama."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste este cartão para qualquer lugar e ele abrirá ali da próxima vez. Ele fecha sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите эту карточку куда угодно, и в следующий раз она откроется там. Закрывается сама."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Presuňte túto kartu kamkoľvek a nabudúce sa otvorí tam. Zatvorí sa sama."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra kortet vart du vill så öppnas det där nästa gång. Det stängs av sig självt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากการ์ดนี้ไปที่ใดก็ได้ ครั้งหน้าจะเปิดที่นั่น และจะปิดเองโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kartı istediğiniz yere sürükleyin, bir sonraki açılışta orada açılır. Kendiliğinden kapanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть цю картку будь-куди, і наступного разу вона відкриється там. Закривається сама."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo thẻ này đến đâu cũng được và lần sau nó mở ở đó. Nó tự đóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此卡片拖到任意位置，下次它就会在那里打开。它会自动关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此卡片拖曳到任何位置，下次就會在該處開啟。它會自動關閉。"
          }
        }
      }
    },
    "Drag to reorder - substitutions run top to bottom": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لإعادة الترتيب، وتُطبَّق الاستبدالات من الأعلى إلى الأسفل"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetažením změníte pořadí, náhrady se provádějí shora dolů"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk for at sortere - erstatninger køres oppefra og ned"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Sortieren ziehen, Ersetzungen laufen von oben nach unten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar: las sustituciones se aplican de arriba abajo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä järjestääksesi uudelleen. Korvaukset suoritetaan ylhäältä alas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez pour réordonner : les substitutions s'appliquent de haut en bas"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרור כדי לסדר מחדש - ההחלפות פועלות מלמעלה למטה"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd az átrendezéshez, a cserék felülről lefelé futnak"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk mengurutkan ulang, penggantian dijalankan dari atas ke bawah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare: le sostituzioni vengono applicate dall'alto verso il basso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替え。置き換えは上から順に適用されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끌어서 순서 변경. 대체는 위에서 아래로 적용돼요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å endre rekkefølge - erstatninger kjøres fra topp til bunn"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om te herordenen - vervangingen worden van boven naar beneden toegepast"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby zmienić kolejność; zamiany działają od góry do dołu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar; as substituições são aplicadas de cima para baixo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы изменить порядок. Замены выполняются сверху вниз"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Presunutím zmeníte poradie, náhrady sa uplatňujú zhora nadol"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att ordna om - ersättningar körs uppifrån och ned"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากเพื่อเรียงลำดับ การแทนที่ทำงานจากบนลงล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıralamak için sürükleyin - değiştirmeler yukarıdan aşağıya uygulanır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть, щоб змінити порядок: заміни виконуються згори донизу"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo để sắp xếp lại, các thay thế được áp dụng từ trên xuống dưới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动可重新排序，替换规则从上到下依次执行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳可重新排序，取代規則會由上到下依序執行"
          }
        }
      }
    },
    "Drop an audio or video file here": {
      "localizations": {
        "ar": {
          "stringUnit": {
