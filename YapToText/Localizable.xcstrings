    "A clean signal. The occasional word may slip in a noisy moment, but accuracy will be strong.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشارة نظيفة. قد تفوت كلمة عرضية في لحظة صاخبة، لكن الدقة ستكون قوية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čistý signál. Občas může v hlučném okamžiku proklouznout slovo, ale přesnost bude silná."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et rent signal. Et enkelt ord kan glide igennem i et støjende øjeblik, men præcisionen bliver høj."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sauberes Signal. Gelegentlich rutscht in einem lauten Moment ein Wort durch, aber die Genauigkeit bleibt hoch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una señal limpia. Alguna palabra puede perderse en un momento ruidoso, pero la precisión será buena."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhdas signaali. Joskus sana voi jäädä kuulematta meluisalla hetkellä, mutta tarkkuus on vahva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un signal propre. Un mot peut parfois passer dans un moment bruyant, mais la précision restera élevée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אות נקי. לעיתים מילה עלולה לחמוק ברגע רועש, אבל הדיוק יהיה חזק."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiszta jel. Zajos pillanatban előfordulhat, hogy egy-egy szó kimarad, de a pontosság erős marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinyal bersih. Sesekali kata bisa terlewat saat ada kebisingan, tetapi akurasinya akan kuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un segnale pulito. In un momento rumoroso può capitare qualche parola persa, ma la precisione sarà buona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリーンな信号です。騒がしい瞬間に単語が抜けることがあるかもしれませんが、精度は高いです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨끗한 신호예요. 시끄러운 순간에는 가끔 단어가 빠질 수 있지만 정확도는 높아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et rent signal. Et og annet ord kan glippe i et støyende øyeblikk, men nøyaktigheten blir god."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een schoon signaal. Af en toe kan een woord in een lawaaierig moment wegvallen, maar de nauwkeurigheid blijft sterk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czysty sygnał. Od czasu do czasu jakieś słowo może umknąć w głośnym momencie, ale dokładność będzie wysoka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um sinal limpo. Ocasionalmente uma palavra pode escapar em um momento barulhento, mas a precisão será boa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чистый сигнал. Иногда в шумный момент может выпасть слово, но точность будет высокой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čistý signál. Občas môže v hlučnom momente uniknúť slovo, ale presnosť bude silná."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ren signal. Enstaka ord kan försvinna i ett bullrigt ögonblick, men träffsäkerheten blir stark."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัญญาณสะอาด บางครั้งอาจมีคำหลุดในช่วงที่มีเสียงรบกวน แต่ความแม่นยำจะดีมาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temiz bir sinyal. Gürültülü anlarda ara sıra bir kelime kaçabilir, ama doğruluk güçlü olacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чистий сигнал. Інколи в шумний момент може випасти слово, але точність буде високою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tín hiệu sạch. Thỉnh thoảng có từ có thể lọt qua lúc ồn, nhưng độ chính xác vẫn cao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信号干净。在嘈杂的时刻偶尔可能会漏掉个别字词，但整体准确率依然很高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊號乾淨。在嘈雜的時刻偶爾可能漏掉一個字，但準確度會很高。"
          }
        }
      }
    },
