        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não entendi. Nada foi transcrito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не расслышал. Ничего не расшифровано."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezachytil som to. Nič sa neprepísalo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det uppfattades inte. Inget transkriberades."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟังไม่ทัน ไม่มีข้อความถูกถอดเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlaşılmadı. Hiçbir şey yazıya dökülmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося розпізнати. Нічого не транскрибовано."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không nghe rõ. Chưa phiên âm nội dung nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有听清。未转写任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有聽清楚，未轉錄任何內容。"
          }
        }
      }
    },
    "Digits spoken one at a time, such as a verification code, go in as bare digits": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأرقام المنطوقة واحداً تلو الآخر، مثل رمز التحقق، تُدرج كأرقام مجردة"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Číslice vyslovené postupně, například ověřovací kód, se vloží jako samotné číslice"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifre sagt ét ad gangen, f.eks. en bekræftelseskode, indsættes som rene cifre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einzeln gesprochene Ziffern, etwa ein Bestätigungscode, werden als reine Ziffern eingefügt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dígitos dichos uno a uno, como un código de verificación, se insertan como dígitos sueltos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksittäin lausutut numerot, kuten vahvistuskoodi, lisätään pelkkinä numeroina"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chiffres dictés un par un, comme un code de vérification, sont insérés tels quels"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספרות שנאמרות אחת אחת, כמו קוד אימות, מוכנסות כספרות בלבד"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyenként kimondott számjegyek, például ellenőrző kód, csupasz számjegyekként kerülnek be"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angka yang diucapkan satu per satu, seperti kode verifikasi, dimasukkan sebagai angka saja"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cifre pronunciate una alla volta, come un codice di verifica, vengono inserite come semplici cifre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証コードのように一桁ずつ話した数字は、そのまま数字として入力されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 코드처럼 한 자리씩 말한 숫자는 숫자만 그대로 입력돼요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sifre som sies ett om gangen, for eksempel en bekreftelseskode, settes inn som rene sifre"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cijfers die één voor één worden uitgesproken, zoals een verificatiecode, worden als losse cijfers ingevoegd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyfry wypowiadane pojedynczo, na przykład kod weryfikacyjny, wchodzą jako same cyfry"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dígitos ditados um de cada vez, como um código de verificação, entram como apenas números"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цифры, произнесённые по одной, например код подтверждения, вставляются как обычные цифры"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Číslice vyslovené jedna po druhej, napríklad overovací kód, sa vložia ako holé číslice"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Siffror som säg en i taget, till exempel en verifieringskod, skrivs in som rena siffror"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลขที่พูดทีละตัว เช่น รหัสยืนยัน จะถูกแทรกเป็นตัวเลขล้วน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulama kodu gibi tek tek söylenen rakamlar, çıplak rakam olarak eklenir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цифри, продиктовані по одній, як-от код підтвердження, вставляються як чисті цифри"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các chữ số được nói từng số một, như mã xác minh, sẽ được chèn dưới dạng chữ số thuần"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐个说出的数字（例如验证码）会以纯数字形式输入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐一口述的數字（例如驗證碼）會以純數字輸入"
          }
        }
      }
    },
