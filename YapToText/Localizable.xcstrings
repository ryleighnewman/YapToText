          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Також зіставлено 1 схоже слово з «%@»"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cũng đã ánh xạ 1 từ phát âm giống sang “%@”"
          }
        },
        "zh-Hans": {
