    "Types the text into whatever field your cursor is in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتب النص في الحقل الذي يوجد فيه المؤشر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
