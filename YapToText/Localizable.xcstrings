    "Clean Up output that leaves off the end of a dictation is replaced by the full transcript, for increased precision on long passages": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستبدل ناتج تنظيف الذي يحذف نهاية الإملاء بالنص الكامل، لدقة أعلى في المقاطع الطويلة"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výstup režimu Vyčistit, který vynechá konec diktátu, je nahrazen úplným přepisem pro vyšší přesnost u dlouhých pasáží"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Output fra Ryd op, der udelader slutningen af en diktering, erstattes af den fulde transskription for større præcision i lange passager"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ausgabe von Bereinigen, die das Ende eines Diktats weglässt, wird durch das vollständige Transkript ersetzt, für höhere Genauigkeit bei langen Passagen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida de Limpiar que omite el final de un dictado se sustituye por la transcripción completa, para mayor precisión en pasajes largos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siisti-tuloste, josta puuttuu sanelun loppu, korvataan täydellä litteroinnilla, mikä lisää tarkkuutta pitkissä kohdissa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sortie de Nettoyer qui omet la fin d'une dictée est remplacée par la transcription complète, pour une précision accrue sur les longs passages"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פלט של נקה שמשמיט את סוף ההכתבה מוחלף בתמלול המלא, לדיוק מוגבר בקטעים ארוכים"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktálás végét elhagyó Tisztítás kimenetet a teljes átirat váltja fel, a hosszú szakaszok nagyobb pontossága érdekében"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluaran Bersihkan yang menghilangkan bagian akhir dikte diganti dengan transkrip lengkap, untuk presisi lebih tinggi pada bagian yang panjang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'output di Pulizia che tralascia la fine di una dettatura viene sostituito dalla trascrizione completa, per una maggiore precisione nei passaggi lunghi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口述の末尾が抜けたクリーンアップの出力は完全な文字起こしに置き換えられ、長い文章の精度が上がります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기의 끝부분을 빠뜨린 정리 출력은 전체 전사로 대체되어 긴 구절의 정밀도가 높아집니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utdata fra Rydd opp som utelater slutten av en diktering, erstattes av hele transkripsjonen, for økt presisjon i lange passasjer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitvoer van Opschonen die het einde van een dictaat weglaat, wordt vervangen door de volledige transcriptie, voor meer precisie bij lange passages"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik trybu Czyść, który pomija koniec dyktowania, jest zastępowany pełną transkrypcją, co zwiększa precyzję w długich fragmentach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A saída de Limpeza que deixa de fora o final de um ditado é substituída pela transcrição completa, para maior precisão em trechos longos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат Очистка, в котором пропущен конец диктовки, заменяется полной расшифровкой для большей точности на длинных отрывках"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Výstup režimu Upraviť, ktorý vynechá koniec diktátu, je nahradený úplným prepisom pre vyššiu presnosť v dlhých pasážach"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utdata från Rensa som utelämnar slutet av en diktering ersätts av hela transkriptionen, för ökad precision i långa avsnitt"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผลลัพธ์ของ ทำความสะอาด ที่ตัดส่วนท้ายของการบอกเล่าออกจะถูกแทนที่ด้วยการถอดความฉบับเต็ม เพื่อความแม่นยำที่สูงขึ้นในข้อความยาว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir diktenin sonunu atlayan Temizle çıktısı, uzun pasajlarda daha yüksek hassasiyet için tam dökümle değiştirilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат Очистити, у якому пропущено кінець диктування, замінюється повною розшифровкою для більшої точності на довгих уривках"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả Làm sạch bỏ sót phần cuối của bài đọc sẽ được thay bằng bản chép đầy đủ, để tăng độ chính xác cho các đoạn dài"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "漏掉听写结尾的清理输出会被完整转写替换,以提高长段落的精确度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "漏掉聽寫結尾的清理輸出會被完整轉錄取代,以提高長段落的精確度"
          }
        }
      }
    },
