            "state": "translated",
            "value": "Tape le texte dans le champ où se trouve votre curseur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקליד את הטקסט בכל שדה שבו נמצא הסמן שלך."
          }
        },
        "hu": {
          "stringUnit": {
