          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelos que seguem a tomada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модели, которые переключаются вместе с питанием."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Modely, ktoré sledujú napájanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modeller som följer kontakten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลที่ทำตามการเสียบปลั๊ก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fişi takılıyken kullanılan modeller."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Моделі, що залежать від живлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình theo nguồn điện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据电源切换的模型。"
          }
        },
        "zh-Hant": {
