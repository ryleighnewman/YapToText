          }
        }
      }
    },
    "Cancel a dictation and it is still transcribed and saved here, marked as canceled, so a stray Escape cannot lose what you said. It is never inserted anywhere.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إلغاء إملاء، يبقى منسوخاً ومحفوظاً هنا ومُعلَّماً بأنه ملغى، حتى لا يُفقد ما قلته بسبب ضغطة Escape عرضية. ولا يُدرج في أي مكان أبداً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušený diktát se přesto přepíše a uloží sem, označený jako zrušený, aby náhodný Esc nemohl ztratit to, co jste řekli. Nikam se nevkládá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullerer du en diktering, bliver den stadig transskriberet og gemt her, markeret som annulleret, så et forkert Escape ikke kan miste det, du sagde. Den indsættes aldrig nogen steder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bricht man ein Diktat ab, wird es trotzdem transkribiert und hier gespeichert, als abgebrochen markiert, damit ein versehentliches Escape nicht verliert, was du gesagt hast. Es wird nie irgendwo eingefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dictado cancelado se sigue transcribiendo y se guarda aquí, marcado como cancelado, para que una pulsación accidental de Escape no pierda lo que dijiste. Nunca se inserta en ningún lugar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Peruutettu sanelu litteroidaan silti ja tallennetaan tänne merkittynä peruutetuksi, joten vahingossa painettu Escape ei hukkaa sanomaasi. Sitä ei lisätä koskaan mihinkään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dictée annulée est tout de même transcrite et enregistrée ici, marquée comme annulée, pour qu'un Escape malencontreux ne fasse pas perdre ce que vous avez dit. Elle n'est jamais insérée nulle part."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכתבה שבוטלה עדיין מתומללת ונשמרת כאן, מסומנת כמבוטלת, כך שלחיצת Escape בטעות לא תאבד את מה שאמרת. היא לעולם לא מוכנסת לשום מקום."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha megszakítasz egy diktálást, az itt is átíródik és mentésre kerül, megszakítottként jelölve, így egy véletlen Escape nem veszítheti el, amit mondtál. Soha nem szúródik be sehova."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte yang dibatalkan tetap ditranskripsi dan disimpan di sini, ditandai sebagai dibatalkan, sehingga Escape yang tidak sengaja tidak menghilangkan apa yang Anda ucapkan. Tidak pernah disisipkan di mana pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche una dettatura annullata viene comunque trascritta e salvata qui, contrassegnata come annullata, così un Esc involontario non fa perdere ciò che hai detto. Non viene mai inserita da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディクテーションをキャンセルしても、書き起こされてここに保存されます。キャンセルとしてマークされ、誤って Escape を押しても、話した内容が失われることはありません。どこにも挿入されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기를 취소해도 여기에 전사되어 취소됨으로 표시되어 저장돼요. 실수로 Escape를 눌러도 말한 내용을 잃지 않아요. 어디에도 삽입되지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbryt en diktering, så blir den likevel transkribert og lagret her, merket som avbrutt, så et uforsiktig Escape ikke kan miste det du sa. Den settes aldri inn noe sted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuleer een dictee en het wordt nog steeds getranscribeerd en hier opgeslagen, gemarkeerd als geannuleerd, zodat een per ongeluk ingedrukte Escape niet kwijtraakt wat je zei. Het wordt nooit ergens ingevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulowane dyktowanie nadal jest przetranskrybowane i zapisane tutaj, oznaczone jako anulowane, więc przypadkowe Escape nie zgubi tego, co powiedziano. Nigdy nie jest nigdzie wstawiane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancele um ditado e ele ainda é transcrito e salvo aqui, marcado como cancelado, para que um Esc acidental não perca o que você disse. Nunca é inserido em lugar nenhum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменённая диктовка всё равно расшифровывается и сохраняется здесь с пометкой «отменено», чтобы случайный Escape не стёр сказанное. Она никогда никуда не вставляется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušený diktát sa stále prepíše a uloží sem, označený ako zrušený, takže omylom stlačený Escape nemôže stratiť to, čo ste povedali. Nikdy sa nevkladá nikam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbryt en diktering så transkriberas den ändå och sparas här, markerad som avbruten, så att ett oavsiktligt Escape inte kan förlora det du sa. Den infogas aldrig någonstans."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การพิมพ์ด้วยเสียงที่ยกเลิกยังคงถูกถอดเสียงและบันทึกไว้ที่นี่ โดยทำเครื่องหมายว่ายกเลิกแล้ว เพื่อไม่ให้การกด Escape โดยไม่ตั้งใจทำให้คำที่คุณพูดหายไป จะไม่ถูกแทรกที่ใดเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir dikteyi iptal ederseniz yine de yazıya dökülür ve burada iptal edildi olarak kaydedilir; yanlışlıkla basılan Escape söylediklerinizi kaybettiremez. Hiçbir yere asla eklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасована диктовка все одно транскрибується і зберігається тут, позначена як скасована, щоб випадковий Escape не міг втратити сказане. Вона ніколи нікуди не вставляється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy một lần đọc chính tả vẫn được phiên âm và lưu ở đây, được đánh dấu là đã hủy, để một lần Escape nhầm không làm mất những gì bạn đã nói. Nội dung không bao giờ được chèn vào đâu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消听写后，内容仍会被转写并保存在此处，并标记为已取消，因此一次误按 Escape 不会丢失你说过的话。它绝不会插入到任何地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使取消聽寫，內容仍會被轉錄並保存在此處，並標記為已取消，因此誤按的 Esc 不會遺失你說過的內容。它永遠不會被插入到任何地方。"
          }
        }
      }
    },
    "Cancel and discard": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
