            "state": "translated",
            "value": "Busca en la barra lateral para ir a cualquier ajuste en segundos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hae sivupalkista ja siirry mihin tahansa asetukseen sekunneissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez dans la barre latérale pour accéder à n'importe quel réglage en quelques secondes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חפש בסרגל הצדדי כדי לקפוץ לכל הגדרה תוך שניות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Keress az oldalsávon, és másodpercek alatt ugorhatsz bármely beállításhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari di bilah sisi untuk langsung ke pengaturan mana pun dalam hitungan detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca nella barra laterale per andare a qualsiasi impostazione in pochi secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーを検索すると、どの設定にも数秒で移動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바에서 검색하면 어떤 설정이든 몇 초 만에 찾을 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søk i sidemenyen for å hoppe til en hvilken som helst innstilling på få sekunder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doorzoek de zijbalk om in een paar seconden naar elke instelling te springen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeszukaj pasek boczny, aby w kilka sekund przejść do dowolnego ustawienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquise na barra lateral para ir a qualquer ajuste em segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищите в боковой панели, чтобы за секунды перейти к любой настройке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hľadajte na bočnom paneli a za pár sekúnd sa dostanete k ľubovoľnému nastaveniu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sök i sidofältet för att hoppa till valfri inställning på några sekunder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาในแถบข้างเพื่อไปยังการตั้งค่าใดก็ได้ในไม่กี่วินาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenar çubuğunda arama yaparak herhangi bir ayara saniyeler içinde gidin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шукайте в бічній панелі, щоб за секунди перейти до будь-якого налаштування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm trên thanh bên để đến bất kỳ cài đặt nào trong vài giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索侧边栏，几秒内即可跳转到任意设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
