    "Dictation needs no network. Nothing is uploaded, and there are no servers to trust.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتاج الإملاء إلى شبكة. لا يُرفع شيء، ولا توجد خوادم تحتاج إلى الثقة بها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktování nepotřebuje síť. Nic se nenahrává a není třeba důvěřovat žádným serverům."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering kræver ikke netværk. Intet uploades, og der er ingen servere, du skal stole på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren braucht kein Netzwerk. Es wird nichts hochgeladen, und es gibt keine Server, denen man vertrauen müsste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado no necesita red. Nada se sube y no hay servidores en los que confiar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanelu ei tarvitse verkkoa. Mitään ei ladata ylös, eikä palvelimiin tarvitse luottaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée n'a pas besoin de réseau. Rien n'est envoyé, et il n'y a aucun serveur à qui faire confiance."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכתבה לא צריכה רשת. שום דבר לא עולה לשרת, ואין שרתים שצריך לסמוך עליהם."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktáláshoz nincs szükség hálózatra. Semmi sem töltődik fel, és nincsenek megbízandó szerverek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte tidak memerlukan jaringan. Tidak ada yang diunggah, dan tidak ada server yang perlu dipercaya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura non richiede rete. Nulla viene caricato e non ci sono server di cui fidarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディクテーションにネットワークは不要です。何もアップロードされず、信頼すべきサーバーもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기에는 네트워크가 필요 없어요. 업로드되는 것이 없고, 믿어야 할 서버도 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering trenger ikke nettverk. Ingenting lastes opp, og det finnes ingen servere å stole på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicteren heeft geen netwerk nodig. Er wordt niets geüpload en er zijn geen servers om te vertrouwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie nie wymaga sieci. Nic nie jest wysyłane i nie ma serwerów, którym trzeba ufać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado não precisa de rede. Nada é enviado, e não há servidores em que confiar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовке не нужна сеть. Ничего не загружается, и нет серверов, которым нужно доверять."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktovanie nepotrebuje sieť. Nič sa nenahráva a nie sú tu žiadne servery, ktorým by ste museli dôverovať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering kräver inget nätverk. Inget laddas upp, och det finns inga servrar att lita på."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การพิมพ์ด้วยเสียงไม่ต้องใช้เครือข่าย ไม่มีการอัปโหลดอะไร และไม่มีเซิร์ฟเวอร์ที่ต้องไว้ใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte ağ gerektirmez. Hiçbir şey yüklenmez ve güvenilmesi gereken sunucu yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовка не потребує мережі. Нічого не завантажується, і немає серверів, яким треба довіряти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc chính tả không cần mạng. Không tải gì lên, và không có máy chủ nào phải tin cậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听写不需要网络。不会上传任何内容，也无需信任任何服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽寫不需要網路。不會上傳任何內容，也不需要信任任何伺服器。"
          }
        }
      }
    },
