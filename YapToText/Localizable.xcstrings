        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilat, automaattitila ja AI-siistintä toimivat jokaisen litteroinnin jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
