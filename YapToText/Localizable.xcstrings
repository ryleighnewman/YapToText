    "Dictation ran for %lld minutes and was stopped automatically": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمر الإملاء %lld دقيقة وتوقف تلقائياً"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktování běželo %lld minut a bylo automaticky zastaveno"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering kørte i %lld minutter og blev stoppet automatisk"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Diktat lief %lld Minuten und wurde automatisch beendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado duró %lld minutos y se detuvo automáticamente"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanelu kesti %lld minuuttia ja pysäytettiin automaattisesti"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée a duré %lld minutes et a été arrêtée automatiquement"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההכתבה רצה %lld דקות ונעצרה אוטומטית"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktálás %lld percig futott, és automatikusan leállt"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte berjalan selama %lld menit dan dihentikan otomatis"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura è durata %lld minuti ed è stata interrotta automaticamente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディクテーションが %lld 分続いたため、自動で停止しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기가 %lld분 동안 진행되어 자동으로 중지됐어요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteringen kjørte i %lld minutter og ble stoppet automatisk"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicteren liep %lld minuten en is automatisch gestopt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie trwało %lld minut i zostało automatycznie zatrzymane"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado rodou por %lld minutos e foi interrompido automaticamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовка шла %lld мин и была остановлена автоматически"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktovanie bežalo %lld minút a bolo automaticky zastavené"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering pågick i %lld minuter och stoppades automatiskt"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การพิมพ์ด้วยเสียงทำงานมา %lld นาทีและหยุดอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte %lld dakika sürdü ve otomatik olarak durduruldu"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовка тривала %lld хв і була зупинена автоматично"
          }
        },
        "vi": {
          "stringUnit": {
