    "No AI modes are engaged. Turn one on in Modes to use this.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد أوضاع ذكاء اصطناعي مفعّلة. فعّل واحداً من الأوضاع لاستخدام هذا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné režimy AI nejsou aktivní. Zapněte jeden v Režimech, abyste to mohli použít."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen AI-tilstande er aktive. Slå en til under Tilstande for at bruge dette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine KI-Modi sind aktiv. Schalte einen unter Modi ein, um dies zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún modo de IA está activo. Activa uno en Modos para usar esto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhtään AI-tilaa ei ole käytössä. Kytke yksi päälle Tilat-kohdassa, jotta voit käyttää tätä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun mode IA n'est activé. Activez-en un dans Modes pour l'utiliser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מצבי AI פעילים. הפעל אחד במצבים כדי להשתמש בזה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen AI mód sincs bekapcsolva. A használathoz kapcsolj be egyet a Módok részben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada mode AI yang aktif. Aktifkan salah satu di Mode untuk memakai ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna modalità IA è attiva. Attivane una in Modalità per usarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な AI モードはありません。使うにはモードでいずれかをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중인 AI 모드가 없어요. 이것을 쓰려면 모드에서 하나를 켜세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen KI-moduser er aktive. Slå på en under Moduser for å bruke dette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen AI-modi actief. Schakel er een in via Modi om dit te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden tryb AI nie jest aktywny. Włącz go w Trybach, aby z tego korzystać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum modo de IA está ativo. Ative um em Modos para usar isto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режимы с ИИ не активны. Включите один в разделе «Режимы», чтобы использовать это."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadny režim AI nie je zapnutý. Zapnite jeden v Režimoch, aby ste to mohli používať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga AI-lägen är aktiva. Slå på ett under Lägen för att använda det här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีโหมด AI ที่ใช้งานอยู่ เปิดโหมดหนึ่งในหน้าโหมดเพื่อใช้งาน"
          }
        },
        "tr": {
