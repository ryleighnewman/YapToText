    "You've changed “%@” to “%@” more than once. Add it and YapToText will spell it that way automatically - and listen for it, so it's heard right in the first place.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد غيّرت “%@” إلى “%@” أكثر من مرة. أضفه وسيكتبه YapToText بهذه الصيغة تلقائياً، ويستمع إليه كي يُسمع بشكل صحيح من البداية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Několikrát jste změnili „%@“ na „%@“. Přidejte to a YapToText to bude automaticky psát tímto způsobem a také to bude poslouchat, takže se to správně rozpozná už od začátku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ændret “%@” til “%@” mere end én gang. Tilføj det, så skriver YapToText det automatisk sådan og lytter efter det, så det høres rigtigt fra start."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast „%@“ mehrmals in „%@“ geändert. Füge es hinzu, dann schreibt YapToText es automatisch so und achtet darauf, damit es von Anfang an richtig verstanden wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has cambiado “%@” por “%@” más de una vez. Añádelo y YapToText lo escribirá así automáticamente, y lo reconocerá para escucharlo bien desde el principio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet muuttanut kohteen ”%@” kohteeksi ”%@” useammin kuin kerran. Lisää se, niin YapToText kirjoittaa sen automaattisesti näin ja kuuntelee sitä, jotta se kuullaan oikein alun perin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez changé “%@” en “%@” plus d'une fois. Ajoutez-le et YapToText l'écrira automatiquement ainsi, et l'entendra correctement dès le départ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינית את “%@” ל-“%@” יותר מפעם אחת. הוסף אותו ו-YapToText יכתוב אותו כך אוטומטית, וגם יאזין לו, כך שיישמע נכון מלכתחילה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Többször is átírtad a(z) „%@” szót „%@” alakra. Add hozzá, és a YapToText automatikusan így írja majd, és elsőre így is hallja meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah mengubah “%@” menjadi “%@” lebih dari sekali. Tambahkan, dan YapToText akan mengejanya dengan cara itu secara otomatis, serta mendengarnya dengan benar sejak awal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai cambiato “%@” in “%@” più di una volta. Aggiungilo e YapToText lo scriverà automaticamente in quel modo, e lo riconoscerà già all'ascolto, così viene sentito giusto fin dall'inizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を「%@」に何度も変更しています。追加すると、YapToText は自動的にその綴りを使うようになり、その言葉を最初から正しく聞き取るようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”을(를) “%@”(으)로 여러 번 고치셨어요. 추가하면 YapToText가 그 철자로 자동 입력하고, 처음부터 제대로 듣도록 그 단어를 인식해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har endret «%@» til «%@» mer enn én gang. Legg det til, så skriver YapToText det slik automatisk - og lytter etter det, så det hører riktig fra starten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt “%@” meer dan één keer gewijzigd in “%@”. Voeg het toe en YapToText schrijft het automatisch zo, en luistert ernaar, zodat het meteen goed wordt gehoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilka razy zmieniłeś „%@” na „%@”. Dodaj to, a YapToText będzie pisał to automatycznie w ten sposób i nasłuchiwał tego, aby od razu słyszeć właściwie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você mudou “%@” para “%@” mais de uma vez. Adicione-a e o YapToText vai escrevê-la assim automaticamente, e também vai reconhecê-la para que seja ouvida certo desde o início."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы несколько раз меняли «%@» на «%@». Добавьте это, и YapToText будет писать так автоматически и будет распознавать это слово правильно с самого начала."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Viackrát ste zmenili „%@“ na „%@“. Pridajte to a YapToText to bude automaticky pravopisne uvádzať, a tiež to bude počúvať, takže to bude správne rozpoznané už od začiatku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har ändrat ”%@” till ”%@” mer än en gång. Lägg till den så stavar YapToText den så automatiskt, och lyssnar efter den så att den hörs rätt från början."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเปลี่ยน “%@” เป็น “%@” มากกว่าหนึ่งครั้งแล้ว เพิ่มไว้แล้ว YapToText จะสะกดแบบนั้นให้อัตโนมัติ และฟังคำนี้ด้วย เพื่อให้ได้ยินถูกตั้งแต่แรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ifadesini “%@” olarak birden fazla kez değiştirdiniz. Ekleyin, YapToText bunu otomatik olarak o şekilde yazar ve dinler, böylece en başta doğru duyulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви більше одного разу змінювали «%@» на «%@». Додайте це, і YapToText писатиме так автоматично, а також слухатиме це, тож розпізнаватиме правильно від початку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đổi “%@” thành “%@” nhiều hơn một lần. Thêm vào và YapToText sẽ luôn viết theo cách đó, đồng thời lắng nghe để nhận đúng ngay từ đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已多次将“%@”改为“%@”。添加后，YapToText 会自动按此拼写，并在听写时识别它，从一开始就听对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已多次將「%@」更改為「%@」。加入後，YapToText 就會自動以該拼法輸入，並在聆聽時辨識它，讓它一開始就能被正確聽到。"
          }
        }
      }
    },
