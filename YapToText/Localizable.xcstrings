    " and can be replayed from History.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " ويمكن إعادة تشغيله من السجل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": " a lze je přehrát z historie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": " og kan afspilles igen fra historikken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " und kann im Verlauf erneut abgespielt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " y se puede reproducir desde el Historial."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": " ja sen voi toistaa historiasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " et peut être rejouée depuis l'historique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": " ואפשר להשמיע שוב מההיסטוריה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": " és az Előzményekből újra lejátszható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": " dan bisa diputar ulang dari Riwayat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " e può essere riascoltata dalla Cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 履歴から再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 기록에서 다시 재생할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": " og kan spilles av på nytt fra Historikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": " en kan opnieuw worden afgespeeld vanuit Geschiedenis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " i można go odtworzyć z historii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " e pode ser reproduzido pelo Histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " и его можно воспроизвести из истории."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": " a dá sa prehrať z histórie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": " och kan spelas upp igen från historiken."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": " และเล่นซ้ำได้จากประวัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " ve Geçmişten yeniden oynatılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": " і можна відтворити з історії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": " và có thể phát lại từ Lịch sử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 并可从历史记录中回放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 並可在紀錄中重新播放。"
          }
        }
      }
    },
