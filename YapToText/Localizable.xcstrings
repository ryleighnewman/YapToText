    "AI cleanup is on. Switch off to type your words exactly as spoken.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظيف الذكاء الاصطناعي مُفعّل. أوقفه لكتابة كلماتك كما نُطقت تماماً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úprava AI je zapnutá. Vypněte ji, pokud chcete psát slova přesně tak, jak jste je řekli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-oprydning er til. Slå den fra for at skrive dine ord præcis som sagt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Bereinigung ist aktiv. Schalte sie aus, um deine Worte genau so zu tippen, wie du sie sprichst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza con IA está activada. Desactívala para escribir tus palabras exactamente como las dijiste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-siistintä on päällä. Kytke pois, jos haluat kirjoittaa sanasi täsmälleen puhutussa muodossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage par IA est activé. Désactivez-le pour taper vos mots exactement comme prononcés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניקוי AI פעיל. כבה כדי להקליד את המילים שלך בדיוק כפי שנאמרו."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az AI tisztítás be van kapcsolva. Kapcsold ki, ha a szavaidat pontosan úgy szeretnéd begépelni, ahogy kimondtad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembersihan AI aktif. Matikan untuk mengetik kata-kata Anda persis seperti yang diucapkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pulizia IA è attiva. Disattivala per scrivere le parole esattamente come le hai pronunciate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI クリーンアップはオンです。話した通りに入力するにはオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 정리가 켜져 있어요. 말한 그대로 입력하려면 끄세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-opprydding er på. Slå av for å skrive ordene dine nøyaktig slik de ble sagt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-opschoning staat aan. Schakel uit om je woorden precies zoals gesproken te typen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyszczenie AI jest włączone. Wyłącz je, aby wpisywać słowa dokładnie tak, jak wypowiedziane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A limpeza com IA está ativada. Desative para digitar suas palavras exatamente como foram ditas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистка с ИИ включена. Выключите, чтобы печатать слова ровно так, как вы их произнесли."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Úprava AI je zapnutá. Vypnite ju, ak chcete písať slová presne tak, ako ste ich povedali."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-rensning är på. Stäng av för att skriva dina ord exakt som de sades."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทำความสะอาดด้วย AI เปิดอยู่ ปิดเพื่อพิมพ์คำของคุณตรงตามที่พูด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "YZ temizliği açık. Sözcüklerinizi söylediğiniz gibi yazmak için kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищення ШІ увімкнено. Вимкніть, щоб друкувати слова точно так, як їх сказано."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm sạch bằng AI đang bật. Tắt đi để gõ đúng từng chữ bạn đã nói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 清理已开启。关闭后将按口述原样输入你的文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 清理已開啟。關閉後會依照口述內容逐字輸入。"
          }
        }
      }
    },
