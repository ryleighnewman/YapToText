    "The on-device AI reformats your words…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد الذكاء الاصطناعي على الجهاز تنسيق كلماتك…"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "AI na zařízení přeformátuje vaše slova…"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI'en på enheden omformaterer dine ord…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI auf dem Gerät formatiert deine Worte neu…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA del dispositivo da formato a tus palabras…"
