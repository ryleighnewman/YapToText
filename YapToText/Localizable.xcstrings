          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyi AI újraformázza a szavaidat…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AI di perangkat menata ulang kata-kata Anda…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA sul dispositivo riformatta le tue parole…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイス AI が言葉を整えています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 AI가 말을 다시 서식화하는 중…"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
