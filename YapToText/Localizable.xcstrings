    "No %@ commands match “%@”.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد أوامر %@ تطابق “%@”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné příkazy %@ neodpovídají „%@“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen %@-kommandoer matcher “%@”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine %@-Befehle passen zu „%@“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún comando de %@ coincide con “%@”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei %@-komentoja, jotka vastaavat ilmaisua ”%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune commande %@ ne correspond à “%@”."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין פקודות %@ שמתאימות ל-“%@”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs %@ parancs, amely megfelel ennek: „%@”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada perintah %@ yang cocok dengan “%@”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun comando %@ corrisponde a “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のコマンドで「%@」に一致するものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 명령 중 “%@”과(와) 일치하는 것이 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen %@-kommandoer samsvarer med «%@»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen %@-opdrachten komen overeen met “%@”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne polecenie %@ nie pasuje do „%@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum comando de %@ corresponde a “%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет команд %@, совпадающих с «%@»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadne príkazy %@ nezodpovedajú „%@“."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga %@-kommandon matchar ”%@”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีคำสั่ง %@ ที่ตรงกับ “%@”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ komutlarında “%@” eşleşmesi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає команд %@, що відповідають «%@»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có lệnh %@ nào khớp “%@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有 %@ 命令匹配“%@”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有 %@ 指令符合「%@」。"
          }
        }
      }
    },
    "No %@ commands yet. Add one below.": {
