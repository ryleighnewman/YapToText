    "Restore all settings to their defaults?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد استعادة كل الإعدادات إلى الافتراضي؟"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovit všechna nastavení na výchozí hodnoty?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendan alle indstillinger til standard?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Einstellungen auf die Standardwerte zurücksetzen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restaurar todos los ajustes a sus valores predeterminados?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palautetaanko kaikki asetukset oletuksiin?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablir tous les réglages par défaut ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשחזר את כל ההגדרות לברירת המחדל?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállítod az összes beállítást az alapértelmezettre?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulihkan semua pengaturan ke default?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristinare tutte le impostazioni ai valori predefiniti?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての設定を初期値に戻しますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 설정을 기본값으로 되돌릴까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenopprette alle innstillinger til standard?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle instellingen terugzetten naar de standaardwaarden?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywrócić wszystkie ustawienia do wartości domyślnych?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar todos os ajustes para o padrão?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуть все настройки к значениям по умолчанию?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoviť všetky nastavenia na predvolené hodnoty?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställa alla inställningar till standard?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนค่าการตั้งค่าทั้งหมดเป็นค่าเริ่มต้นหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm ayarlar varsayılanlarına geri yüklensin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновити всі налаштування до типових?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục mọi cài đặt về mặc định?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要将所有设置恢复为默认值吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要將所有設定還原為預設值嗎？"
          }
        }
      }
    },
