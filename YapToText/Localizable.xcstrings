          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un modello vocale whisper.cpp (.bin) o un modello di pulizia llama.cpp (.gguf)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
