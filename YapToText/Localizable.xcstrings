    "Add an app to make YapToText switch to a chosen mode automatically whenever that app is in front. Everywhere else keeps using your current mode.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضِف تطبيقاً ليتحول YapToText إلى الوضع الذي تختاره تلقائياً كلما كان ذلك التطبيق في المقدمة. وفي كل مكان آخر يبقى الوضع الحالي مستخدماً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte aplikaci, aby se YapToText automaticky přepnul do zvoleného režimu, kdykoli bude tato aplikace v popředí. Všude jinde zůstane aktuální režim."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en app, så YapToText automatisk skifter til en valgt tilstand, når appen er forrest. Alle andre steder bruges din aktuelle tilstand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine App hinzu, damit YapToText automatisch in einen gewählten Modus wechselt, sobald diese App im Vordergrund ist. Überall sonst bleibt dein aktueller Modus aktiv."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una app para que YapToText cambie automáticamente a un modo elegido cuando esa app esté al frente. En cualquier otro lugar seguirá usando tu modo actual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää sovellus, jolloin YapToText vaihtaa valitsemaasi tilaan automaattisesti aina, kun sovellus on edessä. Muualla käytetään nykyistä tilaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une app pour que YapToText passe automatiquement au mode choisi chaque fois que cette app est au premier plan. Partout ailleurs, le mode actuel reste utilisé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף אפליקציה כדי ש-YapToText יעבור אוטומטית למצב שבחרת בכל פעם שהאפליקציה הזו בחזית. בכל מקום אחר ימשיך להשתמש במצב הנוכחי שלך."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá egy alkalmazást, hogy a YapToText automatikusan átváltson a kiválasztott módra, amikor az alkalmazás előtérbe kerül. Minden máshol a jelenlegi mód marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan aplikasi agar YapToText otomatis beralih ke mode pilihan setiap kali aplikasi itu aktif. Di tempat lain, mode Anda saat ini tetap dipakai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un'app per far passare YapToText automaticamente alla modalità scelta ogni volta che quell'app è in primo piano. Altrove resta attiva la modalità corrente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを追加すると、そのアプリが前面にあるときに YapToText が選んだモードへ自動で切り替わります。それ以外の場所では、現在のモードが使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 추가하면 그 앱이 맨 앞에 있을 때 YapToText가 선택한 모드로 자동 전환돼요. 다른 곳에서는 현재 모드를 계속 사용해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en app, så bytter YapToText automatisk til valgt modus når den appen er først. Ellers brukes gjeldende modus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een app toe zodat YapToText automatisch naar een gekozen modus schakelt zodra die app vooraan staat. Overal elders blijft je huidige modus gelden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj aplikację, aby YapToText automatycznie przełączał się na wybrany tryb, gdy ta aplikacja jest na wierzchu. Wszędzie indziej nadal używany jest bieżący tryb."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um app para que o YapToText mude automaticamente para o modo escolhido sempre que esse app estiver em primeiro plano. Em todos os outros lugares, continua usando o seu modo atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте приложение, и YapToText будет автоматически переключаться на выбранный режим, пока это приложение на переднем плане. Везде в остальных местах используется текущий режим."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte aplikáciu, aby YapToText automaticky prepol na zvolený režim vždy, keď je táto aplikácia v popredí. Všade inde sa používa váš aktuálny režim."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en app så att YapToText byter till valt läge automatiskt när appen är framme. Överallt annars används ditt aktuella läge."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มแอปเพื่อให้ YapToText สลับไปใช้โหมดที่เลือกโดยอัตโนมัติทุกครั้งที่แอปนั้นอยู่ด้านหน้า ที่อื่นจะใช้โหมดปัจจุบันของคุณต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir uygulama önde olduğunda YapToText'in seçtiğiniz moda otomatik olarak geçmesi için uygulama ekleyin. Diğer her yerde geçerli modunuz kullanılmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте програму, щоб YapToText автоматично перемикався на обраний режим щоразу, коли ця програма на передньому плані. Скрізь інде лишається поточний режим."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một ứng dụng để YapToText tự chuyển sang chế độ đã chọn mỗi khi ứng dụng đó ở trên cùng. Mọi nơi khác vẫn dùng chế độ hiện tại của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加应用后，只要该应用位于最前面，YapToText 就会自动切换到你选定的模式。在其他地方则继续使用当前模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增 App，讓 YapToText 在該 App 位於最前方時自動切換到指定模式。其他情況則繼續使用你目前的模式。"
          }
        }
      }
    },
