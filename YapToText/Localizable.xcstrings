            "state": "translated",
            "value": "С открытым кодом. Ничего не покидает ваш Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorený zdrojový kód. Nič neopúšťa váš Mac."
