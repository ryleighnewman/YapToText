        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מהיר וקל, רב-לשוני. מתאים להערות מהירות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyors és könnyű, többnyelvű. Gyors jegyzetekhez jó."
