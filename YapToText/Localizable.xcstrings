            "value": "Szybki i lekki, wielojęzyczny. Dobry do szybkich notatek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido e leve, multilíngue. Bom para anotações rápidas."
