            "value": "ยกเลิกแล้ว บันทึกลงประวัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal edildi, Geçmişe kaydedildi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасовано, збережено в історії"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hủy, đã lưu vào Lịch sử"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消，已保存到历史记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消，已儲存至紀錄"
          }
        }
      }
    },
    "Cancelling discards the recording. Nothing is saved and it cannot be recovered.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإلغاء يتجاهل التسجيل. لا يُحفظ شيء ولا يمكن استرجاعه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušení zahodí nahrávku. Nic se neuloží a nelze ji obnovit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullering kasserer optagelsen. Intet gemmes, og den kan ikke gendannes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Abbrechen wird die Aufnahme verworfen. Nichts wird gespeichert, und sie lässt sich nicht wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar descarta la grabación. No se guarda nada y no se puede recuperar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Peruuttaminen hylkää äänityksen. Mitään ei tallenneta, eikä sitä voi palauttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler supprime l'enregistrement. Rien n'est enregistré et il ne peut pas être récupéré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול משליך את ההקלטה. שום דבר לא נשמר, ואי אפשר לשחזר."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megszakítás elveti a felvételt. Semmi sem mentődik, és nem állítható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membatalkan akan membuang rekaman. Tidak ada yang disimpan dan tidak bisa dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullare scarta la registrazione. Non viene salvato nulla e non è recuperabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルすると録音は破棄されます。何も保存されず、復元もできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소하면 녹음이 버려져요. 아무것도 저장되지 않으며 복구할 수 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbrytelse forkaster opptaket. Ingenting lagres, og det kan ikke gjenopprettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuleren verwijdert de opname. Er wordt niets opgeslagen en het kan niet worden hersteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulowanie odrzuca nagranie. Nic nie jest zapisywane i nie da się tego odzyskać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar descarta a gravação. Nada é salvo e não pode ser recuperado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена удаляет запись. Ничего не сохраняется, и восстановить её нельзя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušením sa nahrávka zahodí. Nič sa neuloží a nedá sa obnoviť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbrytning kasserar inspelningen. Inget sparas och den kan inte återställas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การยกเลิกจะทิ้งการบันทึก จะไม่มีอะไรถูกบันทึกและกู้คืนไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal etmek kaydı atar. Hiçbir şey kaydedilmez ve geri getirilemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасування відхиляє запис. Нічого не зберігається, і відновити його не можна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy sẽ bỏ bản ghi. Không lưu gì và không thể khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消会舍弃录音。不会保存任何内容，且无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消會捨棄錄音。不會儲存任何內容，也無法復原。"
          }
        }
      }
    },
