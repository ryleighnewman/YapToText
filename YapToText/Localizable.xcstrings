          }
        }
      }
    },
    "The wave follows your app accent color. Strength sets how vivid the ribbons are.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع الموجة لون التمييز في تطبيقك. تحدد القوة مدى وضوح الشرائط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlna sleduje barvu zvýraznění aplikace. Síla určuje, jak živé jsou stuhy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bølgen følger din apps accentfarve. Styrke bestemmer, hvor kraftige båndene er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Welle folgt der Akzentfarbe deiner App. Die Stärke bestimmt, wie kräftig die Bänder leuchten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La onda sigue el color de acento de tu app. La intensidad define qué tan vívidas son las cintas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aalto seuraa sovelluksen korostusväriä. Voimakkuus määrittää, kuinka eloisia nauhat ovat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vague suit la couleur d'accent de votre app. L'intensité règle le degré de saturation des rubans."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגל עוקב אחרי צבע ההדגשה של האפליקציה. העוצמה קובעת כמה חיים הסרטים."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hullám az alkalmazás kiemelőszínét követi. Az erősség határozza meg, mennyire élénkek a szalagok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelombang mengikuti warna aksen aplikasi Anda. Kekuatan menentukan seberapa cerah pitanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'onda segue il colore di accento dell'app. L'intensità regola quanto sono vivaci i nastri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "波形はアプリのアクセント色に従います。強さでリボンの鮮やかさを設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파형은 앱 강조 색을 따라가요. 강도로 리본의 선명도를 정해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bølgen følger aksentfargen i appen din. Styrke bestemmer hvor kraftige båndene er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De golf volgt de accentkleur van je app. Sterkte bepaalt hoe levendig de linten zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fala podąża za kolorem akcentu aplikacji. Siła określa, jak żywe są wstęgi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A onda segue a cor de destaque do app. A intensidade define quão vívidas são as fitas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Волна следует цвету акцента приложения. Сила задаёт яркость лент."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlna sleduje farbu zvýraznenia aplikácie. Sila určuje, aké výrazné sú pásy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vågen följer appens accentfärg. Styrkan avgör hur färgstarka banden är."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลื่นจะทำตามสีเน้นของแอป ความเข้มกำหนดความสดของริบบิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalga uygulamanızın vurgu rengini izler. Güç, şeritlerin ne kadar canlı olacağını belirler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хвиля слідує за акцентним кольором програми. Сила визначає, наскільки яскраві стрічки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sóng theo màu nhấn của ứng dụng. Cường độ quyết định các dải màu rực rỡ đến đâu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "波形跟随应用的强调色。强度决定彩带的鲜艳程度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "波形會跟隨 App 的強調色。「強度」可設定彩帶的鮮明程度。"
          }
        }
      }
    },
    "The wave uses this color and its neighboring shades. Strength sets how vivid the ribbons are.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم الموجة هذا اللون والدرجات المجاورة له. تحدد القوة مدى وضوح الشرائط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlna používá tuto barvu a její sousední odstíny. Síla určuje, jak živé jsou stuhy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bølgen bruger denne farve og dens nabonuancer. Styrke bestemmer, hvor kraftige båndene er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Welle verwendet diese Farbe und ihre Nachbartöne. Die Stärke bestimmt, wie kräftig die Bänder leuchten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La onda usa este color y sus tonos cercanos. La intensidad define qué tan vívidas son las cintas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aalto käyttää tätä väriä ja sen lähisävyjä. Voimakkuus määrittää, kuinka eloisia nauhat ovat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vague utilise cette couleur et ses teintes voisines. L'intensité règle la vivacité des rubans."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגל משתמש בצבע הזה ובגווני השכנים שלו. העוצמה קובעת כמה חיים הסרטים."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hullám ezt a színt és a szomszédos árnyalatait használja. Az erősség határozza meg, mennyire élénkek a szalagok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelombang memakai warna ini dan nuansa terdekatnya. Kekuatan menentukan seberapa cerah pitanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'onda usa questo colore e le sue sfumature vicine. L'intensità regola quanto sono vivaci i nastri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "波形はこの色とその近い色合いを使います。強さでリボンの鮮やかさを設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파형은 이 색과 인접한 색조를 사용해요. 강도로 리본의 선명도를 정해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bølgen bruker denne fargen og nabotonene. Styrke bestemmer hvor kraftige båndene er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De golf gebruikt deze kleur en de naburige tinten. Sterkte bepaalt hoe levendig de linten zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fala używa tego koloru i sąsiednich odcieni. Siła określa, jak żywe są wstęgi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A onda usa esta cor e seus tons vizinhos. A intensidade define quão vívidas são as fitas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Волна использует этот цвет и соседние оттенки. Сила задаёт яркость лент."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlna používa túto farbu a jej susedné odtiene. Sila určuje, aké výrazné sú pásy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vågen använder den här färgen och närliggande nyanser. Styrkan avgör hur färgstarka banden är."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลื่นใช้สีนี้และเฉดใกล้เคียง ความเข้มกำหนดความสดของริบบิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalga bu rengi ve komşu tonlarını kullanır. Güç, şeritlerin ne kadar canlı olacağını belirler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хвиля використовує цей колір і сусідні відтінки. Сила визначає, наскільки яскраві стрічки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sóng dùng màu này và các sắc độ lân cận. Cường độ quyết định các dải màu rực rỡ đến đâu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "波形使用此颜色及其相邻的色调。强度决定彩带的鲜艳程度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "波形會使用此顏色及其相近的色階。「強度」可設定彩帶的鮮明程度。"
          }
        }
      }
    },
    "The waveform follows your voice, and your words land here while you are still talking.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع الموجة صوتك، وتظهر كلماتك هنا بينما ما زلت تتكلم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlna sleduje váš hlas a vaše slova se objevují, zatímco ještě mluvíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bølgeformen følger din stemme, og dine ord lander her, mens du stadig taler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wellenform folgt deiner Stimme, und deine Worte landen hier, während du noch sprichst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La onda sigue tu voz, y tus palabras aparecen aquí mientras aún estás hablando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aaltomuoto seuraa ääntäsi, ja sanasi ilmestyvät tänne jo puhuessasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vague suit votre voix, et vos mots apparaissent ici pendant que vous parlez encore."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגל עוקב אחרי הקול שלך, והמילים שלך מגיעות לכאן בזמן שאתה עדיין מדבר."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hullámforma követi a hangodat, a szavaid pedig itt landolnak, miközben még beszélsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelombang mengikuti suara Anda, dan kata-kata Anda masuk di sini selagi Anda masih berbicara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'onda segue la tua voce, e le tue parole appaiono qui mentre stai ancora parlando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "波形は声に合わせて動き、話している間にも言葉がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파형은 목소리를 따라가고, 말하는 중에도 말이 여기에 들어가요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bølgeformen følger stemmen din, og ordene dine lander her mens du fortsatt snakker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De golfvorm volgt je stem, en je woorden landen hier terwijl je nog praat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fala podąża za twoim głosem, a twoje słowa pojawiają się tutaj, zanim skończysz mówić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A onda segue sua voz, e suas palavras caem aqui enquanto você ainda está falando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Волна следует за вашим голосом, а слова появляются здесь, пока вы ещё говорите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlna sleduje váš hlas a vaše slová sa tu objavujú, kým ešte rozprávate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vågen följer din röst, och dina ord landar här medan du fortfarande pratar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลื่นเสียงจะตามเสียงของคุณ และคำของคุณจะปรากฏตรงนี้ขณะที่คุณยังพูดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalga formu sesinizi izler, sözcükleriniz siz hâlâ konuşurken burada belirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хвиля слідує за вашим голосом, а слова з'являються тут, поки ви ще говорите."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sóng âm theo giọng bạn, và lời bạn hiện ở đây ngay khi bạn vẫn đang nói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "波形跟随你的声音，你的文字会在你仍在说话时就出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "波形會跟隨你的聲音，你說話的同時，文字就會出現在這裡。"
          }
        }
      }
    },
    "There's noticeable background noise relative to your voice. A headset or getting closer to the mic would raise accuracy the most. If you're in a call app (Teams, Zoom), it may be holding the mic and lowering your level.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك ضوضاء خلفية ملحوظة مقارنةً بصوتك. سماعة الرأس أو الاقتراب من الميكروفون سيرفعان الدقة أكثر من أي شيء آخر. إن كنت في تطبيق مكالمات (Teams أو Zoom)، فقد يكون يمسك بالميكروفون ويخفض مستواك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve srovnání s vaším hlasem je znatelný okolní hluk. Náhlavní souprava nebo bližší mikrofon by přesnost zvýšily nejvíce. Pokud jste v hovorové aplikaci (Teams, Zoom), může mikrofon držet a snižovat vaši úroveň."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er mærkbar baggrundsstøj i forhold til din stemme. Et headset eller at komme tættere på mikrofonen ville øge præcisionen mest. Er du i en opkaldsapp (Teams, Zoom), kan den måske holde på mikrofonen og sænke dit niveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Verhältnis zu deiner Stimme ist deutlich Hintergrundgeräusch da. Ein Headset oder näher ans Mikrofon zu rücken, würde die Genauigkeit am stärksten steigern. Wenn du in einer Anruf-App (Teams, Zoom) bist, belegt sie womöglich das Mikrofon und senkt deinen Pegel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un ruido de fondo notable en comparación con tu voz. Unos auriculares o acercarte más al micrófono mejorarían la precisión más que nada. Si estás en una app de llamadas (Teams, Zoom), es posible que esté usando el micrófono y bajando tu nivel."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustamelu on huomattavaa äänesi tasoon nähden. Kuulokkeet tai lähempänä mikrofonia oleminen parantaisivat tarkkuutta eniten. Jos olet puhelusovelluksessa (Teams, Zoom), se voi pitää mikrofonia ja laskea tasoasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a un bruit de fond notable par rapport à votre voix. Un casque ou un rapprochement du micro améliorerait le plus la précision. Si vous êtes dans une app d'appel (Teams, Zoom), elle peut monopoliser le micro et baisser votre niveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש רעש רקע מורגש ביחס לקול שלך. אוזנייה או התקרבות למיקרופון יעלו את הדיוק הכי הרבה. אם אתה באפליקציית שיחות (Teams, Zoom), היא עלולה להחזיק את המיקרופון ולהנמיך את הרמה שלך."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Észrevehető háttérzaj van a hangodhoz képest. Egy fejhallgató vagy a mikrofonhoz való közelebb állás növelné leginkább a pontosságot. Ha hívóalkalmazásban vagy (Teams, Zoom), lehet, hogy az lefoglalja a mikrofont, és csökkenti a szinted."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada kebisingan latar yang cukup terasa dibanding suara Anda. Headset atau mendekat ke mikrofon akan paling meningkatkan akurasi. Jika Anda sedang di aplikasi panggilan (Teams, Zoom), aplikasi itu mungkin menahan mikrofon dan menurunkan level Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è un rumore di fondo evidente rispetto alla tua voce. Una cuffia o avvicinarsi al microfono aumenterebbe di più la precisione. Se sei in un'app di chiamata (Teams, Zoom), potrebbe occupare il microfono e abbassare il tuo livello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声に対して、背景のノイズがはっきり聞こえます。ヘッドセットを使うか、マイクに近づくと、精度が最も上がります。通話アプリ(Teams、Zoom など)がマイクを占有していると、音量が下がることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목소리에 비해 배경 소음이 눈에 띄어요. 헤드셋을 쓰거나 마이크에 더 가까이 가면 정확도가 가장 많이 올라가요. 통화 앱(Teams, Zoom)을 쓰고 있다면 마이크를 점유하고 입력 레벨을 낮추고 있을 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er merkbar bakgrunnsstøy i forhold til stemmen din. Et headset eller å komme nærmere mikrofonen ville øke nøyaktigheten mest. Hvis du er i en samtaleapp (Teams, Zoom), kan den holde mikrofonen og senke nivået ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is merkbaar achtergrondgeluid ten opzichte van je stem. Een headset of dichter bij de microfoon zou de nauwkeurigheid het meest verhogen. Als je in een belapp zit (Teams, Zoom), houdt die mogelijk de microfoon vast en verlaagt je niveau."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słychać zauważalny szum tła w stosunku do twojego głosu. Najbardziej zwiększyłby dokładność zestaw słuchawkowy albo bliższa odległość od mikrofonu. Jeśli jesteś w aplikacji do rozmów (Teams, Zoom), może ona blokować mikrofon i obniżać twój poziom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há ruído de fundo perceptível em relação à sua voz. Um fone ou chegar mais perto do microfone aumentaria mais a precisão. Se você estiver em um app de chamadas (Teams, Zoom), ele pode estar segurando o microfone e reduzindo seu nível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметный фоновый шум по сравнению с вашим голосом. Больше всего точность повысит гарнитура или более близкое расположение к микрофону. Если вы в приложении для звонков (Teams, Zoom), оно может занимать микрофон и снижать ваш уровень."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Je znateľný hluk v pozadí v porovnaní s vaším hlasom. Najviac by pomohla náhlavná súprava alebo bližší mikrofón. Ak ste v aplikácii na hovory (Teams, Zoom), môže držať mikrofón a znižovať vašu úroveň."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns märkbart bakgrundsbrus i förhållande till din röst. Ett headset eller att komma närmare mikrofonen skulle höja träffsäkerheten mest. Om du är i ett samtalsprogram (Teams, Zoom) kan det hålla i mikrofonen och sänka din nivå."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเสียงรบกวนพื้นหลังที่เห็นได้ชัดเมื่อเทียบกับเสียงของคุณ หูฟังหรือการขยับเข้าใกล้ไมค์จะช่วยเพิ่มความแม่นยำได้มากที่สุด หากคุณอยู่ในแอปโทรอย่าง Teams หรือ Zoom แอปนั้นอาจกำลังถือไมค์และลดระดับเสียงของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesinize göre belirgin bir arka plan gürültüsü var. Bir kulaklık ya da mikrofona yaklaşmak doğruluğu en çok artırır. Bir görüşme uygulamasındaysanız (Teams, Zoom), mikrofonu tutup düzeyinizi düşürüyor olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помітний фоновий шум відносно вашого голосу. Найбільше підвищить точність гарнітура або ближча відстань до мікрофона. Якщо ви в програмі для дзвінків (Teams, Zoom), вона може займати мікрофон і знижувати ваш рівень."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có tiếng ồn nền đáng chú ý so với giọng bạn. Tai nghe hoặc đến gần micrô hơn sẽ tăng độ chính xác nhiều nhất. Nếu bạn đang ở ứng dụng gọi (Teams, Zoom), nó có thể đang giữ micrô và làm giảm mức của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相对于你的声音，背景噪音较明显。使用耳机或靠近麦克风会最大程度地提高准确率。如果你正在使用通话应用（Teams、Zoom），它可能占用了麦克风并降低了你的电平。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相對於你的聲音，背景噪音明顯偏大。使用耳機或靠近麥克風，最能提升準確度。如果你正在通話 App（Teams、Zoom）中，它可能正佔用麥克風，並降低你的音量。"
          }
        }
      }
    },
    "These colors belong to the Quick Edit card alone, so it never looks like a dictation. Purple out of the box.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الألوان خاصة ببطاقة التحرير السريع وحدها، حتى لا تبدو أبداً كإملاء. اللون البنفسجي هو الافتراضي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto barvy patří pouze kartě Rychlých úprav, aby nikdy nevypadala jako diktát. Ve výchozím nastavení fialové."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse farver hører kun til kortet for hurtig redigering, så det aldrig ligner en diktering. Lilla fra start."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Farben gehören nur zur Karte Schnellbearbeitung, damit sie nie wie ein Diktat aussieht. Standardmäßig lila."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos colores son exclusivos de la tarjeta de Edición rápida, para que nunca parezca un dictado. Morado de fábrica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä värit kuuluvat pelkästään Pikamuokkauskortille, joten se ei näytä koskaan sanelulta. Oletuksena violetti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces couleurs sont réservées à la carte d'édition rapide, pour qu'elle ne ressemble jamais à une dictée. Violet par défaut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצבעים האלה שייכים לכרטיס העריכה המהירה בלבד, כך שהוא לעולם לא ייראה כמו הכתבה. סגול מההתחלה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezek a színek kizárólag a Gyors szerkesztés kártyát illetik, így sosem tűnik diktálásnak. Alapból lila."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna ini khusus untuk kartu Quick Edit, jadi tidak pernah terlihat seperti dikte. Ungu secara default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi colori appartengono solo alla scheda Modifica rapida, così non sembra mai una dettatura. Viola di serie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの色はクイック編集カードだけのものなので、ディクテーションと見間違えることはありません。初期設定では紫です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 색상은 Quick Edit 카드 전용이라 받아쓰기처럼 보이지 않아요. 기본값은 보라색이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse fargene tilhører bare hurtigredigeringskortet, så det aldri ser ut som en diktering. Lilla som standard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze kleuren horen alleen bij de kaart Snel bewerken, zodat die nooit op een dictee lijkt. Standaard paars."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te kolory należą wyłącznie do karty Szybkiej edycji, więc nigdy nie wygląda jak dyktowanie. Domyślnie fioletowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essas cores são exclusivas do cartão de Edição rápida, para que ele nunca pareça um ditado. Roxo de fábrica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти цвета относятся только к карточке быстрого редактирования, поэтому она никогда не будет похожа на диктовку. По умолчанию фиолетовые."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto farby patria len karte Rýchlej úpravy, takže nikdy nevyzerá ako diktát. Z výroby fialová."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Färgerna hör bara till snabbredigeringskortet, så att det aldrig ser ut som en diktering. Lila från start."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สีเหล่านี้ใช้กับการ์ดแก้ไขด่วนโดยเฉพาะ เพื่อไม่ให้ดูเหมือนการพิมพ์ด้วยเสียง ค่าเริ่มต้นเป็นสีม่วง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu renkler yalnızca Hızlı Düzenleme kartına aittir, böylece hiçbir zaman dikteye benzemez. Kutudan çıkar çıkmaz mor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці кольори належать лише картці швидкого редагування, щоб вона ніколи не скидалася на диктовку. За замовчуванням фіолетові."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các màu này chỉ dành cho thẻ Chỉnh sửa nhanh, để nó không bao giờ trông giống một lần đọc chính tả. Mặc định là màu tím."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些颜色仅用于快速编辑卡片，因此它永远不会与听写混淆。默认为紫色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些顏色僅適用於快速編輯卡片，因此它永遠不會看起來像聽寫內容。預設為紫色。"
          }
        }
      }
    },
