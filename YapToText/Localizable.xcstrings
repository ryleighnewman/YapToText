        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תן שם למצב הזה ולאופן שבו הוא מופיע."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevezd el ezt a módot, és add meg, hogyan jelenjen meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri nama mode ini dan atur tampilannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai un nome a questa modalità e scegli come appare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモードの名前と表示方法を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모드의 이름과 표시 방식을 정하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi denne modusen et navn og bestem hvordan den vises."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef deze modus een naam en bepaal hoe die verschijnt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwij ten tryb i określ, jak się wyświetla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê um nome a este modo e defina como ele aparece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назовите этот режим и задайте, как он отображается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomenujte tento režim a určte, ako sa zobrazí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namnge det här läget och hur det visas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งชื่อโหมดนี้และกำหนดวิธีแสดงผล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu modu ve nasıl görüneceğini adlandırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назвіть цей режим і вкажіть, як він відображатиметься."
          }
        },
        "vi": {
          "stringUnit": {
