    "Click any field and press keys to record; right-click it to clear or reset.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر أي حقل واضغط المفاتيح للتسجيل، وانقر بزر الفأرة الأيمن عليه للمسح أو إعادة التعيين."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikněte na libovolné pole a stisknutím kláves zkratku nahrajte. Pravým tlačítkem ji vymažete nebo obnovíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på et felt og tryk taster for at optage; højreklik for at rydde eller nulstille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf ein Feld und drücke Tasten zum Aufnehmen; mit einem Rechtsklick leerst oder setzt du es zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un campo y pulsa las teclas para grabar; haz clic derecho para borrarlo o restablecerlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napsauta kenttää ja paina näppäimiä tallentaaksesi. Tyhjennä tai palauta napsauttamalla hiiren kakkospainikkeella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un champ puis appuyez sur les touches à enregistrer ; faites un clic droit pour l'effacer ou le réinitialiser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחץ על שדה כלשהו והקש מקשים כדי להקליט; לחיצה ימנית עליו מנקה או מאפסת."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kattints egy mezőre, és nyomd le a billentyűket a rögzítéshez; jobb kattintással törölheted vagy visszaállíthatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik kolom mana pun lalu tekan tombol untuk merekam; klik kanan untuk menghapus atau mengatur ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su un campo e premi i tasti per registrarli. Fai clic destro per cancellarlo o ripristinarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "欄をクリックしてキーを押すと記録されます。右クリックで消去またはリセットできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무 칸이나 클릭하고 키를 눌러 기록하세요. 오른쪽 클릭하면 지우거나 초기화할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på et felt og trykk taster for å registrere; høyreklikk for å tømme eller tilbakestille."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op een veld en druk toetsen om vast te leggen; klik er met de rechtermuisknop op om te wissen of te resetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij pole i naciśnij klawisze, aby je nagrać; kliknij je prawym przyciskiem, aby wyczyścić lub zresetować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em um campo e pressione as teclas para gravar; clique com o botão direito para limpar ou redefinir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите в любое поле и нажмите клавиши, чтобы записать. Правый клик очищает или сбрасывает поле."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite na ľubovoľné pole a stlačte klávesy na zaznamenanie; pravým tlačidlom ho vymažete alebo obnovíte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka i ett fält och tryck på tangenter för att spela in; högerklicka för att rensa eller återställa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกช่องใดก็ได้แล้วกดปุ่มเพื่อบันทึก คลิกขวาเพื่อล้างหรือรีเซ็ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir alana tıklayıp tuşlara basarak kaydedin; temizlemek ya da sıfırlamak için alana sağ tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть будь-яке поле і натисніть клавіші, щоб записати їх; клацніть правою кнопкою, щоб очистити або скинути."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấp vào ô bất kỳ rồi nhấn phím để ghi lại; nhấp chuột phải để xóa hoặc đặt lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击任意输入框后按下按键即可录入；右键点击可清除或重置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選任一欄位後按下按鍵即可錄製；按右鍵可清除或重設。"
          }
        }
      }
    },
    "Click any mode to edit its prompt, model, dictionaries, and output.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على أي وضع لتحرير أمره ونموذجه وقواميسه ومخرجاته."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknutím na režim upravíte jeho prompt, model, slovníky a výstup."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på en tilstand for at redigere dens prompt, model, ordbøger og output."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf einen Modus, um seinen Prompt, sein Modell, seine Wörterbücher und seine Ausgabe zu bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en cualquier modo para editar su prompt, modelo, diccionarios y salida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napsauta mitä tahansa tilaa muokataksesi sen kehotetta, mallia, sanastoja ja tulosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un mode pour modifier son invite, son modèle, ses dictionnaires et sa sortie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחץ על מצב כלשהו כדי לערוך את ההנחיה, המודל, המילונים והפלט שלו."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kattints bármelyik módra az utasítás, a modell, a szótárak és a kimenet szerkesztéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik mode mana pun untuk mengedit prompt, model, kamus, dan keluarannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su una modalità per modificare il suo prompt, il modello, i dizionari e l'output."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モードをクリックすると、プロンプト、モデル、辞書、出力を編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모드를 클릭하면 프롬프트, 모델, 사전, 출력을 편집할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på en modus for å redigere prompt, modell, ordlister og resultat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op een modus om de prompt, het model, de woordenlijsten en de uitvoer te bewerken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij tryb, aby edytować jego prompt, model, słowniki i wyjście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em um modo para editar seu prompt, modelo, dicionários e saída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на любой режим, чтобы изменить его запрос, модель, словари и вывод."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknutím na režim upravíte jeho výzvu, model, slovníky a výstup."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på ett läge för att redigera dess prompt, modell, ordlistor och utdata."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกโหมดใดก็ได้เพื่อแก้ไขพรอมต์ โมเดล พจนานุกรม และผลลัพธ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstemini, modelini, sözlüklerini ve çıktısını düzenlemek için bir moda tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть будь-який режим, щоб змінити його запит, модель, словники і вивід."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấp vào chế độ bất kỳ để sửa lời nhắc, mô hình, từ điển và đầu ra của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击任意模式即可编辑其提示词、模型、词典和输出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選任一模式即可編輯其提示詞、模型、字典與輸出。"
          }
        }
      }
    },
    "Click him to start a dictation, switch mode or microphone, transcribe a file, regenerate the last dictation as any mode, or insert it again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر عليه لبدء الإملاء، أو تبديل الوضع أو الميكروفون، أو نسخ ملف، أو إعادة توليد آخر إملاء بأي وضع، أو إدراجه مجدداً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikněte na něj pro spuštění diktátu, přepnutí režimu nebo mikrofonu, přepsání souboru, přegenerování posledního diktátu v libovolném režimu nebo jeho opětovné vložení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på ham for at starte en diktering, skifte tilstand eller mikrofon, transskribere en fil, generere den sidste diktering igen i en vilkårlig tilstand eller indsætte den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf ihn, um ein Diktat zu starten, den Modus oder das Mikrofon zu wechseln, eine Datei zu transkribieren, das letzte Diktat in einem beliebigen Modus neu zu erzeugen oder es erneut einzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en él para iniciar un dictado, cambiar de modo o micrófono, transcribir un archivo, regenerar el último dictado con cualquier modo o volver a insertarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napsauta häntä aloittaaksesi sanelun, vaihtaaksesi tilaa tai mikrofonia, litteroidaksesi tiedoston, luodaksesi viimeisimmän sanelun uudelleen millä tahansa tilalla tai lisätäksesi sen uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur lui pour démarrer une dictée, changer de mode ou de microphone, transcrire un fichier, régénérer la dernière dictée dans n'importe quel mode, ou la réinsérer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחץ עליו כדי להתחיל הכתבה, להחליף מצב או מיקרופון, לתמלל קובץ, ליצור מחדש את ההכתבה האחרונה בכל מצב, או להכניס אותה שוב."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kattints rá diktálás indításához, mód vagy mikrofon váltásához, fájl átírásához, az utolsó diktálás újragenerálásához bármely módban, vagy újbóli beszúráshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik dia untuk memulai dikte, mengganti mode atau mikrofon, mentranskripsi file, membuat ulang dikte terakhir dengan mode apa pun, atau menyisipkannya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su di lui per avviare una dettatura, cambiare modalità o microfono, trascrivere un file, rigenerare l'ultima dettatura in qualsiasi modalità o inserirla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "彼をクリックすると、ディクテーションの開始、モードやマイクの切り替え、ファイルの書き起こし、直前のディクテーションを任意のモードで再生成、再挿入ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그를 클릭하면 받아쓰기를 시작하고, 모드나 마이크를 바꾸고, 파일을 전사하고, 마지막 받아쓰기를 아무 모드로나 다시 생성하거나 다시 삽입할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på ham for å starte en diktering, bytte modus eller mikrofon, transkribere en fil, lage den siste dikteringen på nytt i en hvilken som helst modus, eller sette den inn igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op hem om een dictee te starten, de modus of microfoon te wisselen, een bestand te transcriberen, het laatste dictee opnieuw te genereren in elke modus, of het opnieuw in te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij go, aby rozpocząć dyktowanie, przełączyć tryb lub mikrofon, przetranskrybować plik, wygenerować ponownie ostatnie dyktowanie w dowolnym trybie albo wstawić je ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique nele para iniciar um ditado, trocar de modo ou microfone, transcrever um arquivo, regenerar o último ditado em qualquer modo ou inseri-lo de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на него, чтобы начать диктовку, переключить режим или микрофон, расшифровать файл, пересоздать последнюю диктовку в любом режиме или вставить её снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite naň a spustite diktovanie, prepnite režim alebo mikrofón, prepíšte súbor, pregenerujte posledný diktát ľubovoľným režimom alebo ho znova vložte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på honom för att starta en diktering, byta läge eller mikrofon, transkribera en fil, skapa om den senaste dikteringen som valfritt läge eller infoga den igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกเขาเพื่อเริ่มการพิมพ์ด้วยเสียง สลับโหมดหรือไมโครโฟน ถอดเสียงจากไฟล์ สร้างการพิมพ์ล่าสุดใหม่ด้วยโหมดใดก็ได้ หรือแทรกอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ona tıklayarak dikteyi başlatın, modu veya mikrofonu değiştirin, bir dosyayı yazıya dökün, son diktenizi herhangi bir modda yeniden oluşturun ya da yeniden ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть на нього, щоб почати диктовку, змінити режим або мікрофон, транскрибувати файл, згенерувати останню диктовку в будь-якому режимі або вставити її знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấp vào cậu ấy để bắt đầu đọc chính tả, đổi chế độ hoặc micrô, phiên âm tệp, tạo lại lần đọc chính tả gần nhất theo chế độ bất kỳ, hoặc chèn lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击他即可开始听写、切换模式或麦克风、转写文件、以任意模式重新生成上一次的听写，或再次插入它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊他即可開始聽寫、切換模式或麥克風、轉錄檔案、以任一模式重新產生上一次的聽寫內容，或再次插入。"
          }
        }
      }
    },
    "Click where you want the text to go.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر حيث تريد أن يذهب النص."
          }
        },
        "cs": {
