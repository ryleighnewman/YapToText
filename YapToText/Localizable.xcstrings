    "Apple Intelligence is off right now, so this mode will insert the raw transcript until it's enabled.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence مُعطّل الآن، لذلك سيُدرج هذا الوضع النص الخام حتى يتم تفعيله."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je právě vypnutá, takže tento režim vloží čistý přepis, dokud ji nezapnete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence er slået fra lige nu, så denne tilstand indsætter den rå transskription, indtil den slås til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist gerade ausgeschaltet, daher fügt dieser Modus das rohe Transkript ein, bis es aktiviert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está desactivada en este momento, así que este modo insertará la transcripción sin procesar hasta que se active."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence on tällä hetkellä pois päältä, joten tämä tila lisää raakalitteroinnin, kunnes se otetaan käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivée pour le moment, donc ce mode insérera la transcription brute jusqu'à son activation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence כבוי כרגע, לכן מצב זה יכניס את התמלול הגולמי עד שיופעל."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Intelligence most ki van kapcsolva, ezért ez a mód addig a nyers átiratot szúrja be, amíg be nem kapcsolják."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence sedang nonaktif, jadi mode ini akan menyisipkan transkrip mentah sampai diaktifkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence è disattivato, quindi questa modalità inserirà la trascrizione grezza finché non verrà attivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence は現在オフのため、有効になるまでこのモードはそのままの書き起こしを挿入します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 Apple Intelligence가 꺼져 있어서, 켜질 때까지 이 모드는 원문 전사를 삽입해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence er av akkurat nå, så denne modusen setter inn den rå transkripsjonen til den er slått på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence staat nu uit, dus deze modus voegt het ruwe transcript in totdat het is ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence jest teraz wyłączone, więc ten tryb będzie wstawiał surową transkrypcję, dopóki nie zostanie włączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence está desativada agora, então este modo vai inserir a transcrição bruta até que seja ativada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence сейчас выключена, поэтому этот режим будет вставлять необработанную расшифровку, пока её не включат."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je momentálne vypnutý, takže tento režim vloží surový prepis, kým ho nezapnete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence är av just nu, så det här läget infogar den råa transkriptionen tills det är påslaget."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ปิดอยู่ตอนนี้ โหมดนี้จึงจะแทรกข้อความถอดเสียงแบบดิบจนกว่าจะเปิดใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence şu anda kapalı, bu yüzden etkinleştirilene kadar bu mod ham dökümü ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence зараз вимкнено, тож цей режим вставлятиме необроблену транскрипцію, доки його не буде увімкнено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence đang tắt, nên chế độ này sẽ chèn bản phiên âm thô cho đến khi được bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 目前已关闭，因此在开启之前，此模式将插入原始转写内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 目前已關閉，因此在啟用之前，此模式會插入原始逐字稿。"
          }
        }
      }
    },
    "Apple Intelligence is ready. AI modes are available.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence جاهز. أوضاع الذكاء الاصطناعي متاحة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je připravena. Režimy AI jsou dostupné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence er klar. AI-tilstande er tilgængelige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist bereit. KI-Modi sind verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está lista. Los modos de IA están disponibles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence on valmis. AI-tilat ovat käytettävissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est prête. Les modes IA sont disponibles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence מוכן. מצבי AI זמינים."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Intelligence kész. Az AI módok elérhetők."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence siap. Mode AI tersedia."
