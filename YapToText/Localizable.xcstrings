          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera allt och börja om?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบทุกอย่างและเริ่มใหม่หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
