    "Glad you are here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسعدنا وجودك هنا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rádi vás tu vidíme."
          }
        },
        "da": {
