    "Granted something in System Settings and it isn't showing here yet?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منحت إذناً في إعدادات النظام ولا يظهر هنا بعد؟"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udělili jste něco v Nastavení systému a tady se to ještě nezobrazuje?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du givet en tilladelse i Systemindstillinger, som ikke vises her endnu?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas in den Systemeinstellungen erlaubt, und es wird hier noch nicht angezeigt?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Concediste algo en Ajustes del Sistema y todavía no aparece aquí?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Myönsitkö jotain Järjestelmäasetuksissa, eikä se näy vielä täällä?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez accordé une autorisation dans Réglages Système et elle n'apparaît pas encore ici ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתת הרשאה בהגדרות המערכת והיא עדיין לא מופיעה כאן?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megadtál valamit a Rendszerbeállításokban, de itt még nem látszik?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah memberi izin di Pengaturan Sistem tetapi belum terlihat di sini?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai concesso un permesso nelle Impostazioni di Sistema e non compare ancora qui?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定で許可したのに、ここにまだ表示されませんか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 권한을 허용했는데 여기에 아직 표시되지 않나요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du gitt noe i Systeminnstillinger uten at det vises her ennå?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iets verleend in Systeeminstellingen en het staat hier nog niet?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyznano coś w Ustawieniach systemowych, a tutaj jeszcze tego nie widać?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedeu algo nos Ajustes do Sistema e ainda não aparece aqui?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдали разрешение в Системных настройках, но здесь оно ещё не отображается?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolili ste niečo v Nastaveniach systému a tu sa to ešte nezobrazuje?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du beviljat något i Systeminställningar som inte syns här än?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตบางอย่างในการตั้งค่าระบบแล้ว แต่ยังไม่แสดงที่นี่ใช่ไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları'nda bir izin verdiniz ama burada henüz görünmüyor mu?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надали щось у Системних налаштуваннях, а тут це ще не видно?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã cấp quyền trong Cài đặt Hệ thống nhưng ở đây chưa hiển thị?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在系统设置中授予权限，但这里还没有显示？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在「系統設定」中授予權限，但此處尚未顯示？"
          }
        }
      }
    },
