            "state": "translated",
            "value": "سريع وخفيف، متعدد اللغات. مناسب للملاحظات السريعة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rychlý a lehký, vícejazyčný. Vhodný pro rychlé poznámky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtig og let, flersproget. Godt til hurtige noter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnell und leicht, mehrsprachig. Gut für kurze Notizen."
