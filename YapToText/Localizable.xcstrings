    "Templates replace the instructions above, so tweak from there.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القوالب تحل محل التعليمات أعلاه، لذا عدّل من هناك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šablony nahradí pokyny výše, takže odtud upravujte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skabeloner erstatter instruktionerne ovenfor, så finjustér derfra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorlagen ersetzen die Anweisungen oben, passe sie daher von dort aus an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantillas reemplazan las instrucciones de arriba, así que ajusta a partir de ahí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mallipohjat korvaavat yllä olevat ohjeet, joten muokkaa niitä siitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles remplacent les instructions ci-dessus ; ajustez à partir de là."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תבניות מחליפות את ההוראות למעלה, אז שנה מהן."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sablonok felülírják a fenti utasításokat, így onnan finomíts."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Templat menggantikan instruksi di atas, jadi sesuaikan dari sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli sostituiscono le istruzioni qui sopra, quindi modificale da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレートは上の指示に置き換わるので、そこから調整してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "템플릿은 위의 지시문을 대체하니, 그 기준으로 다듬으세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Maler erstatter instruksjonene over, så juster derfra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjablonen vervangen de instructies hierboven, dus pas die vandaaruit aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szablony zastępują instrukcje powyżej, więc dopasuj je od tego miejsca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos substituem as instruções acima, então ajuste a partir delas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблоны заменяют инструкции выше, поэтому дорабатывайте уже от них."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Šablóny nahradia pokyny vyššie, takže ich odtiaľ upravte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mallar ersätter instruktionerna ovan, så justera därifrån."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เทมเพลตจะแทนที่คำสั่งข้างบน จึงปรับแต่งต่อจากตรงนั้นได้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şablonlar yukarıdaki talimatların yerini alır, bu yüzden oradan ayarlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблони замінюють інструкції вище, тож змінюйте вже з них."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẫu thay thế hướng dẫn ở trên, nên hãy chỉnh từ đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板会替换上方的指令，因此可在此基础上微调。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範本會取代上方的指示，因此請從那裡開始微調。"
          }
        }
      }
    },
