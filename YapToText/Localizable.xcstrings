    "Your support means a lot. YapToText will keep getting better because of it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دعمك يعني الكثير. سيستمر YapToText في التحسن بفضله."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše podpora hodně znamená. Díky ní se YapToText bude dál zlepšovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din støtte betyder meget. YapToText bliver ved med at blive bedre takket være den."
