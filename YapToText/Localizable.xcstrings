        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть %@, щоб почати, натисніть ще раз, щоб зупинити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn %@ để bắt đầu, nhấn lại để dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻按 %@ 开始，再次轻按停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕按 %@ 開始，再按一次停止。"
          }
        }
      }
    },
    "Tap Right Command again. The text lands at your cursor.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ⌘ الأيمن مجدداً. يظهر النص عند المؤشر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte znovu na pravý Command. Text se objeví u kurzoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på højre Command igen. Teksten lander ved din markør."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe erneut auf die rechte Command-Taste. Der Text landet an deiner Einfügemarke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⌘ derecha de nuevo. El texto aparece en tu cursor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta oikeaa Commandia uudelleen. Teksti ilmestyy kohdistimeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez à nouveau sur ⌘ droite. Le texte apparaît à votre curseur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש שוב על ⌘ הימני. הטקסט מגיע למיקום הסמן."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints újra a jobb Command billentyűre. A szöveg a kurzorodnál kerül beszúrásra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Command Kanan lagi. Teks masuk di kursor Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca di nuovo ⌘ destro. Il testo appare al cursore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右 Command をもう一度押してください。テキストがカーソル位置に入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 Command를 다시 탭하세요. 텍스트가 커서 위치에 들어가요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk høyre Kommando igjen. Teksten havner ved markøren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik nogmaals op rechter Command. De tekst komt op je cursor terecht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ponownie prawy Command. Tekst trafi w kursor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ⌘ direito de novo. O texto cai no seu cursor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите правый Command ещё раз. Текст появится у курсора."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite znova na pravý Command. Text sa vloží na kurzor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på höger Command igen. Texten landar vid din markör."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ ⌘ ขวาอีกครั้ง ข้อความจะไปลงที่เคอร์เซอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağ Command'a tekrar dokunun. Metin imlecinize düşer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть праву Command ще раз. Текст з'явиться в курсорі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn ⌘ phải lần nữa. Văn bản hiện tại con trỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次轻按右 Command。文字会落在你的光标处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再輕按一次右側 Command。文字會出現在游標處。"
          }
        }
      }
    },
    "Tap Right Command and talk.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ⌘ الأيمن وتكلّم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na pravý Command a mluvte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på højre Command, og tal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die rechte Command-Taste und sprich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⌘ derecho y habla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta oikeaa Komentoa ja puhu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ⌘ droite et parlez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על ⌘ הימני ודבר."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a jobb Command billentyűre, és beszélj."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Command Kanan dan mulai bicara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ⌘ destro e parla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右 Command を押して話してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 Command를 탭하고 말하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk høyre Kommando og snakk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op rechter Command en praat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij prawy Command i mów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ⌘ direito e fale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите правый Command и говорите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na pravý Command a hovorte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på höger Command och prata."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ ⌘ ขวาแล้วพูด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağ Command'a dokunun ve konuşun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть праву ⌘ і говоріть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn ⌘ phải rồi nói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻按右 Command 键，然后开始说话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕敲右側 Command 並開始說話。"
          }
        }
      }
    },
    "Tap Right ⌘ anywhere on your Mac and start talking. Everything's changeable later in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ⌘ الأيمن في أي مكان على Mac وابدأ بالكلام. كل شيء قابل للتغيير لاحقاً في الإعدادات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na pravou ⌘ kdekoli na Macu a začněte mluvit. Vše lze později změnit v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på højre ⌘ hvor som helst på din Mac, og begynd at tale. Alt kan ændres senere under Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe irgendwo auf deinem Mac auf die rechte ⌘ und sprich los. Alles lässt sich später in den Einstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⌘ derecho en cualquier lugar de tu Mac y empieza a hablar. Todo se puede cambiar después en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta oikeaa ⌘:ta missä tahansa Macissasi ja ala puhua. Kaikkea voi muuttaa myöhemmin Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur ⌘ droite n'importe où sur votre Mac et commencez à parler. Tout se modifie plus tard dans Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על ⌘ הימני בכל מקום במחשב שלך והתחל לדבר. הכול ניתן לשינוי אחר כך בהגדרות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a jobb ⌘ billentyűre a Macen bárhol, és kezdj beszélni. Minden később a Beállításokban módosítható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk ⌘ Kanan di mana saja di Mac Anda dan mulai bicara. Semuanya bisa diubah nanti di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ⌘ destro ovunque sul tuo Mac e inizia a parlare. Tutto è modificabile più tardi nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac のどこでも右 ⌘ を押して話してください。すべての設定は後から変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 어디서든 오른쪽 ⌘를 탭하고 말을 시작하세요. 모든 설정은 나중에 설정에서 바꿀 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk høyre ⌘ hvor som helst på Macen og begynn å snakke. Alt kan endres senere i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op rechter ⌘ waar dan ook op je Mac en begin te praten. Alles is later te wijzigen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij prawy ⌘ w dowolnym miejscu na Macu i zacznij mówić. Wszystko można później zmienić w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ⌘ direito em qualquer lugar do seu Mac e comece a falar. Tudo pode ser alterado depois nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите правый ⌘ в любом месте на Mac и начинайте говорить. Всё можно изменить позже в настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na pravý ⌘ kdekoľvek na Macu a začnite hovoriť. Všetko sa dá neskôr zmeniť v Nastaveniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på höger ⌘ var som helst på din Mac och börja prata. Allt går att ändra senare i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ ⌘ ขวาที่ใดก็ได้บน Mac แล้วเริ่มพูด ทุกอย่างเปลี่ยนได้ในภายหลังในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizde herhangi bir yerde Sağ ⌘'ye dokunup konuşmaya başlayın. Her şey daha sonra Ayarlar'dan değiştirilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть праву ⌘ будь-де на Mac і починайте говорити. Усе можна змінити пізніше в Налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn ⌘ phải ở bất kỳ đâu trên Mac và bắt đầu nói. Mọi thứ có thể thay đổi sau trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 的任意位置轻按右 ⌘，然后开始说话。之后可在设置中更改所有内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上任何地方輕按右側 ⌘ 並開始說話。之後都可以在「設定」中變更。"
          }
        }
      }
    },
    "Tap Space mid-dictation to pause; tap it again to resume.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط Space أثناء الإملاء للإيقاف المؤقت، واضغطه مجدداً للاستئناف."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na Space během diktování pro pozastavení; klepnutím znovu pokračujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på mellemrum midt i en diktering for at pause; tryk igen for at genoptage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe während des Diktats auf Space, um zu pausieren; tippe erneut, um fortzusetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Espacio a mitad de un dictado para pausar; púlsalo de nuevo para reanudar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta välilyöntiä sanelun aikana keskeyttääksesi. Napauta uudelleen jatkaaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Space pendant la dictée pour la mettre en pause ; appuyez à nouveau pour reprendre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על Space באמצע הכתבה כדי להשהות; הקש שוב כדי להמשיך."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktálás közben koppints a Szóközre a szüneteltetéshez; újabb koppintás folytatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Space di tengah dikte untuk jeda; ketuk lagi untuk melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Spazio durante la dettatura per mettere in pausa; toccalo di nuovo per riprendere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディクテーション中に Space を押すと一時停止し、もう一度押すと再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰는 중에 Space를 탭하면 일시 정지하고, 다시 탭하면 재개해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk mellomrom midt i diktering for å pause; trykk igjen for å fortsette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik midden in een dictee op spatie om te pauzeren; tik opnieuw om te hervatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij Space w trakcie dyktowania, aby wstrzymać; naciśnij ponownie, aby wznowić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Espaço durante o ditado para pausar; toque de novo para retomar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите пробел во время диктовки, чтобы поставить на паузу, и ещё раз, чтобы продолжить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na Space počas diktovania na pozastavenie; ďalším ťuknutím pokračujte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på Space under diktering för att pausa; tryck igen för att återuppta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ Space ระหว่างพิมพ์ด้วยเสียงเพื่อหยุดชั่วคราว แตะอีกครั้งเพื่อทำต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklatmak için dikte sırasında Boşluk tuşuna dokunun; devam etmek için tekrar dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть Space під час диктовки, щоб призупинити; натисніть ще раз, щоб продовжити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn Dấu cách khi đang đọc chính tả để tạm dừng; nhấn lại để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听写过程中轻按 Space 暂停；再次轻按即可继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽寫途中輕按 Space 即可暫停；再按一次即可繼續。"
          }
        }
      }
    },
    "Tap a bare modifier key (like Right ⌘) to start and stop dictation": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مفتاح تعديل منفرداً (مثل ⌘ الأيمن) لبدء الإملاء وإيقافه"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na samostatnou modifikační klávesu (například pravou ⌘) spustíte a zastavíte diktování"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en nøgle alene (som højre ⌘) for at starte og stoppe diktering"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine einzelne Modifikatortaste (etwa die rechte ⌘), um das Diktat zu starten und zu stoppen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa una tecla modificadora sola (como ⌘ derecha) para iniciar y detener el dictado"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta pelkkää muokkausnäppäintä (kuten oikea ⌘) aloittaaksesi ja lopettaaksesi sanelun"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur une touche de modification seule (comme ⌘ droite) pour démarrer et arrêter la dictée"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על מקש שינוי בודד (כמו ⌘ הימני) כדי להתחיל ולעצור הכתבה"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy önálló módosítóbillentyűre (például a jobb ⌘-ra) a diktálás indításához és leállításához"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tombol modifier tunggal (seperti ⌘ Kanan) untuk memulai dan berhenti dikte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca da solo un tasto modificatore (come ⌘ destro) per avviare e fermare la dettatura"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キーだけ(右 ⌘ など)を押して、ディクテーションを開始・停止"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단독 수정자 키(예: 오른쪽 ⌘)를 탭해서 받아쓰기를 시작하고 멈추세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk en enkel modifikatortast (som høyre ⌘) for å starte og stoppe diktering"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een losse modifiertoets (zoals rechter ⌘) om dicteren te starten en te stoppen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij sam klawisz modyfikatora (na przykład prawy ⌘), aby rozpocząć i zatrzymać dyktowanie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma tecla modificadora sozinha (como ⌘ direito) para iniciar e parar o ditado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите одну модификаторную клавишу (например, правый ⌘), чтобы запустить и остановить диктовку"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na holý modifikačný kláves (napr. pravý ⌘) na spustenie a zastavenie diktovania"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en ren modifieringstangent (som höger ⌘) för att starta och stoppa diktering"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่มดัดแปลงเดี่ยว ๆ (เช่น ⌘ ขวา) เพื่อเริ่มและหยุดการพิมพ์ด้วยเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteyi başlatmak ve durdurmak için tek başına bir değiştirici tuşa (Sağ ⌘ gibi) dokunun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть окрему клавішу-модифікатор (наприклад, праву ⌘), щоб почати і зупинити диктовку"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn một phím bổ trợ trơn (như ⌘ phải) để bắt đầu và dừng đọc chính tả"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻按单独的修饰键（例如右 ⌘）即可开始和停止听写"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕按單獨的修飾鍵（例如右側 ⌘）即可開始與停止聽寫"
          }
        }
      }
    },
