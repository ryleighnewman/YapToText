    "Full large-v3 accuracy, quantized to save space. Slower than Turbo.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دقة large-v3 كاملة، مضغوطة لتوفير المساحة. أبطأ من Turbo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plná přesnost large-v3, kvantizovaná pro úsporu místa. Pomalejší než Turbo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuld large-v3-præcision, kvantiseret for at spare plads. Langsommere end Turbo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Volle Genauigkeit von large-v3, quantisiert, um Platz zu sparen. Langsamer als Turbo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisión completa de large-v3, cuantizada para ahorrar espacio. Más lento que Turbo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täysi large-v3-tarkkuus, kvantisoituna tilan säästämiseksi. Hitaampi kuin Turbo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Précision complète de large-v3, quantifiée pour gagner de la place. Plus lent que Turbo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דיוק מלא של large-v3, מכווץ כדי לחסוך מקום. איטי יותר מ-Turbo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes large-v3 pontosság, helytakarékos kvantálással. Lassabb, mint a Turbo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akurasi large-v3 penuh, dikuantisasi untuk menghemat ruang. Lebih lambat dari Turbo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisione completa di large-v3, quantizzata per risparmiare spazio. Più lento di Turbo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "large-v3 の精度をそのまま、容量を抑えて量子化したものです。Turbo より遅くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용량을 줄이도록 양자화한 large-v3의 전체 정확도. Turbo보다 느려요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Full nøyaktighet i large-v3, kvantisert for å spare plass. Tregere enn Turbo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volledige large-v3 nauwkeurigheid, gekwantiseerd om ruimte te besparen. Trager dan Turbo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełna dokładność large-v3, skwantowana, aby oszczędzać miejsce. Wolniejszy niż Turbo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisão total do large-v3, quantizado para economizar espaço. Mais lento que o Turbo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полная точность large-v3, квантованная для экономии места. Медленнее Turbo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plná presnosť large-v3, kvantizovaná na úsporu miesta. Pomalšie ako Turbo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Full träffsäkerhet från large-v3, kvantiserad för att spara utrymme. Långsammare än Turbo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความแม่นยำเต็มของ large-v3 ลดขนาดด้วยการควอนไทซ์เพื่อประหยัดพื้นที่ ช้ากว่า Turbo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam large-v3 doğruluğu, yer kazanmak için nicemlenmiş. Turbo'dan daha yavaş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повна точність large-v3, квантована для економії місця. Повільніше за Turbo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ chính xác đầy đủ của large-v3, được lượng tử hóa để tiết kiệm dung lượng. Chậm hơn Turbo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整的 large-v3 精度，经过量化以节省空间。比 Turbo 慢。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完整的 large-v3 準確度，經量化以節省空間。比 Turbo 慢。"
          }
        }
      }
    },
    "Full turbo model. High accuracy, multilingual, fast on Apple Silicon.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نموذج Turbo الكامل. دقة عالية، متعدد اللغات، وسريع على Apple Silicon."
          }
        },
        "cs": {
          "stringUnit": {
