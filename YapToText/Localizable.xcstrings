    "Name this mode and how it appears.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سمِّ هذا الوضع وحدد طريقة ظهوره."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojmenujte tento režim a určete, jak se zobrazí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Navngiv denne tilstand, og hvordan den vises."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benenne diesen Modus und lege fest, wie er angezeigt wird."
