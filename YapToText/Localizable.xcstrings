          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצבים, אוטומטי וניקוי AI רצים אחרי כל תמלול."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módok, az automatikus mód és az AI tisztítás minden átírás után fut."
          }
        },
        "id": {
          "stringUnit": {
