    "Snippets paste whole blocks of text: addresses, sign-offs, links. Live tokens work in the Inserts box: {date}, {time}, and {clipboard}.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُلصق المقتطفات كتلاً كاملة من النص: العناوين والخواتيم والروابط. تعمل الرموز الحية في مربع الإدراجات: {date} و{time} و{clipboard}."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úryvky vkládají celé bloky textu: adresy, závěrečné pozdravy, odkazy. Živé značky fungují v poli Vložení: {date}, {time} a {clipboard}."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uddrag indsætter hele tekstblokke: adresser, afslutninger, links. Live-koder virker i feltet Indsæt: {date}, {time} og {clipboard}."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Textbausteine fügen ganze Textblöcke ein: Adressen, Grußformeln, Links. Live-Platzhalter funktionieren im Feld Einfügungen: {date}, {time} und {clipboard}."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fragmentos pegan bloques enteros de texto: direcciones, despedidas, enlaces. Las etiquetas en vivo funcionan en el cuadro Insertos: {date}, {time} y {clipboard}."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikatekstit liittävät kokonaisia tekstilohkoja: osoitteita, lopetuksia, linkkejä. Eläviä merkkejä toimii Lisäykset-kentässä: {date}, {time} ja {clipboard}."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les extraits collent des blocs de texte entiers : adresses, formules de politesse, liens. Les jetons dynamiques fonctionnent dans la zone Insertions : {date}, {time} et {clipboard}."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קטעים מדביקים בלוקים שלמים של טקסט: כתובות, סיומות, קישורים. טוקנים חיים עובדים בתיבת ההוספות: {date}, {time}, ו-{clipboard}."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szövegrészletek egész szövegblokkokat illesztenek be: címeket, záró formulákat, linkeket. Az élő jelölők a Beszúrások mezőben működnek: {date}, {time} és {clipboard}."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuplikan menempelkan blok teks utuh: alamat, penutup, tautan. Token langsung bekerja di kotak Sisipan: {date}, {time}, dan {clipboard}."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli snippet incollano interi blocchi di testo: indirizzi, firme, link. I token dinamici funzionano nella casella Inserimenti: {date}, {time} e {clipboard}."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スニペットは住所、結びの言葉、リンクなど、まとまったテキストを貼り付けます。挿入欄では、{date}、{time}、{clipboard} のライブトークンが使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스니펫은 주소, 맺음말, 링크 같은 텍스트 덩어리를 붙여넣어요. 삽입 상자에서 {date}, {time}, {clipboard} 같은 실시간 토큰을 쓸 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snutter limer inn hele tekstblokker: adresser, avslutninger, lenker. Levende koder fungerer i feltet Innsettinger: {date}, {time} og {clipboard}."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snippets plakken hele tekstblokken: adressen, afsluitingen, links. Live-tokens werken in het vak Invoegingen: {date}, {time} en {clipboard}."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragmenty wklejają całe bloki tekstu: adresy, podpisy, linki. Działające znaczniki w polu Wstawki: {date}, {time} i {clipboard}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trechos colam blocos inteiros de texto: endereços, despedidas, links. Os tokens ao vivo funcionam na caixa Inserções: {date}, {time} e {clipboard}."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сниппеты вставляют целые блоки текста: адреса, подписи, ссылки. В поле вставок работают живые метки: {date}, {time} и {clipboard}."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Úryvky vkladajú celé bloky textu: adresy, záverečné pozdravy, odkazy. Živé značky fungujú v poli Vložky: {date}, {time} a {clipboard}."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snippets klistrar in hela textblock: adresser, avslutningar, länkar. Liveplatshållare fungerar i rutan Infogningar: {date}, {time} och {clipboard}."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวย่อข้อความจะวางทั้งบล็อกของข้อความ เช่น ที่อยู่ คำลงท้าย และลิงก์ โทเค็นสดใช้ได้ในช่องแทรก: {date} {time} และ {clipboard}"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa metinler adresler, kapanışlar ve bağlantılar gibi metin bloklarını yapıştırır. Ekle kutusunda canlı belirteçler çalışır: {date}, {time} ve {clipboard}."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сніпети вставляють цілі блоки тексту: адреси, підписи, посилання. У полі «Вставки» працюють живі маркери: {date}, {time} і {clipboard}."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đoạn mẫu dán cả khối văn bản: địa chỉ, lời kết, liên kết. Các thẻ động dùng được trong ô Chèn: {date}, {time} và {clipboard}."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "片段会粘贴整段文字：地址、结尾语、链接。“插入”框中支持实时标记：{date}、{time} 和 {clipboard}。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "片段會貼上整段文字，例如地址、結尾敬語與連結。「插入」欄位中可使用即時代碼：{date}、{time} 與 {clipboard}。"
          }
        }
      }
    },
    "So I made the dictation app of my dreams: free, fully on device, and endlessly customizable. I hope it's helpful for you too. If you run into any problems, or have suggestions, please let me know.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لذلك صنعتُ تطبيق الإملاء الذي كنت أحلم به: مجاني، يعمل بالكامل على الجهاز، وقابل للتخصيص بلا حدود. آمل أن يفيدك أيضاً. إن واجهت أي مشكلة أو لديك اقتراحات، فأخبرني."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořil jsem tedy aplikaci pro diktování ze svých snů: zdarma, plně na zařízení a nekonečně přizpůsobitelnou. Doufám, že bude užitečná i pro vás. Pokud narazíte na problém nebo budete mít návrhy, dejte mi vědět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Så jeg lavede drømmeappen til diktering: gratis, helt på enheden og uendeligt tilpasselig. Jeg håber, den også hjælper dig. Hvis du støder på problemer eller har forslag, så lad mig vide det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Also habe ich die Diktier-App meiner Träume gebaut: kostenlos, komplett auf dem Gerät und endlos anpassbar. Ich hoffe, sie hilft dir auch. Wenn dir Probleme begegnen oder du Vorschläge hast, sag mir bitte Bescheid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así que creé la app de dictado de mis sueños: gratuita, completamente en el dispositivo y personalizable sin límite. Espero que también te sirva. Si encuentras algún problema o tienes sugerencias, avísame."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tein siis unelmieni sanelusovelluksen: ilmainen, täysin laitteella toimiva ja loputtomasti muokattavissa. Toivon, että siitä on apua myös sinulle. Jos törmäät ongelmiin tai sinulla on ehdotuksia, kerro minulle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai donc créé l'app de dictée de mes rêves : gratuite, entièrement locale et infiniment personnalisable. J'espère qu'elle vous sera utile aussi. Si vous rencontrez un problème ou avez une suggestion, faites-le-moi savoir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אז יצרתי את אפליקציית ההכתבה של החלומות שלי: חינמית, פועלת כולה על המכשיר, וניתנת להתאמה אישית ללא סוף. מקווה שהיא תעזור גם לך. אם תיתקל בבעיות או יש לך הצעות, אנא ספר לי."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Így készítettem el álmaim diktálóalkalmazását: ingyenes, teljes egészében helyi és végtelenül testreszabható. Remélem, neked is hasznos lesz. Ha problémába ütközöl, vagy van javaslatod, kérlek, jelezd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadi saya membuat aplikasi dikte impian saya: gratis, sepenuhnya di perangkat, dan bisa disesuaikan tanpa batas. Semoga juga berguna bagi Anda. Jika menemukan masalah atau punya saran, silakan beri tahu saya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così ho creato l'app di dettatura dei miei sogni: gratuita, interamente sul dispositivo e personalizzabile all'infinito. Spero sia utile anche a te. Se incontri problemi o hai suggerimenti, fammelo sapere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そこで、理想のディクテーションアプリを作りました。無料で、完全にデバイス上で動作し、どこまでもカスタマイズできます。お役に立てば嬉しいです。問題や提案があれば、ぜひお知らせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래서 꿈꾸던 받아쓰기 앱을 만들었어요. 무료이고, 전부 기기 안에서 돌아가고, 끝없이 바꿀 수 있어요. 여러분에게도 도움이 되면 좋겠어요. 문제가 생기거나 제안이 있으면 알려 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Så jeg laget diktering-appen jeg drømte om: gratis, helt på enheten og uendelig tilpassbar. Jeg håper den hjelper deg også. Hvis du støter på problemer eller har forslag, si fra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dus heb ik de dicteer-app van mijn dromen gemaakt: gratis, volledig op het apparaat en eindeloos aanpasbaar. Ik hoop dat hij ook voor jou nuttig is. Als je problemen tegenkomt of suggesties hebt, laat het me weten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stworzyłem więc aplikację do dyktowania moich marzeń: bezpłatną, w pełni działającą na urządzeniu i dającą się dowolnie dostosować. Mam nadzieję, że i Tobie się przyda. Jeśli napotkasz problemy albo będziesz mieć sugestie, daj mi znać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Então criei o app de ditado dos meus sonhos: gratuito, totalmente no dispositivo e infinitamente personalizável. Espero que também seja útil para você. Se tiver algum problema ou sugestão, me avise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так я создал приложение для диктовки своей мечты: бесплатное, работающее полностью на устройстве и безгранично настраиваемое. Надеюсь, оно пригодится и вам. Если возникнут проблемы или будут предложения, сообщите мне."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vznikla aplikácia na diktovanie zo snov: zadarmo, úplne v zariadení a nekonečne prispôsobiteľná. Dúfam, že pomôže aj vám. Ak narazíte na problémy alebo máte návrhy, dajte vedieť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Så jag byggde diktappen av mina drömmar: gratis, helt på enheten och oändligt anpassningsbar. Jag hoppas att den hjälper dig också. Om du stöter på problem eller har förslag, säg gärna till."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันจึงสร้างแอปพิมพ์ด้วยเสียงในฝันของฉัน: ฟรี ทำงานบนอุปกรณ์ทั้งหมด และปรับแต่งได้ไม่สิ้นสุด ฉันหวังว่ามันจะมีประโยชน์กับคุณเช่นกัน หากพบปัญหาหรือมีข้อเสนอแนะ โปรดแจ้งให้ฉันทราบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ben de hayallerimdeki dikte uygulamasını yaptım: ücretsiz, tamamen cihaz içinde ve sonsuz şekilde özelleştirilebilir. Sizin için de yardımcı olmasını umuyorum. Bir sorunla karşılaşırsanız ya da önerileriniz olursa lütfen bana bildirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тож я створив застосунок для диктовки своєї мрії: безкоштовний, повністю на пристрої і безмежно налаштовуваний. Сподіваюся, він буде корисним і для вас. Якщо виникнуть проблеми або пропозиції, будь ласка, напишіть мені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vậy là tôi đã làm ứng dụng đọc chính tả mơ ước của mình: miễn phí, chạy hoàn toàn trên thiết bị và tùy biến không giới hạn. Mong nó cũng hữu ích với bạn. Nếu gặp vấn đề hay có góp ý, hãy cho tôi biết nhé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "于是我做出了我梦想中的听写应用：免费、完全在本机运行，并且可以无限定制。希望它对你也有帮助。如果你遇到任何问题或有建议，请告诉我。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所以我做出了夢想中的聽寫 App：免費、完全在裝置端運作，並且可以無限自訂。希望它對你也有幫助。如果你遇到任何問題或有建議，請告訴我。"
          }
        }
      }
    },
    "So back-to-back dictations don't run together. History keeps the text without the extra space.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى لا تتداخل الإملاءات المتتالية. يحتفظ السجل بالنص دون المسافة الإضافية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby se po sobě jdoucí diktáty nespojovaly, historie uchovává text bez přebytečné mezery."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Så dikteringer lige efter hinanden ikke løber sammen. Historikken gemmer teksten uden det ekstra mellemrum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit aufeinanderfolgende Diktate nicht zusammenlaufen. Der Verlauf speichert den Text ohne das zusätzliche Leerzeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que los dictados seguidos no se junten. El Historial conserva el texto sin el espacio extra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotta peräkkäiset sanelut eivät yhdy, historia säilyttää tekstin ilman ylimääräistä välilyöntiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que les dictées consécutives ne se collent pas. L'historique conserve le texte sans l'espace supplémentaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כך שהכתבות רצופות לא ייצמדו זו לזו. ההיסטוריה שומרת את הטקסט בלי הרווח הנוסף."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Így az egymás utáni diktálások nem olvadnak össze. Az előzmények a szöveget a plusz szóköz nélkül őrzik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agar dikte berurutan tidak menyatu. Riwayat menyimpan teks tanpa spasi tambahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così due dettature consecutive non si fondono. La Cronologia conserva il testo senza lo spazio in più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続するディクテーションが続けて繋がらないようにしています。履歴には余分な空白を除いたテキストが残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연속 받아쓰기가 붙지 않도록 해요. 기록에는 추가 공백 없이 텍스트가 남아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Så dikteringer etter hverandre ikke glir sammen. Historikken beholder teksten uten det ekstra mellomrommet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodat opeenvolgende dictees niet aan elkaar plakken. De geschiedenis bewaart de tekst zonder de extra spatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby dyktowania jedno po drugim się nie łączyły. Historia zachowuje tekst bez dodatkowej spacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que ditados seguidos não se juntem. O Histórico guarda o texto sem o espaço extra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы диктовки, идущие подряд, не слипались. В истории текст сохраняется без лишнего пробела."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby sa po sebe idúce diktáty nespájali. História uchová text bez extra medzery."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Så att dikteringar efter varandra inte rinner ihop. Historiken behåller texten utan det extra mellanslaget."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อไม่ให้การพิมพ์ด้วยเสียงที่ต่อกันติดกันรวมเป็นก้อนเดียว ประวัติจะเก็บข้อความโดยไม่มีช่องว่างเพิ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Böylece arka arkaya yapılan dikteler birbirine karışmaz. Geçmiş, metni fazladan boşluk olmadan saklar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб диктовки, що йдуть одна за одною, не зливалися. В історії текст зберігається без зайвого пробілу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để các lần đọc chính tả liền nhau không bị dính. Lịch sử giữ văn bản không có khoảng trắng thêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这样连续听写的内容就不会粘连在一起。历史记录中会保留不带多余空格的文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如此一來，連續的聽寫內容就不會黏在一起。紀錄中會保留不含多餘空格的文字。"
          }
        }
      }
    },
    "Some apps beep when this reads your cursor. Turning Alert volume down in Sound settings silences it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض التطبيقات تصدر صوتاً عندما يقرأ هذا المؤشر. خفض مستوى صوت التنبيه في إعدادات الصوت يُسكته."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé aplikace pípají, když toto čte kurzor. Ztlumení hlasitosti upozornění v nastavení Zvuku to umlčí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle apps bipper, når denne læser din markør. Skruer du ned for Advarselslydstyrke i Lydindstillinger, bliver det tyst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Apps piepen, wenn dies die Einfügemarke liest. Die Warnlautstärke in den Toneinstellungen zu senken, stellt es ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas apps emiten un pitido cuando esto lee tu cursor. Bajar el volumen de alertas en los ajustes de Sonido lo silencia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotkin sovellukset piippaavat, kun tämä lukee kohdistimen. Hälytysäänen hiljentäminen Ääni-asetuksissa hiljentää sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines apps émettent un bip quand elle lit votre curseur. Baisser le volume des alertes dans les réglages Son le fait taire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק מהאפליקציות מצפצפות כשזה קורא את הסמן. הנמכת עוצמת ההתראות בהגדרות הצליל משתיקה את זה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyes alkalmazások sípolnak, amikor ez olvassa a kurzort. A Figyelmeztető hangerő csökkentésével a hangbeállításokban ez elnémul."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa aplikasi berbunyi bip saat ini membaca kursor Anda. Menurunkan Volume peringatan di pengaturan Suara akan membungkamnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune app emettono un bip quando questo legge il cursore. Abbassare il Volume avvisi nelle Impostazioni audio lo silenzia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカーソル読み取り時にビープ音が鳴るアプリがあります。サウンド設定でアラート音量を下げると消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기능이 커서를 읽을 때 일부 앱에서 삐 소리가 나요. 사운드 설정에서 알림 음량을 낮추면 조용해져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen apper piper når denne leser markøren. Å skru ned Varselvolum i Lydinnstillinger stopper det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige apps piepen wanneer dit je cursor leest. Het Waarschuwingsvolume lager zetten in Geluidsinstellingen zwijgt dat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre aplikacje emitują dźwięk, gdy to odczytuje kursor. Wyciszenie Głośności alertów w ustawieniach dźwięku to wyłącza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns apps emitem bipes quando isto lê seu cursor. Diminuir o volume de Alerta nos ajustes de Som silencia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые приложения издают звук, когда это читает курсор. Уменьшение громкости оповещений в настройках звука отключит его."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektoré aplikácie pípnu, keď toto číta kurzor. Stíšenie hlasitosti upozornení v Nastaveniach zvuku to vypne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa appar piper när den här läser din markör. Att sänka Varningsvolym i Ljudinställningar tystar det."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บางแอปจะส่งเสียงบี๊ปเมื่อการอ่านนี้อ่านเคอร์เซอร์ ลดระดับเสียงแจ้งเตือนในการตั้งค่าเสียงจะทำให้เงียบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, imlecinizi okuduğunda bazı uygulamalar bip sesi çıkarır. Ses ayarlarında Uyarı sesini kısmak bunu susturur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі програми пищать, коли це читає курсор. Зменшення гучності сповіщень у налаштуваннях звуку це вимикає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số ứng dụng kêu bíp khi nó đọc con trỏ. Giảm Âm lượng cảnh báo trong Cài đặt âm thanh sẽ tắt tiếng đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某些应用在它读取你的光标时会发出提示音。在“声音”设置中调低提示音量即可消除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "某些 App 在此功能讀取游標時會發出嗶聲。在「聲音」設定中將提醒音量調低即可消除。"
          }
        }
      }
    },
