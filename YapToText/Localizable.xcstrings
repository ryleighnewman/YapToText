    "Everything you can press.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما يمكنك الضغط عليه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše, co lze stisknout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt, du kan trykke på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du drücken kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que puedes pulsar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki, mitä voit painaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous pouvez appuyer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מה שאפשר ללחוץ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden, amit megnyomhatsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang bisa ditekan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che puoi premere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押せるものすべて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누를 수 있는 모든 것."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt du kan trykke på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat je kunt indrukken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, co możesz nacisnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que você pode pressionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что можно нажать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko, čo sa dá stlačiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt du kan trycka på."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกปุ่มที่กดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basabileceğiniz her şey."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе, що можна натиснути."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ bạn có thể nhấn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有可以按下的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有可以按下的按鍵。"
          }
        }
      }
    },
    "Everything you've configured: modes, dictionaries, commands, AI actions, and settings. History is never included.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما قمت بإعداده: الأوضاع والقواميس والأوامر وإجراءات الذكاء الاصطناعي والإعدادات. لا يُدرج السجل أبداً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše, co jste nastavili: režimy, slovníky, příkazy, akce AI a nastavení. Historie se nikdy nezahrnuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt du har sat op: tilstande, ordbøger, kommandoer, AI-handlinger og indstillinger. Historik er aldrig med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du eingerichtet hast: Modi, Wörterbücher, Befehle, KI-Aktionen und Einstellungen. Der Verlauf ist nie enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que has configurado: modos, diccionarios, comandos, acciones de IA y ajustes. El historial nunca se incluye."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki määrittämäsi: tilat, sanastot, komennot, AI-toiminnot ja asetukset. Historiaa ei sisällytetä koskaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous avez configuré : modes, dictionnaires, commandes, actions IA et réglages. L'historique n'est jamais inclus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מה שהגדרת: מצבים, מילונים, פקודות, פעולות AI והגדרות. ההיסטוריה אף פעם לא נכללת."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden, amit beállítottál: módok, szótárak, parancsok, AI műveletek és beállítások. Az előzmények soha nincsenek benne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang sudah Anda atur: mode, kamus, perintah, aksi AI, dan pengaturan. Riwayat tidak pernah disertakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che hai configurato: modalità, dizionari, comandi, azioni IA e impostazioni. La cronologia non viene mai inclusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定したもの(モード、辞書、コマンド、AI アクション、各種設定)です。履歴は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정한 모든 항목: 모드, 사전, 명령, AI 작업, 설정. 기록은 포함되지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt du har satt opp: moduser, ordlister, kommandoer, KI-handlinger og innstillinger. Historikk er aldri med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat je hebt ingesteld: modi, woordenlijsten, opdrachten, AI-acties en instellingen. Geschiedenis wordt nooit meegenomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, co skonfigurowano: tryby, słowniki, polecenia, akcje AI i ustawienia. Historia nigdy nie jest dołączana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que você configurou: modos, dicionários, comandos, ações de IA e ajustes. O histórico nunca é incluído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что вы настроили: режимы, словари, команды, действия с ИИ и настройки. История никогда не включается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko, čo ste nastavili: režimy, slovníky, príkazy, akcie AI a nastavenia. História sa nikdy nezahŕňa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt du har ställt in: lägen, ordlistor, kommandon, AI-åtgärder och inställningar. Historiken tas aldrig med."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างที่คุณตั้งค่าไว้: โหมด พจนานุกรม คำสั่ง การทำงานของ AI และการตั้งค่า ประวัติจะไม่รวมอยู่ด้วยเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapılandırdığınız her şey: modlar, sözlükler, komutlar, YZ eylemleri ve ayarlar. Geçmiş hiçbir zaman dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе налаштоване: режими, словники, команди, дії ШІ і налаштування. Історія ніколи не включається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ bạn đã thiết lập: chế độ, từ điển, lệnh, hành động AI và cài đặt. Lịch sử không bao giờ được đưa vào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已配置的全部内容：模式、词典、命令、AI 操作和设置。不包括历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你設定過的所有內容：模式、字典、指令、AI 動作與設定。紀錄永遠不會包含在內。"
          }
        }
      }
    },
    "Exact requests like “capitalize this” or “change this to hearing aids” are instant and skip the AI.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الطلبات الدقيقة مثل “اكتب هذا بالأحرف الكبيرة” أو “غيّر هذا إلى سماعات الأذن الطبية” تُنفَّذ فوراً وتتجاوز الذكاء الاصطناعي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesné požadavky jako „capitalize this“ nebo „change this to hearing aids“ jsou okamžité a obejdou AI."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Præcise anmodninger som “capitalize this” eller “change this to hearing aids” sker med det samme og springer AI'en over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genaue Anweisungen wie „capitalize this“ oder „change this to hearing aids“ wirken sofort und umgehen die KI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las peticiones exactas como “pon esto en mayúscula” o “cambia esto por audífonos” son instantáneas y omiten la IA."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkat pyynnöt, kuten ”capitalize this” tai ”change this to hearing aids”, toteutuvat heti ja ohittavat tekoälyn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes exactes comme “mets ça en majuscules” ou “remplace ceci par prothèses auditives” sont instantanées et évitent l'IA."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקשות מדויקות כמו “capitalize this” או “change this to hearing aids” מתבצעות מיד ודולגות על ה-AI."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pontos kérések, mint a „capitalize this” vagy a „change this to hearing aids”, azonnal lefutnak, és kihagyják az AI-t."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan persis seperti “capitalize this” atau “change this to hearing aids” langsung dijalankan dan melewati AI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le richieste esatte come “capitalize this” o “change this to hearing aids” sono immediate e saltano l'IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「capitalize this」や「change this to hearing aids」のような完全一致の指示は即座に実行され、AI は使いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“capitalize this”나 “change this to hearing aids” 같은 정확한 요청은 즉시 처리되고 AI를 거치지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksakte forespørsler som «capitalize this» eller «change this to hearing aids» er umiddelbare og hopper over KI-en."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Exacte verzoeken zoals “capitalize this” of “change this to hearing aids” zijn direct en slaan de AI over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokładne polecenia, jak „zapisz to wielką literą” albo „zmień to na aparaty słuchowe”, działają natychmiast i pomijają AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedidos exatos como “colocar isto em maiúscula” ou “mudar isto para aparelhos auditivos” são instantâneos e dispensam a IA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точные запросы вроде «сделай заглавной» или «замени на слуховые аппараты» выполняются мгновенно и без ИИ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Presné požiadavky ako „toto veľkým písmenom“ alebo „zmeň toto na sluchadlá“ sú okamžité a obchádzajú AI."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exakta önskemål som ”skriv det här med versal” eller ”ändra det här till hörapparater” är omedelbara och hoppar över AI:n."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำสั่งตรงตัว เช่น “ทำเป็นตัวพิมพ์ใหญ่” หรือ “เปลี่ยนเป็นเครื่องช่วยฟัง” จะทำทันทีและข้าม AI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“bunu büyük harfle yaz” ya da “bunu işitme cihazları yap” gibi tam istekler anında gerçekleşir ve YZ'yi atlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Точні запити на кшталт «зроби першу літеру великою» або «зміни це на слухові апарати» виконуються миттєво і оминають ШІ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các yêu cầu chính xác như “viết hoa cái này” hoặc “đổi cái này thành máy trợ thính” diễn ra tức thì và bỏ qua AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像“capitalize this”或“change this to hearing aids”这样的精确指令会立即执行，并跳过 AI。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "像「capitalize this」或「change this to hearing aids」這類完全相符的請求會立即執行，並略過 AI。"
          }
        }
      }
    },
