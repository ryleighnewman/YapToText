    "Ready instantly for the next dictation. The mic indicator stays on while warm.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جاهز فوراً للإملاء التالي. يبقى مؤشر الميكروفون مضاءً أثناء الاستعداد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Okamžitě připraveno pro další diktát. Indikátor mikrofonu svítí, dokud je teplý."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klar med det samme til næste diktering. Mikrofonindikatoren er tændt, mens den er varm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sofort bereit für das nächste Diktat. Die Mikrofonanzeige bleibt an, solange es warm gehalten wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo al instante para el siguiente dictado. El indicador del micrófono permanece encendido mientras está activo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmis heti seuraavaan sanelun. Mikrofonin merkkivalo pysyy päällä lämpimänä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt instantanément pour la prochaine dictée. L'indicateur du micro reste allumé pendant la mise en veille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוכן מיד להכתבה הבאה. נורית המיקרופון נשארת דלוקה כשהוא חם."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő diktálásra azonnal kész. A mikrofonjelző addig világít, amíg melegen tartjuk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siap seketika untuk dikte berikutnya. Indikator mikrofon tetap menyala saat hangat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto subito per la prossima dettatura. L'indicatore del microfono resta acceso mentre è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のディクテーションにすぐ備えます。待機中はマイクのインジケーターが点灯したままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 받아쓰기를 바로 시작할 수 있어요. 대기 중에는 마이크 표시등이 켜져 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klar med én gang til neste diktering. Mikrofonindikatoren er på mens den er varm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct klaar voor het volgende dictee. De microfooniindicator blijft aan zolang hij warm is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe od razu na następne dyktowanie. Wskaźnik mikrofonu świeci się, gdy jest w gotowości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto na hora para o próximo ditado. O indicador do microfone fica ligado enquanto aquecido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мгновенно готов к следующей диктовке. Индикатор микрофона горит, пока он наготове."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Okamžite pripravené na ďalší diktát. Indikátor mikrofónu svieti, kým je pripravený."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redo direkt för nästa diktering. Mikrofonindikatorn är på medan den är varm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พร้อมทันทีสำหรับการพิมพ์ด้วยเสียงครั้งถัดไป ตัวบอกสถานะไมค์จะเปิดค้างไว้ขณะอุ่นเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki dikte için anında hazır. Sıcak tutulurken mikrofon göstergesi açık kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Миттєво готовий до наступної диктовки. Індикатор мікрофона горить, поки він активний."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẵn sàng ngay cho lần đọc chính tả tiếp theo. Đèn micrô vẫn bật khi đang ấm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为下一次听写即时就绪。麦克风指示灯会在预热期间保持开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次聽寫可立即使用。待命時，麥克風指示燈會保持亮起。"
          }
        }
      }
    },
