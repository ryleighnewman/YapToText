    "Which microphone YapToText listens to. If the chosen one is unplugged, it falls back to the system default.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الميكروفون الذي يستمع إليه YapToText. إن تم فصل الميكروفون المختار، يعود إلى الافتراضي للنظام."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Který mikrofon YapToText poslouchá. Pokud je vybraný odpojen, přepne se na výchozí systémový."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken mikrofon YapToText lytter til. Hvis den valgte er afbrudt, falder den tilbage til systemstandarden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf welches Mikrofon YapToText hört. Ist das gewählte abgesteckt, wird auf den Systemstandard zurückgegriffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué micrófono escucha YapToText. Si el elegido se desconecta, vuelve al predeterminado del sistema."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä mikrofonia YapToText kuuntelee. Jos valittu mikrofoni irrotetaan, käytetään järjestelmän oletusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le microphone écouté par YapToText. Si celui choisi est débranché, l'app revient à celui par défaut du système."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאיזה מיקרופון YapToText מקשיב. אם המיקרופון שנבחר מנותק, הוא חוזר לברירת המחדל של המערכת."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Melyik mikrofont hallgassa a YapToText. Ha a kiválasztott nincs csatlakoztatva, a rendszer alapértelmezettjére vált."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon yang didengarkan YapToText. Jika yang dipilih dicabut, aplikasi kembali ke default sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono che ascolta YapToText. Se quello scelto viene scollegato, si torna al predefinito di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText が聞き取るマイクです。選んだマイクが外れている場合は、システムの既定に切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText가 듣는 마이크예요. 선택한 마이크를 분리하면 시스템 기본값으로 돌아가요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken mikrofon YapToText lytter til. Hvis den valgte er frakoblet, faller den tilbake til systemstandarden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar welke microfoon YapToText luistert. Als de gekozen microfoon is losgekoppeld, valt het terug op de systeemstandaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Którego mikrofonu słucha YapToText. Jeśli wybrany zostanie odłączony, przełączy się na domyślny systemowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual microfone o YapToText usa para ouvir. Se o escolhido for desconectado, ele volta ao padrão do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какой микрофон слушает YapToText. Если выбранный отключён, используется системный по умолчанию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ktorý mikrofón YapToText počúva. Ak je zvolený odpojený, prepne sa na predvolený systémový."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilken mikrofon YapToText lyssnar på. Om den valda kopplas bort faller den tillbaka till systemets standard."
          }
        },
        "th": {
