          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nový jazyk se zobrazí po restartu YapToText."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det nye sprog vises, når YapToText genstarter."
