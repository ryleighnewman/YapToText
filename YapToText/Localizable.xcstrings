    "This app is loaded with customizability and deeper features, but all you have to do is tap %@ and talk. Everything on the left is optional.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا التطبيق مليء بخيارات التخصيص والميزات المتقدمة، لكن كل ما عليك فعله هو الضغط على %@ والتكلم. كل ما على اليسار اختياري."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato aplikace má hodně možností přizpůsobení a pokročilých funkcí, ale stačí klepnout na %@ a mluvit. Vše vlevo je volitelné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne app er fyldt med tilpasningsmuligheder og dybere funktioner, men alt du skal gøre er at trykke på %@ og tale. Alt til venstre er valgfrit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App bietet viele Anpassungsmöglichkeiten und tiefere Funktionen, aber du musst nur %@ antippen und sprechen. Alles auf der linken Seite ist optional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app tiene muchas opciones personalizables y funciones avanzadas, pero solo tienes que pulsar %@ y hablar. Todo lo de la izquierda es opcional."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus on täynnä muokattavuutta ja syvempiä ominaisuuksia, mutta sinun tarvitsee vain napauttaa %@ ja puhua. Kaikki vasemmalla on vapaaehtoista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app regorge de personnalisation et de fonctions avancées, mais il vous suffit d'appuyer sur %@ et de parler. Tout ce qui se trouve à gauche est facultatif."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה מלאה באפשרויות התאמה ותכונות מעמיקות, אבל כל מה שצריך זה להקיש על %@ ולדבר. כל מה שבצד שמאל הוא אופציונלי."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az alkalmazás sok testreszabási és mélyebb funkciót tartalmaz, de neked csak a(z) %@ billentyűt kell megkoppintanod, és beszélned. A bal oldali minden opcionális."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ini penuh dengan opsi penyesuaian dan fitur yang lebih dalam, tetapi Anda cukup mengetuk %@ dan bicara. Semua yang di sebelah kiri bersifat opsional."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app è ricca di personalizzazioni e funzioni avanzate, ma ti basta toccare %@ e parlare. Tutto ciò che si trova a sinistra è facoltativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリには、多彩なカスタマイズと高度な機能がありますが、%@ を押して話すだけで使えます。左側の項目はすべて任意です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱에는 사용자 지정 기능과 고급 기능이 많지만, 할 일은 %@을(를) 탭하고 말하는 것뿐이에요. 왼쪽의 모든 항목은 선택 사항이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne appen har mange tilpasningsmuligheter og dypere funksjoner, men alt du trenger å gjøre er å trykke %@ og snakke. Alt til venstre er valgfritt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze app zit boordevol aanpassingsmogelijkheden en diepere functies, maar je hoeft alleen op %@ te tikken en te praten. Alles aan de linkerkant is optioneel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta aplikacja ma mnóstwo opcji i głębszych funkcji, ale wystarczy, że stukniesz %@ i zaczniesz mówić. Wszystko po lewej jest opcjonalne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app tem muita personalização e recursos mais profundos, mas tudo o que você precisa fazer é tocar em %@ e falar. Tudo à esquerda é opcional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом приложении много настроек и дополнительных функций, но достаточно нажать %@ и говорить. Всё слева необязательно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto aplikácia má veľa možností prispôsobenia a pokročilých funkcií, ale stačí ťuknúť na %@ a rozprávať. Všetko vľavo je voliteľné."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här appen har många anpassningsmöjligheter och djupare funktioner, men allt du behöver göra är att trycka på %@ och prata. Allt till vänster är valfritt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปนี้มีการปรับแต่งและฟีเจอร์เชิงลึกมากมาย แต่คุณเพียงแตะ %@ แล้วพูดก็พอ ทุกอย่างทางซ้ายเป็นตัวเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama özelleştirme ve daha derin özelliklerle dolu, ama tek yapmanız gereken %@ tuşuna dokunup konuşmak. Soldaki her şey isteğe bağlıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей застосунок має багато налаштувань і глибших функцій, але достатньо натиснути %@ і говорити. Усе ліворуч необов'язкове."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng này có nhiều tùy chỉnh và tính năng sâu hơn, nhưng bạn chỉ cần nhấn %@ và nói. Mọi thứ bên trái đều là tùy chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这款应用提供了丰富的自定义功能和更多高级选项，但你只需轻按 %@ 然后说话即可。左侧的一切都是可选的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 App 具備豐富的自訂功能與進階選項，但你只需要輕按 %@ 並開口說話。左側的一切都是選用的。"
          }
        }
      }
    },
    "This cannot be undone. Settings, modes, dictionaries, commands, AI actions, history, and saved audio are deleted, and the app relaunches at its welcome screen. Downloaded models are kept unless you choose to erase them too. Permissions granted in System Settings stay.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن هذا. ستُحذف الإعدادات والأوضاع والقواميس والأوامر وإجراءات الذكاء الاصطناعي والسجل والصوت المحفوظ، ويُعاد تشغيل التطبيق على شاشة الترحيب. تبقى النماذج المنزّلة ما لم تختر مسحها أيضاً. وتبقى الأذونات الممنوحة في إعدادات النظام."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto nelze vrátit zpět. Nastavení, režimy, slovníky, příkazy, akce AI, historie a uložený zvuk budou smazány a aplikace se restartuje na uvítací obrazovce. Stažené modely zůstanou, pokud nezvolíte jejich smazání. Oprávnění udělená v Nastavení systému zůstanou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan ikke fortrydes. Indstillinger, tilstande, ordbøger, kommandoer, AI-handlinger, historik og gemt lyd slettes, og appen starter forfra på velkomstskærmen. Hentede modeller bevares, medmindre du vælger at slette dem også. Tilladelser givet i Systemindstillinger bliver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies kann nicht rückgängig gemacht werden. Einstellungen, Modi, Wörterbücher, Befehle, KI-Aktionen, Verlauf und gespeichertes Audio werden gelöscht, und die App startet auf ihrem Begrüßungsbildschirm neu. Heruntergeladene Modelle bleiben erhalten, außer du entscheidest dich, sie ebenfalls zu löschen. In den Systemeinstellungen erteilte Berechtigungen bleiben bestehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer. Se borrarán los ajustes, modos, diccionarios, comandos, acciones de IA, historial y audio guardado, y la app se reiniciará en su pantalla de bienvenida. Los modelos descargados se conservan, a menos que elijas borrarlos también. Los permisos concedidos en Ajustes del Sistema se mantienen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä ei voi perua. Asetukset, tilat, sanastot, komennot, AI-toiminnot, historia ja tallennettu ääni poistetaan, ja sovellus käynnistyy uudelleen tervetuloanäkymään. Ladatut mallit säilyvät, ellet valitse myös niiden poistamista. Järjestelmäasetuksissa myönnetyt luvat säilyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible. Les réglages, modes, dictionnaires, commandes, actions IA, l'historique et l'audio enregistré sont supprimés, et l'app redémarre sur son écran d'accueil. Les modèles téléchargés sont conservés, sauf si vous choisissez de les effacer aussi. Les autorisations accordées dans Réglages Système restent en place."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר לבטל את זה. הגדרות, מצבים, מילונים, פקודות, פעולות AI, היסטוריה והקלטות שמורות יימחקו, והאפליקציה תיפתח מחדש במסך הפתיחה. מודלים שהורדו יישמרו, אלא אם תבחר למחוק גם אותם. הרשאות שניתנו בהגדרות המערכת יישארו."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez nem vonható vissza. A beállítások, módok, szótárak, parancsok, AI műveletek, előzmények és a mentett hang törlődnek, az alkalmazás pedig az üdvözlő képernyőjével újraindul. A letöltött modellek megmaradnak, hacsak nem törlöd azokat is. A Rendszerbeállításokban megadott engedélyek megmaradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tidak bisa dibatalkan. Pengaturan, mode, kamus, perintah, aksi AI, riwayat, dan audio tersimpan akan dihapus, dan aplikasi dibuka ulang di layar selamat datang. Model yang diunduh tetap disimpan kecuali Anda memilih untuk menghapusnya juga. Izin yang diberikan di Pengaturan Sistem tetap berlaku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è reversibile. Impostazioni, modalità, dizionari, comandi, azioni IA, cronologia e audio salvato vengono eliminati, e l'app si riavvia nella schermata di benvenuto. I modelli scaricati restano, a meno che tu non scelga di cancellarli. I permessi concessi nelle Impostazioni di Sistema restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません。設定、モード、辞書、コマンド、AI アクション、履歴、保存された音声がすべて削除され、アプリはウェルカム画面から再起動します。ダウンロード済みのモデルは、消去しない限り残ります。システム設定で許可した権限はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 되돌릴 수 없어요. 설정, 모드, 사전, 명령, AI 작업, 기록, 저장된 오디오가 삭제되고, 앱은 시작 화면으로 다시 실행돼요. 다운로드한 모델은 함께 지우기를 선택하지 않으면 유지돼요. 시스템 설정에서 허용한 권한은 그대로 남아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan ikke angres. Innstillinger, moduser, ordlister, kommandoer, KI-handlinger, historikk og lagret lyd slettes, og appen starter på nytt ved velkomstskjermen. Nedlastede modeller beholdes med mindre du velger å slette dem også. Tillatelser gitt i Systeminnstillinger blir værende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan niet ongedaan worden gemaakt. Instellingen, modi, woordenlijsten, opdrachten, AI-acties, geschiedenis en opgeslagen audio worden verwijderd, en de app start opnieuw op bij het welkomstscherm. Gedownloade modellen blijven bewaard, tenzij je ook die wilt wissen. Toestemmingen in Systeeminstellingen blijven staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego nie można cofnąć. Ustawienia, tryby, słowniki, polecenia, akcje AI, historia i zapisane nagrania zostaną usunięte, a aplikacja uruchomi się ponownie na ekranie powitalnym. Pobrane modele zostaną zachowane, chyba że zdecydujesz się wymazać je także. Uprawnienia przyznane w Ustawieniach systemowych pozostaną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não pode ser desfeito. Ajustes, modos, dicionários, comandos, ações de IA, histórico e áudios salvos serão apagados, e o app reinicia na tela de boas-vindas. Modelos baixados são mantidos, a menos que você escolha apagá-los também. Permissões concedidas nos Ajustes do Sistema permanecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это нельзя отменить. Настройки, режимы, словари, команды, действия с ИИ, история и сохранённое аудио будут удалены, а приложение перезапустится на экране приветствия. Загруженные модели сохранятся, если вы не решите удалить и их. Разрешения, выданные в Системных настройках, останутся."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto sa nedá vrátiť späť. Nastavenia, režimy, slovníky, príkazy, akcie AI, história a uložený zvuk sa vymažú a aplikácia sa znova spustí na úvodnej obrazovke. Stiahnuté modely sa ponechajú, pokiaľ ich nezvolíte vymazať tiež. Povolenia udelené v Nastaveniach systému zostanú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att ångra. Inställningar, lägen, ordlistor, kommandon, AI-åtgärder, historik och sparat ljud raderas, och appen startar om till välkomstskärmen. Hämtade modeller behålls om du inte väljer att radera dem också. Behörigheter som beviljats i Systeminställningar består."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้ย้อนกลับไม่ได้ การตั้งค่า โหมด พจนานุกรม คำสั่ง การทำงาน AI ประวัติ และเสียงที่บันทึกไว้จะถูกลบ และแอปจะเปิดใหม่ที่หน้าจอต้อนรับ โมเดลที่ดาวน์โหลดแล้วจะถูกเก็บไว้ เว้นแต่คุณจะเลือกลบด้วย สิทธิ์ที่อนุญาตในการตั้งค่าระบบจะยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu geri alınamaz. Ayarlar, modlar, sözlükler, komutlar, YZ eylemleri, geçmiş ve kaydedilmiş sesler silinir ve uygulama karşılama ekranında yeniden başlar. İndirilen modeller, onları da silmeyi seçmediğiniz sürece korunur. Sistem Ayarları'nda verilen izinler kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не можна скасувати. Налаштування, режими, словники, команди, дії ШІ, історія і збережені аудіо буде видалено, а програма перезапуститься на екрані привітання. Завантажені моделі лишаються, якщо ви не вирішите стерти і їх. Дозволи, надані в Системних налаштуваннях, лишаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể hoàn tác. Cài đặt, chế độ, từ điển, lệnh, hành động AI, lịch sử và âm thanh đã lưu sẽ bị xóa, và ứng dụng khởi động lại ở màn hình chào mừng. Mô hình đã tải được giữ lại trừ khi bạn chọn xóa luôn. Quyền đã cấp trong Cài đặt Hệ thống vẫn giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。设置、模式、词典、命令、AI 操作、历史记录和已保存的音频都将被删除，应用将重新启动到欢迎界面。除非你选择一并抹掉，否则已下载的模型会被保留。在系统设置中授予的权限会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作無法復原。所有設定、模式、字典、指令、AI 動作、紀錄與已儲存的音訊都會被刪除，App 會重新啟動並回到歡迎畫面。除非你選擇一併抹除，否則已下載的模型會保留。在「系統設定」中授予的權限也會保留。"
          }
        }
      }
    },
    "This is a showcase of everything YapToText can do, chained into one easy-to-follow pipeline. Dictate into the scratchpad (or transcribe any audio or video file), send the result down to be rewritten by any mode - your dictionaries and voice commands apply just like a real dictation - then finish it with a one-shot AI action like translate or summarize. Every card has Copy and Insert, and “Send below” passes text to the next step. It's the whole app, laid out on one workbench.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا عرض لكل ما يستطيع YapToText فعله، مرتبط في مسار واحد سهل المتابعة. أملِ في المسودة (أو انسخ أي ملف صوتي أو مرئي)، ثم أرسل النتيجة لإعادة كتابتها بأي وضع، فتنطبق القواميس وأوامر الصوت تماماً كما في الإملاء الحقيقي، ثم أنهِها بإجراء ذكاء اصطناعي فوري مثل الترجمة أو التلخيص. تحتوي كل بطاقة على نسخ وإدراج، و“أرسل أدناه” يمرر النص إلى الخطوة التالية. إنه التطبيق كله، مرتباً على طاولة عمل واحدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je ukázka všeho, co YapToText umí, propojená do jednoho snadno sledovatelného postupu. Nadiktujte do konceptu (nebo přepište libovolný zvukový či video soubor), výsledek pošlete dolů k přepsání libovolným režimem, kde se uplatní vaše slovníky a hlasové příkazy stejně jako při běžném diktování, a pak jej dokončete jednorázovou akcí AI, třeba překladem nebo shrnutím. Každá karta má Kopírovat a Vložit a „Poslat níže“ předá text dalšímu kroku. Je to celá aplikace rozložená na jednom pracovním stole."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en præsentation af alt, YapToText kan, lænket sammen i én let at følge pipeline. Diktér ind i notesblokken (eller transskribér en vilkårlig lyd- eller videofil), send resultatet videre til omskrivning med en vilkårlig tilstand - dine ordbøger og stemmekommandoer gælder præcis som ved en rigtig diktering - og afslut derefter med en engangs-AI-handling som oversæt eller opsummer. Hvert kort har Kopiér og Indsæt, og “Send nedenfor” sender teksten til næste trin. Det er hele appen, samlet på én arbejdsbænk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine Vorführung all dessen, was YapToText kann, verkettet zu einer leicht nachvollziehbaren Verarbeitungskette. Diktiere in den Notizblock (oder transkribiere eine beliebige Audio- oder Videodatei), schicke das Ergebnis weiter, um es mit einem beliebigen Modus umschreiben zu lassen. Deine Wörterbücher und Sprachbefehle wirken dabei genau wie bei einem echten Diktat. Danach schließt du mit einer einmaligen KI-Aktion wie Übersetzen oder Zusammenfassen ab. Jede Karte hat Kopieren und Einfügen, und „Unten senden“ gibt den Text an den nächsten Schritt weiter. Es ist die ganze App, auf einer Werkbank ausgebreitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una muestra de todo lo que YapToText puede hacer, encadenado en un proceso fácil de seguir. Dicta en el bloc de notas (o transcribe cualquier archivo de audio o video), envía el resultado para que lo reescriba cualquier modo (tus diccionarios y comandos de voz se aplican igual que en un dictado real) y termínalo con una acción de IA puntual, como traducir o resumir. Cada tarjeta tiene Copiar e Insertar, y “Enviar abajo” pasa el texto al siguiente paso. Es toda la app, sobre una sola mesa de trabajo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on esittely kaikesta, mitä YapToText osaa, ketjutettuna yhdeksi helposti seurattavaksi käsittelyketjuksi. Sanele muistioon (tai litteroi mikä tahansa ääni- tai videotiedosto), lähetä tulos alas uudelleen kirjoitettavaksi millä tahansa tilalla. Sanastosi ja äänikomennot toimivat kuten oikeassa sanelussa. Lopuksi viimeistele se kertakäyttöisellä AI-toiminnolla, kuten käännä tai tiivistä. Jokaisessa kortissa on Kopioi ja Lisää, ja ”Lähetä alle” välittää tekstin seuraavaan vaiheeseen. Koko sovellus on tässä yhdellä työpöydällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vitrine de tout ce que YapToText sait faire, enchaînée en un seul traitement facile à suivre. Dictez dans le bloc-notes (ou transcrivez n'importe quel fichier audio ou vidéo), envoyez le résultat pour qu'il soit réécrit par un mode - vos dictionnaires et commandes vocales s'appliquent comme pour une vraie dictée - puis terminez avec une action IA ponctuelle comme traduire ou résumer. Chaque carte a Copier et Insérer, et “Envoyer ci-dessous” transmet le texte à l'étape suivante. C'est toute l'app, disposée sur un seul plan de travail."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זוהי הדגמה של כל מה ש-YapToText יכול לעשות, מחוברת לצינור אחד קל לעקוב אחריו. הכתב לתוך פנקס הרשימות (או תמלל כל קובץ אודיו או וידאו), שלח את התוצאה למטה כדי שכל מצב יכתוב אותה מחדש - המילונים והפקודות הקוליות חלים בדיוק כמו בהכתבה אמיתית - ואז סיים אותה בפעולת AI חד פעמית, כמו תרגום או סיכום. לכל כרטיס יש העתקה והכנסה, ו-“Send below” מעביר טקסט לשלב הבא. זו כל האפליקציה, מסודרת על שולחן עבודה אחד."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a YapToText összes képességének bemutatója, egyetlen, könnyen követhető feldolgozási láncba fűzve. Diktálj a vázlatfüzetbe (vagy írass át bármilyen hang- vagy videófájlt), küldd tovább az eredményt átírásra bármely módnak: a szótáraid és a hangparancsaid úgy működnek, mint egy valódi diktálásnál. Végül zárd egy egyszeri AI művelettel, például fordítással vagy összefoglalással. Minden kártyán van Másolás és Beszúrás gomb, a „Küldés alá” pedig továbbadja a szöveget a következő lépésnek. Ez az egész alkalmazás, egyetlen munkapadon elrendezve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah etalase semua yang bisa dilakukan YapToText, dirangkai menjadi satu alur yang mudah diikuti. Dikte ke scratchpad (atau transkripsi file audio atau video apa pun), kirim hasilnya untuk ditulis ulang oleh mode apa pun - kamus dan perintah suara Anda berlaku seperti dikte sungguhan - lalu selesaikan dengan aksi AI sekali jalan seperti terjemahkan atau ringkas. Setiap kartu punya Salin dan Sisipkan, dan “Send below” meneruskan teks ke langkah berikutnya. Ini keseluruhan aplikasinya, tersusun di satu meja kerja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è una vetrina di tutto ciò che YapToText sa fare, concatenato in una pipeline facile da seguire. Detta nello spazio di prova (oppure trascrivi un file audio o video), invia il risultato a una modalità qualsiasi per essere riscritto: i tuoi dizionari e i comandi vocali si applicano come in una dettatura vera, poi concludi con un'azione IA immediata come tradurre o riassumere. Ogni scheda ha Copia e Inserisci, e “Send below” passa il testo al passo successivo. È l'intera app, disposta su un unico banco di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは YapToText ができることを、わかりやすい一つの処理の流れにまとめたショーケースです。メモ帳にディクテーションするか(任意の音声・動画ファイルの書き起こしも可能)、結果をどのモードでも書き直せるように送ります。辞書と音声コマンドは、通常のディクテーションと同じように適用されます。最後に、翻訳や要約などのワンショット AI アクションで仕上げます。どのカードにも「コピー」と「挿入」があり、「下に送る」で次のステップにテキストを渡せます。アプリ全体を一つのワークベンチに並べたものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면은 YapToText가 할 수 있는 모든 기능을 따라 하기 쉬운 하나의 파이프라인으로 보여 줘요. 메모장에 받아쓰거나(또는 오디오나 비디오 파일을 전사하고), 결과를 아무 모드로 다시 쓰도록 보내세요. 사전과 음성 명령도 실제 받아쓰기와 똑같이 적용돼요. 마지막으로 번역이나 요약 같은 일회성 AI 작업으로 마무리하세요. 각 카드에는 복사와 삽입 버튼이 있고, “아래로 보내기”는 텍스트를 다음 단계로 넘겨요. 앱 전체를 하나의 작업대에 펼쳐 놓은 셈이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en presentasjon av alt YapToText kan gjøre, koblet sammen i én pipeline som er lett å følge. Dikter inn i notatlappen (eller transkriber en hvilken som helst lyd- eller videofil), send resultatet videre for å bli skrevet om av en hvilken som helst modus - ordlistene og stemmekommandoene dine gjelder akkurat som ved en vanlig diktering - og avslutt med en engangs KI-handling, for eksempel oversett eller oppsummer. Hvert kort har Kopier og Sett inn, og «Send under» sender tekst til neste steg. Det er hele appen, lagt ut på én arbeidsbenk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een overzicht van alles wat YapToText kan, in één goed te volgen keten. Dicteer in het kladblok (of transcribeer elk audio- of videobestand), stuur het resultaat door om door een modus te worden herschreven - je woordenlijsten en spraakopdrachten gelden net als bij een echt dictee - en maak het af met een eenmalige AI-actie zoals vertalen of samenvatten. Elke kaart heeft Kopiëren en Invoegen, en “Hieronder sturen” geeft tekst door aan de volgende stap. Het is de hele app, op één werkbank."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To pokaz wszystkiego, co potrafi YapToText, połączony w jeden łatwy do śledzenia potok. Dyktuj do notatnika (albo transkrybuj dowolny plik audio lub wideo), a wynik wyślij do przepisania dowolnym trybem. Słowniki i polecenia głosowe działają tak samo jak przy zwykłym dyktowaniu. Na koniec dodaj jednorazową akcję AI, na przykład tłumaczenie lub streszczenie. Każda karta ma Kopiuj i Wstaw, a „Wyślij poniżej” przekazuje tekst do następnego kroku. To cała aplikacja, ułożona na jednym stole roboczym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma vitrine de tudo o que o YapToText pode fazer, encadeado em um pipeline fácil de acompanhar. Dite no bloco de notas (ou transcreva qualquer arquivo de áudio ou vídeo), envie o resultado para ser reescrito por qualquer modo (seus dicionários e comandos de voz se aplicam como em um ditado real) e finalize com uma ação de IA pontual, como traduzir ou resumir. Cada cartão tem Copiar e Inserir, e “Enviar abaixo” passa o texto para a próxima etapa. É o app inteiro, organizado em uma única bancada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это витрина всего, что умеет YapToText, собранная в один понятный конвейер. Продиктуйте текст в черновик (или расшифруйте любой аудио- или видеофайл), отправьте результат на переписывание любым режимом (ваши словари и голосовые команды работают так же, как в обычной диктовке), а затем завершите одним действием с ИИ, например переводом или сокращением. У каждой карточки есть «Копировать» и «Вставить», а «Отправить ниже» передаёт текст на следующий шаг. Это всё приложение, разложенное на одном рабочем столе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je ukážka všetkého, čo YapToText dokáže, spojená do jedného ľahko sledovateľného postupu. Diktujte do poznámkového bloku (alebo prepíšte ľubovoľný zvukový či video súbor), pošlite výsledok na prepísanie ľubovoľným režimom - vaše slovníky a hlasové príkazy sa uplatnia rovnako ako pri skutočnom diktovaní - a potom ho dokončite jednorazovou akciou AI, napríklad preložením alebo zhrnutím. Každá karta má Kopírovať a Vložiť a „Odoslať nižšie“ posiela text ďalšiemu kroku. Je to celá aplikácia rozložená na jednom pracovnom stole."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är en visning av allt YapToText kan göra, kopplat i en lättföljd pipeline. Diktera till anteckningsytan (eller transkribera vilken ljud- eller videofil som helst), skicka resultatet till ett läge för omskrivning - dina ordlistor och röstkommandon gäller precis som vid en riktig diktering - och avsluta sedan med en engångs-AI-åtgärd som översätt eller sammanfatta. Varje kort har Kopiera och Infoga, och ”Skicka nedan” skickar text till nästa steg. Det är hela appen, utlagd på en arbetsbänk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือการสาธิตทุกอย่างที่ YapToText ทำได้ เชื่อมต่อเป็นขั้นตอนเดียวที่ทำตามได้ง่าย พูดลงในกระดาษโน้ต (หรือถอดเสียงจากไฟล์เสียงหรือวิดีโอใดก็ได้) แล้วส่งผลลัพธ์ไปเขียนใหม่ด้วยโหมดใดก็ได้ พจนานุกรมและคำสั่งเสียงจะใช้งานเหมือนการพิมพ์ด้วยเสียงจริง จากนั้นจบด้วยการทำงาน AI ครั้งเดียว เช่น แปลหรือสรุป ทุกการ์ดมีปุ่มคัดลอกและแทรก และ “ส่งด้านล่าง” จะส่งข้อความไปยังขั้นตอนถัดไป นี่คือทั้งแอปที่จัดวางบนโต๊ะทำงานเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, YapToText'in yapabildiği her şeyin, takibi kolay tek bir işlem hattında zincirlenmiş bir gösterimidir. Taslak alanına dikte edin (ya da herhangi bir ses veya video dosyasını yazıya dökün), sonucu herhangi bir modla yeniden yazılması için aşağı gönderin - sözlükleriniz ve sesli komutlarınız tıpkı gerçek bir dikte gibi uygulanır - ardından çevir ya da özetle gibi tek seferlik bir YZ eylemiyle bitirin. Her kartta Kopyala ve Ekle vardır, “Aşağı gönder” metni bir sonraki adıma iletir. Tüm uygulama tek bir çalışma tezgahında düzenlenmiştir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це демонстрація всього, що вміє YapToText, зібрана в один зрозумілий конвеєр. Диктуйте в чернетку (або транскрибуйте будь-який аудіо- чи відеофайл), надішліть результат на переписування будь-яким режимом (ваші словники і голосові команди працюють так само, як у звичайній диктовці), а потім завершіть одноразовою дією ШІ, наприклад перекладом або підсумком. Кожна картка має кнопки «Копіювати» і «Вставити», а «Надіслати нижче» передає текст наступному кроку. Це вся програма, розкладена на одному робочому столі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là bản trình diễn mọi thứ YapToText làm được, nối thành một quy trình dễ theo dõi. Đọc chính tả vào khung nháp (hoặc phiên âm bất kỳ tệp âm thanh hoặc video nào), gửi kết quả xuống để được viết lại bằng bất kỳ chế độ nào - từ điển và lệnh giọng nói của bạn áp dụng như một lần đọc chính tả thật - rồi hoàn tất bằng một hành động AI một lần như dịch hoặc tóm tắt. Mỗi thẻ đều có Sao chép và Chèn, và “Gửi xuống dưới” chuyển văn bản sang bước tiếp theo. Đó là toàn bộ ứng dụng, được bày trên một bàn làm việc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 YapToText 全部功能的展示，串联成一条易于理解的处理流程。先在草稿区听写（或转写任意音频或视频文件），再将结果发送下去，由任意模式进行改写，你的词典和语音命令同样适用，就像真正的听写一样。最后用一次性的 AI 操作完成处理，例如翻译或总结。每张卡片都有“复制”和“插入”，“发送到下方”会把文字传递给下一步。整个应用都铺陈在这一个工作台上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是 YapToText 所有功能的展示，串連成一條易於理解的處理流程。你可以聽寫到草稿區（或轉錄任何音訊或影片檔案），再將結果傳送給任一模式改寫，你的字典與語音指令會像一般聽寫一樣套用，最後再以翻譯或摘要等一次性 AI 動作完成。每張卡片都有「複製」與「插入」，「傳送到下方」會把文字交給下一步。這就是整個 App，全部排列在同一個工作台上。"
          }
        }
      }
    },
    "This key is bound to BOTH dictation and Quick Edit - whichever fires first wins.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المفتاح مرتبط بالإملاء والتحرير السريع معاً، وأيهما يعمل أولاً يفوز."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato klávesa je přiřazena JAK diktování, tak Rychlým úpravám. Vyhrává to, co se spustí jako první."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne tast er knyttet til BÅDE diktering og hurtig redigering - den, der aktiveres først, vinder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Taste ist SOWOHL dem Diktat als auch der Schnellbearbeitung zugewiesen, wer zuerst reagiert, gewinnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tecla está asignada a AMBOS, dictado y Edición rápida: gana la que se active primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä näppäin on sidottu SEKÄ sanelulle ETTÄ pikamuokkaukselle. Se, joka aktivoituu ensin, voittaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette touche est liée à la fois à la dictée et à l'édition rapide : celle qui se déclenche en premier l'emporte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המקש הזה משויך גם להכתבה וגם לעריכה מהירה - מי שמופעל ראשון זוכה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a billentyű MIND a diktáláshoz, MIND a Gyors szerkesztéshez van rendelve, az nyer, amelyik előbb aktiválódik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol ini terikat pada dikte DAN Quick Edit, mana pun yang lebih dulu aktif yang berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo tasto è assegnato sia alla dettatura sia alla Modifica rapida: vince quella che si attiva per prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーはディクテーションとクイック編集の両方に割り当てられています。先に反応したほうが優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키는 받아쓰기와 Quick Edit 둘 다에 연결돼 있어요. 먼저 실행되는 쪽이 이겨요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne tasten er knyttet til BÅDE diktering og hurtigredigering - den som utløses først, vinner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze toets is gekoppeld aan ZOWEL dicteren als Snel bewerken; wat het eerst afgaat, wint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten klawisz jest przypisany ZARÓWNO do dyktowania, jak i do szybkiej edycji; to, co zadziała pierwsze, wygrywa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tecla está associada ao ditado E à edição rápida; quem disparar primeiro vence."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта клавиша назначена И диктовке, И быстрому редактированию. Что сработает первым, то и выполнится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento kláves je priradený DIKTOVANIU aj RÝCHLEJ ÚPRAVE - vyhrá to, čo sa spustí prvé."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här tangenten är kopplad till BÅDE diktering och snabbredigering. Den som aktiveras först vinner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มนี้ผูกทั้งกับการพิมพ์ด้วยเสียงและแก้ไขด่วน อันไหนทำงานก่อนจะได้ผล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tuş HEM dikteye HEM de Hızlı Düzenlemeye atanmış - hangisi önce tetiklenirse o kazanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця клавіша прив'язана І до диктовки, І до швидкого редагування: що спрацює першим, те й виконається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím này được gán cho CẢ đọc chính tả và Chỉnh sửa nhanh. Cái nào kích hoạt trước sẽ thắng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此键同时绑定了听写和快速编辑，谁先触发就执行谁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此按鍵同時綁定了聽寫與快速編輯，先觸發的功能會生效。"
          }
        }
      }
    },
