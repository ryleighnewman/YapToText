          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 말하기(대안은 쉼표로 구분)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Si dette (skill alternativer med komma)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg dit (scheid alternatieven met komma's)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz to (oddziel warianty przecinkami)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga isto (separe as alternativas com vírgulas)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажите это (варианты разделяйте запятыми)"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povedať toto (alternatívy oddeľte čiarkami)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säg det här (skilj alternativen åt med kommatecken)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พูดคำนี้ (คั่นตัวเลือกอื่นด้วยจุลภาค)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu söyleyin (alternatifleri virgülle ayırın)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажіть це (окремі варіанти розділяйте комами)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói câu này (các cách nói thay thế ngăn cách bằng dấu phẩy)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
