        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana emergente de arriba sigue cada cambio que hagas aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yllä oleva ponnahdusikkuna seuraa jokaista tekemääsi muutosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre ci-dessus suit chaque modification faite ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלון הקופץ למעלה עוקב אחרי כל שינוי כאן כשאתה עושה אותו."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fenti felugró ablak minden itt végzett változtatást azonnal követ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop-up di atas mengikuti setiap perubahan di sini saat Anda membuatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pop-up qui sopra segue ogni modifica che fai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上のポップアップは、ここで変更するたびに反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위의 팝업은 여기서 바꾸는 모든 변경을 바로 따라가요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Popupen over følger hver endring her etter hvert som du gjør den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De pop-up hierboven volgt elke wijziging hier terwijl je die maakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dymek powyżej na bieżąco odzwierciedla każdą zmianę wprowadzaną tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pop-up acima acompanha cada mudança feita aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всплывающее окно выше повторяет каждое изменение, которое вы здесь вносите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyskakovacie okno vyššie sleduje každú zmenu, ktorú tu urobíte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Popupen ovan följer varje ändring här när du gör den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป๊อปอัปด้านบนจะตามการเปลี่ยนแปลงทุกอย่างที่นี่ขณะที่คุณทำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarıdaki açılır pencere, siz değiştirdikçe buradaki her değişikliği izler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спливаюче вікно вгорі відстежує кожну зміну, яку ви тут робите."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cửa sổ nổi phía trên theo dõi mọi thay đổi ở đây khi bạn thực hiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上方的弹出窗口会随你在此处的每项更改实时变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上方的彈出視窗會即時反映你在此處所做的每項變更。"
          }
        }
      }
    },
    "The pop-up opens here every time, even after you drag it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفتح النافذة المنبثقة هنا في كل مرة، حتى بعد أن تسحبها."
          }
