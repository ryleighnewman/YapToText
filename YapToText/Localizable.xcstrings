    "For developers: concise, technical phrasing for comments and commit messages.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للمطورين: صياغة موجزة وتقنية للتعليقات ورسائل الإيداع."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro vývojáře: stručné, technické formulace pro komentáře a popisy commitů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til udviklere: kortfattet, teknisk formulering til kommentarer og commit-beskeder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Entwickler: knappe, technische Formulierungen für Kommentare und Commit-Nachrichten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para desarrolladores: redacción concisa y técnica para comentarios y mensajes de commit."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehittäjille: tiivis, tekninen ilmaisu kommentteihin ja commit-viesteihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les développeurs : formulation concise et technique pour les commentaires et les messages de commit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למפתחים: ניסוח תמציתי וטכני להערות ולהודעות commit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fejlesztőknek: tömör, szakmai megfogalmazás kommentekhez és commit üzenetekhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk pengembang: kalimat ringkas dan teknis untuk komentar dan pesan commit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per sviluppatori: formulazione concisa e tecnica per commenti e messaggi di commit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発者向け: コメントやコミットメッセージ用に、簡潔で技術的な言い回しにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발자용: 주석과 커밋 메시지에 맞는 간결하고 기술적인 표현."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For utviklere: kortfattet, teknisk språk til kommentarer og commit-meldinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor ontwikkelaars: beknopte, technische formulering voor opmerkingen en commit-berichten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla programistów: zwięzłe, techniczne sformułowania w komentarzach i opisach commitów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para desenvolvedores: frases concisas e técnicas para comentários e mensagens de commit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для разработчиков: краткие технические формулировки для комментариев и сообщений коммитов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre vývojárov: stručné, technické vyjadrovanie pre komentáre a správy o commitoch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För utvecklare: kortfattad, teknisk formulering för kommentarer och commit-meddelanden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับนักพัฒนา: ใช้ถ้อยคำกระชับและเชิงเทคนิคสำหรับคอมเมนต์และข้อความ commit"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştiriciler için: yorumlar ve commit mesajları için kısa, teknik bir dil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для розробників: стислі технічні формулювання для коментарів і повідомлень комітів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dành cho lập trình viên: diễn đạt ngắn gọn, mang tính kỹ thuật cho chú thích và thông điệp commit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面向开发者：为注释和提交信息使用简洁的技术用语。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給開發者：為註解與提交訊息使用簡潔的技術用語。"
          }
        }
      }
    },
    "Formats dictation as a polished email while keeping your voice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينسّق الإملاء كبريد إلكتروني مصقول مع الحفاظ على أسلوبك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naformátuje diktát jako upravený e-mail a zachová váš styl."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Formaterer diktering som en poleret e-mail, mens din stemme bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatiert das Diktat als gepflegte E-Mail und behält dabei deine Stimme bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da formato al dictado como un correo pulido, manteniendo tu voz."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muotoilee sanelun hiotuksi sähköpostiksi säilyttäen äänesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met la dictée en forme d'e-mail soigné tout en gardant votre style."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעצב הכתבה לאימייל מלוטש, תוך שמירה על הקול שלך."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktálást csiszolt e-mailként formázza, megtartva a hangodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memformat dikte menjadi email yang rapi tanpa menghilangkan suara Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatta la dettatura come un'email curata mantenendo la tua voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの声の調子を保ったまま、ディクテーションを整ったメールに整形します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목소리는 그대로 살리고, 받아쓴 내용을 다듬은 이메일 형식으로 만들어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Formaterer diktering som en pusset e-post og beholder stemmen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt van een dictee een verzorgde e-mail met behoud van je stem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatuje dyktowanie jako dopracowany e-mail, zachowując twój głos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Formata o ditado como um e-mail bem escrito, mantendo a sua voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформляет диктовку как аккуратное письмо, сохраняя ваш голос."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naformátuje diktát ako upravený e-mail a zachová váš štýl."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Formaterar diktering som ett genomarbetat e-postmeddelande och behåller din röst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดรูปการพิมพ์ด้วยเสียงให้เป็นอีเมลที่สละสลวย โดยยังคงน้ำเสียงของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesinizi koruyarak dikteyi cilalı bir e-postaya biçimlendirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Форматує диктовку як відшліфований лист, зберігаючи ваш голос."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định dạng lời đọc chính tả thành email chỉn chu nhưng vẫn giữ giọng của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将听写内容整理为精致的邮件，同时保留你的语气。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將聽寫內容整理為精緻的電子郵件，同時保留你的語氣。"
          }
        }
      }
    },
