          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk wat deze modus doet met een voorbeeld, zonder te dicteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz podgląd, co ten tryb robi z przykładowym tekstem, bez dyktowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja a prévia do que este modo faz com um exemplo, sem ditar."
          }
        },
