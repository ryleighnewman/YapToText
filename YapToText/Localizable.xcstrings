        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pop-up si apre sempre qui, anche dopo che lo hai trascinato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグした後でも、ポップアップは毎回ここに開きます。"
