            "value": "Đọc chính tả chạy %lld phút và đã tự động dừng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听写已运行 %lld 分钟，并已自动停止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽寫已進行 %lld 分鐘，並已自動停止"
          }
        }
      }
    },
    "Dictation switches to this mode automatically whenever one of these apps is in front.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبدّل الإملاء إلى هذا الوضع تلقائياً كلما كان أحد هذه التطبيقات في المقدمة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktování se automaticky přepne do tohoto režimu, kdykoli bude některá z těchto aplikací v popředí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering skifter automatisk til denne tilstand, når en af disse apps er forrest."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Diktat wechselt automatisch in diesen Modus, sobald eine dieser Apps im Vordergrund ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado cambia a este modo automáticamente cuando una de estas apps está al frente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanelu vaihtaa tähän tilaan automaattisesti aina, kun jokin näistä sovelluksista on edessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée passe automatiquement à ce mode chaque fois qu'une de ces apps est au premier plan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההכתבה עוברת למצב הזה אוטומטית בכל פעם שאחת מהאפליקציות האלה בחזית."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktálás automatikusan erre a módra vált, valahányszor ezek közül egy alkalmazás előtérbe kerül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte otomatis beralih ke mode ini setiap kali salah satu aplikasi ini aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura passa automaticamente a questa modalità ogni volta che una di queste app è in primo piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアプリのいずれかが前面にあるとき、ディクテーションは自動的にこのモードに切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱 중 하나가 맨 앞에 있으면 받아쓰기가 자동으로 이 모드로 바뀌어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering bytter automatisk til denne modusen når en av disse appene er først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicteren schakelt automatisch naar deze modus zodra een van deze apps vooraan staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie przełącza się na ten tryb automatycznie, gdy jedna z tych aplikacji jest na wierzchu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado muda automaticamente para este modo sempre que um desses apps estiver em primeiro plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовка автоматически переключается на этот режим, когда одно из этих приложений на переднем плане."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktovanie automaticky prepne na tento režim vždy, keď je niektorá z týchto aplikácií v popredí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering byter till det här läget automatiskt när någon av dessa appar är framme."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การพิมพ์ด้วยเสียงจะสลับมาใช้โหมดนี้โดยอัตโนมัติทุกครั้งที่หนึ่งในแอปเหล่านี้อยู่ด้านหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamalardan biri önde olduğunda dikte otomatik olarak bu moda geçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовка автоматично переходить у цей режим, коли одна з цих програм на передньому плані."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc chính tả tự chuyển sang chế độ này mỗi khi một trong các ứng dụng này ở trên cùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只要这些应用中的任意一个位于最前面，听写就会自动切换到此模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要這些 App 之一位於最前方，聽寫就會自動切換到此模式。"
          }
        }
      }
    },
