            "value": "キーを 1 つ押すだけ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 하나면 충분해요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én tast er alt som trengs"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén toets is alles wat nodig is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystarczy jeden klawisz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta uma tecla"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достаточно одной клавиши"
          }
        },
        "sk": {
