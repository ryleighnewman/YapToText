    "Undo the last mode change (rename, prompt edit, reorder, delete)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تراجع عن آخر تغيير في الوضع (إعادة التسمية، أو تحرير الأمر، أو إعادة الترتيب، أو الحذف)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátit poslední změnu režimu (přejmenování, úprava promptu, změna pořadí, smazání)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortryd den sidste ændring af tilstand (omdøbning, redigering af prompt, sortering, sletning)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte Moduseinstellung rückgängig machen (umbenennen, Prompt bearbeiten, sortieren, löschen)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshacer el último cambio de modo (renombrar, editar prompt, reordenar, eliminar)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumoa viimeisin tilamuutos (nimeäminen, kehotteen muokkaus, järjestys, poisto)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler le dernier changement de mode (renommer, modifier l'invite, réordonner, supprimer)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בטל את שינוי המצב האחרון (שינוי שם, עריכת הנחיה, סידור מחדש, מחיקה)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utolsó módváltozás visszavonása (átnevezés, utasítás szerkesztése, átrendezés, törlés)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan perubahan mode terakhir (ubah nama, edit prompt, urutkan ulang, hapus)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla l'ultima modifica alla modalità (rinomina, modifica del prompt, riordino, eliminazione)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直前のモード変更(名前変更、プロンプト編集、並べ替え、削除)を取り消す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 모드 변경 되돌리기(이름 바꾸기, 프롬프트 편집, 순서 변경, 삭제)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angre siste modusendring (gi nytt navn, redigere prompt, endre rekkefølge, slette)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De laatste wijziging van de modus ongedaan maken (hernoemen, prompt bewerken, herordenen, verwijderen)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cofnij ostatnią zmianę trybu (zmiana nazwy, edycja promptu, zmiana kolejności, usunięcie)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfazer a última alteração de modo (renomear, editar prompt, reordenar, excluir)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить последнее изменение режима (переименование, правку запроса, порядок, удаление)"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátiť poslednú zmenu režimu (premenovanie, úprava výzvy, zmena poradia, vymazanie)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ångra senaste lägesändringen (byt namn, redigera prompt, ordna om, ta bort)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกการเปลี่ยนโหมดล่าสุด (เปลี่ยนชื่อ แก้ไขพรอมต์ เรียงลำดับใหม่ ลบ)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son mod değişikliğini geri al (yeniden adlandırma, istem düzenleme, sıralama, silme)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасувати останню зміну режиму (перейменування, редагування запиту, порядок, видалення)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tác thay đổi chế độ gần nhất (đổi tên, sửa lời nhắc, sắp xếp lại, xóa)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销上一次模式更改（重命名、提示词编辑、排序、删除）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原上一次的模式變更（重新命名、提示詞編輯、重新排序、刪除）"
          }
        }
      }
    },
    "Unplugged, this mode uses the lighter model; on mains it uses the one above.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند فصل الكهرباء، يستخدم هذا الوضع النموذج الأخف، وعند التوصيل يستخدم النموذج أعلاه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez napájení tento režim použije lehčí model; připojený k síti použije model výše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden strøm bruger denne tilstand den lettere model; på lysnettet bruger den den ovenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Netzteil verwendet dieser Modus das leichtere Modell, am Netz das oben genannte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cargador, este modo usa el modelo más ligero; con el cargador conectado usa el de arriba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Akulla tämä tila käyttää kevyempää mallia, verkkovirrassa yllä olevaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur batterie, ce mode utilise le modèle plus léger ; sur secteur, il utilise celui ci-dessus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשלא מחובר לחשמל, המצב הזה משתמש במודל הקל יותר; בחשמל הוא משתמש במודל שלמעלה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hálózat nélkül ez a mód a könnyebb modellt használja, hálózatról a fenti modellt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat tidak tersambung, mode ini memakai model yang lebih ringan; saat tersambung listrik, memakai yang di atas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scollegato, questa modalità usa il modello più leggero; collegato alla rete usa quello sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー駆動時は軽いモデルを使い、電源接続時は上のモデルを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전원이 연결되지 않으면 이 모드는 더 가벼운 모델을 쓰고, 전원이 연결되면 위의 모델을 써요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frakoblet bruker denne modusen den lettere modellen; på strøm bruker den modellen over."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Losgekoppeld gebruikt deze modus het lichtere model; op het stroomnet gebruikt hij het model hierboven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez zasilania ten tryb używa lżejszego modelu; z zasilaniem używa wyższego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem a tomada, este modo usa o modelo mais leve; na tomada, usa o de cima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От батареи этот режим использует более лёгкую модель, а от сети ту, что выше."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez napájania tento režim používa ľahší model; pri napájaní používa model vyššie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Urkopplad använder det här läget den lättare modellen; på nätet använder det modellen ovan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อไม่เสียบปลั๊ก โหมดนี้ใช้โมเดลที่เบากว่า เมื่อเสียบปลั๊กจะใช้โมเดลด้านบน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fişten çıkarılmışken bu mod daha hafif modeli kullanır; şebekedeyken yukarıdakini kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без живлення цей режим використовує легшу модель; від мережі, ту, що вище."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi rút sạc, chế độ này dùng mô hình nhẹ hơn; khi cắm điện, dùng mô hình ở trên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用电池时，此模式使用较轻的模型；接通电源时，则使用上方的模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用電池時，此模式會使用較輕量的模型；接上電源時則使用上方的模型。"
          }
        }
      }
    },
    "Untangling the words…": {
      "localizations": {
