            "value": "ค่าเริ่มต้นของระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem varsayılanı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Системна типова"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặc định hệ thống"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统默认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統預設"
          }
        }
      }
    },
    "Talk, and your words show up wherever your cursor is.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكلّم، وستظهر كلماتك حيثما يوجد المؤشر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mluvte a vaše slova se objeví tam, kde je kurzor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal, og dine ord vises, hvor din markør er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich, und deine Worte erscheinen überall, wo sich deine Einfügemarke befindet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla, y tus palabras aparecerán donde esté tu cursor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhu, ja sanasi ilmestyvät kohdistimen kohtaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez, et vos mots apparaissent là où se trouve votre curseur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דבר, והמילים שלך מופיעות בכל מקום שבו הסמן שלך."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beszélj, és a szavaid ott jelennek meg, ahol a kurzorod van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bicara, dan kata-kata Anda muncul di mana pun kursor berada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla, e le tue parole compaiono dove si trova il cursore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話すと、カーソルのある場所に言葉が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하면 커서가 있는 곳에 말이 나타나요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snakk, så vises ordene dine der markøren er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Praat, en je woorden verschijnen waar je cursor zich ook bevindt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mów, a słowa pojawią się tam, gdzie jest kursor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale, e suas palavras aparecem onde estiver o cursor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорите, и ваши слова появятся там, где находится курсор."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozprávajte a vaše slová sa objavia tam, kde je kurzor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prata, så dyker dina ord upp där markören är."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พูดได้เลย แล้วคำของคุณจะปรากฏตรงตำแหน่งเคอร์เซอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşun, sözcükleriniz imlecinizin olduğu yerde görünsün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Говоріть, і ваші слова з'являтимуться там, де курсор."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cứ nói, và lời bạn xuất hiện ở bất cứ nơi nào con trỏ đang đứng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话即可，你的文字会出现在光标所在的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開口說話，你的文字就會出現在游標所在之處。"
          }
        }
      }
    },
    "Tap %@ to start listening, tap again to apply.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط %@ لبدء الاستماع، واضغط مجدداً للتطبيق."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na %@ pro začátek poslechu, klepněte znovu pro použití."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på %@ for at begynde at lytte, tryk igen for at anvende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe %@, um zuzuhören, tippe erneut, um zu übernehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa %@ para empezar a escuchar y vuelve a pulsar para aplicar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta %@ aloittaaksesi kuuntelun ja napauta uudelleen ottaaksesi muutoksen käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur %@ pour commencer l'écoute, appuyez à nouveau pour appliquer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על %@ כדי להתחיל להקשיב, הקש שוב כדי להחיל."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a(z) %@ billentyűre a hallgatás indításához, újabb koppintással alkalmazd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk %@ untuk mulai mendengarkan, ketuk lagi untuk menerapkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca %@ per iniziare ad ascoltare, toccalo di nuovo per applicare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を押して聞き取りを開始し、もう一度押して適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 탭하면 듣기 시작하고, 다시 탭하면 적용해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk %@ for å begynne å lytte, trykk igjen for å bruke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op %@ om te luisteren, tik opnieuw om toe te passen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij %@, aby zacząć słuchać, naciśnij ponownie, aby zastosować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em %@ para começar a ouvir, toque de novo para aplicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите %@, чтобы начать слушать, и ещё раз, чтобы применить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na %@ a začnite počúvať, ďalším ťuknutím použijete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på %@ för att börja lyssna, tryck igen för att tillämpa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ %@ เพื่อเริ่มฟัง แตะอีกครั้งเพื่อใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlemeye başlamak için %@ tuşuna dokunun, uygulamak için tekrar dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть %@, щоб почати слухати, натисніть ще раз, щоб застосувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn %@ để bắt đầu nghe, nhấn lại để áp dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻按 %@ 开始聆听，再次轻按即可应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕按 %@ 開始聆聽，再按一次即可套用。"
          }
        }
      }
    },
    "Tap %@ to start, tap again to stop.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
