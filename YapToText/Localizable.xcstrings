          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eigen sneltoets hieronder start en stopt elk dictee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój własny skrót poniżej rozpoczyna i zatrzymuje każde dyktowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
