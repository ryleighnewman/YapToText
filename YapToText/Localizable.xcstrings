          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en whisper.cpp-talemodell (.bin) eller en llama.cpp-opprydningsmodell (.gguf)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een whisper.cpp spraakmodel (.bin) of een llama.cpp opschoonmodel (.gguf)"
          }
        },
        "pl": {
          "stringUnit": {
