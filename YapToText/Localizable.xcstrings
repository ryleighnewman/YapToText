    "Status at a glance, controls one click away.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحالة في لمحة، والعناصر التحكمية على بعد نقرة واحدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stav na první pohled, ovládání na jedno kliknutí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Status med et blik, betjening et klik væk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Status auf einen Blick, Steuerung mit einem Klick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado de un vistazo, controles a un clic."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tila silmäyksellä, säätimet yhden napsautuksen päässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'état d'un coup d'œil, les commandes à un clic."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצב במבט אחד, פקדים בלחיצה אחת."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állapot egy pillantással, a vezérlők egy kattintásnyira."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status sekilas, kontrol hanya satu klik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stato a colpo d'occhio, comandi a un clic di distanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状態が一目でわかり、操作はワンクリックです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태는 한눈에, 조작은 한 번의 클릭으로."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Status med et blikk, kontroller ett klikk unna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Status in één oogopslag, bediening op één klik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stan na pierwszy rzut oka, sterowanie o jedno kliknięcie dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Status de relance, controles a um clique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статус на виду, управление в одном нажатии."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stav na prvý pohľad, ovládanie na jedno kliknutie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Status på en blick, kontroller ett klick bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูสถานะได้ทันที และควบคุมได้ในคลิกเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durum bir bakışta, kontroller bir tık uzakta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стан видно одразу, керування за один клік."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trạng thái nhìn một cái là thấy, điều khiển chỉ cách một lần nhấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态一目了然，控制只需一键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看清狀態，控制項只需一次點選。"
          }
        }
      }
    },
