            "state": "translated",
            "value": "Mikrofonen kunde inte starta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไมโครโฟนเริ่มทำงานไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon başlatılamadı."
          }
        },
        "uk": {
