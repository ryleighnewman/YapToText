          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file non è un modello supportato. I modelli vocali sono file whisper.cpp GGML .bin; i modelli di pulizia sono file llama.cpp GGUF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのファイルは対応しているモデルではありません。音声モデルは whisper.cpp の GGML .bin ファイル、クリーンアップモデルは llama.cpp の GGUF ファイルです。"
          }
        },
        "ko": {
          "stringUnit": {
