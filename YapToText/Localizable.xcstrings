    "Cleaning up what was misheard - nothing rewritten…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ تصحيح ما تم سماعه بشكل خاطئ، دون إعادة كتابة شيء…"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravuji přeslechnutá slova, nic se nepřepisuje…"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rydder op i det, der blev misforstået - intet omskrevet…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhörtes wird bereinigt, nichts wird umgeschrieben…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigiendo lo que se oyó mal, sin reescribir nada…"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siistitään väärin kuullut sanat, mitään ei kirjoiteta uudelleen…"
          }
        },
        "fr": {
