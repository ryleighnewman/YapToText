          "stringUnit": {
            "state": "translated",
            "value": "Ohje on aina sivupalkin alareunassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aide se trouve toujours en bas de la barre latérale."
