    "Spoken phrases like “scratch that” are inserted as ordinary text.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُدرج العبارات المنطوقة مثل “scratch that” كنص عادي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyslovené fráze jako „scratch that“ se vloží jako běžný text."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Talte udtryk som “scratch that” indsættes som almindelig tekst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesprochene Wendungen wie „scratch that“ werden als gewöhnlicher Text eingefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las frases habladas como “borra eso” se insertan como texto normal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhutut ilmaisut, kuten ”scratch that”, lisätään tavallisena tekstinä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les expressions dictées comme “efface ça” sont insérées comme du texte ordinaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטויים מדוברים כמו “scratch that” מוכנסים כטקסט רגיל."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kimondott kifejezések, mint a „scratch that”, sima szövegként kerülnek beszúrásra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Frasa lisan seperti “scratch that” dimasukkan sebagai teks biasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le frasi pronunciate come “scratch that” vengono inserite come testo normale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「scratch that」などの話した言葉は、通常のテキストとして挿入されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“scratch that”처럼 말한 표현은 일반 텍스트로 입력돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Talte fraser som «scratch that» settes inn som vanlig tekst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesproken zinnen zoals “scratch that” worden als gewone tekst ingevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypowiadane frazy, jak „skreśl to”, są wstawiane jako zwykły tekst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Frases faladas como “desfazer isso” são inseridas como texto comum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Произнесённые фразы вроде «зачеркни» вставляются как обычный текст."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasové frázy ako „zmaž to“ sa vkladajú ako bežný text."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Talade fraser som ”stryk det” infogas som vanlig text."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วลีที่พูดอย่าง “ลบที่พูดไป” จะถูกแทรกเป็นข้อความธรรมดา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“bunu sil” gibi konuşulan ifadeler sıradan metin olarak eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сказані фрази на кшталт «scratch that» вставляються як звичайний текст."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cụm từ nói như “xóa cái đó” được chèn như văn bản thông thường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像“scratch that”这样的口述短语会作为普通文字插入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "像「scratch that」這類口述片語會以一般文字插入。"
          }
        }
      }
    },
