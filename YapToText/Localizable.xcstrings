        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เร็วและเบา แม่นยำดีสำหรับการพิมพ์ด้วยเสียงทั่วไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük dikte için sağlam doğrulukla hızlı ve hafif."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Швидка й легка, з гарною точністю для щоденної диктовки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhanh và nhẹ, độ chính xác tốt cho đọc chính tả hằng ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速轻量，准确率稳定，适合日常听写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "速度快、體積輕，準確度可靠，適合日常聽寫。"
          }
        }
      }
    },
    "Fast and light, multilingual. Good for quick notes.": {
      "localizations": {
        "ar": {
