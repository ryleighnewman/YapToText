    "Emails become emails, chat stays as spoken, the rest is cleaned up.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتحول الرسائل الإلكترونية إلى رسائل، وتبقى الدردشة كما نُطقت، ويُنظَّف الباقي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "E-maily se změní na e-maily, chat zůstane tak, jak jste řekli, zbytek se upraví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mails bliver til e-mails, chat forbliver som sagt, resten ryddes op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mails werden zu E-Mails, Chat bleibt so, wie gesprochen, der Rest wird bereinigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los correos se convierten en correos, el chat se queda como lo dijiste y lo demás se limpia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sähköpostit muuttuvat sähköposteiksi, chat pysyy puhutussa muodossa ja muu siistitään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les e-mails deviennent des e-mails, le chat reste tel qu'énoncé, le reste est nettoyé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אימיילים הופכים לאימיילים, צ'אט נשאר כפי שנאמר, והשאר מנוקה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az e-mailek e-mailé válnak, a csevegés a kimondott formában marad, a többi tisztítást kap."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Email menjadi email, obrolan tetap seperti yang diucapkan, sisanya dibersihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le email diventano email, la chat resta com'è stata detta, il resto viene ripulito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールはメールらしく、チャットは話した通りに、その他は整えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일은 이메일로, 채팅은 말한 그대로, 나머지는 정리해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "E-poster blir til e-post, chat forblir slik den ble sagt, resten ryddes opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mails worden e-mails, chat blijft zoals gesproken, de rest wordt opgeschoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "E-maile stają się e-mailami, czat zostaje taki, jak wypowiedziano, a reszta jest oczyszczona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mails viram e-mails, o chat continua como foi falado, e o resto é limpo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Письма становятся письмами, переписка остаётся как продиктовано, всё остальное очищается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "E-maily sa zmenia na e-maily, rozhovor zostane taký, ako bol vyslovený, a zvyšok sa upraví."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "E-post blir e-post, chatt förblir som den sades, resten rensas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีเมลจะเป็นอีเมล แชทจะคงตามที่พูด ที่เหลือจะถูกทำความสะอาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-postalar e-posta olur, sohbet konuşulduğu gibi kalır, geri kalanı temizlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Листи стають листами, розмова лишається як сказана, решта очищується."
          }
        },
        "vi": {
          "stringUnit": {
