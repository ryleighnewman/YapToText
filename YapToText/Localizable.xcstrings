    "Fastest, lowest accuracy. Good for quick notes on older Macs.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسرع وأقل دقة. مناسب للملاحظات السريعة على أجهزة Mac القديمة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejrychlejší, nejnižší přesnost. Vhodné pro rychlé poznámky na starších Macích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtigst, lavest præcision. Godt til hurtige noter på ældre Mac'er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am schnellsten, geringste Genauigkeit. Gut für kurze Notizen auf älteren Macs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El más rápido, con la menor precisión. Bueno para notas rápidas en Mac más antiguos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nopein, pienin tarkkuus. Hyvä pikamuistiinpanoihin vanhemmilla Maceilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus rapide, avec la plus faible précision. Idéal pour de petites notes sur les anciens Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המהיר ביותר, הדיוק הנמוך ביותר. מתאים להערות מהירות על Macs ישנים."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A leggyorsabb, legkisebb pontosság. Gyors jegyzetekhez jó régebbi Maceken."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tercepat, akurasi paling rendah. Cocok untuk catatan cepat di Mac lama."
