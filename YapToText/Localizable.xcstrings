        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhanh nhất, độ chính xác thấp nhất. Phù hợp để ghi chú nhanh trên Mac đời cũ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
