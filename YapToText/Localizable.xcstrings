    "Set Right ⌘ to hold-to-talk and use it like a walkie-talkie.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط ⌘ الأيمن على الضغط المطول للتحدث، واستخدمه كجهاز اتصال لاسلكي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte pravou ⌘ na podržení pro mluvení a používejte ji jako vysílačku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt højre ⌘ til hold-for-at-tale og brug den som en walkie-talkie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle die rechte ⌘ auf Gedrückt halten zum Sprechen, und nutze sie wie ein Walkie-Talkie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura ⌘ derecha para mantener y hablar, y úsala como un walkie-talkie."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta oikea ⌘ pidä pohjassa puhumista varten ja käytä sitä kuin walkie-talkieta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez ⌘ droite en maintenir pour parler et utilisez-la comme un talkie-walkie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדר את ⌘ הימני לדבר בהחזקה והשתמש בו כמו walkie-talkie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsd be a jobb ⌘-t nyomva tartásos beszédre, és használd úgy, mint egy walkie-talkie-t."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur ⌘ Kanan sebagai tahan-untuk-bicara dan gunakan seperti walkie-talkie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta ⌘ destro su tieni premuto per parlare e usalo come un walkie-talkie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右 ⌘ を押し続けて話すように設定すると、トランシーバーのように使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 ⌘를 누르고 말하기로 설정하면 무전기처럼 쓸 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett høyre ⌘ til å holde for å snakke, og bruk den som en walkie-talkie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel rechter ⌘ in op ingedrukt houden om te praten en gebruik het als een walkietalkie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw prawy ⌘ jako przytrzymaj, aby mówić, i używaj go jak krótkofalówki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina ⌘ direito como segurar para falar e use-o como um walkie-talkie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте правый ⌘ для режима «удерживать, чтобы говорить» и пользуйтесь им как рацией."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte pravý ⌘ na podržanie na rozprávanie a používajte ho ako vysielačku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in höger ⌘ för håll-för-att-prata och använd den som en walkie-talkie."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้ง ⌘ ขวาเป็นกดค้างเพื่อพูด ใช้เหมือนวอกี้ทอกกี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağ ⌘'yi basılı tut-konuş olarak ayarlayın ve telsiz gibi kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте праву ⌘ як «утримувати, щоб говорити» і користуйтеся нею як рацією."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt ⌘ phải thành giữ để nói và dùng như bộ đàm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将右 ⌘ 设为按住说话，像对讲机一样使用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將右側 ⌘ 設為按住說話，像對講機一樣使用。"
          }
        }
      }
    },
