    "Right Command is tap to start and stop by default, or hold to talk if you prefer. Both keys can be remapped on the Home page.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ الأيمن يعمل بالنقر للبدء والإيقاف افتراضياً، أو بالضغط المطول للتحدث إن فضّلت. ويمكن إعادة تعيين المفتاحين من الصفحة الرئيسية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravý Command je ve výchozím nastavení klepnutím spouštěč i zastavovač, nebo podržením pro mluvení, pokud chcete. Obě klávesy lze přemapovat na domovské stránce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højre Command er som standard tryk for at starte og stoppe, eller hold for at tale, hvis du foretrækker det. Begge taster kan omlægges på startsiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die rechte Command-Taste startet und stoppt standardmäßig mit einem Tipp, oder du hältst sie zum Sprechen, falls du das bevorzugst. Beide Tasten lassen sich auf der Startseite neu belegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tecla Comando derecha inicia y detiene con un toque de forma predeterminada, o se mantiene para hablar si lo prefieres. Ambas teclas se pueden reasignar en la página Inicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikea Command toimii oletuksena napautuksella aloittamiseen ja lopettamiseen, tai pidä pohjassa puhuaksesi, jos haluat. Molemmat näppäimet voi määrittää uudelleen Etusivulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, ⌘ droite se touche pour démarrer et arrêter, ou se maintient pour parler si vous préférez. Les deux touches peuvent être réattribuées sur la page Accueil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ הימני מתחיל ועוצר בהקשה כברירת מחדל, או מחזיק כדי לדבר אם תעדיף. אפשר להגדיר את שני המקשים מחדש בדף הבית."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alapértelmezésben a jobb Command koppintásra indít és leállít, vagy ha úgy szeretnéd, tartsd lenyomva a beszédhez. Mindkét billentyű átállítható a Kezdőlapon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Kanan secara default ketuk untuk mulai dan berhenti, atau tahan untuk bicara jika Anda lebih suka. Kedua tombol bisa diatur ulang di halaman Beranda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per impostazione predefinita, ⌘ destro si usa toccando per avviare e fermare, oppure tenendo premuto per parlare, se preferisci. Entrambi i tasti si possono riassegnare nella pagina Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右 Command は既定でタップで開始・停止します。お好みで押し続けて話すこともできます。両方のキーはホームページで割り当て直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 오른쪽 Command는 탭해서 시작하고 멈추며, 원하면 누르고 말하기로 쓸 수 있어요. 두 키 모두 홈 페이지에서 다시 설정할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyre Kommando trykker for å starte og stoppe som standard, eller holder for å snakke hvis du foretrekker det. Begge tastene kan endres på Hjem-siden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechter Command is standaard tik om te starten en te stoppen, of ingedrukt houden om te praten als je dat liever hebt. Beide toetsen kunnen op de startpagina opnieuw worden ingesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prawy Command domyślnie działa stuknięciem, aby zacząć i zatrzymać, albo przytrzymaniem, jeśli wolisz. Oba klawisze można przypisać inaczej na stronie Start."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ direito é tocar para iniciar e parar por padrão, ou segurar para falar, se preferir. As duas teclas podem ser remapeadas na página Início."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию правый Command нажимается для запуска и остановки, или удерживается для разговора, если вам так удобнее. Обе клавиши можно переназначить на странице «Главная»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravý Command štandardne ťuknutím spustí a zastaví diktovanie, alebo ho podržte na rozprávanie, ak tak chcete. Oba klávesy môžete premapovať na stránke Domov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Höger Command startar och stoppar med ett tryck som standard, eller håll ned för att prata om du föredrar det. Båda tangenterna kan ändras på startsidan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ ขวาเป็นการแตะเพื่อเริ่มและหยุดตามค่าเริ่มต้น หรือกดค้างเพื่อพูดหากคุณต้องการ ปุ่มทั้งสองกำหนดใหม่ได้ในหน้าหลัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağ Command varsayılan olarak dokunup başlatma ve durdurma içindir, isterseniz konuşmak için basılı tutun. Her iki tuş da Ana sayfadan yeniden atanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За замовчуванням права Command натискається, щоб почати і зупинити, або утримується, щоб говорити, якщо вам так зручніше. Обидві клавіші можна перепризначити на сторінці «Головна»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ phải mặc định là nhấn để bắt đầu và dừng, hoặc giữ để nói nếu bạn thích. Cả hai phím đều có thể gán lại ở trang Trang chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认情况下，右 Command 键轻按即可开始和停止；如果你更喜欢，也可以按住说话。两个键都可以在主页上重新映射。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右側 Command 預設為輕按開始與停止；若你偏好，也可以設為按住說話。兩個按鍵都可以在「首頁」重新對應。"
          }
        }
      }
    },
    "Right after text lands, “scratch that” removes it and “replace X with Y” fixes it, no key needed. Only an exact whole phrase counts, within 30 seconds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مباشرة بعد ظهور النص، تحذفه عبارة “scratch that” وتصححه عبارة “replace X with Y”، دون الحاجة إلى مفتاح. تُحتسب العبارة الكاملة المطابقة فقط، خلال 30 ثانية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hned po vložení textu „scratch that“ text odstraní a „replace X with Y“ jej opraví, bez potřeby klávesy. Počítá se jen přesná celá fráze do 30 sekund."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lige efter tekst er indsat, fjerner “scratch that” den, og “replace X with Y” retter den, uden nogen tast. Kun en nøjagtig hel frase tæller, inden for 30 sekunder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt nachdem Text eingefügt wurde, entfernt „scratch that“ ihn, und „replace X with Y“ korrigiert ihn, ganz ohne Taste. Nur eine exakt passende Wendung zählt, innerhalb von 30 Sekunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Justo después de insertar el texto, “borra eso” lo elimina y “reemplaza X por Y” lo corrige, sin necesidad de tecla. Solo cuenta una frase exacta completa, dentro de 30 segundos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Heti tekstin lisäämisen jälkeen ”scratch that” poistaa sen ja ”replace X with Y” korjaa sen ilman näppäintä. Lasketaan vain tarkka koko ilmaisu 30 sekunnin sisällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Juste après l'insertion du texte, “efface ça” le supprime et “remplace X par Y” le corrige, sans touche à presser. Seule une expression exacte et complète compte, dans les 30 secondes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מיד אחרי שטקסט מגיע, “scratch that” מוחק אותו ו-“replace X with Y” מתקן אותו, בלי צורך במקש. נספרים רק ביטויים מדויקים ושלמים, בתוך 30 שניות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Közvetlenül a szöveg beszúrása után a „scratch that” eltávolítja, a „replace X with Y” pedig javítja, billentyű nélkül. Csak a pontos, teljes kifejezés számít, 30 másodpercen belül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepat setelah teks masuk, “scratch that” menghapusnya dan “replace X with Y” memperbaikinya, tanpa perlu tombol. Hanya frasa utuh yang persis yang dihitung, dalam 30 detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Subito dopo l'inserimento, “scratch that” lo elimina e “replace X with Y” lo corregge, senza bisogno di tasti. Conta solo una frase intera esatta, entro 30 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストが挿入された直後なら、「scratch that」でそのテキストを削除し、「replace X with Y」で修正できます。キーは不要です。完全一致のフレーズだけが対象で、30 秒以内に限ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트가 들어가자마자 “scratch that”이라고 하면 지우고, “replace X with Y”라고 하면 고쳐요. 키는 필요 없어요. 30초 안에 정확한 문구를 말해야 인식돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rett etter at tekst er satt inn, fjerner «scratch that» den, og «replace X with Y» retter den, uten tast. Bare en eksakt hel frase teller, innen 30 sekunder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct nadat tekst is ingevoegd, verwijdert “scratch that” die en corrigeert “replace X with Y” hem, zonder toets. Alleen een exacte, volledige zin telt, binnen 30 seconden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaraz po wstawieniu tekstu „skreśl to” go usuwa, a „zamień X na Y” poprawia, bez klawisza. Liczy się tylko dokładnie ta cała fraza, w ciągu 30 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo depois que o texto é inserido, “desfazer isso” o remove e “substituir X por Y” o corrige, sem precisar de tecla. Só conta uma frase inteira exata, em até 30 segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сразу после вставки текста фраза «зачеркни» его удаляет, а «замени X на Y» исправляет, без нажатия клавиш. Учитывается только точная фраза целиком, в течение 30 секунд."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hneď po vložení textu „zmaž to“ ho odstráni a „nahraď X za Y“ ho opraví, bez potreby klávesu. Počíta sa len presná celá fráza, do 30 sekúnd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt efter att text har landat tar ”stryk det” bort den och ”ersätt X med Y” rättar den, utan någon tangent. Bara en exakt hel fras räknas, inom 30 sekunder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทันทีหลังข้อความถูกแทรก “ลบที่พูดไป” จะลบออก และ “แทนที่ X ด้วย Y” จะแก้ไขให้ ไม่ต้องใช้ปุ่มใด ๆ นับเฉพาะวลีที่พูดตรงทั้งวลีภายใน 30 วินาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin yerleşir yerleşmez “bunu sil” onu kaldırır, “X yerine Y yaz” ise düzeltir; tuş gerekmez. Yalnızca tam ifade, 30 saniye içinde geçerlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одразу після вставлення тексту «scratch that» його видаляє, а «replace X with Y» виправляє, без жодної клавіші. Враховується лише точна фраза цілком, протягом 30 секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngay sau khi văn bản được chèn, nói “xóa cái đó” sẽ xóa nó và “thay X bằng Y” sẽ sửa lại, không cần phím nào. Chỉ cụm từ nguyên vẹn chính xác mới được tính, trong vòng 30 giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字刚输入后，说“scratch that”即可删除它，说“replace X with Y”即可修正它，无需按键。只有完整且准确的短语才会生效，且须在 30 秒内说出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字輸入後的短時間內，說「scratch that」會刪除該文字，說「replace X with Y」則會修正它，不需要按任何按鍵。只有完全相符的整句片語才會生效，且須在 30 秒內說出。"
          }
        }
      }
    },
    "Right now the room is too loud for this microphone: %.0f dB of voice over the noise, where 7 dB is the floor.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الغرفة صاخبة جداً على هذا الميكروفون الآن: %.0f dB من الصوت فوق الضوضاء، والحد الأدنى هو 7 dB."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Právě teď je v místnosti pro tento mikrofon příliš hlasitě: %.0f dB hlasu nad šumem, přičemž 7 dB je minimum."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lige nu er rummet for højlydt til denne mikrofon: %.0f dB stemme over støjen, hvor 7 dB er grænsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade ist der Raum für dieses Mikrofon zu laut: %.0f dB Stimme über dem Rauschen, wobei 7 dB die Untergrenze ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo la habitación es demasiado ruidosa para este micrófono: %.0f dB de voz sobre el ruido, cuando 7 dB es el mínimo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huone on juuri nyt liian meluisa tälle mikrofonille: ääntä on %.0f dB kohinan yli, kun raja on 7 dB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l'instant, la pièce est trop bruyante pour ce microphone : %.0f dB de voix au-dessus du bruit, alors que le minimum est de 7 dB."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כרגע החדר רועש מדי למיקרופון הזה: %.0f dB של קול מעל הרעש, כשהרף הוא 7 dB."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most túl hangos a szoba ehhez a mikrofonhoz: %.0f dB hang a zaj felett, ahol a minimum 7 dB."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ini ruangan terlalu bising untuk mikrofon ini: suara Anda %.0f dB di atas kebisingan, padahal batas minimal 7 dB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questo momento la stanza è troppo rumorosa per questo microfono: %.0f dB di voce sopra il rumore, dove 7 dB è il minimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、部屋が騒がしすぎてこのマイクでは聞き取れません。声とノイズの差は %.0f dB で、7 dB が下限です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 방이 이 마이크에 비해 너무 시끄러워요. 소음 대비 목소리가 %.0f dB인데, 최소 기준은 7 dB예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkurat nå er rommet for høylytt for denne mikrofonen: %.0f dB stemme over støyen, der 7 dB er minimum."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dit moment is de ruimte te luid voor deze microfoon: %.0f dB stem boven het geluid, waarbij 7 dB de ondergrens is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz w pomieszczeniu jest za głośno dla tego mikrofonu: %.0f dB głosu nad szumem, gdzie 7 dB to minimum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora o ambiente está barulhento demais para este microfone: %.0f dB de voz acima do ruído, sendo 7 dB o mínimo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас в комнате слишком шумно для этого микрофона: голос над шумом %.0f дБ, при том что минимум 7 дБ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Momentálne je v miestnosti pre tento mikrofón príliš hlasno: %.0f dB hlasu nad šumom, pričom 7 dB je minimum."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Just nu är rummet för högljutt för den här mikrofonen: %.0f dB röst över bruset, där 7 dB är golvet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ห้องเสียงดังเกินไปสำหรับไมโครโฟนนี้: เสียงพูดสูงกว่าเสียงรบกวน %.0f dB โดยค่าต่ำสุดคือ 7 dB"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda oda bu mikrofon için çok gürültülü: gürültünün üstünde %.0f dB ses var, oysa taban 7 dB'dir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз у кімнаті надто гучно для цього мікрофона: %.0f дБ голосу над шумом, при тому що мінімум становить 7 дБ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lúc này phòng quá ồn đối với micrô này: %.0f dB giọng nói so với tiếng ồn, trong khi 7 dB là mức tối thiểu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此刻房间对于该麦克风来说太吵了：人声高出噪音 %.0f dB，而 7 dB 是下限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前房間對這支麥克風來說太吵了：人聲比噪音高出 %.0f dB，而 7 dB 是最低門檻。"
          }
        }
      }
    },
