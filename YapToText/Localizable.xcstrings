          }
        }
      }
    },
    "Fast, literal speech-to-text with basic punctuation. No AI.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحويل سريع وحرفي للكلام إلى نص، مع علامات ترقيم أساسية. بدون ذكاء اصطناعي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rychlý doslovný přepis řeči se základní interpunkcí. Bez AI."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtig, ordret tale-til-tekst med grundlæggende tegnsætning. Ingen AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnelle, wörtliche Spracherkennung mit einfacher Zeichensetzung. Ohne KI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversión de voz a texto rápida y literal, con puntuación básica. Sin IA."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nopea, sanatarkka puheentunnistus perusvälimerkeillä. Ei tekoälyä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription rapide et littérale avec une ponctuation de base. Sans IA."
