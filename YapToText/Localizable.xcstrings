    "Models load once per launch. Every dictation after that is quick.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحمَّل النماذج مرة واحدة عند كل تشغيل. كل إملاء بعد ذلك يكون سريعاً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Modely se načtou jednou při spuštění. Každý další diktát je pak rychlý."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modeller indlæses én gang pr. start. Hver diktering derefter er hurtig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle werden einmal pro Start geladen. Jedes weitere Diktat ist danach schnell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos se cargan una vez por inicio. Cada dictado después es rápido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mallit latautuvat kerran käynnistyksessä. Jokainen sen jälkeinen sanelu on nopea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles se chargent une fois par lancement. Chaque dictée suivante est rapide."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המודלים נטענים פעם אחת בכל הפעלה. כל הכתבה אחרי זה מהירה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A modellek indításonként egyszer töltődnek be. Utána minden diktálás gyors."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model dimuat sekali setiap kali dibuka. Setiap dikte setelahnya cepat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli si caricano una volta per avvio. Ogni dettatura successiva è rapida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルは起動ごとに一度だけ読み込まれます。それ以降のディクテーションは素早く処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델은 실행할 때 한 번 불러와요. 그 뒤의 받아쓰기는 모두 빨라요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Modeller lastes én gang per oppstart. Hver diktering etter det er rask."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen laden één keer per start. Elk volgend dictee is snel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Modele ładują się raz przy każdym uruchomieniu. Każde kolejne dyktowanie jest szybkie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos carregam uma vez por abertura. Cada ditado depois disso é rápido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модели загружаются один раз при запуске. Каждая следующая диктовка быстрая."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Modely sa načítajú raz pri spustení. Každé ďalšie diktovanie je rýchle."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modeller läses in en gång per start. Varje diktering därefter går snabbt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลโหลดครั้งเดียวต่อการเปิดแอป การพิมพ์ด้วยเสียงหลังจากนั้นทุกครั้งจะรวดเร็ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modeller her açılışta bir kez yüklenir. Bundan sonraki her dikte hızlıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Моделі завантажуються один раз за запуск. Кожна наступна диктовка швидка."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình được tải một lần mỗi lần mở. Mọi lần đọc chính tả sau đó đều nhanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型在每次启动时加载一次。之后的每次听写都很快。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型每次啟動只需載入一次。之後的每次聽寫都很快。"
          }
        }
      }
    },
    "Models that follow the plug.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نماذج تتبع مصدر الطاقة."
