          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть, щоб редагувати виділений текст голосом одним натисканням клавіші."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật lên để chỉnh sửa văn bản đã chọn bằng giọng nói khi nhấn phím."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，按下按键即可通过语音编辑所选文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，按下按鍵即可用語音編輯選取的文字。"
