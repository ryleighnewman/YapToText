    "Two models, both on your Mac, both swappable.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نموذجان، كلاهما على Mac، وكلاهما قابل للاستبدال."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dva modely, oba na vašem Macu, oba lze vyměnit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "To modeller, begge på din Mac, begge kan skiftes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Modelle, beide auf deinem Mac, beide austauschbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos modelos, ambos en tu Mac, ambos intercambiables."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaksi mallia, molemmat Macilla, molemmat vaihdettavissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux modèles, tous deux sur votre Mac, tous deux interchangeables."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שני מודלים, שניהם במחשב שלך, שניהם ניתנים להחלפה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Két modell, mindkettő a Macen, mindkettő cserélhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua model, keduanya di Mac Anda, keduanya bisa diganti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due modelli, entrambi sul tuo Mac, entrambi sostituibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 つのモデルは、どちらも Mac 上にあり、どちらも交換できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 모델 모두 이 Mac에 있고, 둘 다 바꿀 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "To modeller, begge på Macen din, begge kan byttes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee modellen, beide op je Mac, beide te wisselen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa modele, oba na twoim Macu, oba wymienne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois modelos, ambos no seu Mac, ambos substituíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Две модели, обе на вашем Mac, обе можно заменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dva modely, oba vo vašom Macu, oba sa dajú vymeniť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Två modeller, båda på din Mac, båda utbytbara."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สองโมเดล ทั้งสองอยู่บน Mac ของคุณ และเปลี่ยนได้ทั้งคู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
