    "Text is inserted exactly as transcribed, regardless of what surrounds the cursor.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُدرج النص تماماً كما نُسخ، بغضّ النظر عمّا يحيط بالمؤشر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text se vloží přesně tak, jak byl přepsán, bez ohledu na okolí kurzoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst indsættes præcis som transskriberet, uanset hvad der omgiver markøren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text wird genau so eingefügt, wie er transkribiert wurde, unabhängig davon, was die Einfügemarke umgibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto se inserta exactamente como se transcribió, sin importar lo que rodee al cursor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksti lisätään täsmälleen litteroituna kohdistimen ympäristöstä riippumatta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte est inséré exactement comme transcrit, quel que soit ce qui entoure le curseur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטקסט מוכנס בדיוק כפי שתומלל, ללא קשר למה שמקיף את הסמן."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szöveg pontosan az átírás szerint kerül beszúrásra, függetlenül attól, mi veszi körül a kurzort."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks disisipkan persis seperti hasil transkripsi, apa pun yang ada di sekitar kursor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo viene inserito esattamente come trascritto, indipendentemente da ciò che circonda il cursore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソル周りの内容に関係なく、書き起こしたとおりにテキストを挿入します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서 주변과 상관없이 받아쓴 그대로 텍스트를 삽입해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst settes inn nøyaktig slik den er transkribert, uansett hva som omgir markøren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst wordt precies ingevoegd zoals getranscribeerd, ongeacht wat de cursor omringt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst jest wstawiany dokładnie tak, jak przetranskrybowano, niezależnie od otoczenia kursora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto é inserido exatamente como foi transcrito, independentemente do que cerca o cursor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст вставляется ровно так, как расшифрован, независимо от того, что окружает курсор."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Text sa vkladá presne tak, ako bol prepísaný, bez ohľadu na to, čo je okolo kurzora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Text infogas exakt som den transkriberades, oavsett vad som finns runt markören."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความจะถูกแทรกตามที่ถอดเสียงทุกประการ ไม่ว่าจะมีอะไรอยู่รอบเคอร์เซอร์ก็ตาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmlecin çevresinde ne olursa olsun metin, yazıya dökülen şekliyle eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст вставляється точно так, як транскрибовано, незалежно від того, що навколо курсора."
          }
        },
        "vi": {
