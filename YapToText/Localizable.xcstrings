        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk stopp och maxlängd följer Inställningar › Inspelning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การหยุดอัตโนมัติและความยาวสูงสุดทำตามการตั้งค่า › การบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik durdurma ve azami uzunluk Ayarlar › Kayıt bölümünü izler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автозупинка і максимальна тривалість визначаються в Налаштування › Запис."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự dừng và độ dài tối đa theo Cài đặt › Ghi âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动停止和最长时长跟随“设置 › 录音”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動停止與最大長度依「設定 › 錄音」設定。"
          }
        }
      }
    },
    "Automatic pasting needs the Accessibility permission. Until it's granted, dictations are copied to the clipboard instead. Grant it on the Home page.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج اللصق التلقائي إلى إذن إمكانية الوصول. إلى أن يُمنح، تُنسخ الإملاءات إلى الحافظة بدلاً من ذلك. امنحه من الصفحة الرئيسية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatické vkládání vyžaduje oprávnění Přístupnost. Dokud ho neudělíte, budou diktáty zkopírovány do schránky. Udělte je na domovské stránce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk indsættelse kræver tilladelsen Tilgængelighed. Indtil den er givet, kopieres diktater til udklipsholderen i stedet. Giv tilladelsen på startsiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisches Einfügen benötigt die Berechtigung für Bedienungshilfen. Bis sie erteilt ist, werden Diktate stattdessen in die Zwischenablage kopiert. Erteile sie auf der Startseite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pegado automático necesita el permiso de Accesibilidad. Mientras no se conceda, los dictados se copian al portapapeles. Concédelo en la página Inicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaattinen liittäminen vaatii saavutettavuusluvan. Ennen sitä sanelut kopioidaan leikepöydälle. Myönnä lupa Etusivulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le collage automatique nécessite l'autorisation Accessibilité. Tant qu'elle n'est pas accordée, les dictées sont copiées dans le presse-papiers à la place. Accordez-la sur la page Accueil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדבקה אוטומטית דורשת הרשאת נגישות. עד שהיא תינתן, ההכתבות יועתקו ללוח במקום. הענק אותה בדף הבית."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az automatikus beillesztéshez az Akadálymentesítés engedély kell. Amíg nincs megadva, a diktálások helyette a vágólapra kerülnek. Add meg a Kezdőlapon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempel otomatis memerlukan izin Aksesibilitas. Sampai izin diberikan, dikte disalin ke papan klip. Berikan izin di halaman Beranda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'incollaggio automatico richiede il permesso di Accessibilità. Finché non viene concesso, le dettature vengono copiate negli appunti. Concedilo nella pagina Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動ペーストにはアクセシビリティの権限が必要です。許可されるまでは、ディクテーションの結果はクリップボードにコピーされます。ホームページで許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 붙여넣기에는 손쉬운 사용 권한이 필요해요. 권한을 허용하기 전까지는 받아쓴 내용이 대신 클립보드에 복사돼요. 홈 페이지에서 허용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk liming krever tillatelsen Tilgjengelighet. Inntil den er gitt, kopieres dikteringer til utklippstavlen i stedet. Gi den på Hjem-siden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch plakken vereist de toestemming Toegankelijkheid. Totdat die is verleend, worden dictees naar het klembord gekopieerd. Verleen die op de startpagina."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczne wklejanie wymaga uprawnienia Dostępność. Dopóki go nie przyznasz, dyktowany tekst jest kopiowany do schowka. Przyznaj je na stronie Start."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A colagem automática precisa da permissão de Acessibilidade. Até que ela seja concedida, os ditados são copiados para a área de transferência. Conceda-a na página Início."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для автоматической вставки нужно разрешение «Универсальный доступ». Пока его нет, диктовка копируется в буфер обмена. Выдайте разрешение на странице «Главная»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatické vkladanie potrebuje povolenie Dostupnosti. Kým ho nepovolíte, diktáty sa namiesto toho skopírujú do schránky. Povoľte ho na stránke Domov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk inklistring kräver behörigheten Tillgänglighet. Tills den är beviljad kopieras dikteringar till urklipp i stället. Ge den på startsidan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวางอัตโนมัติต้องใช้สิทธิ์การเข้าถึง จนกว่าจะอนุญาต ข้อความที่พูดจะถูกคัดลอกไปยังคลิปบอร์ดแทน อนุญาตได้ที่หน้าหลัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik yapıştırma için Erişilebilirlik izni gerekir. Verilene kadar dikteler bunun yerine panoya kopyalanır. Ana sayfadan izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для автоматичного вставлення потрібен дозвіл Доступності. Поки його не надано, диктовки копіюються в буфер обміну. Надайте дозвіл на сторінці «Головна»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán tự động cần quyền Trợ năng. Cho đến khi được cấp, văn bản đọc chính tả sẽ được chép vào bảng nhớ tạm. Hãy cấp quyền ở trang Trang chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动粘贴需要辅助功能权限。在授予该权限之前，听写内容会改为复制到剪贴板。请在“主页”中授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動貼上需要「輔助使用」權限。在取得此權限之前，聽寫內容會改為複製到剪貼簿。請在「首頁」授予權限。"
          }
        }
      }
    },
