          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence está pronta. Os modos de IA estão disponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence готова. Режимы с ИИ доступны."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence je pripravený. Režimy AI sú k dispozícii."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence är redo. AI-lägena är tillgängliga."
          }
        },
        "th": {
