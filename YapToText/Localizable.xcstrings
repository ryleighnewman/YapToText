    "Secure Input is on (usually a password field). Click into normal text and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإدخال الآمن مُفعّل (عادةً حقل كلمة مرور). انقر داخل نص عادي وحاول مجدداً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabezpečený vstup je zapnutý (obvykle pole pro heslo). Klikněte do běžného textu a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikker indtastning er til (typisk et adgangskodefelt). Klik i almindelig tekst og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere Eingabe ist aktiv (meist ein Passwortfeld). Klicke in normalen Text und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entrada segura está activada (normalmente un campo de contraseña). Haz clic en un texto normal e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suojattu syöte on päällä (yleensä salasanakenttä). Napsauta tavalliseen tekstiin ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saisie sécurisée est activée (souvent un champ de mot de passe). Cliquez dans un texte normal et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קלט מאובטח פעיל (בדרך כלל שדה סיסמה). לחץ לתוך טקסט רגיל ונסה שוב."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A biztonságos bevitel be van kapcsolva (általában jelszómezőnél). Kattints normál szövegmezőbe, és próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Input Aman aktif (biasanya kolom kata sandi). Klik ke teks biasa lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Input sicuro attivo (di solito un campo password). Fai clic in un testo normale e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュア入力がオンです(通常はパスワード欄)。通常のテキスト欄をクリックして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 입력이 켜져 있어요(보통 암호 칸). 일반 텍스트 칸을 클릭하고 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikker inndata er på (vanligvis et passordfelt). Klikk i vanlig tekst og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veilige invoer staat aan (meestal een wachtwoordveld). Klik in normale tekst en probeer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpieczne wprowadzanie jest włączone (zwykle pole hasła). Kliknij w zwykły tekst i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Entrada Segura está ativa (geralmente um campo de senha). Clique em um texto normal e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защищённый ввод включён (обычно это поле пароля). Нажмите в обычный текст и попробуйте снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabezpečený vstup je zapnutý (zvyčajne ide o pole na heslo). Kliknite do bežného textu a skúste to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säker inmatning är på (oftast ett lösenordsfält). Klicka i vanlig text och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Input เปิดอยู่ (มักเป็นช่องรหัสผ่าน) คลิกเข้าไปในช่องข้อความปกติแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenli Giriş açık (genellikle bir parola alanı). Normal bir metin alanına tıklayıp yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Захищене введення увімкнено (зазвичай це поле пароля). Клацніть у звичайний текст і спробуйте знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập bảo mật đang bật (thường là ô mật khẩu). Hãy nhấp vào văn bản thông thường rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全输入已开启（通常是密码框）。请点击普通文字区域后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安全輸入已開啟（通常是密碼欄位）。請點選一般文字欄位後再試一次。"
          }
        }
      }
    },
    "Secure Input is on, so the selection can't be read": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإدخال الآمن مُفعّل، لذلك لا يمكن قراءة التحديد"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabezpečený vstup je zapnutý, takže výběr nelze přečíst"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikker indtastning er til, så markeringen kan ikke læses"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere Eingabe ist aktiv, daher kann die Markierung nicht gelesen werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entrada segura está activada, así que no se puede leer la selección"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suojattu syöte on päällä, joten valintaa ei voi lukea"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saisie sécurisée est activée, la sélection ne peut donc pas être lue"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קלט מאובטח פעיל, לכן לא ניתן לקרוא את הבחירה"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A biztonságos bevitel be van kapcsolva, így a kijelölés nem olvasható"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Input Aman aktif, sehingga pilihan tidak bisa dibaca"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Input sicuro è attivo, quindi la selezione non può essere letta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュア入力がオンのため、選択範囲を読み取れません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 입력이 켜져 있어서 선택 항목을 읽을 수 없어요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikker inndata er på, så markeringen kan ikke leses"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veilige invoer staat aan, dus de selectie kan niet worden gelezen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpieczne wprowadzanie jest włączone, więc zaznaczenia nie da się odczytać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Entrada Segura está ativa, então a seleção não pode ser lida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защищённый ввод включён, поэтому выделение не читается"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
