    "Removes filler words and false starts, fixes grammar and punctuation. The recommended default.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل كلمات الحشو والبدايات الخاطئة، ويصحح القواعد وعلامات الترقيم. الافتراضي الموصى به."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraní vycpávková slova a chybné začátky, opraví gramatiku a interpunkci. Doporučené výchozí nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner fyldord og falske starter og retter grammatik og tegnsætning. Den anbefalede standard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt Füllwörter und Fehlstarts, korrigiert Grammatik und Zeichensetzung. Der empfohlene Standard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita muletillas y arranques en falso, y corrige la gramática y la puntuación. El predeterminado recomendado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa täytesanat ja väärät alut sekä korjaa kieliopin ja välimerkit. Suositeltu oletus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les mots parasites et les faux départs, corrige la grammaire et la ponctuation. Le choix recommandé par défaut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסיר מילות מילוי והתחלות שגויות, מתקן דקדוק ופיסוק. ברירת המחדל המומלצת."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolítja a töltelékszavakat és a félbehagyott mondatokat, javítja a nyelvtant és az írásjeleket. Az ajánlott alapértelmezett."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus kata pengisi dan awal kalimat yang keliru, memperbaiki tata bahasa dan tanda baca. Default yang direkomendasikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove riempitivi e false partenze, corregge grammatica e punteggiatura. Il predefinito consigliato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「えー」などのフィラーや言い直しを取り除き、文法と句読点を修正します。おすすめの既定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "군더더기 말과 말 더듬을 빼고, 문법과 문장 부호를 고쳐요. 추천 기본값이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner fyllord og falske starter, retter grammatikk og tegnsetting. Den anbefalte standarden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert vulwoorden en valse starts, corrigeert grammatica en interpunctie. De aanbevolen standaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa słowa wypełniacze i przerwane zaczęcia, poprawia gramatykę i interpunkcję. Zalecane domyślne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove palavras de preenchimento e começos falsos, corrige gramática e pontuação. O padrão recomendado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет слова-паразиты и оговорки, исправляет грамматику и пунктуацию. Рекомендуемый вариант по умолчанию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstráni výplňové slová a začiatky viet, opraví gramatiku a interpunkciu. Odporúčaná predvoľba."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar bort utfyllnadsord och falska starter, rättar grammatik och skiljetecken. Den rekommenderade standarden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบคำติดปากและการเริ่มผิด แก้ไวยากรณ์และเครื่องหมายวรรคตอน ค่าเริ่มต้นที่แนะนำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolgu sözcüklerini ve yanlış başlangıçları kaldırır, dilbilgisini ve noktalamayı düzeltir. Önerilen varsayılan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прибирає слова-паразити і хибні початки, виправляє граматику і пунктуацію. Рекомендований типовий варіант."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loại bỏ từ đệm và chỗ ngập ngừng, sửa ngữ pháp và dấu câu. Mặc định được đề xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去除语气词和重复的起句，修正语法和标点。推荐的默认选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除贅詞與重新開始的片段，修正文法與標點符號。建議的預設選項。"
          }
        }
      }
    },
    "Reopen this window from the menu bar icon or your dictation key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد فتح هذه النافذة من أيقونة شريط القوائم أو من مفتاح الإملاء."
