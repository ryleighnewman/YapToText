    "so it's always spelled and capitalized this way": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى تُكتب دائماً بهذه التهجئة وحالة الأحرف"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "takže se to vždy píše a velkými písmeny tímto způsobem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "så den altid staves og skrives med versaler på denne måde"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "damit es immer so geschrieben und großgeschrieben wird"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "así siempre se escribe y se pone en mayúscula de esta forma"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "joten se kirjoitetaan aina näin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "pour qu'il soit toujours écrit et mis en majuscules ainsi"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כך שזה תמיד ייכתב ויוגדל כך"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "így mindig ebben az írásmódban és nagybetűzéssel jelenik meg"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "agar selalu dieja dan dikapitalisasi dengan cara ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "così viene sempre scritto e maiuscolato in questo modo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのため、常にこの綴りと大文字・小文字で表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래서 항상 이 철자와 대소문자로 표시돼요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "så det alltid staves og skrives med store bokstaver på denne måten"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "zodat het altijd zo gespeld en met hoofdletters wordt geschreven"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "tak aby zawsze było pisane i pisane wielkimi literami w ten sposób"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "para que seja sempre escrito e capitalizado deste jeito"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "чтобы всегда писалось и с заглавной именно так"
          }
        },
        "sk": {
