    "Shows your words while you speak. Costs extra battery with Whisper models.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض كلماتك أثناء الكلام. يستهلك بطارية إضافية مع نماذج Whisper."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje vaše slova během mluvení. U modelů Whisper spotřebuje víc baterie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser dine ord, mens du taler. Koster ekstra batteri med Whisper-modeller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt deine Worte, während du sprichst. Verbraucht mit Whisper-Modellen zusätzlich Akku."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tus palabras mientras hablas. Consume más batería con los modelos Whisper."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää sanasi puhuessasi. Whisper-malleilla kuluttaa ylimääräistä akkua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche vos mots pendant que vous parlez. Consomme davantage de batterie avec les modèles Whisper."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג את המילים שלך בזמן שאתה מדבר. עולה סוללה נוספת עם מודלי Whisper."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beszéd közben megjeleníti a szavaidat. Whisper modellekkel extra akkumulátort fogyaszt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan kata-kata Anda saat bicara. Memakan baterai ekstra dengan model Whisper."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le tue parole mentre parli. Con i modelli Whisper consuma più batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話している間に言葉を表示します。Whisper モデルではバッテリーを余分に消費します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하는 동안 말을 보여 줘요. Whisper 모델에서는 배터리를 더 써요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser ordene dine mens du snakker. Koster litt ekstra batteri med Whisper-modeller."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont je woorden terwijl je spreekt. Kost extra batterij met Whisper-modellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje twoje słowa podczas mówienia. Modele Whisper zużywają przy tym więcej baterii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra suas palavras enquanto você fala. Consome mais bateria com modelos Whisper."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает ваши слова, пока вы говорите. С моделями Whisper расходует дополнительный заряд батареи."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje vaše slová počas rozprávania. Pri modeloch Whisper stojí viac batérie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar dina ord medan du talar. Kostar extra batteri med Whisper-modeller."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงคำของคุณขณะพูด ใช้แบตเตอรี่เพิ่มเมื่อใช้โมเดล Whisper"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuştukça sözcüklerinizi gösterir. Whisper modelleriyle ekstra pil harcar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує ваші слова, поки ви говорите. З моделями Whisper трохи витрачає батарею."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện lời bạn trong khi nói. Tốn thêm pin với mô hình Whisper."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你说话时显示你的文字。使用 Whisper 模型时会额外消耗电池。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說話時顯示你的文字。使用 Whisper 模型會額外耗電。"
          }
        }
      }
    },
