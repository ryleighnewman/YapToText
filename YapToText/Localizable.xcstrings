    "Insert text automatically is off, so each dictation is copied to the clipboard. Turn it on from the [Dictation page](yap://dictation).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خاصية الإدراج التلقائي للنص مُعطّلة، لذلك يُنسخ كل إملاء إلى الحافظة. فعّلها من [صفحة الإملاء](yap://dictation)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatické vkládání textu je vypnuté, takže se každý diktát zkopíruje do schránky. Zapněte jej na [stránce Diktování](yap://dictation)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt tekst automatisk er slået fra, så hver diktering kopieres til udklipsholderen. Slå den til på [siden Diktering](yap://dictation)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text automatisch einfügen ist ausgeschaltet, daher wird jedes Diktat in die Zwischenablage kopiert. Schalte es auf der [Seite Diktat](yap://dictation) ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Insertar texto automáticamente está desactivado, así que cada dictado se copia al portapapeles. Actívalo desde la [página Dictado](yap://dictation)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstin automaattinen lisäys on pois päältä, joten jokainen sanelu kopioidaan leikepöydälle. Ota se käyttöön [Sanelu-sivulta](yap://dictation)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'insertion automatique du texte est désactivée, donc chaque dictée est copiée dans le presse-papiers. Activez-la depuis la [page Dictée](yap://dictation)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכנסת טקסט אוטומטית כבויה, לכן כל הכתבה מועתקת ללוח. הפעל אותה מ[דף ההכתבה](yap://dictation)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az automatikus szövegbeszúrás ki van kapcsolva, ezért minden diktálás a vágólapra kerül. Kapcsold be a [Diktálás oldalon](yap://dictation)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisipkan teks otomatis nonaktif, jadi setiap dikte disalin ke papan klip. Aktifkan dari [halaman Dikte](yap://dictation)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'inserimento automatico del testo è disattivato, quindi ogni dettatura viene copiata negli appunti. Attivalo dalla [pagina Dettatura](yap://dictation)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストの自動挿入がオフのため、各ディクテーションはクリップボードにコピーされます。[ディクテーションページ](yap://dictation) でオンにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 자동 삽입이 꺼져 있어서 받아쓴 내용이 클립보드에 복사돼요. [받아쓰기 페이지](yap://dictation)에서 켤 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett inn tekst automatisk er av, så hver diktering kopieres til utklippstavlen. Slå det på fra [Diktering-siden](yap://dictation)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst automatisch invoegen staat uit, dus elk dictee wordt naar het klembord gekopieerd. Schakel het in via de [pagina Dicteren](yap://dictation)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczne wstawianie tekstu jest wyłączone, więc każde dyktowanie jest kopiowane do schowka. Włącz je na [stronie Dyktowanie](yap://dictation)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A inserção automática de texto está desativada, então cada ditado é copiado para a área de transferência. Ative-a na [página Ditado](yap://dictation)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматическая вставка текста выключена, поэтому каждая диктовка копируется в буфер обмена. Включите её на [странице «Диктовка»](yap://dictation)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatické vkladanie textu je vypnuté, takže sa každý diktát skopíruje do schránky. Zapnite ho na [stránke Diktovanie](yap://dictation)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Infoga text automatiskt är avstängt, så varje diktering kopieras till urklipp. Slå på det på [sidan Diktering](yap://dictation)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดการแทรกข้อความอัตโนมัติอยู่ การพิมพ์ด้วยเสียงแต่ละครั้งจึงถูกคัดลอกไปยังคลิปบอร์ด เปิดได้จาก [หน้าการพิมพ์ด้วยเสียง](yap://dictation)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metni otomatik ekle kapalı olduğundan her dikte panoya kopyalanır. [Dikte sayfasından](yap://dictation) açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматичне вставлення тексту вимкнено, тож кожна диктовка копіюється в буфер обміну. Увімкніть його на [сторінці «Диктовка»](yap://dictation)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động chèn văn bản đang tắt, nên mỗi lần đọc được chép vào bảng nhớ tạm. Hãy bật trong [trang Đọc chính tả](yap://dictation)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动插入文字”已关闭，因此每次听写都会复制到剪贴板。你可以在[听写页面](yap://dictation)中开启它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前已關閉「自動插入文字」，因此每次聽寫都會複製到剪貼簿。你可以在 [聽寫頁面](yap://dictation) 開啟此功能。"
          }
        }
      }
    },
