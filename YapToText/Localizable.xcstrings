        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลทำความสะอาดล้มเหลวขณะสร้างผลลัพธ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizleme modeli oluşturma sırasında başarısız oldu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель очищення зазнала помилки під час генерації."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình làm sạch bị lỗi khi đang tạo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理模型在生成时失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理模型在產生時失敗。"
          }
        }
      }
    },
