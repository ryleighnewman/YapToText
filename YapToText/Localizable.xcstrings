            "state": "translated",
            "value": "Rápido y ligero, multilingüe. Bueno para notas rápidas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nopea ja kevyt, monikielinen. Hyvä pikamuistiinpanoihin."
          }
        },
        "fr": {
