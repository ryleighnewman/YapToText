    "That file isn't a supported model. Speech models are whisper.cpp GGML .bin files; cleanup models are llama.cpp GGUF files.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف ليس نموذجاً مدعوماً. نماذج الكلام هي ملفات whisper.cpp GGML ‎.bin، ونماذج التنظيف هي ملفات llama.cpp GGUF."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento soubor není podporovaný model. Modely řeči jsou soubory whisper.cpp GGML .bin, modely úpravy jsou soubory llama.cpp GGUF."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fil er ikke en understøttet model. Talemodeller er whisper.cpp GGML .bin-filer; oprydningsmodeller er llama.cpp GGUF-filer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist kein unterstütztes Modell. Sprachmodelle sind whisper.cpp-GGML-Dateien (.bin), Bereinigungsmodelle sind llama.cpp-GGUF-Dateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese archivo no es un modelo compatible. Los modelos de voz son archivos .bin GGML de whisper.cpp; los modelos de limpieza son archivos GGUF de llama.cpp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tiedosto ei ole tuettu malli. Puhemallit ovat whisper.cpp GGML .bin -tiedostoja, siistintämallit llama.cpp GGUF -tiedostoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n'est pas un modèle pris en charge. Les modèles de parole sont des fichiers whisper.cpp GGML .bin ; les modèles de nettoyage sont des fichiers llama.cpp GGUF."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ הזה אינו מודל נתמך. מודלי דיבור הם קבצי whisper.cpp בפורמט GGML ‎.bin; מודלי ניקוי הם קבצי llama.cpp בפורמט GGUF."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a fájl nem támogatott modell. A beszédmodellek whisper.cpp GGML .bin fájlok, a tisztító modellek llama.cpp GGUF fájlok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
