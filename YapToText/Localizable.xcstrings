    "Required so YapToText can hear you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب حتى يتمكن YapToText من سماعك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžadováno, aby vás YapToText slyšel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Krævet, så YapToText kan høre dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erforderlich, damit YapToText dich hören kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesario para que YapToText pueda oírte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarvitaan, jotta YapToText kuulee sinut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour que YapToText vous entende."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרש כדי ש-YapToText ישמע אותך."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szükséges ahhoz, hogy a YapToText hallhasson."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperlukan agar YapToText bisa mendengar Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessario affinché YapToText possa sentirti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText があなたの声を聞くために必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText가 들을 수 있도록 필요해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreves for at YapToText skal kunne høre deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereist zodat YapToText je kan horen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagane, aby YapToText mógł cię słyszeć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessário para o YapToText ouvir você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно, чтобы YapToText мог вас слышать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje sa, aby vás YapToText počul."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Krävs för att YapToText ska kunna höra dig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำเป็นเพื่อให้ YapToText ได้ยินคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText'in sizi duyabilmesi için gerekli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібно, щоб YapToText міг вас чути."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần thiết để YapToText nghe được bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText 需要此权限才能听到你的声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "YapToText 需要此權限才能聽到你的聲音。"
          }
        }
      }
    },
    "Required to paste your dictations into other apps, and for the global shortcuts. Without it, text is copied to the clipboard.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب للصق إملاءاتك في تطبيقات أخرى، وللاختصارات العامة. بدونه يُنسخ النص إلى الحافظة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžadováno pro vkládání diktátů do jiných aplikací a pro globální zkratky. Bez něj se text zkopíruje do schránky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Krævet for at indsætte dine diktater i andre apps og for de globale genveje. Uden den kopieres teksten til udklipsholderen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nötig, um deine Diktate in andere Apps einzufügen und für die globalen Kurzbefehle. Ohne sie wird Text in die Zwischenablage kopiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesario para pegar tus dictados en otras apps y para los atajos globales. Sin él, el texto se copia al portapapeles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarvitaan sanelujen liittämiseen muihin sovelluksiin ja yleisiin pikanäppäimiin. Ilman sitä teksti kopioidaan leikepöydälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour coller vos dictées dans d'autres apps et pour les raccourcis globaux. Sans elle, le texte est copié dans le presse-papiers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרש כדי להדביק הכתבות לאפליקציות אחרות, ולקיצורי הדרך הגלובליים. בלעדיו, הטקסט מועתק ללוח."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szükséges a diktálások más alkalmazásokba való beillesztéséhez és a globális parancsikonokhoz. Nélküle a szöveg a vágólapra másolódik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperlukan untuk menempelkan dikte ke aplikasi lain, dan untuk pintasan global. Tanpa ini, teks disalin ke papan klip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessario per incollare le dettature in altre app e per le scorciatoie globali. Senza di esso, il testo viene copiato negli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディクテーションを他のアプリにペーストしたり、グローバルショートカットを使ったりするために必要です。これがないと、テキストはクリップボードにコピーされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓴 내용을 다른 앱에 붙여넣고 전역 단축키를 쓰려면 필요해요. 없으면 텍스트가 클립보드에 복사돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreves for å lime inn dikteringene dine i andre apper og for globale snarveier. Uten den kopieres teksten til utklippstavlen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereist om je dictees in andere apps te plakken, en voor de globale sneltoetsen. Zonder dit wordt tekst naar het klembord gekopieerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagane, aby wklejać dyktowane teksty do innych aplikacji oraz do skrótów globalnych. Bez tego tekst jest kopiowany do schowka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessário para colar seus ditados em outros apps e para os atalhos globais. Sem ele, o texto é copiado para a área de transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно, чтобы вставлять диктовку в другие приложения и для глобальных команд. Без него текст копируется в буфер обмена."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje sa na vkladanie diktátov do iných aplikácií a na globálne skratky. Bez neho sa text skopíruje do schránky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Krävs för att klistra in dina dikteringar i andra appar och för globala genvägar. Utan den kopieras text till urklipp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำเป็นสำหรับการวางการพิมพ์ด้วยเสียงลงในแอปอื่นและทางลัดส่วนกลาง หากไม่มี ข้อความจะถูกคัดลอกไปยังคลิปบอร์ด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteleri diğer uygulamalara yapıştırmak ve genel kısayollar için gereklidir. Olmadan metin panoya kopyalanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібно для вставлення диктовок в інші програми і для глобальних комбінацій. Без цього текст копіюється в буфер обміну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần để dán lời đọc chính tả vào ứng dụng khác và cho các phím tắt toàn cục. Không có quyền này, văn bản sẽ được chép vào bảng nhớ tạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要此权限才能将听写内容粘贴到其他应用中，并用于全局快捷键。没有此权限时，文字会复制到剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於將聽寫內容貼上到其他 App，以及全域快捷鍵。若未授權，文字會複製到剪貼簿。"
          }
        }
      }
    },
    "Required to paste your words into other apps automatically, for the Right ⌘ key, and for reading selected text. Without it, dictations are copied to the clipboard instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب للصق كلماتك تلقائياً في تطبيقات أخرى، ولمفتاح ⌘ الأيمن، ولقراءة النص المحدد. بدونه تُنسخ الإملاءات إلى الحافظة بدلاً من ذلك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžadováno pro automatické vkládání vašich slov do jiných aplikací, pro pravou ⌘ a pro čtení označeného textu. Bez něj se diktáty zkopírují do schránky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Krævet for automatisk at indsætte dine ord i andre apps, for højre ⌘-tasten og for at læse markeret tekst. Uden den kopieres diktater i stedet til udklipsholderen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nötig, um deine Worte automatisch in andere Apps einzufügen, für die rechte ⌘-Taste und zum Lesen markierten Texts. Ohne sie werden Diktate stattdessen in die Zwischenablage kopiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesario para pegar tus palabras en otras apps automáticamente, para la tecla ⌘ derecha y para leer el texto seleccionado. Sin él, los dictados se copian al portapapeles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarvitaan sanojesi automaattiseen liittämiseen muihin sovelluksiin, oikealle ⌘-näppäimelle ja valitun tekstin lukemiseen. Ilman sitä sanelut kopioidaan leikepöydälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour coller automatiquement vos mots dans d'autres apps, pour la touche ⌘ droite, et pour lire le texte sélectionné. Sans elle, les dictées sont copiées dans le presse-papiers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרש כדי להדביק את המילים שלך באפליקציות אחרות אוטומטית, עבור מקש ⌘ הימני, ולקריאת טקסט נבחר. בלעדיו, ההכתבות מועתקות ללוח במקום."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szükséges a szavaid automatikus beillesztéséhez más alkalmazásokba, a jobb ⌘ billentyűhöz és a kijelölt szöveg olvasásához. Nélküle a diktálások helyette a vágólapra másolódnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperlukan untuk menempel kata-kata Anda ke aplikasi lain secara otomatis, untuk tombol ⌘ Kanan, dan untuk membaca teks yang dipilih. Tanpa ini, dikte disalin ke papan klip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessario per incollare automaticamente le tue parole in altre app, per il tasto ⌘ destro e per leggere il testo selezionato. Senza di esso, le dettature vengono copiate negli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のアプリへ自動でペーストするため、右 ⌘ キーのため、選択テキストの読み取りのために必要です。これがないと、ディクテーションはクリップボードにコピーされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말을 다른 앱에 자동으로 붙여넣고, 오른쪽 ⌘ 키를 쓰고, 선택한 텍스트를 읽는 데 필요해요. 없으면 받아쓰기 결과가 대신 클립보드에 복사돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreves for å lime inn ordene dine i andre apper automatisk, for høyre ⌘-tasten og for å lese markert tekst. Uten den kopieres dikteringer til utklippstavlen i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereist om je woorden automatisch in andere apps te plakken, voor de rechter ⌘-toets, en om geselecteerde tekst te lezen. Zonder dit worden dictees naar het klembord gekopieerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagane do automatycznego wklejania twoich słów do innych aplikacji, dla prawego klawisza ⌘ oraz do odczytu zaznaczonego tekstu. Bez tego dyktowania są kopiowane do schowka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessário para colar suas palavras em outros apps automaticamente, para a tecla ⌘ direito e para ler o texto selecionado. Sem ele, os ditados são copiados para a área de transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен для автоматической вставки ваших слов в другие приложения, для клавиши правый ⌘ и для чтения выделенного текста. Без него диктовки копируются в буфер обмена."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje sa na automatické vkladanie slov do iných aplikácií, pre kláves pravý ⌘ a na čítanie označeného textu. Bez neho sa diktáty namiesto toho skopírujú do schránky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Krävs för att automatiskt klistra in dina ord i andra appar, för höger ⌘-tangenten och för att läsa markerad text. Utan den kopieras dikteringar till urklipp i stället."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำเป็นสำหรับการวางคำของคุณลงในแอปอื่นโดยอัตโนมัติ สำหรับปุ่ม ⌘ ขวา และสำหรับการอ่านข้อความที่เลือก หากไม่มี การพิมพ์ด้วยเสียงจะถูกคัดลอกไปยังคลิปบอร์ดแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sözcüklerinizi diğer uygulamalara otomatik yapıştırmak, Sağ ⌘ tuşu ve seçili metni okumak için gerekli. Olmadan dikteler bunun yerine panoya kopyalanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібно для автоматичного вставлення ваших слів в інші програми, для клавіші Права ⌘ і для читання виділеного тексту. Без цього диктовки копіюються в буфер обміну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần để tự động dán lời bạn nói vào ứng dụng khác, cho phím ⌘ phải, và để đọc vùng chọn. Không có quyền này, lần đọc chính tả sẽ được chép vào bảng nhớ tạm thay thế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于将你的文字自动粘贴到其他应用中、用于右 ⌘ 键，以及用于读取所选文字。没有它，听写内容会改为复制到剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於自動將你的文字貼上到其他 App、右側 ⌘ 按鍵，以及讀取選取的文字。未授權時，聽寫內容會改為複製到剪貼簿。"
          }
        }
      }
    },
