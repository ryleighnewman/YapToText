          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережено. Клацніть поле, щоб змінити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu. Nhấp vào ô để thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
