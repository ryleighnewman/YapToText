          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите, чтобы редактировать выделенный текст голосом одним нажатием клавиши."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite, ak chcete upravovať označený text hlasom stlačením klávesu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på den för att redigera markerad text med röst med ett tangenttryck."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดเพื่อแก้ไขข้อความที่เลือกด้วยเสียงโดยการกดปุ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
