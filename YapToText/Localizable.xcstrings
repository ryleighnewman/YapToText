          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เร็วที่สุด แต่ความแม่นยำต่ำที่สุด เหมาะสำหรับโน้ตสั้น ๆ บน Mac รุ่นเก่า"
