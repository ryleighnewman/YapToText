    "Microphone access is needed to hear you. Accessibility permission is needed to type into other apps; without it, the text goes to your clipboard instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب الوصول إلى الميكروفون ليسمعك التطبيق. ومطلوب إذن إمكانية الوصول للكتابة في تطبيقات أخرى؛ وبدونه يذهب النص إلى الحافظة بدلاً من ذلك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístup k mikrofonu je potřeba, aby vás slyšel. Oprávnění Přístupnost je potřeba pro psaní do jiných aplikací; bez něj text půjde do schránky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgang til mikrofonen er nødvendig for at høre dig. Tilladelsen Tilgængelighed er nødvendig for at skrive i andre apps; uden den går teksten til udklipsholderen i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf das Mikrofon wird benötigt, damit dich die App hören kann. Die Berechtigung für Bedienungshilfen wird benötigt, um in andere Apps zu tippen; ohne sie landet der Text stattdessen in der Zwischenablage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita acceso al micrófono para oírte. El permiso de Accesibilidad es necesario para escribir en otras apps; sin él, el texto va al portapapeles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonin käyttöoikeus tarvitaan, jotta sinut kuullaan. Saavutettavuusluvan avulla voidaan kirjoittaa muihin sovelluksiin. Ilman sitä teksti menee leikepöydälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au microphone est nécessaire pour vous entendre. L'autorisation Accessibilité est nécessaire pour taper dans d'autres apps ; sans elle, le texte va dans votre presse-papiers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרשת גישה למיקרופון כדי לשמוע אותך. נדרשת הרשאת נגישות כדי להקליד באפליקציות אחרות; בלעדיה הטקסט הולך ללוח."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mikrofon-hozzáférés kell ahhoz, hogy hallhassunk. Az Akadálymentesítés engedély kell más alkalmazásokba gépeléshez; nélküle a szöveg a vágólapra kerül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon diperlukan untuk mendengar Anda. Izin Aksesibilitas diperlukan untuk mengetik ke aplikasi lain; tanpa itu, teks masuk ke papan klip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve l'accesso al microfono per sentirti. Il permesso di Accessibilità serve per scrivere in altre app; senza di esso, il testo va negli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声を聞くためにマイクへのアクセスが必要です。他のアプリに入力するにはアクセシビリティの権限が必要です。権限がない場合、テキストはクリップボードに入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목소리를 들으려면 마이크 접근 권한이 필요해요. 다른 앱에 입력하려면 손쉬운 사용 권한이 필요하고, 없으면 텍스트가 대신 클립보드로 가요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgang til mikrofonen trengs for å høre deg. Tillatelsen Tilgjengelighet trengs for å skrive i andre apper; uten den går teksten til utklippstavlen i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot de microfoon is nodig om je te horen. Toegankelijkheid is nodig om in andere apps te typen; zonder dat gaat de tekst naar je klembord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do mikrofonu jest potrzebny, aby cię słyszeć. Uprawnienie Dostępność jest potrzebne do pisania w innych aplikacjach; bez niego tekst trafi do schowka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone é necessário para ouvir você. A permissão de Acessibilidade é necessária para digitar em outros apps; sem ela, o texto vai para a área de transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен доступ к микрофону, чтобы слышать вас. Для печати в другие приложения нужен «Универсальный доступ». Без него текст попадёт в буфер обмена."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prístup k mikrofónu je potrebný, aby vás počul. Povolenie Dostupnosti je potrebné na písanie v iných aplikáciách; bez neho sa text skopíruje do schránky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtkomst till mikrofonen behövs för att höra dig. Behörigheten Tillgänglighet behövs för att skriva i andra appar; utan den hamnar texten på urklipp i stället."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องใช้สิทธิ์ไมโครโฟนเพื่อได้ยินคุณ ต้องใช้สิทธิ์การเข้าถึงเพื่อพิมพ์ลงแอปอื่น หากไม่มี ข้อความจะไปยังคลิปบอร์ดแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizi duyabilmek için mikrofon erişimi gerekli. Diğer uygulamalara yazabilmek için Erişilebilirlik izni gerekli; olmadan metin bunun yerine panoya gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен доступ до мікрофона, щоб вас чути. Дозвіл Доступності потрібен, щоб друкувати в інших програмах; без нього текст піде в буфер обміну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần quyền micrô để nghe bạn. Quyền Trợ năng cần để gõ vào ứng dụng khác; không có quyền này, văn bản sẽ chuyển vào bảng nhớ tạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要麦克风权限才能听到你的声音。需要辅助功能权限才能向其他应用输入文字；没有它，文字将改为复制到剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要麥克風存取權限才能聽到你的聲音。需要輔助使用權限才能輸入到其他 App；若未授權，文字會改為送到剪貼簿。"
          }
        }
      }
    },
    "Microphone access is needed. Enable it in System Settings > Privacy & Security > Microphone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب الوصول إلى الميكروفون. فعّله من إعدادات النظام > الخصوصية والأمان > الميكروفون."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je potřeba přístup k mikrofonu. Povolte jej v Nastavení systému > Soukromí a zabezpečení > Mikrofon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgang til mikrofonen er nødvendig. Slå den til under Systemindstillinger > Anonymitet & sikkerhed > Mikrofon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf das Mikrofon wird benötigt. Aktiviere ihn unter Systemeinstellungen > Datenschutz & Sicherheit > Mikrofon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita acceso al micrófono. Actívalo en Ajustes del Sistema > Privacidad y seguridad > Micrófono."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonin käyttöoikeus tarvitaan. Ota se käyttöön kohdassa Järjestelmäasetukset > Yksityisyys ja turvallisuus > Mikrofoni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au microphone est nécessaire. Activez-le dans Réglages Système > Confidentialité et sécurité > Microphone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרשת גישה למיקרופון. הפעל אותה בהגדרות המערכת > פרטיות ואבטחה > מיקרופון."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon-hozzáférésre van szükség. Engedélyezd a Rendszerbeállítások > Adatvédelem és biztonság > Mikrofon menüpontban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon diperlukan. Aktifkan di Pengaturan Sistem > Privasi & Keamanan > Mikrofon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve l'accesso al microfono. Attivalo in Impostazioni di Sistema > Privacy e sicurezza > Microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスが必要です。システム設定 > プライバシーとセキュリティ > マイク で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 접근 권한이 필요해요. 시스템 설정 > 개인 정보 보호 및 보안 > 마이크에서 켜 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgang til mikrofonen kreves. Slå den på under Systeminnstillinger > Personvern og sikkerhet > Mikrofon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot de microfoon is nodig. Schakel het in via Systeeminstellingen > Privacy en beveiliging > Microfoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebny jest dostęp do mikrofonu. Włącz go w Ustawieniach systemowych > Prywatność i ochrona > Mikrofon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso acesso ao microfone. Ative-o em Ajustes do Sistema > Privacidade e Segurança > Microfone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен доступ к микрофону. Включите его в Системных настройках > Конфиденциальность и безопасность > Микрофон."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Je potrebný prístup k mikrofónu. Povoľte ho v Nastaveniach systému > Súkromie a bezpečnosť > Mikrofón."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtkomst till mikrofonen krävs. Aktivera den under Systeminställningar > Integritet och säkerhet > Mikrofon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องการสิทธิ์เข้าถึงไมโครโฟน เปิดได้ที่การตั้งค่าระบบ > ความเป็นส่วนตัวและความปลอดภัย > ไมโครโฟน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon erişimi gerekli. Sistem Ayarları > Gizlilik ve Güvenlik > Mikrofon bölümünden etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен доступ до мікрофона. Увімкніть його в Системних налаштуваннях > Конфіденційність і безпека > Мікрофон."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần quyền truy cập micrô. Hãy bật trong Cài đặt Hệ thống > Quyền riêng tư & Bảo mật > Micrô."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要麦克风权限。请在“系统设置 > 隐私与安全性 > 麦克风”中开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要麥克風存取權限。請在「系統設定」>「隱私權與安全性」>「麥克風」中開啟。"
          }
        }
      }
    },
    "Microphone input": {
