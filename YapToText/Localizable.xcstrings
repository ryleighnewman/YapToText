    "Dictating over a selected word in a web app replaces the word again, instead of landing after it when the page is slow to answer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإملاء فوق كلمة محددة في تطبيق ويب يستبدل الكلمة مجدداً، بدلاً من أن يظهر بعدها عندما تكون الصفحة بطيئة في الاستجابة"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktování přes označené slovo ve webové aplikaci slovo znovu nahradí, místo aby se vložilo za něj, když stránka reaguje pomalu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering over et markeret ord i en webapp erstatter ordet igen, i stedet for at lande efter det, når siden svarer langsomt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren über ein markiertes Wort in einer Web-App ersetzt das Wort wieder, statt danach eingefügt zu werden, wenn die Seite langsam reagiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictar sobre una palabra seleccionada en una app web vuelve a reemplazar la palabra, en lugar de insertarse después cuando la página tarda en responder"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanelu valitun sanan päälle verkkosovelluksessa korvaa sanan uudelleen sen sijaan, että teksti ilmestyisi sen jälkeen, kun sivu vastaa hitaasti"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicter sur un mot sélectionné dans une app web remplace à nouveau le mot, au lieu de l'insérer après lui quand la page répond lentement"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכתבה על מילה נבחרת באפליקציית אינטרנט מחליפה את המילה שוב, במקום להופיע אחריה כשהדף מגיב לאט"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Webalkalmazásban kijelölt szó fölé diktálva a szó újra lecserélődik, nem pedig utána kerül, ha az oldal lassan válaszol"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mendikte di atas kata yang dipilih di aplikasi web menggantinya lagi, bukan muncul setelahnya saat halaman lambat merespons"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dettare sopra una parola selezionata in un'app web sostituisce di nuovo la parola, invece di inserirla dopo quando la pagina risponde lentamente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェブアプリで単語を選択してディクテーションすると、ページの応答が遅くても、その単語の後ろではなく、その単語を置き換えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 앱에서 선택한 단어 위에 받아쓰면, 페이지 응답이 느릴 때 뒤에 붙는 대신 그 단어를 다시 대체해요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering over et markert ord i en nettapp erstatter ordet igjen, i stedet for å havne etter det når siden svarer tregt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicteren over een geselecteerd woord in een webapp vervangt het woord opnieuw, in plaats van erna te komen als de pagina traag reageert"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie nad zaznaczonym słowem w aplikacji webowej ponownie zastępuje to słowo, zamiast wstawiać tekst za nim, gdy strona wolno reaguje"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditar sobre uma palavra selecionada em um app web substitui a palavra de novo, em vez de ser colocada depois dela quando a página demora para responder"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовка поверх выделенного слова в веб-приложении снова заменяет слово, а не вставляет его после, когда страница медленно отвечает"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktovanie nad označeným slovom vo webovej aplikácii ho nahradí, namiesto vloženia za slovo, keď stránka odpovedá pomaly"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering över ett markerat ord i en webbapp ersätter ordet igen, i stället för att hamna efter det när sidan svarar långsamt"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การพิมพ์ด้วยเสียงทับคำที่เลือกในเว็บแอปจะแทนที่คำนั้นอีกครั้ง แทนที่จะไปต่อท้ายเมื่อหน้าเว็บตอบสนองช้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir web uygulamasında seçili bir kelimenin üzerine dikte etmek, sayfa yavaş yanıt verdiğinde metni sonrasına eklemek yerine kelimenin yerini yeniden değiştirir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовка поверх виділеного слова у веб-застосунку знову замінює слово, а не вставляється після нього, коли сторінка повільно відповідає"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc chính tả lên một từ đã chọn trong ứng dụng web sẽ thay thế đúng từ đó, thay vì chèn sau nó khi trang phản hồi chậm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在网页应用中选中一个词进行听写时，会再次替换该词，而不会在页面响应缓慢时落在它后面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在網頁 App 中對選取的字詞聽寫時，即使頁面回應較慢，也會再次取代該字詞，而不會落在它後面"
          }
        }
      }
    },
