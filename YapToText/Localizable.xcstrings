          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、1 回ではなく毎月の支援になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일회성 대신 매달 후원하려면 켜세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på for å støtte månedlig i stedet for én gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel in om maandelijks te steunen in plaats van eenmalig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz, aby wspierać co miesiąc zamiast jednorazowo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative para apoiar mensalmente em vez de uma vez só."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите, чтобы поддерживать ежемесячно, а не разово."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite, ak chcete podporovať mesačne namiesto jednorazovo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på för att stödja månadsvis i stället för en gång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดเพื่อสนับสนุนรายเดือนแทนการให้ครั้งเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek seferlik yerine aylık destek olmak için açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть, щоб підтримувати щомісяця, а не одноразово."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật để ủng hộ hằng tháng thay vì một lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后可按月支持，而不是一次性支持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後可改為每月支持，而非單次支持。"
          }
        }
      }
    },
