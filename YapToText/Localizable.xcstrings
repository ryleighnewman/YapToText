    "Every remaining option - insertion method, input device, sounds, backup shortcuts - lives in [Settings](yap://settings).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل خيار آخر، مثل طريقة الإدراج وجهاز الإدخال والأصوات واختصارات الاحتياط، موجود في [الإعدادات](yap://settings)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny ostatní volby (způsob vkládání, vstupní zařízení, zvuky, záložní zkratky) jsou v [Nastavení](yap://settings)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle øvrige valgmuligheder - indsættelsesmetode, indgangsenhed, lyde, reservegenveje - findes under [Indstillinger](yap://settings)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle übrigen Optionen, also Einfügemethode, Eingabegerät, Töne und Ersatzkurzbefehle, findest du unter [Einstellungen](yap://settings)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada opción restante (método de inserción, dispositivo de entrada, sonidos, atajos de respaldo) está en [Ajustes](yap://settings)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki muut vaihtoehdot, kuten lisäystapa, syötelaite, äänet ja varanäppäimet, ovat [Asetuksissa](yap://settings)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les autres options (méthode d'insertion, périphérique d'entrée, sons, raccourcis de secours) se trouvent dans les [Réglages](yap://settings)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל שאר האפשרויות - שיטת הכנסה, מכשיר קלט, צלילים, קיצורי גיבוי - נמצאות ב[הגדרות](yap://settings)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden további beállítás, a beszúrási mód, a bemeneti eszköz, a hangok és a tartalék parancsikonok a [Beállításokban](yap://settings) találhatók."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua opsi lainnya - metode penyisipan, perangkat masukan, suara, pintasan cadangan - ada di [Pengaturan](yap://settings)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le altre opzioni (metodo di inserimento, dispositivo di ingresso, suoni, scorciatoie di riserva) si trovano nelle [Impostazioni](yap://settings)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残りのオプション(挿入方法、入力デバイス、サウンド、バックアップのショートカットなど)はすべて [設定](yap://settings) にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나머지 모든 옵션(삽입 방식, 입력 장치, 소리, 백업 단축키)은 [설정](yap://settings)에 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle andre valg - innsettingsmetode, inndataenhet, lyder, reservesnarveier - finnes i [Innstillinger](yap://settings)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle overige opties (invoegmethode, invoerapparaat, geluiden, reservesneltoetsen) staan in [Instellingen](yap://settings)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda pozostała opcja: metoda wstawiania, urządzenie wejściowe, dźwięki, skróty zapasowe, znajduje się w [Ustawieniach](yap://settings)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as outras opções (método de inserção, dispositivo de entrada, sons, atalhos de reserva) ficam em [Ajustes](yap://settings)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все остальные параметры: способ вставки, устройство ввода, звуки, резервные команды находятся в [настройках](yap://settings)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky ostatné možnosti, spôsob vkladania, vstupné zariadenie, zvuky a záložné skratky, sú v [Nastaveniach](yap://settings)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje återstående alternativ - infogningsmetod, ingångsenhet, ljud, reservgenvägar - finns i [Inställningar](yap://settings)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลือกที่เหลือทั้งหมด เช่น วิธีการแทรก อุปกรณ์อินพุต เสียง และทางลัดสำรอง อยู่ใน [การตั้งค่า](yap://settings)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalan her seçenek - ekleme yöntemi, giriş aygıtı, sesler, yedek kısayollar - [Ayarlar](yap://settings) bölümündedir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Решта параметрів: спосіб вставлення, пристрій введення, звуки, резервні комбінації, розташовані в [Налаштуваннях](yap://settings)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi tùy chọn còn lại: phương thức chèn, thiết bị đầu vào, âm thanh, phím tắt dự phòng, nằm trong [Cài đặt](yap://settings)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其余所有选项（插入方式、输入设备、声音、备用快捷键）都位于[设置](yap://settings)中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其餘所有選項，包括插入方式、輸入裝置、音效與備用快捷鍵，都位於 [設定](yap://settings) 中。"
          }
        }
      }
    },
    "Every setting on every page goes back to how it was on first launch. Modes, dictionaries, commands, AI actions, and history are kept. You can undo until you quit the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعود كل إعدادات كل صفحة إلى ما كانت عليه عند أول تشغيل. تُحفظ الأوضاع والقواميس والأوامر وإجراءات الذكاء الاصطناعي والسجل. يمكنك التراجع حتى تُنهي التطبيق."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé nastavení na každé stránce se vrátí do stavu z prvního spuštění. Režimy, slovníky, příkazy, akce AI a historie zůstanou zachovány. Až do ukončení aplikace můžete vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle indstillinger på alle sider går tilbage til, som de var ved første start. Tilstande, ordbøger, kommandoer, AI-handlinger og historik bevares. Du kan fortryde, indtil du afslutter appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Einstellung auf jeder Seite wird auf den Stand beim ersten Start zurückgesetzt. Modi, Wörterbücher, Befehle, KI-Aktionen und Verlauf bleiben erhalten. Du kannst bis zum Beenden der App rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ajuste de cada página vuelve a como estaba en el primer inicio. Se conservan los modos, diccionarios, comandos, acciones de IA e historial. Puedes deshacer hasta que cierres la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen asetus kaikilla sivuilla palautuu siihen, miten se oli ensimmäisellä käynnistyskerralla. Tilat, sanastot, komennot, AI-toiminnot ja historia säilytetään. Voit kumota, kunnes lopetat sovelluksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque réglage de chaque page revient à son état du premier lancement. Les modes, dictionnaires, commandes, actions IA et l'historique sont conservés. Vous pouvez annuler jusqu'à la fermeture de l'app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל הגדרה בכל דף חוזרת למצב שהיה בהפעלה הראשונה. מצבים, מילונים, פקודות, פעולות AI והיסטוריה נשמרים. אפשר לבטל עד שתצא מהאפליקציה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden oldal minden beállítása visszaáll az első indításkori állapotra. A módok, szótárak, parancsok, AI műveletek és az előzmények megmaradnak. Az alkalmazás kilépéséig visszavonhatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap pengaturan di setiap halaman kembali seperti saat pertama dibuka. Mode, kamus, perintah, aksi AI, dan riwayat tetap disimpan. Anda bisa membatalkan sampai keluar dari aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni impostazione di ogni pagina torna com'era al primo avvio. Modalità, dizionari, comandi, azioni IA e cronologia vengono conservati. Puoi annullare fino alla chiusura dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのページのすべての設定が、初回起動時の状態に戻ります。モード、辞書、コマンド、AI アクション、履歴は残ります。アプリを終了するまでは取り消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 페이지의 모든 설정이 처음 실행했을 때 상태로 돌아가요. 모드, 사전, 명령, AI 작업, 기록은 유지돼요. 앱을 종료하기 전까지 실행 취소할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver innstilling på hver side går tilbake til slik den var ved første oppstart. Moduser, ordlister, kommandoer, KI-handlinger og historikk beholdes. Du kan angre til du avslutter appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke instelling op elke pagina keert terug naar de staat bij de eerste start. Modi, woordenlijsten, opdrachten, AI-acties en geschiedenis blijven bewaard. Je kunt ongedaan maken tot je de app afsluit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde ustawienie na każdej stronie wraca do stanu z pierwszego uruchomienia. Tryby, słowniki, polecenia, akcje AI i historia są zachowane. Możesz cofnąć zmiany do zamknięcia aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo ajuste de todas as páginas volta a como estava no primeiro uso. Modos, dicionários, comandos, ações de IA e histórico são mantidos. Você pode desfazer até sair do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая настройка на каждой странице возвращается к тому состоянию, каким было при первом запуске. Режимы, словари, команды, действия с ИИ и история сохранятся. Отменить можно до выхода из приложения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé nastavenie na každej stránke sa vráti do stavu pri prvom spustení. Režimy, slovníky, príkazy, akcie AI a história ostanú zachované. Zmeny môžete vrátiť, kým aplikáciu neukončíte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje inställning på varje sida återgår till hur den var vid första starten. Lägen, ordlistor, kommandon, AI-åtgärder och historik behålls. Du kan ångra tills du avslutar appen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกการตั้งค่าในทุกหน้าจะกลับไปเป็นอย่างที่เป็นตอนเปิดแอปครั้งแรก โหมด พจนานุกรม คำสั่ง การทำงาน AI และประวัติจะถูกเก็บไว้ คุณยกเลิกได้จนกว่าจะออกจากแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sayfadaki her ayar ilk açılıştaki haline döner. Modlar, sözlükler, komutlar, YZ eylemleri ve geçmiş korunur. Uygulamadan çıkana kadar geri alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне налаштування на кожній сторінці повертається до стану під час першого запуску. Режими, словники, команди, дії ШІ та історія зберігаються. Можна скасувати, доки не вийдете з програми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi cài đặt trên mọi trang trở về như lúc mở ứng dụng lần đầu. Chế độ, từ điển, lệnh, hành động AI và lịch sử được giữ lại. Bạn có thể hoàn tác cho đến khi thoát ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个页面上的每项设置都会恢复到首次启动时的状态。模式、词典、命令、AI 操作和历史记录会保留。在退出应用之前，你都可以撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個頁面上的所有設定都會還原為首次啟動時的狀態。模式、字典、指令、AI 動作與紀錄都會保留。在結束 App 之前，你都可以復原。"
          }
        }
      }
    },
    "Every setting, mode, dictionary, command, and AI action, plus your whole history and saved audio. The app relaunches at its welcome screen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل إعداد ووضع وقاموس وأمر وإجراء ذكاء اصطناعي، إضافة إلى كامل السجل والصوت المحفوظ. يُعاد تشغيل التطبيق على شاشة الترحيب."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechna nastavení, režimy, slovníky, příkazy a akce AI, včetně celé historie a uložených nahrávek. Aplikace se restartuje na uvítací obrazovce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle indstillinger, tilstande, ordbøger, kommandoer og AI-handlinger samt hele din historik og gemte lyd. Appen starter forfra på velkomstskærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Einstellung, jeder Modus, jedes Wörterbuch, jeder Befehl und jede KI-Aktion sowie dein gesamter Verlauf und alle gespeicherten Audiodaten. Die App startet danach auf ihrem Begrüßungsbildschirm neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los ajustes, modos, diccionarios, comandos y acciones de IA, además de todo tu historial y el audio guardado. La app se reinicia en su pantalla de bienvenida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen asetus, tila, sanasto, komento ja AI-toiminto, sekä koko historia ja tallennettu ääni. Sovellus käynnistyy uudelleen tervetuloanäkymään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les réglages, modes, dictionnaires, commandes et actions IA, ainsi que tout votre historique et l'audio enregistré. L'app redémarre sur son écran d'accueil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל ההגדרות, המצבים, המילונים, הפקודות ופעולות ה-AI, וכן כל ההיסטוריה וההקלטות השמורות. האפליקציה תיפתח מחדש במסך הפתיחה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden beállítás, mód, szótár, parancs és AI művelet, valamint a teljes előzményed és a mentett hang. Az alkalmazás az üdvözlő képernyőjével újraindul."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua pengaturan, mode, kamus, perintah, dan aksi AI, beserta seluruh riwayat dan audio tersimpan. Aplikasi akan dibuka ulang di layar selamat datang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni impostazione, modalità, dizionario, comando e azione IA, oltre a tutta la cronologia e all'audio salvato. L'app si riavvia nella schermata di benvenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての設定、モード、辞書、コマンド、AI アクションに加え、履歴と保存された音声もすべて消去されます。アプリはウェルカム画面から再起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 설정, 모드, 사전, 명령, AI 작업과 전체 기록 및 저장된 오디오가 지워져요. 앱은 시작 화면으로 다시 실행돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle innstillinger, moduser, ordlister, kommandoer og KI-handlinger, pluss hele historikken og lagret lyd. Appen starter på nytt ved velkomstskjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke instelling, modus, woordenlijst, opdracht en AI-actie, plus je hele geschiedenis en opgeslagen audio. De app start opnieuw op bij het welkomstscherm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde ustawienie, tryb, słownik, polecenie i akcja AI, a także cała historia i zapisane nagrania. Aplikacja uruchomi się ponownie na ekranie powitalnym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os ajustes, modos, dicionários, comandos e ações de IA, além de todo o seu histórico e áudios salvos. O app reinicia na tela de boas-vindas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все настройки, режимы, словари, команды и действия с ИИ, а также вся история и сохранённые аудиозаписи. Приложение перезапустится на экране приветствия."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky nastavenia, režimy, slovníky, príkazy a akcie AI, ako aj celá história a uložené zvukové nahrávky. Aplikácia sa znova spustí na úvodnej obrazovke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla inställningar, lägen, ordlistor, kommandon och AI-åtgärder, plus hela din historik och sparade ljud. Appen startar om till välkomstskärmen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่า โหมด พจนานุกรม คำสั่ง และการทำงานของ AI ทั้งหมด รวมถึงประวัติและเสียงที่บันทึกไว้ทั้งหมด แอปจะเปิดใหม่ที่หน้าจอต้อนรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ayar, mod, sözlük, komut ve YZ eylemi ile tüm geçmişiniz ve kayıtlı sesleriniz. Uygulama karşılama ekranında yeniden başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі налаштування, режими, словники, команди і дії ШІ, а також уся історія та збережені аудіозаписи. Програма перезапуститься на екрані привітання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi cài đặt, chế độ, từ điển, lệnh và hành động AI, cùng toàn bộ lịch sử và âm thanh đã lưu. Ứng dụng sẽ khởi động lại ở màn hình chào mừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有设置、模式、词典、命令和 AI 操作，以及全部历史记录和已保存的音频。应用将重新启动到欢迎界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有設定、模式、字典、指令與 AI 動作，以及你的完整紀錄與已儲存的音訊。App 會重新啟動並回到歡迎畫面。"
          }
        }
      }
    },
    "Everything runs on your Mac. Your voice is never uploaded.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء يعمل على Mac. لا يُرفع صوتك أبداً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše běží na vašem Macu. Váš hlas se nikdy nenahrává."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt kører på din Mac. Din stemme uploades aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles läuft auf deinem Mac. Deine Stimme wird nie hochgeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo funciona en tu Mac. Tu voz nunca se sube."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki toimii Macilla. Ääntäsi ei lähetetä koskaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout fonctionne sur votre Mac. Votre voix n'est jamais envoyée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכול רץ במחשב שלך. הקול שלך לעולם לא עולה לרשת."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden a Macen fut. A hangod soha nem töltődik fel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya berjalan di Mac Anda. Suara Anda tidak pernah diunggah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto funziona sul tuo Mac. La tua voce non viene mai caricata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて Mac 上で動作します。音声がアップロードされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 것이 이 Mac에서 실행돼요. 목소리는 절대 업로드되지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt kjører på din Mac. Stemmen din lastes aldri opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles draait op je Mac. Je stem wordt nooit geüpload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko działa na Twoim Macu. Twój głos nigdy nie jest wysyłany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo roda no seu Mac. Sua voz nunca é enviada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё работает на вашем Mac. Ваш голос никогда не загружается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko beží vo vašom Macu. Váš hlas sa nikdy neodosiela."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt körs på din Mac. Din röst laddas aldrig upp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างทำงานบน Mac ของคุณ เสียงของคุณจะไม่ถูกอัปโหลดเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey Mac'inizde çalışır. Sesiniz asla yüklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе працює на вашому Mac. Ваш голос ніколи не завантажується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ chạy trên Mac của bạn. Giọng nói của bạn không bao giờ được tải lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都在你的 Mac 上运行。你的声音从不上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有功能都在你的 Mac 上執行。你的聲音永遠不會上傳。"
          }
        }
      }
    },
