    "The mic shuts off after each dictation; the next one may miss the first second.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُغلق الميكروفون بعد كل إملاء؛ وقد يفوّت الإملاء التالي الثانية الأولى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon se po každém diktátu vypne; další může zmeškat první sekundu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen slukkes efter hver diktering; den næste kan gå glip af det første sekund."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon schaltet sich nach jedem Diktat ab; das nächste verpasst womöglich die erste Sekunde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono se apaga tras cada dictado; el siguiente puede perder el primer segundo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofoni sammuu jokaisen sanelun jälkeen. Seuraava saattaa menettää ensimmäisen sekunnin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro s'éteint après chaque dictée ; la suivante peut manquer la première seconde."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המיקרופון נכבה אחרי כל הכתבה; הבאה עלולה לפספס את השנייה הראשונה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mikrofon minden diktálás után kikapcsol; a következő elveszítheti az első másodpercet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon mati setelah setiap dikte; dikte berikutnya mungkin melewatkan detik pertama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono si spegne dopo ogni dettatura; la successiva potrebbe perdere il primo secondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクはディクテーションのたびに停止します。次のディクテーションでは最初の 1 秒が聞き取れないことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기가 끝날 때마다 마이크가 꺼져요. 다음 받아쓰기에서는 첫 1초를 놓칠 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen slås av etter hver diktering; den neste kan gå glipp av det første sekundet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoon schakelt na elk dictee uit; de volgende mist mogelijk de eerste seconde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon wyłącza się po każdym dyktowaniu; następne może pominąć pierwszą sekundę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone desliga após cada ditado; o próximo pode perder o primeiro segundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон выключается после каждой диктовки, поэтому следующая может пропустить первую секунду."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofón sa po každom diktáte vypne; ďalší môže vynechať prvú sekundu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen stängs av efter varje diktering; nästa kan missa den första sekunden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไมค์จะปิดหลังการพิมพ์ด้วยเสียงแต่ละครั้ง ครั้งถัดไปอาจพลาดวินาทีแรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon her dikteden sonra kapanır; bir sonraki dikte ilk saniyeyi kaçırabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікрофон вимикається після кожної диктовки; наступна може пропустити першу секунду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Micrô tắt sau mỗi lần đọc chính tả; lần sau có thể bỏ lỡ giây đầu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次听写后麦克风都会关闭；下一次听写可能会漏掉开头的一秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風會在每次聽寫後關閉；下一次聽寫可能會漏掉開頭的第一秒。"
          }
        }
      }
    },
    "The microphone couldn't start.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تشغيل الميكروفون."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon se nepodařilo spustit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen kunne ikke starte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon konnte nicht gestartet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono no pudo iniciarse."
          }
        },
        "fi": {
