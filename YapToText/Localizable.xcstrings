            "value": "Режими, Авто і очищення ШІ виконуються після кожної транскрибації."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ, Tự động và làm sạch AI chạy sau mỗi lần phiên âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模式、自动和 AI 清理会在每次转写后运行。"
