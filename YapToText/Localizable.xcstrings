            "value": "การพิมพ์ด้วยเสียงครั้งแรกของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk diktiniz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша перша диктовка"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần đọc chính tả đầu tiên của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的第一次听写"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的第一次聽寫"
          }
        }
      }
    },
    "Your formatted text lands here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
