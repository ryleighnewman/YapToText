    "The spoken language and when recording stops.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لغة الكلام ومتى يتوقف التسجيل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mluvený jazyk a kdy se nahrávání zastaví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det talte sprog, og hvornår optagelsen stopper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gesprochene Sprache und wann die Aufnahme endet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma hablado y cuándo se detiene la grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhuttu kieli ja milloin nauhoitus pysähtyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue parlée et le moment où l'enregistrement s'arrête."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השפה המדוברת ומתי ההקלטה נעצרת."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszélt nyelv és a felvétel leállásának módja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahasa yang diucapkan dan kapan rekaman berhenti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua parlata e quando la registrazione si ferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話す言語と、録音が停止するタイミング。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하는 언어와 녹음이 멈추는 시점."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Talespråket og når opptaket stopper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gesproken taal en wanneer het opnemen stopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mówiony język i moment zatrzymania nagrywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma falado e quando a gravação para."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык речи и момент остановки записи."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovorený jazyk a kedy sa nahrávanie zastaví."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det talade språket och när inspelningen stoppas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาษาที่พูดและเวลาที่การบันทึกจะหยุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşulan dil ve kaydın ne zaman durduğu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мова мовлення і коли запис зупиняється."
          }
        },
        "vi": {
