            "value": "ファイルに読み取れる音声がありませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에 읽을 수 있는 오디오가 없었어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen hadde ingen lesbar lyd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand bevatte geen leesbare audio."
          }
        },
        "pl": {
          "stringUnit": {
