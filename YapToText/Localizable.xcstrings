          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De AI op het apparaat formatteert je woorden opnieuw…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI na urządzeniu przekształca twoje słowa…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA no dispositivo está reformatando suas palavras…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ на устройстве переоформляет ваши слова…"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "AI v zariadení upravuje vaše slová…"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AI:n på enheten formaterar om dina ord…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AI บนอุปกรณ์กำลังจัดรูปแบบคำของคุณใหม่…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
