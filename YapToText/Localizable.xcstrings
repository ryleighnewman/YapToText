    "macOS asks for microphone permission once, on the very first try.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب macOS إذن الميكروفون مرة واحدة فقط، في أول محاولة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS se zeptá na oprávnění k mikrofonu jen jednou, při prvním pokusu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS beder om mikrofontilladelse én gang, ved det allerførste forsøg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt beim allerersten Versuch einmal nach der Berechtigung für das Mikrofon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pide permiso para el micrófono una sola vez, en el primer intento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS kysyy mikrofonin käyttöoikeutta kerran, ensimmäisellä yrityksellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demande l'autorisation du microphone une seule fois, dès le premier essai."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS מבקש הרשאת מיקרופון פעם אחת, בניסיון הראשון."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A macOS egyszer kéri a mikrofon-engedélyt, az első próbálkozáskor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS meminta izin mikrofon sekali, pada percobaan pertama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS chiede il permesso del microfono una sola volta, al primo tentativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS は、最初に試したときにだけマイクの許可を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS는 처음 시도할 때 마이크 권한을 한 번 물어봐요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS spør om mikrofontillatelse én gang, ved det aller første forsøket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS vraagt één keer om toestemming voor de microfoon, bij de allereerste poging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pyta o dostęp do mikrofonu tylko raz, przy pierwszej próbie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS pede a permissão do microfone uma vez, na primeira tentativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS запрашивает доступ к микрофону один раз, при первой попытке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS sa pýta na povolenie mikrofónu raz, pri prvom pokuse."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS frågar efter mikrofonbehörighet en gång, vid första försöket."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS จะขอสิทธิ์ไมโครโฟนเพียงครั้งเดียว ตั้งแต่ครั้งแรกที่ลองใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, mikrofon izni için ilk denemede bir kez sorar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS запитує дозвіл на мікрофон один раз, під час першої спроби."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS chỉ hỏi quyền micrô một lần, ngay lần thử đầu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会在首次尝试时请求一次麦克风权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 只會在第一次嘗試時詢問一次麥克風權限。"
          }
        }
      }
    },
