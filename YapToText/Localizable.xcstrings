    "The model file couldn't be loaded. Try re-downloading it on the AI Models page.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل ملف النموذج. حاول إعادة تنزيله من صفحة نماذج الذكاء الاصطناعي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor modelu nelze načíst. Zkuste jej znovu stáhnout na stránce Modely AI."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelfilen kunne ikke indlæses. Prøv at hente den igen på siden AI-modeller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
