    "Also mapped %lld sound-alikes to “%@”": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم أيضاً ربط %lld كلمات متشابهة صوتياً بـ “%@”"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navíc jsem %lld podobně znějících slov přiřadil k „%@“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilknyttede også %lld lydlignende ord til “%@”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Außerdem %lld ähnlich klingende Wörter auf „%@“ abgebildet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También asocié %lld palabras parecidas a “%@”"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Myös %lld samankaltaista sanaa yhdistettiin kohteeseen ”%@”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld homophones ont aussi été associés à “%@”"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מיפיתי גם %lld מילים דומות ל-“%@”"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hasonló hangzású szót is „%@” alakra cseréltem"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Juga memetakan %lld kata yang mirip bunyinya ke “%@”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho associato anche %lld parole simili a “%@”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ響きの言葉 %lld 件を「%@」に割り当てました"
          }
        },
        "ko": {
          "stringUnit": {
