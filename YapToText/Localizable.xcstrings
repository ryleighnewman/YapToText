    "Bring any whisper.cpp speech model (.bin) or llama.cpp cleanup model (.gguf).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضِف أي نموذج كلام whisper.cpp ‎(.bin) أو نموذج تنظيف llama.cpp ‎(.gguf)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte libovolný model řeči whisper.cpp (.bin) nebo model úpravy llama.cpp (.gguf)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Medbring en hvilken som helst whisper.cpp-talemodel (.bin) eller llama.cpp-oprydningsmodel (.gguf)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringe ein beliebiges whisper.cpp-Sprachmodell (.bin) oder llama.cpp-Bereinigungsmodell (.gguf) mit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa cualquier modelo de voz whisper.cpp (.bin) o modelo de limpieza llama.cpp (.gguf)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuo mikä tahansa whisper.cpp-puhemalli (.bin) tai llama.cpp-siistintämalli (.gguf)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez n'importe quel modèle de parole whisper.cpp (.bin) ou modèle de nettoyage llama.cpp (.gguf)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבא כל מודל דיבור של whisper.cpp ‎(.bin) או מודל ניקוי של llama.cpp ‎(.gguf)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármely whisper.cpp beszédmodellt (.bin) vagy llama.cpp tisztító modellt (.gguf) betölthetsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawa model ucapan whisper.cpp (.bin) atau model pembersihan llama.cpp (.gguf) apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa qualsiasi modello vocale whisper.cpp (.bin) o modello di pulizia llama.cpp (.gguf)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意の whisper.cpp 音声モデル (.bin) または llama.cpp クリーンアップモデル (.gguf) を追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "whisper.cpp 음성 모델(.bin)이나 llama.cpp 정리 모델(.gguf)을 가져오세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta med hvilken som helst whisper.cpp-talemodell (.bin) eller llama.cpp-opprydningsmodell (.gguf)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik elk whisper.cpp spraakmodel (.bin) of llama.cpp opschoonmodel (.gguf)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj dowolny model mowy whisper.cpp (.bin) lub model czyszczenia llama.cpp (.gguf)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traga qualquer modelo de fala whisper.cpp (.bin) ou modelo de limpeza llama.cpp (.gguf)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте любую модель речи whisper.cpp (.bin) или модель очистки llama.cpp (.gguf)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte ľubovoľný model reči whisper.cpp (.bin) alebo model úpravy llama.cpp (.gguf)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta med valfri whisper.cpp-talmodell (.bin) eller llama.cpp-rensningsmodell (.gguf)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำโมเดลการพูด whisper.cpp (.bin) หรือโมเดลทำความสะอาด llama.cpp (.gguf) ใดก็ได้มาใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir whisper.cpp konuşma modeli (.bin) ya da llama.cpp temizleme modeli (.gguf) ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте будь-яку модель мовлення whisper.cpp (.bin) або модель очищення llama.cpp (.gguf)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng bất kỳ mô hình giọng nói whisper.cpp (.bin) hoặc mô hình làm sạch llama.cpp (.gguf) nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可导入任意 whisper.cpp 语音模型 (.bin) 或 llama.cpp 清理模型 (.gguf)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入任何 whisper.cpp 語音模型（.bin）或 llama.cpp 清理模型（.gguf）。"
          }
        }
      }
