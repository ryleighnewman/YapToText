    "Higher-quality cleanup and formatting. Larger, slower.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظيف وتنسيق بجودة أعلى. أكبر وأبطأ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvalitnější úprava a formátování. Větší a pomalejší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedre oprydning og formatering. Større og langsommere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bessere Bereinigung und Formatierung. Größer und langsamer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpieza y formato de mayor calidad. Más grande y más lento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadukkaampi siistintä ja muotoilu. Suurempi, hitaampi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyage et mise en forme de meilleure qualité. Plus volumineux, plus lent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניקוי ועיצוב באיכות גבוהה יותר. גדול יותר, איטי יותר."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Magasabb minőségű tisztítás és formázás. Nagyobb, lassabb."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembersihan dan pemformatan berkualitas lebih tinggi. Lebih besar, lebih lambat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulizia e formattazione di qualità superiore. Più grande e più lento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より高品質なクリーンアップと整形ができます。大きく、遅めです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 높은 품질의 정리와 서식. 더 크고 느려요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedre opprydding og formatering. Større og tregere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opschoning en opmaak van hogere kwaliteit. Groter, trager."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepsze czyszczenie i formatowanie. Większy, wolniejszy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpeza e formatação de maior qualidade. Maior e mais lento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более качественная очистка и оформление. Больше по размеру и медленнее."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvalitnejšia úprava a formátovanie. Väčšie a pomalšie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bättre rensning och formatering. Större och långsammare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทำความสะอาดและจัดรูปแบบที่มีคุณภาพสูงกว่า มีขนาดใหญ่และช้ากว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yüksek kaliteli temizlik ve biçimlendirme. Daha büyük, daha yavaş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якісніші очищення і форматування. Більша й повільніша."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm sạch và định dạng chất lượng cao hơn. Lớn hơn, chậm hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "质量更高的清理和格式化。体积更大，速度更慢。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "品質更高的清理與格式化。體積較大，速度較慢。"
          }
        }
      }
    },
