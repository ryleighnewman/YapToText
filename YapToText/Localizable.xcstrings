    "Add it in Dictionaries, or select the right spelling anywhere, press your Quick Edit key, and say “add this to my dictionary”.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضِفه في القواميس، أو حدد التهجئة الصحيحة في أي مكان، واضغط مفتاح التحرير السريع، وقل “أضِف هذا إلى قاموسي”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte jej v Slovnících, nebo označte správný zápis kdekoli, stiskněte klávesu Rychlých úprav a řekněte „add this to my dictionary“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj det under Ordbøger, eller markér den rigtige stavning hvor som helst, tryk på din tast for hurtig redigering, og sig “tilføj dette til min ordbog”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge es unter Wörterbücher hinzu, oder markiere die richtige Schreibweise irgendwo, drücke deine Taste für Schnellbearbeitung und sage „add this to my dictionary“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añádela en Diccionarios, o selecciona la ortografía correcta en cualquier lugar, pulsa tu tecla de Edición rápida y di “añade esto a mi diccionario”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää se Sanastoihin, tai valitse oikea kirjoitusasu mistä tahansa, paina pikamuokkausnäppäintäsi ja sano ”add this to my dictionary”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez-le dans Dictionnaires, ou sélectionnez la bonne orthographe n'importe où, appuyez sur votre touche Édition rapide et dites “ajoute ceci à mon dictionnaire”."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף אותה במילונים, או בחר את האיות הנכון בכל מקום, לחץ על מקש העריכה המהירה שלך, ואמור “הוסף את זה למילון שלי”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Add hozzá a Szótárakban, vagy jelöld ki a helyes írásmódot bárhol, nyomd meg a Gyors szerkesztés billentyűjét, és mondd: „add this to my dictionary”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan di Kamus, atau pilih ejaan yang benar di mana saja, tekan tombol Quick Edit, lalu katakan “add this to my dictionary”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungila nei Dizionari, oppure seleziona la grafia corretta in qualsiasi punto, premi il tasto Modifica rapida e di' “aggiungi questo al mio dizionario”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書で追加するか、どこでも正しい綴りを選択してクイック編集キーを押し、「add this to my dictionary」と言ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전에서 추가하거나, 아무 곳에서나 올바른 철자를 선택하고 Quick Edit 키를 누른 뒤 “add this to my dictionary”라고 말하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg den til under Ordlister, eller marker riktig stavemåte et hvilket som helst sted, trykk på hurtigredigeringstasten og si «legg dette til i ordlisten min»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg het toe onder Woordenlijsten, of selecteer de juiste spelling waar dan ook, druk op je sneltoets Snel bewerken en zeg “add this to my dictionary”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj go w Słownikach albo zaznacz poprawną pisownię w dowolnym miejscu, naciśnij klawisz Szybkiej edycji i powiedz „dodaj to do mojego słownika”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione em Dicionários, ou selecione a grafia certa em qualquer lugar, pressione sua tecla de Edição rápida e diga “adicionar isto ao meu dicionário”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте его в словарях или выделите правильное написание в любом месте, нажмите клавишу быстрого редактирования и скажите «добавь это в мой словарь»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte ho v Slovníkoch, alebo označte správny pravopis kdekoľvek, stlačte kláves Rýchlej úpravy a povedzte „pridaj to do môjho slovníka“."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till det i Ordlistor, eller markera rätt stavning var som helst, tryck på din snabbredigeringstangent och säg ”lägg till detta i min ordlista”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มได้ในพจนานุกรม หรือเลือกการสะกดที่ถูกต้องที่ใดก็ได้ กดปุ่มแก้ไขด่วน แล้วพูดว่า “เพิ่มสิ่งนี้ลงในพจนานุกรมของฉัน”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sözlüklerde ekleyin ya da doğru yazımı herhangi bir yerde seçip Hızlı Düzenleme tuşunuza basın ve “bunu sözlüğüme ekle” deyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте його у словниках або виділіть правильне написання будь-де, натисніть клавішу швидкого редагування і скажіть «додати це до мого словника»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm trong Từ điển, hoặc chọn cách viết đúng ở bất kỳ đâu, nhấn phím Chỉnh sửa nhanh rồi nói “thêm cái này vào từ điển của tôi”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以在词典中添加，也可以在任意位置选中正确的拼写，按下快速编辑键，然后说“把这个加入我的词典”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「字典」中新增，或在任何地方選取正確的拼法，按下快速編輯按鍵，然後說「add this to my dictionary」。"
          }
        }
      }
    },
