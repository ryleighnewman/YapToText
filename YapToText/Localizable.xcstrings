          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna a un emoji varias frases, como “emoji de fuego, emoji de llama, emoji de fuego encendido”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna yhdelle emojille useita ilmaisuja, kuten ”fire emoji, flame emoji, lit emoji”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez à un emoji plusieurs formulations, comme “emoji feu, emoji flamme, emoji lit”."
          }
        },
        "he": {
          "stringUnit": {
