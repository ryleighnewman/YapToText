            "value": "Plik nie zawierał czytelnego audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo não tinha áudio legível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В файле нет читаемого аудио."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbor neobsahoval čitateľný zvuk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen hade inget läsbart ljud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ไม่มีเสียงที่อ่านได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyada okunabilir ses yoktu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У файлі немає аудіо, яке можна прочитати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp không có âm thanh đọc được."
          }
        },
        "zh-Hans": {
