    "Verbatim. Switch on to clean up the transcript with AI.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرفياً. فعّله لتنظيف النص بالذكاء الاصطناعي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doslova. Zapněte pro úpravu přepisu pomocí AI."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordret. Slå til for at rydde op i transskriptionen med AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wörtlich. Einschalten, um das Transkript mit KI zu bereinigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Literal. Actívalo para limpiar la transcripción con IA."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanatarkka. Kytke päälle siistiäksesi litteroinnin AI:lla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mot à mot. Activez pour nettoyer la transcription avec l'IA."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מילולי. הפעל כדי לנקות את התמלול עם AI."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szó szerint. Kapcsold be, ha az átiratot AI-val szeretnéd tisztítani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbatim. Aktifkan untuk membersihkan transkrip dengan AI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testuale. Attiva per ripulire la trascrizione con l'IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのまま。オンにすると、AI で書き起こしを整えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원문 그대로예요. 켜면 AI로 전사본을 정리해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordrett. Slå på for å rydde i transkripsjonen med KI."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Letterlijk. Zet aan om het transcript met AI op te schonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosłownie. Włącz, aby oczyścić transkrypcję za pomocą AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Literal. Ative para limpar a transcrição com IA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дословно. Включите, чтобы очистить расшифровку с ИИ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Doslovne. Zapnite, ak chcete prepis upraviť pomocou AI."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordagrant. Slå på för att rensa transkriptionen med AI."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรงตัว เปิดเพื่อทำความสะอาดข้อความถอดเสียงด้วย AI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birebir. Dökümü YZ ile temizlemek için açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дослівно. Увімкніть, щоб очистити транскрипцію за допомогою ШІ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguyên văn. Bật lên để làm sạch bản phiên âm bằng AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐字。开启后可用 AI 清理转写内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐字。開啟後即可以 AI 整理逐字稿。"
          }
        }
      }
    },
