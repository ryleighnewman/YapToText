        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dấu cách (mặc định)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Space（默认）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Space（預設）"
          }
        }
      }
    },
    "Speak now and watch the meter. Raise the boost until normal speech reaches the green-to-yellow zone without sitting in the red.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكلّم الآن وراقب المقياس. ارفع التعزيز حتى يصل الكلام العادي إلى المنطقة من الأخضر إلى الأصفر دون أن يبقى في الأحمر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mluvte nyní a sledujte měřič. Zvyšujte zesílení, dokud se běžná řeč nedostane do zelenožluté zóny a nezůstane v červené."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal nu og følg måleren. Hæv forstærkningen, indtil normal tale når det grøn-til-gule område uden at ligge i det røde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich jetzt und beobachte die Anzeige. Erhöhe die Verstärkung, bis normale Sprache den Bereich von Grün bis Gelb erreicht, ohne im Roten zu hängen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla ahora y observa el medidor. Sube el refuerzo hasta que la voz normal llegue a la zona de verde a amarillo sin quedarse en el rojo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhu nyt ja seuraa mittaria. Nosta vahvistusta, kunnes normaali puhe ylittää vihreän ja keltaisen alueen, mutta ei jää punaiselle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez maintenant et regardez le niveau. Augmentez l'amplification jusqu'à ce que la parole normale atteigne la zone vert-jaune sans rester dans le rouge."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דבר עכשיו והסתכל על המד. העלה את ההגברה עד שדיבור רגיל מגיע לאזור הירוק-צהוב בלי להישאר באדום."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beszélj most, és figyeld a mérőt. Emeld az erősítést, amíg a normál beszéd a zöldből a sárgába érkezik, és nem marad a pirosban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bicara sekarang dan perhatikan meternya. Naikkan penguatan sampai ucapan normal mencapai zona hijau ke kuning tanpa berada di zona merah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla ora e osserva il misuratore. Alza il potenziamento finché il parlato normale raggiunge la zona dal verde al giallo senza finire nel rosso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今話して、メーターを確認してください。普通の話し声が緑から黄色の範囲に入り、赤に張り付かないように、ブーストを上げてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 말하면서 미터를 보세요. 평소 말소리가 빨강에 머물지 않고 초록에서 노랑 구간에 닿을 때까지 증폭을 올리세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snakk nå og følg måleren. Øk forsterkningen til vanlig tale når den grønn-til-gule sonen uten å ligge i det røde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreek nu en let op de meter. Verhoog de versterking totdat normale spraak de groen-naar-gele zone bereikt zonder in het rood te blijven hangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mów teraz i obserwuj miernik. Podnoś wzmocnienie, aż zwykła mowa dojdzie do strefy zielono-żółtej i nie będzie wpadać w czerwoną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale agora e observe o medidor. Aumente o reforço até que a fala normal chegue à zona verde-amarela sem ficar no vermelho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорите сейчас и следите за индикатором. Поднимайте усиление, пока обычная речь не дойдёт до зелёно-жёлтой зоны и не будет заходить в красную."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovorte teraz a sledujte merač. Zvyšujte zosilnenie, kým sa bežná reč nedostane do zelenej až žltej zóny a nebude v červenej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prata nu och titta på mätaren. Höj förstärkningen tills normalt tal når den grön-gula zonen utan att ligga i det röda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พูดตอนนี้แล้วดูมิเตอร์ เพิ่มการขยายจนเสียงพูดปกติไปถึงโซนเขียวถึงเหลืองโดยไม่อยู่ในโซนแดง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi konuşun ve ölçere bakın. Normal konuşma kırmızıda kalmadan yeşilden sarıya bölgesine ulaşana kadar artırmayı yükseltin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Говоріть зараз і стежте за індикатором. Підвищуйте підсилення, доки звичайне мовлення не досягне зеленожовтої зони і не потраплятиме в червону."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói ngay và xem đồng hồ đo. Tăng mức tăng cường cho đến khi lời nói bình thường đạt vùng xanh lá sang vàng mà không nằm trong vùng đỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在开口说话并观察电平表。提高增益，直到正常语速落在绿色到黄色区间，且不会停留在红色区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在開始說話，並觀察音量表。提高增益，直到一般語速的聲音落在綠色到黃色區間，且不會停留在紅色區域。"
          }
        }
      }
    },
    "Speak once; a mode is the recipe that formats your words as an email, a note, a message, or your own. Tap 1, 2, or 3 to switch the recipe mid-demo.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكلّم مرة واحدة؛ الوضع هو الوصفة التي تنسّق كلماتك كبريد إلكتروني أو ملاحظة أو رسالة أو وصفة خاصة بك. اضغط 1 أو 2 أو 3 لتبديل الوصفة أثناء العرض."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Promluvte jednou; režim je recept, který formátuje vaše slova jako e-mail, poznámku, zprávu nebo váš vlastní. Klepněte na 1, 2 nebo 3 pro přepnutí receptu během ukázky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal én gang; en tilstand er opskriften, der formaterer dine ord som en e-mail, en note, en besked eller din egen. Tryk 1, 2 eller 3 for at skifte opskrift midt i demoen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich einmal; ein Modus ist das Rezept, das deine Worte als E-Mail, Notiz, Nachricht oder als eigenes Format gestaltet. Tippe 1, 2 oder 3, um das Rezept während der Vorführung zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla una vez; un modo es la receta que da formato a tus palabras como correo, nota, mensaje o como tú quieras. Pulsa 1, 2 o 3 para cambiar la receta durante la demostración."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhu kerran. Tila on resepti, joka muotoilee sanasi sähköpostiksi, muistiinpanoksi, viestiksi tai omaksi muodokseksesi. Napauta 1, 2 tai 3 vaihtaaksesi reseptiä esittelyn aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez une fois ; un mode est la recette qui met vos mots en forme comme un e-mail, une note, un message ou comme vous le souhaitez. Appuyez sur 1, 2 ou 3 pour changer de recette pendant la démo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דבר פעם אחת; מצב הוא המתכון שמעצב את המילים שלך כאימייל, הערה, הודעה או משלך. הקש 1, 2 או 3 כדי להחליף את המתכון באמצע ההדגמה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beszélj egyszer; a mód az a recept, amely a szavaidat e-mailként, jegyzetként, üzenetként vagy saját formában formázza. Koppints az 1, 2 vagy 3 gombra, hogy a bemutató közben váltsd a receptet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ucapkan sekali; mode adalah resep yang memformat kata-kata Anda menjadi email, catatan, pesan, atau bentuk Anda sendiri. Ketuk 1, 2, atau 3 untuk mengganti resep di tengah demo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla una volta: una modalità è la ricetta che formatta le tue parole come email, nota, messaggio o come preferisci tu. Tocca 1, 2 o 3 per cambiare ricetta durante la demo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度話すと、モードがその言葉をメール、メモ、メッセージ、またはお好みの形式に整えます。デモ中に 1、2、3 を押すと、整え方を切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 말하면, 모드는 말을 이메일, 메모, 메시지 또는 나만의 형식으로 서식화하는 조리법이에요. 데모 중에 1, 2, 3을 탭해서 조리법을 바꿔 보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snakk én gang; en modus er oppskriften som formaterer ordene dine som en e-post, et notat, en melding eller din egen. Trykk 1, 2 eller 3 for å bytte oppskrift midt i demoen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreek één keer; een modus is het recept dat je woorden opmaakt als e-mail, notitie, bericht of je eigen opmaak. Tik op 1, 2 of 3 om het recept midden in de demo te wisselen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz raz; tryb to przepis, który formatuje twoje słowa jako e-mail, notatkę, wiadomość albo własny. Stuknij 1, 2 lub 3, aby zmienić przepis w trakcie demo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale uma vez; um modo é a receita que formata suas palavras como e-mail, nota, mensagem ou a sua própria. Toque em 1, 2 ou 3 para trocar a receita durante a demonstração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажите один раз: режим это рецепт, который оформляет ваши слова как письмо, заметку, сообщение или ваш собственный. Нажмите 1, 2 или 3, чтобы переключить рецепт во время демонстрации."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povedzte raz; režim je recept, ktorý formátuje vaše slová ako e-mail, poznámku, správu alebo váš vlastný. Ťuknite na 1, 2 alebo 3 a počas ukážky prepnete recept."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tala en gång; ett läge är receptet som formaterar dina ord som ett e-postmeddelande, en anteckning, ett meddelande eller ditt eget. Tryck på 1, 2 eller 3 för att byta recept mitt i demon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พูดครั้งเดียว โหมดคือสูตรที่จัดรูปแบบคำของคุณให้เป็นอีเมล โน้ต ข้อความ หรือรูปแบบของคุณเอง แตะ 1, 2 หรือ 3 เพื่อสลับสูตรระหว่างการสาธิต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez konuşun; bir mod, sözcüklerinizi e-posta, not, mesaj ya da kendi biçiminiz olarak biçimlendiren tariftir. Demo sırasında tarifi değiştirmek için 1, 2 ya da 3'e dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажіть один раз: режим, це рецепт, що форматує ваші слова як лист, нотатку, повідомлення або власний варіант. Натисніть 1, 2 або 3, щоб змінити рецепт під час демо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói một lần; chế độ là công thức định dạng lời bạn thành email, ghi chú, tin nhắn hoặc công thức của riêng bạn. Nhấn 1, 2 hoặc 3 để đổi công thức giữa bản demo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说一次即可；模式是把你的文字整理为邮件、笔记、消息或你自定义格式的配方。在演示过程中轻按 1、2 或 3 即可切换配方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說一次即可；模式就是將你的文字排版為電子郵件、筆記、訊息或你自訂格式的配方。在示範中按下 1、2 或 3 即可切換配方。"
          }
        }
      }
    },
    "Speak straight into a scratchpad, then copy it or send it to your last app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكلّم مباشرة في المسودة، ثم انسخها أو أرسلها إلى آخر تطبيق استخدمته."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mluvte přímo do konceptu, pak jej zkopírujte nebo pošlete do poslední aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal direkte ind i en notesblok, og kopiér den derefter eller send den til din sidste app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich direkt in einen Notizblock und kopiere den Text oder sende ihn an deine letzte App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla directamente en un bloc de notas y luego cópialo o envíalo a tu última app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhu suoraan muistiolehtiöön ja kopioi se tai lähetä viimeisimpään sovellukseesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez directement dans un bloc-notes, puis copiez-le ou envoyez-le à votre dernière app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דבר ישירות לפנקס רשימות, ואז העתק אותו או שלח לאפליקציה הקודמת שלך."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Közvetlenül a vázlatfüzetbe beszélj, majd másold ki, vagy küldd el az utolsó alkalmazásodnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bicara langsung ke scratchpad, lalu salin atau kirim ke aplikasi terakhir Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla direttamente in un blocco note di prova, poi copialo o inviamelo nell'ultima app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモ帳に直接話してから、コピーするか直前のアプリに送ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모장에 바로 말한 뒤 복사하거나 마지막 앱으로 보내세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snakk rett inn i en notatlapp, og kopier den eller send den til forrige app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreek direct in een kladblok, kopieer het dan of stuur het naar je laatste app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mów bezpośrednio do notatnika, a potem skopiuj to albo wyślij do ostatniej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale direto em um bloco de notas e depois copie ou envie para o último app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорите прямо в черновик, затем скопируйте его или отправьте в последнее приложение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovorte priamo do poznámkového bloku a potom ho skopírujte alebo pošlite do poslednej aplikácie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tala direkt till en anteckningsyta, kopiera sedan eller skicka den till din senaste app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พูดลงในกระดาษโน้ตโดยตรง แล้วคัดลอกหรือส่งไปยังแอปล่าสุดของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrudan bir taslağa konuşun, sonra kopyalayın ya da son uygulamanıza gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Говоріть прямо в чернетку, потім скопіюйте її або надішліть у свою останню програму."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói thẳng vào khung nháp, rồi sao chép hoặc gửi sang ứng dụng gần nhất của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接对着草稿区说话，然后复制，或将其发送到你上一次使用的应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接對著草稿區說話，然後複製它，或傳送到你上一個使用的 App。"
          }
        }
      }
    },
    "Speaking pace": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سرعة الكلام"
          }
        },
        "cs": {
          "stringUnit": {
