    "Washes the floating recording panel's glass with this color. The next time the panel appears, it uses the new tint.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغمر زجاج لوحة التسجيل العائمة بهذا اللون. في المرة التالية التي تظهر فيها اللوحة، تستخدم اللون الجديد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přelije sklo plovoucího panelu nahrávání touto barvou. Až se panel příště objeví, použije nový odstín."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonerer glasset på det svævende optagelsespanel med denne farve. Næste gang panelet vises, bruger det den nye tone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überzieht das Glas des schwebenden Aufnahmefeldes mit dieser Farbe. Beim nächsten Erscheinen des Feldes wird der neue Farbton verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiñe el cristal del panel flotante de grabación con este color. La próxima vez que aparezca el panel, usará el nuevo tono."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sävyttää kelluvan nauhoituspaneelin lasin tällä värillä. Seuraavalla kerralla paneeli käyttää uutta sävyä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teinte le verre du panneau d'enregistrement flottant avec cette couleur. La prochaine fois que le panneau apparaît, il utilise la nouvelle teinte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צובע את זכוכית פאנל ההקלטה הצף בצבע הזה. בפעם הבאה שהפאנל יופיע, הוא ישתמש בגוון החדש."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel a színnel festi át a lebegő felvételi panel üvegét. A panel következő megjelenésekor az új árnyalatot használja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memberi warna pada kaca panel rekaman mengambang dengan warna ini. Saat panel muncul berikutnya, panel memakai tint baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinge il vetro del pannello di registrazione mobile con questo colore. La prossima volta che il pannello compare, userà la nuova tonalità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フローティング録音パネルのガラスをこの色で彩ります。次にパネルが表示されたときから新しい色合いになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "떠 있는 녹음 패널의 유리에 이 색을 입혀요. 다음에 패널이 나타날 때 새 색조가 적용돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fargelegger glasset i det flytende opptakspanelet med denne fargen. Neste gang panelet vises, bruker det den nye tonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tint het glas van het zwevende opnamepaneel met deze kleur. De volgende keer dat het paneel verschijnt, gebruikt het de nieuwe tint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabarwia szkło pływającego panelu nagrywania tym kolorem. Przy następnym pojawieniu się panelu użyje nowego odcienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinge o vidro do painel flutuante de gravação com esta cor. Na próxima vez que o painel aparecer, ele usa o novo tom."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окрашивает стекло плавающей панели записи этим цветом. При следующем появлении панели будет использован новый оттенок."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zafarbí sklo plávajúceho panela nahrávania touto farbou. Pri ďalšom zobrazení panela použije novú farbu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonar den flytande inspelningspanelens glas med den här färgen. Nästa gång panelen visas använder den den nya tonen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เคลือบกระจกของแผงบันทึกแบบลอยด้วยสีนี้ ครั้งต่อไปที่แผงปรากฏจะใช้โทนสีใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzen kayıt panelinin camını bu renkle boyar. Panel bir sonraki görünüşünde yeni tonu kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забарвлює скло плаваючої панелі запису цим кольором. Наступного разу, коли панель з'явиться, вона використає новий відтінок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phủ màu này lên mặt kính của bảng ghi nổi. Lần bảng hiện tiếp theo sẽ dùng màu mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用此颜色为浮动录音面板的玻璃质感着色。面板下次出现时将使用新的色调。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以此顏色為浮動錄音面板的玻璃質感上色。下次面板出現時，會使用新的色調。"
          }
        }
      }
    },
    "Watch it work": {
      "localizations": {
        "ar": {
