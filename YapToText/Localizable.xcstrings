          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada olduğunuza sevindik."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Раді, що ви тут."
          }
        },
        "vi": {
