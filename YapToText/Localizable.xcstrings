    "What all that talking adds up to.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما تُسفر عنه كل تلك الأحاديث."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čemu se to všechno mluvení rovná."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad al den snak lægger sammen til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was all das Sprechen ergibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que suma todo ese hablar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mihin kaikki tuo puhuminen kokonaisuudessaan yltää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le total de toutes ces paroles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה כל הדיבור הזה מסתכם בו."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mire jut ennyi beszéd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil dari semua ocehan itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il totale di tutto quel parlare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これだけ話した成果です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 모든 말이 쌓인 결과예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva all snakkingen blir til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar al dat praten op uitkomt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do czego prowadzi całe to gadanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No que toda essa conversa resulta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во что складывается вся эта болтовня."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čo všetko to rozprávanie predstavuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad allt pratande ger ihop till."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การพูดทั้งหมดนั้นรวมกันได้เท่าไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm bu konuşmanın toplamı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумок усього цього мовлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổng kết tất cả những gì bạn đã nói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些说话内容的总计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些說話累積起來的成果。"
          }
        }
      }
    },
    "What should we call you?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بماذا نناديك؟"
          }
