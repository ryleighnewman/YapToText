    "Tips are completely optional. YapToText is free with no locked features. Tips simply support continued development and future updates.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإكراميات اختيارية تماماً. YapToText مجاني بلا ميزات مقفلة. الإكراميات تدعم التطوير المستمر والتحديثات القادمة فقط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spropitné je zcela dobrovolné. YapToText je zdarma bez zamčených funkcí. Spropitné pouze podporuje další vývoj a budoucí aktualizace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips er helt valgfrie. YapToText er gratis uden låste funktioner. Tips støtter blot den fortsatte udvikling og kommende opdateringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipps sind völlig optional. YapToText ist kostenlos und ohne gesperrte Funktionen. Tipps unterstützen einfach die weitere Entwicklung und künftige Updates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las propinas son totalmente opcionales. YapToText es gratis y no tiene funciones bloqueadas. Las propinas solo ayudan a seguir desarrollando y a las próximas actualizaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinkit ovat täysin vapaaehtoisia. YapToText on ilmainen, eikä siinä ole lukittuja ominaisuuksia. Vinkit tukevat vain jatkokehitystä ja tulevia päivityksiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pourboires sont entièrement facultatifs. YapToText est gratuit, sans fonctions verrouillées. Les pourboires soutiennent simplement le développement et les mises à jour futures."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טיפים הם לגמרי אופציונליים. YapToText חינמי, בלי תכונות נעולות. טיפים פשוט תומכים בפיתוח המשך ובעדכונים עתידיים."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tippek teljesen opcionálisak. A YapToText ingyenes, nincsenek zárolt funkciói. A tippek csak a további fejlesztést és frissítéseket támogatják."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips sepenuhnya opsional. YapToText gratis tanpa fitur terkunci. Tips hanya mendukung pengembangan dan pembaruan berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I contributi sono del tutto facoltativi. YapToText è gratuito e senza funzioni bloccate. I contributi servono solo a sostenere lo sviluppo e gli aggiornamenti futuri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チップは完全に任意です。YapToText は無料で、ロックされた機能もありません。チップは今後の開発と更新を支えるためのものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁은 전적으로 선택 사항이에요. YapToText는 잠긴 기능 없이 무료예요. 팁은 계속된 개발과 향후 업데이트를 지원할 뿐이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips er helt valgfritt. YapToText er gratis uten låste funksjoner. Tips støtter bare videre utvikling og fremtidige oppdateringer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips zijn volledig optioneel. YapToText is gratis, zonder vergrendelde functies. Tips ondersteunen alleen de verdere ontwikkeling en toekomstige updates."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiwki są całkowicie opcjonalne. YapToText jest bezpłatny, bez zablokowanych funkcji. Napiwki po prostu wspierają dalszy rozwój i przyszłe aktualizacje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gorjetas são totalmente opcionais. O YapToText é gratuito, sem recursos bloqueados. As gorjetas apenas apoiam o desenvolvimento contínuo e as atualizações futuras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаевые полностью необязательны. YapToText бесплатен, и никакие функции не заблокированы. Чаевые просто помогают развивать программу и выпускать обновления."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipy sú úplne voliteľné. YapToText je zadarmo bez zamknutých funkcií. Tipy len podporujú ďalší vývoj a budúce aktualizácie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips är helt frivilliga. YapToText är gratis utan låsta funktioner. Tips stödjer bara fortsatt utveckling och framtida uppdateringar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทิปเป็นตัวเลือกทั้งหมด YapToText ฟรีโดยไม่มีฟีเจอร์ที่ล็อกไว้ ทิปเป็นเพียงการสนับสนุนการพัฒนาต่อและการอัปเดตในอนาคต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpuçları tamamen isteğe bağlıdır. YapToText kilitli özellik olmadan ücretsizdir. İpuçları yalnızca sürekli geliştirmeyi ve gelecek güncellemeleri destekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чайові повністю необов'язкові. YapToText безкоштовний, без закритих функцій. Чайові лише підтримують подальшу розробку й оновлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gợi ý hoàn toàn tùy chọn. YapToText miễn phí và không có tính năng khóa. Gợi ý chỉ giúp duy trì việc phát triển và các bản cập nhật sau này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打赏完全是自愿的。YapToText 免费，没有任何锁定功能。打赏只是为了支持持续开发和未来的更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "贊助完全是選擇性的。YapToText 免費使用，沒有任何鎖定的功能。贊助只是用來支持後續開發與未來的更新。"
          }
        }
      }
    },
    "Tips are temporarily unavailable": {
      "localizations": {
        "ar": {
