    "Open an issue on GitHub. Every one gets read.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح بلاغاً على GitHub. تتم قراءة كل بلاغ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Založte úkol na GitHubu. Každý se přečte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret en sag på GitHub. Hver enkelt bliver læst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eröffne ein Issue auf GitHub. Jedes wird gelesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un issue en GitHub. Todos se leen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa ongelmailmoitus GitHubissa. Jokainen luetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un ticket sur GitHub. Chacun est lu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח בעיה ב-GitHub. כל אחת נקראת."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyiss hibajegyet a GitHubon. Mindegyiket elolvassuk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka isu di GitHub. Setiap masukan pasti dibaca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri una segnalazione su GitHub. Ogni segnalazione viene letta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub で Issue を開いてください。すべて目を通します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에 이슈를 남겨 주세요. 모든 이슈를 읽어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne en sak på GitHub. Alle blir lest."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open een melding op GitHub. Elke melding wordt gelezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz zgłoszenie na GitHub. Każde zostanie przeczytane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra uma issue no GitHub. Todas são lidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте задачу на GitHub. Каждую читают."
          }
        },
