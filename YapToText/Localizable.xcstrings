        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout, posição e cores do pop-up ficam na [página Ditado](yap://dictation)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Макет, положение и цвета всплывающего окна находятся на [странице «Диктовка»](yap://dictation)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozloženie, poloha a farby vyskakovacieho okna sú na [stránke Diktovanie](yap://dictation)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Popupens layout, position och färger finns på [sidan Diktering](yap://dictation)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลย์เอาต์ ตำแหน่ง และสีของป๊อปอัปอยู่ที่ [หน้าการพิมพ์ด้วยเสียง](yap://dictation)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılır pencerenin düzeni, konumu ve renkleri [Dikte sayfasındadır](yap://dictation)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Макет, положення і кольори спливаючого вікна, на [сторінці «Диктовка»](yap://dictation)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bố cục, vị trí và màu của cửa sổ nổi nằm ở [trang Đọc chính tả](yap://dictation)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹出窗口的布局、位置和颜色位于[听写页面](yap://dictation)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "彈出視窗的版面、位置與顏色位於 [聽寫頁面](yap://dictation)。"
          }
        }
      }
    },
    "The recognizer heard silence. Get closer to the microphone, check the input on the Dictation page, or raise the input boost.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سمع المُتعرّف صمتاً. اقترب من الميكروفون، أو راجع الإدخال في صفحة الإملاء، أو ارفع تعزيز الإدخال."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznávání slyšelo ticho. Přibližte se k mikrofonu, zkontrolujte vstup na stránce Diktování nebo zvyšte zesílení vstupu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genkenderen hørte stilhed. Kom tættere på mikrofonen, kontrollér indgangen på siden Diktering, eller hæv indgangsforstærkningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erkennung hat Stille gehört. Rücke näher ans Mikrofon, prüfe den Eingang auf der Seite Diktat oder erhöhe die Eingangsverstärkung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocedor escuchó silencio. Acércate al micrófono, revisa la entrada en la página Dictado o sube el refuerzo de entrada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnistin kuuli hiljaisuutta. Siirry lähemmäs mikrofonia, tarkista syöte Sanelu-sivulla tai nosta syötteen vahvistusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance n'a entendu que du silence. Rapprochez-vous du microphone, vérifiez l'entrée sur la page Dictée, ou augmentez l'amplification d'entrée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מזהה הדיבור שמע שקט. התקרב למיקרופון, בדוק את הקלט בדף ההכתבה, או העלה את הגברת הקלט."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felismerő csendet hallott. Menj közelebb a mikrofonhoz, ellenőrizd a bemenetet a Diktálás oldalon, vagy emeld a bemeneti erősítést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengenal suara mendengar keheningan. Dekatkan diri ke mikrofon, periksa masukan di halaman Dikte, atau naikkan penguatan masukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscitore ha sentito silenzio. Avvicinati al microfono, controlla l'ingresso nella pagina Dettatura oppure alza il potenziamento in ingresso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認識エンジンは無音を検出しました。マイクに近づくか、ディクテーションページで入力を確認するか、入力ブーストを上げてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인식기가 무음을 들었어요. 마이크에 더 가까이 가거나, 받아쓰기 페이지에서 입력을 확인하거나, 입력 증폭을 올리세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenkjenneren hørte stillhet. Kom nærmere mikrofonen, sjekk inndata på Diktering-siden, eller øk inngangsforsterkningen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De herkenner hoorde stilte. Ga dichter bij de microfoon, controleer de ingang op de pagina Dicteren, of verhoog de ingangsversterking."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznawanie usłyszało ciszę. Podejdź bliżej mikrofonu, sprawdź wejście na stronie Dyktowanie lub podnieś wzmocnienie wejścia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecedor ouviu silêncio. Chegue mais perto do microfone, confira a entrada na página Ditado ou aumente o reforço de entrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание услышало тишину. Подойдите ближе к микрофону, проверьте вход на странице «Диктовка» или поднимите усиление входа."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznávač počul ticho. Priblížte sa k mikrofónu, skontrolujte vstup na stránke Diktovanie alebo zvýšte zosilnenie vstupu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Igenkänningen hörde tystnad. Kom närmare mikrofonen, kontrollera ingången på sidan Diktering eller höj ingångsförstärkningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบจดจำได้ยินความเงียบ ขยับเข้าใกล้ไมโครโฟน ตรวจอินพุตในหน้าการพิมพ์ด้วยเสียง หรือเพิ่มการขยายสัญญาณเข้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanıyıcı sessizlik duydu. Mikrofona yaklaşın, Dikte sayfasındaki girişi kontrol edin ya da giriş artırmayı yükseltin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розпізнавач почув тишу. Підійдіть ближче до мікрофона, перевірте вхід на сторінці «Диктовка» або збільште підсилення входу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhận dạng nghe thấy im lặng. Hãy đến gần micrô hơn, kiểm tra đầu vào ở trang Đọc chính tả, hoặc tăng cường đầu vào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别器只听到了静音。请靠近麦克风、检查听写页面中的输入，或提高输入增益。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "辨識器只聽到了靜音。請靠近麥克風、檢查「聽寫」頁面中的輸入設定，或提高輸入增益。"
          }
        }
      }
    },
    "The recommended cleanup model. MIT-licensed like Whisper, it follows rewrite instructions far more reliably than Apple Intelligence.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نموذج التنظيف الموصى به. مرخّص بموجب MIT مثل Whisper، ويتبع تعليمات إعادة الكتابة بموثوقية أكبر بكثير من Apple Intelligence."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doporučený model úprav. Licencovaný MIT jako Whisper, spolehlivěji než Apple Intelligence plní pokyny k přepisu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den anbefalede oprydningsmodel. MIT-licenseret ligesom Whisper, og den følger omskrivningsinstruktioner langt mere pålideligt end Apple Intelligence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das empfohlene Bereinigungsmodell. Es ist wie Whisper unter der MIT-Lizenz und folgt Umschreibungsanweisungen deutlich zuverlässiger als Apple Intelligence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de limpieza recomendado. Con licencia MIT como Whisper, sigue las instrucciones de reescritura mucho más fielmente que Apple Intelligence."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suositeltu siistintämalli. MIT-lisenssillä kuten Whisper, se noudattaa uudelleenkirjoitusohjeita paljon luotettavammin kuin Apple Intelligence."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle de nettoyage recommandé. Sous licence MIT comme Whisper, il suit les instructions de réécriture bien plus fidèlement qu'Apple Intelligence."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מודל הניקוי המומלץ. רישיון MIT כמו Whisper, והוא עוקב אחרי הוראות כתיבה מחדש הרבה יותר באמינות מ-Apple Intelligence."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ajánlott tisztító modell. A Whisperhez hasonlóan MIT licencű, és az átírási utasításokat sokkal megbízhatóbban követi, mint az Apple Intelligence."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model pembersihan yang direkomendasikan. Berlisensi MIT seperti Whisper, dan jauh lebih andal mengikuti instruksi penulisan ulang dibanding Apple Intelligence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello di pulizia consigliato. Con licenza MIT come Whisper, segue le istruzioni di riscrittura molto più affidabilmente di Apple Intelligence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめのクリーンアップモデルです。Whisper と同じく MIT ライセンスで、Apple Intelligence よりはるかに確実に書き直しの指示に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천 정리 모델이에요. Whisper처럼 MIT 라이선스이며, Apple Intelligence보다 다시 쓰기 지시를 훨씬 안정적으로 따라요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den anbefalte opprydningsmodellen. MIT-lisensiert som Whisper, og den følger omskrivingsinstruksjoner langt mer pålitelig enn Apple Intelligence."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het aanbevolen opschoonmodel. Met MIT-licentie zoals Whisper, en het volgt herschrijfinstructies veel betrouwbaarder dan Apple Intelligence."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalecany model czyszczenia. Na licencji MIT, jak Whisper, znacznie niezawodniej wykonuje instrukcje przepisywania niż Apple Intelligence."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de limpeza recomendado. Licença MIT, como o Whisper, segue instruções de reescrita muito mais confiavelmente do que a Apple Intelligence."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендуемая модель очистки. Лицензия MIT, как у Whisper. Она гораздо надёжнее выполняет инструкции по переписыванию, чем Apple Intelligence."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odporúčaný model úpravy. Má licenciu MIT ako Whisper a riadi sa pokynmi na prepísanie oveľa spoľahlivejšie než Apple Intelligence."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den rekommenderade rensningsmodellen. MIT-licensierad som Whisper, den följer omskrivningsinstruktioner betydligt mer tillförlitligt än Apple Intelligence."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลทำความสะอาดที่แนะนำ ใบอนุญาต MIT เหมือน Whisper และทำตามคำสั่งเขียนใหม่ได้เชื่อถือได้มากกว่า Apple Intelligence มาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önerilen temizleme modeli. Whisper gibi MIT lisanslı, yeniden yazma talimatlarını Apple Intelligence'dan çok daha güvenilir şekilde izler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендована модель очищення. Ліцензія MIT, як і в Whisper; вона значно надійніше виконує інструкції з переписування, ніж Apple Intelligence."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình làm sạch được đề xuất. Có giấy phép MIT như Whisper, nó làm theo các hướng dẫn viết lại đáng tin cậy hơn nhiều so với Apple Intelligence."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐的清理模型。与 Whisper 一样采用 MIT 许可证，执行改写指令的可靠性远高于 Apple Intelligence。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建議使用的清理模型。與 Whisper 一樣採 MIT 授權，遵循改寫指示的能力遠勝 Apple Intelligence。"
          }
        }
      }
    },
    "The ribbons ride the spectrum. Speed sets the cycle rate; spread fans the ribbons apart in hue - all the way down pulses the whole wave as one color.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتحرك الشرائط عبر الطيف. تحدد السرعة معدل الدورة؛ ويفرّق الانتشار الشرائط في درجة اللون، وعند الحد الأدنى تنبض الموجة كلها بلون واحد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuhy jedou po spektru. Rychlost určuje rychlost cyklu; rozptyl rozvětvuje stuhy v odstínu. Úplně dolů pulzuje celá vlna jako jedna barva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Båndene kører gennem spektret. Hastighed sætter cyklussen; spredning spreder båndene i farvetone - helt nede får hele bølgen puls som én farve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bänder durchlaufen das Farbspektrum. Das Tempo bestimmt die Zyklusrate; die Streuung fächert die Bänder im Farbton auf. Ganz nach unten gezogen lässt die ganze Welle als eine Farbe pulsieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cintas recorren el espectro. La velocidad define la frecuencia del ciclo; la dispersión separa las cintas en tono, y si la bajas del todo, la onda entera pulsa en un solo color."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhat kulkevat spektrin läpi. Nopeus määrää kiertonopeuden, leviäminen levittää nauhat sävyltään erilleen. Täysin alas vedettynä koko aalto sykkii yhtenä värinä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rubans parcourent le spectre. La vitesse règle le rythme du cycle ; la dispersion écarte les rubans en teinte. Tout en bas, toute la vague pulse dans une seule couleur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסרטים רוכבים על הספקטרום. המהירות קובעת את קצב המחזור; הפיזור מפזר את הסרטים בגוון. עד הסוף, הגל כולו פועם בצבע אחד."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szalagok a színskálán haladnak. A sebesség a ciklus gyorsaságát, az eloszlás a szalagok árnyalati szétterítését állítja; teljesen lehúzva az egész hullám egy színben pulzál."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pita bergerak di spektrum. Kecepatan mengatur laju siklus; sebaran membuka pita dalam rona - sampai paling kecil membuat seluruh gelombang berdenyut dalam satu warna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nastri attraversano lo spettro. La velocità imposta il ritmo del ciclo; la dispersione separa i nastri per tonalità. Al minimo, l'intera onda pulsa con un solo colore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リボンはスペクトル上を移動します。速さは周期を、広がりは色相の間隔を決めます。広がりを最小にすると、波全体が一色で脈打ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리본은 스펙트럼을 따라 움직여요. 속도는 순환 속도를, 분산은 색조에서 리본을 펼쳐요. 가장 낮게 하면 전체 파형이 하나의 색으로 맥동해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Båndene følger spekteret. Hastighet bestemmer syklusraten; spredning spreier båndene fra hverandre i fargetone - helt nede gjør at hele bølgen pulserer som én farge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De linten bewegen over het spectrum. Snelheid bepaalt de cyclusfrequentie; spreiding spreidt de linten uit in tint. Helemaal naar beneden pulseert de hele golf als één kleur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstęgi przebiegają przez spektrum. Szybkość ustawia tempo cyklu; rozrzut rozsuwa wstęgi w barwie, a na samym dole cała fala pulsuje jednym kolorem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fitas percorrem o espectro. A velocidade define a taxa do ciclo; a dispersão abre as fitas em matiz, e no mínimo a onda inteira pulsa em uma única cor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ленты проходят по спектру. Скорость задаёт частоту цикла, разброс раздвигает ленты по оттенку. Если выставить его на ноль, вся волна пульсирует одним цветом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pásy sa pohybujú po spektre. Rýchlosť určuje tempo cyklu; rozptyl rozvetví pásy v odtieni. Pri nulovom rozptyle sa celá vlna pulzuje v jednej farbe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Banden rör sig över spektrumet. Hastighet anger cykelns takt; spridning fördelar banden i nyans, och när den skruvas helt ned pulserar hela vågen i en enda färg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ริบบิ้นจะวนไปตามสเปกตรัม ความเร็วกำหนดอัตรารอบ การกระจายแยกริบบิ้นออกตามโทนสี เมื่อลดลงสุดจะทำให้ทั้งคลื่นกะพริบเป็นสีเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şeritler spektrumda gezinir. Hız döngü oranını belirler; yayılım şeritleri ton olarak ayırır - en aşağı çekildiğinde tüm dalga tek bir renk olarak nabız atar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стрічки проходять спектр. Швидкість задає частоту циклу; розкид розводить стрічки за відтінком; якщо викрутити до нуля, уся хвиля пульсує одним кольором."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các dải màu chạy theo quang phổ. Tốc độ đặt nhịp chu kỳ; độ lan tách các dải ra theo sắc độ. Kéo hết xuống sẽ làm cả sóng nhấp nháy như một màu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "彩带沿着色谱流动。速度决定循环速率；分布决定彩带在色相上的展开程度，调到最低时整个波形会以同一种颜色脉动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "彩帶會沿著光譜流動。速度設定循環速率；分佈會依色相將彩帶展開，調到最低時，整個波形會以單一顏色脈動。"
          }
        }
      }
    },
    "The round buttons are pause, stop and insert, and cancel. Drag the panel anywhere and it stays there. Size, position, and colors are on the Dictation page, with a live preview.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأزرار الدائرية هي: إيقاف مؤقت وإيقاف وإدراج، والإلغاء. اسحب اللوحة إلى أي مكان وستبقى هناك. الحجم والموضع والألوان موجودة في صفحة الإملاء، مع معاينة مباشرة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulatá tlačítka slouží k pozastavení, zastavení a vložení a ke zrušení. Panel přetáhněte kamkoli a zůstane tam. Velikost, poloha a barvy jsou na stránce Diktování s živým náhledem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De runde knapper er pause, stop og indsæt samt annuller. Træk panelet hen, hvor du vil, så bliver det der. Størrelse, position og farver findes på siden Diktering med en live-forhåndsvisning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die runden Schaltflächen sind Pausieren, Beenden und Einfügen sowie Abbrechen. Ziehe das Feld irgendwohin, es bleibt dort. Größe, Position und Farben findest du auf der Seite Diktat mit einer Live-Vorschau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los botones redondos son pausar, detener e insertar, y cancelar. Arrastra el panel a cualquier lugar y se quedará allí. El tamaño, la posición y los colores están en la página Dictado, con vista previa en vivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyöreät painikkeet ovat keskeytys, lopeta ja lisää sekä peruuta. Vedä paneeli minne tahansa, ja se pysyy siinä. Koko, sijainti ja värit ovat Sanelu-sivulla, ja siellä on reaaliaikainen esikatselu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les boutons ronds sont pause, arrêt et insertion, et annulation. Faites glisser le panneau où vous voulez, il y reste. La taille, la position et les couleurs se règlent sur la page Dictée, avec un aperçu en direct."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכפתורים העגולים הם השהה, עצור והכנס, וביטול. גרור את הפאנל לכל מקום והוא יישאר שם. הגודל, המיקום והצבעים נמצאים בדף ההכתבה, עם תצוגה חיה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kerek gombok a szünet, a leállítás és beszúrás, valamint a megszakítás. Húzd a panelt bárhová, és ott marad. A méret, a pozíció és a színek a Diktálás oldalon találhatók, élő előnézettel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol bulat berfungsi untuk jeda, hentikan dan sisipkan, serta batalkan. Seret panel ke mana saja dan panel akan tetap di sana. Ukuran, posisi, dan warna ada di halaman Dikte, dengan pratinjau langsung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pulsanti rotondi sono pausa, stop e inserisci, e annulla. Trascina il pannello dove vuoi e rimane lì. Dimensione, posizione e colori si trovano nella pagina Dettatura, con anteprima dal vivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "丸いボタンは、一時停止、停止して挿入、キャンセルです。パネルはどこへドラッグしても、そこに留まります。サイズ、位置、色はディクテーションページで、ライブプレビュー付きで設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둥근 버튼은 일시 정지, 중지 및 삽입, 취소예요. 패널은 어디로든 끌어다 놓으면 그 자리에 남아 있어요. 크기, 위치, 색상은 받아쓰기 페이지에서 실시간 미리 보기와 함께 설정해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De runde knappene er pause, stopp og sett inn, og avbryt. Dra panelet hvor som helst, så blir det der. Størrelse, posisjon og farger finnes på Diktering-siden, med en live forhåndsvisning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ronde knoppen zijn pauzeren, stoppen en invoegen, en annuleren. Sleep het paneel waar je wilt, en het blijft daar. Grootte, positie en kleuren staan op de pagina Dicteren, met een live voorbeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okrągłe przyciski to wstrzymaj, zatrzymaj i wstaw oraz anuluj. Przeciągnij panel w dowolne miejsce, a tam zostanie. Rozmiar, położenie i kolory są na stronie Dyktowanie, z podglądem na żywo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os botões redondos são pausar, parar e inserir, e cancelar. Arraste o painel para qualquer lugar e ele fica lá. Tamanho, posição e cores ficam na página Ditado, com uma prévia ao vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Круглые кнопки: пауза, остановить и вставить, отмена. Перетащите панель куда угодно, и она останется там. Размер, положение и цвета находятся на странице «Диктовка» с живым предпросмотром."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Okrúhle tlačidlá slúžia na pozastavenie, zastavenie a vloženie a na zrušenie. Panel môžete presunúť kamkoľvek a zostane tam. Veľkosť, poloha a farby sú na stránke Diktovanie s živou ukážkou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De runda knapparna är paus, stopp och infoga samt avbryt. Dra panelen vart du vill så stannar den där. Storlek, position och färger finns på sidan Diktering, med en live-förhandsvisning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มกลมคือ หยุดชั่วคราว หยุดและแทรก และยกเลิก ลากแผงไปที่ใดก็ได้แล้วมันจะอยู่ตรงนั้น ขนาด ตำแหน่ง และสีอยู่ในหน้าการพิมพ์ด้วยเสียง พร้อมตัวอย่างสด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuvarlak düğmeler duraklat, durdur ve ekle ile iptal içindir. Paneli istediğiniz yere sürükleyin, orada kalır. Boyut, konum ve renkler canlı önizlemeyle Dikte sayfasındadır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Круглі кнопки: пауза, зупинка з вставленням і скасування. Панель можна перетягнути будь-куди, і вона там залишиться. Розмір, положення і кольори, на сторінці «Диктовка» з живим попереднім переглядом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các nút tròn là tạm dừng, dừng và chèn, và hủy. Kéo bảng đi đâu cũng được và nó sẽ ở đó. Kích thước, vị trí và màu nằm ở trang Đọc chính tả, có bản xem trước trực tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆形按钮依次为暂停、停止并插入，以及取消。可将面板拖动到任意位置，它会停留在那里。大小、位置和颜色位于听写页面，并附带实时预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圓形按鈕依序為暫停、停止並插入，以及取消。拖曳面板即可放在任何位置，並會保留在該處。大小、位置與顏色位於「聽寫」頁面，並附有即時預覽。"
          }
        }
      }
    },
    "The same words, shaped for where they are going.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكلمات نفسها، مُشكّلة لتناسب وجهتها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stejná slova, upravená pro místo, kam směřují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De samme ord, formet til det sted, de skal hen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselben Worte, geformt für ihr Ziel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mismas palabras, con la forma del lugar al que van."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Samat sanat, muotoiltuina sen mukaan, minne ne menevät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mêmes mots, façonnés pour leur destination."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אותן מילים, מעוצבות למקום שאליו הן הולכות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugyanazok a szavak, ahhoz formálva, ahová tartanak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata-kata yang sama, dibentuk sesuai tujuannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stesse parole, adattate alla destinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ言葉を、行き先に合わせて整えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 말을, 가는 곳에 맞게 다듬어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De samme ordene, formet for dit de skal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezelfde woorden, gevormd naar waar ze naartoe gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te same słowa, ukształtowane pod miejsce, do którego trafiają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mesmas palavras, moldadas para o lugar aonde vão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Те же слова, оформленные под место назначения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tie isté slová, upravené podľa miesta, kam smerujú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samma ord, formade för vart de ska."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำเดิม จัดรูปให้เหมาะกับที่ที่มันจะไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı sözcükler, gideceği yere göre biçimlendirilmiş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ті самі слова, оформлені відповідно до того, куди вони йдуть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những từ như vậy, được định dạng cho nơi chúng sẽ đến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同样的文字，依据其去向进行整理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同樣的文字，依照它要去的地方調整格式。"
          }
        }
      }
    },
