    "The microphone isn't delivering audio. Try again, or pick another input in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الميكروفون لا يرسل صوتاً. حاول مجدداً، أو اختر إدخالاً آخر في الإعدادات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon nedodává zvuk. Zkuste to znovu nebo v Nastavení vyberte jiný vstup."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen leverer ingen lyd. Prøv igen, eller vælg en anden indgang under Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon liefert kein Audio. Versuche es erneut oder wähle in den Einstellungen einen anderen Eingang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono no envía audio. Inténtalo de nuevo o elige otra entrada en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofoni ei välitä ääntä. Yritä uudelleen tai valitse toinen syöte Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le microphone ne transmet pas d'audio. Réessayez, ou choisissez une autre entrée dans Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המיקרופון לא מעביר אודיו. נסה שוב, או בחר קלט אחר בהגדרות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mikrofon nem ad hangot. Próbáld újra, vagy válassz másik bemenetet a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon tidak mengirim audio. Coba lagi, atau pilih masukan lain di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono non invia audio. Riprova oppure scegli un altro ingresso nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクから音声が届いていません。もう一度お試しいただくか、設定で別の入力を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크가 오디오를 전달하지 않고 있어요. 다시 시도하거나 설정에서 다른 입력을 고르세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen leverer ikke lyd. Prøv igjen, eller velg en annen inngang i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoon levert geen audio. Probeer het opnieuw of kies een andere ingang in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon nie przesyła dźwięku. Spróbuj ponownie albo wybierz inne wejście w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone não está entregando áudio. Tente de novo ou escolha outra entrada nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон не передаёт звук. Попробуйте снова или выберите другой вход в настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofón neposiela zvuk. Skúste to znova alebo vyberte iný vstup v Nastaveniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen levererar inget ljud. Försök igen, eller välj en annan ingång i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไมโครโฟนไม่ได้ส่งเสียง ลองอีกครั้ง หรือเลือกอินพุตอื่นในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon ses vermiyor. Yeniden deneyin ya da Ayarlar'dan başka bir giriş seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікрофон не передає аудіо. Спробуйте знову або виберіть інший вхід у Налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Micrô không gửi được âm thanh. Hãy thử lại, hoặc chọn một đầu vào khác trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风没有传送音频。请重试，或在设置中选择其他输入设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風沒有傳送音訊。請再試一次，或在「設定」中選擇其他輸入裝置。"
          }
        }
      }
    },
    "The microphone or speech engine didn't start. Check the Microphone permission in System Settings > Privacy, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يبدأ الميكروفون أو محرك الكلام. تحقق من إذن الميكروفون في إعدادات النظام > الخصوصية، ثم حاول مجدداً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon nebo engine řeči se nespustil. Zkontrolujte oprávnění Mikrofon v Nastavení systému > Soukromí a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen eller talemotoren startede ikke. Kontrollér tilladelsen Mikrofon under Systemindstillinger > Anonymitet, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon oder die Spracherkennung konnte nicht starten. Prüfe die Mikrofonberechtigung unter Systemeinstellungen > Datenschutz und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se inició el micrófono ni el motor de voz. Revisa el permiso de Micrófono en Ajustes del Sistema > Privacidad y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonia tai puhemoottoria ei voitu käynnistää. Tarkista mikrofonin lupa kohdasta Järjestelmäasetukset > Yksityisyys, ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le microphone ou le moteur de parole n'a pas démarré. Vérifiez l'autorisation Microphone dans Réglages Système > Confidentialité, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המיקרופון או מנוע הדיבור לא התחילו. בדוק את הרשאת המיקרופון בהגדרות המערכת > פרטיות, ואז נסה שוב."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mikrofon vagy a beszédmotor nem indult el. Ellenőrizd a Mikrofon engedélyt a Rendszerbeállítások > Adatvédelem részben, majd próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon atau mesin ucapan tidak mulai. Periksa izin Mikrofon di Pengaturan Sistem > Privasi, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono o il motore vocale non si sono avviati. Controlla il permesso Microfono in Impostazioni di Sistema > Privacy, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクまたは音声エンジンが起動しませんでした。システム設定 > プライバシー で マイクの権限を確認してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 또는 음성 엔진을 시작할 수 없었어요. 시스템 설정 > 개인 정보 보호에서 마이크 권한을 확인한 뒤 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen eller talemotoren startet ikke. Sjekk tillatelsen for Mikrofon i Systeminnstillinger > Personvern, og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoon of spraakengine is niet gestart. Controleer de toestemming voor de microfoon onder Systeeminstellingen > Privacy en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon albo silnik mowy nie uruchomił się. Sprawdź uprawnienie Mikrofon w Ustawieniach systemowych > Prywatność, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone ou o mecanismo de fala não iniciou. Confira a permissão de Microfone em Ajustes do Sistema > Privacidade e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон или движок речи не запустился. Проверьте разрешение на микрофон в Системных настройках > Конфиденциальность, затем попробуйте снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofón alebo engine reči sa nespustil. Skontrolujte povolenie Mikrofón v Nastaveniach systému > Súkromie a potom to skúste znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen eller talmotorn startade inte. Kontrollera behörigheten Mikrofon i Systeminställningar > Integritet och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไมโครโฟนหรือเอนจินเสียงเริ่มทำงานไม่ได้ ตรวจสอบสิทธิ์ไมโครโฟนในการตั้งค่าระบบ > ความเป็นส่วนตัว แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon ya da konuşma motoru başlamadı. Sistem Ayarları > Gizlilik bölümünde Mikrofon iznini kontrol edip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікрофон або мовний рушій не запустилися. Перевірте дозвіл на мікрофон у Системних налаштуваннях > Конфіденційність, потім спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Micrô hoặc engine giọng nói không khởi động. Hãy kiểm tra quyền Micrô trong Cài đặt Hệ thống > Quyền riêng tư, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风或语音引擎未能启动。请在“系统设置 > 隐私”中检查麦克风权限，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風或語音引擎無法啟動。請到「系統設定」>「隱私權」檢查麥克風權限，然後再試一次。"
          }
        }
      }
    },
    "The microphone stopped sending audio, so YapToText restarted it. Check the last few words.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف الميكروفون عن إرسال الصوت، فأعاد YapToText تشغيله. تحقق من آخر بضع كلمات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon přestal posílat zvuk, takže jej YapToText restartoval. Zkontrolujte posledních několik slov."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen holdt op med at sende lyd, så YapToText genstartede den. Kontrollér de sidste par ord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon hat kein Audio mehr gesendet, daher hat YapToText es neu gestartet. Prüfe die letzten Worte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono dejó de enviar audio, así que YapToText lo reinició. Revisa las últimas palabras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofoni lakkasi lähettämästä ääntä, joten YapToText käynnisti sen uudelleen. Tarkista viimeiset sanat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le microphone a cessé d'envoyer de l'audio, donc YapToText l'a redémarré. Vérifiez les derniers mots."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המיקרופון הפסיק לשלוח אודיו, לכן YapToText הפעיל אותו מחדש. בדוק את המילים האחרונות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mikrofon nem küldött több hangot, ezért a YapToText újraindította. Ellenőrizd az utolsó néhány szót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon berhenti mengirim audio, jadi YapToText memulainya ulang. Periksa beberapa kata terakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono ha smesso di inviare audio, quindi YapToText lo ha riavviato. Controlla le ultime parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクが音声を送らなくなったため、YapToText が再開しました。最後の数語を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크가 오디오를 보내지 않아서 YapToText가 다시 시작했어요. 마지막 몇 단어를 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen sluttet å sende lyd, så YapToText startet den på nytt. Sjekk de siste ordene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoon stuurde geen audio meer, dus YapToText heeft hem opnieuw gestart. Controleer de laatste paar woorden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon przestał przesyłać dźwięk, więc YapToText go uruchomił ponownie. Sprawdź ostatnie kilka słów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone parou de enviar áudio, então o YapToText o reiniciou. Confira as últimas palavras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон перестал передавать звук, поэтому YapToText перезапустил его. Проверьте последние слова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofón prestal posielať zvuk, takže ho YapToText reštartoval. Skontrolujte posledných pár slov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen slutade skicka ljud, så YapToText startade om den. Kontrollera de sista orden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไมโครโฟนหยุดส่งเสียง YapToText จึงเริ่มใหม่ ตรวจดูคำสุดท้ายไม่กี่คำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon ses göndermeyi durdurdu, bu yüzden YapToText onu yeniden başlattı. Son birkaç kelimeyi kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікрофон перестав передавати аудіо, тож YapToText його перезапустив. Перевірте останні кілька слів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Micrô ngừng gửi âm thanh, nên YapToText đã khởi động lại. Hãy kiểm tra vài từ cuối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风停止发送音频，因此 YapToText 将其重新启动。请检查最后几个字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風停止傳送音訊，因此 YapToText 已將其重新啟動。請檢查最後幾個字。"
          }
        }
      }
    },
    "The microphone stopped sending audio. Stop and start the dictation again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف الميكروفون عن إرسال الصوت. أوقف الإملاء وابدأه مجدداً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon přestal posílat zvuk. Zastavte a znovu spusťte diktování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen holdt op med at sende lyd. Stop og start dikteringen igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon sendet kein Audio mehr. Beende das Diktat und starte es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono dejó de enviar audio. Detén y vuelve a iniciar el dictado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofoni lakkasi lähettämästä ääntä. Lopeta ja käynnistä sanelu uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le microphone a cessé d'envoyer de l'audio. Arrêtez puis relancez la dictée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המיקרופון הפסיק לשלוח אודיו. עצור והתחל את ההכתבה מחדש."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mikrofon nem küld hangot. Állítsd le, majd indítsd újra a diktálást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon berhenti mengirim audio. Hentikan lalu mulai ulang dikte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono ha smesso di inviare audio. Ferma e riavvia la dettatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクが音声を送らなくなりました。ディクテーションを停止して、もう一度開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크가 오디오를 보내지 않게 됐어요. 받아쓰기를 멈췄다가 다시 시작하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen sluttet å sende lyd. Stopp og start dikteringen på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoon stuurt geen audio meer. Stop en start het dicteren opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon przestał przesyłać dźwięk. Zatrzymaj i uruchom dyktowanie ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone parou de enviar áudio. Pare e inicie o ditado de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон перестал передавать звук. Остановите и снова запустите диктовку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofón prestal posielať zvuk. Zastavte a znova spustite diktovanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen slutade skicka ljud. Stoppa och starta diktering igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไมโครโฟนหยุดส่งเสียง หยุดและเริ่มการพิมพ์ด้วยเสียงใหม่อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon ses göndermeyi durdurdu. Dikteyi durdurup yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікрофон перестав передавати аудіо. Зупиніть і знову запустіть диктовку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Micrô đã ngừng gửi âm thanh. Hãy dừng và bắt đầu lại đọc chính tả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风停止发送音频。请停止并重新开始听写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風已停止傳送音訊。請停止並重新開始聽寫。"
          }
        }
      }
    },
