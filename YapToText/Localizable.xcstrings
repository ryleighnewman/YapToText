    },
    "Type your name below so AI modes can sign your emails for you instead of writing “[Your Name]”. It's optional, so feel free to skip it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب اسمك أدناه حتى تتمكن أوضاع الذكاء الاصطناعي من توقيع رسائلك بدلاً من كتابة “[Your Name]”. هذا اختياري، ويمكنك تخطيه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napište níže své jméno, aby režimy AI mohly podepisovat vaše e-maily místo „[Your Name]“. Je to nepovinné, můžete to přeskočit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv dit navn nedenfor, så AI-tilstande kan underskrive dine e-mails for dig i stedet for at skrive “[Your Name]”. Det er valgfrit, så spring gerne over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib unten deinen Namen ein, damit KI-Modi deine E-Mails für dich signieren können, statt „[Your Name]“ zu schreiben. Das ist optional, du kannst es gern überspringen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe tu nombre abajo para que los modos de IA firmen tus correos por ti en lugar de escribir “[Tu nombre]”. Es opcional, así que puedes omitirlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita nimesi alle, jotta AI-tilat voivat allekirjoittaa sähköpostisi ”[Your Name]” -kirjoittamisen sijaan. Se on vapaaehtoinen, voit ohittaa sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez votre nom ci-dessous pour que les modes IA signent vos e-mails à votre place au lieu d'écrire “[Votre nom]”. C'est facultatif, vous pouvez passer cette étape."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלד את שמך למטה כדי שמצבי AI יוכלו לחתום על האימיילים שלך במקום לכתוב “[Your Name]”. זה אופציונלי, אז אפשר לדלג."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írd be lent a neved, hogy az AI módok aláírhassák helyetted az e-mailjeidet a „[Your Name]” helyett. Ez opcionális, nyugodtan hagyd ki."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik nama Anda di bawah agar mode AI bisa menandatangani email untuk Anda, bukan menulis “[Your Name]”. Ini opsional, jadi silakan dilewati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi il tuo nome qui sotto così le modalità IA possono firmare le tue email al posto tuo invece di scrivere “[Your Name]”. È facoltativo, quindi puoi saltarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下に名前を入力すると、AI モードがメールに署名できます。「[Your Name]」と書かれることはなくなります。任意なので、スキップしても構いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에 이름을 입력하면 AI 모드가 “[Your Name]” 대신 이메일에 서명해 줘요. 선택 사항이니 건너뛰어도 괜찮아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv navnet ditt nedenfor, så kan KI-moduser signere e-postene dine i stedet for å skrive «[Ditt navn]». Det er valgfritt, så hopp gjerne over det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ hieronder je naam zodat AI-modi je e-mails voor je kunnen ondertekenen in plaats van “[Your Name]” te schrijven. Het is optioneel, dus sla het gerust over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz poniżej swoje imię, aby tryby AI mogły podpisywać za ciebie e-maile zamiast pisać „[Twoje imię]”. To opcjonalne, więc możesz pominąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite seu nome abaixo para que os modos de IA assinem seus e-mails em vez de escrever “[Seu nome]”. É opcional, pode pular à vontade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите ниже своё имя, чтобы режимы с ИИ подписывали ваши письма, а не писали «[Ваше имя]». Это необязательно, можно пропустить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíšte nižšie svoje meno, aby režimy AI mohli podpisovať e-maily namiesto „[Vaše meno]“. Je to voliteľné, takže môžete preskočiť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv ditt namn nedan så att AI-lägena kan signera dina e-postmeddelanden åt dig i stället för att skriva ”[Ditt namn]”. Det är valfritt, så hoppa gärna över det."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์ชื่อของคุณด้านล่าง เพื่อให้โหมด AI ลงชื่อในอีเมลให้แทนการเขียน “[ชื่อของคุณ]” ไม่บังคับ จะข้ามไปก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "YZ modlarının “[Adınız]” yazmak yerine e-postalarınızı sizin adınıza imzalayabilmesi için adınızı aşağıya yazın. İsteğe bağlıdır, dilerseniz atlayabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть своє ім'я нижче, щоб режими ШІ підписували ваші листи замість написання «[Ваше ім'я]». Це необов'язково, тож можете пропустити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gõ tên bên dưới để các chế độ AI ký email thay bạn thay vì viết “[Tên của bạn]”. Không bắt buộc, bạn có thể bỏ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方输入你的名字，AI 模式就会代你在邮件上署名，而不再写“[Your Name]”。此项为可选，可以随意跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在下方輸入你的名字，讓 AI 模式能替你簽署電子郵件，而不是寫出「[Your Name]」。這是選用的，你可以略過。"
          }
        }
      }
    },
