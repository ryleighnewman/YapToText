    "Choose a whisper.cpp speech model (.bin) or a llama.cpp cleanup model (.gguf)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر نموذج كلام whisper.cpp ‎(.bin) أو نموذج تنظيف llama.cpp ‎(.gguf)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte model řeči whisper.cpp (.bin) nebo model úpravy llama.cpp (.gguf)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en whisper.cpp-talemodel (.bin) eller en llama.cpp-oprydningsmodel (.gguf)"
          }
        },
        "de": {
          "stringUnit": {
