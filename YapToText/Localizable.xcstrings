    "Buttons and highlights follow your system accent color.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع الأزرار والتمييزات لون التمييز في النظام."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačítka a zvýraznění se řídí barvou zvýraznění systému."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Knapper og fremhævninger følger din systems accentfarve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltflächen und Hervorhebungen folgen der Akzentfarbe deines Systems."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los botones y los resaltados siguen el color de acento de tu sistema."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Painikkeet ja korostukset seuraavat järjestelmän korostusväriä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les boutons et les surbrillances suivent la couleur d'accent de votre système."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כפתורים והדגשות עוקבים אחרי צבע ההדגשה של המערכת."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gombok és kiemelések a rendszer kiemelőszínét követik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol dan sorotan mengikuti warna aksen sistem Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsanti ed evidenziazioni seguono il colore di accento del sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンとハイライトはシステムのアクセント色に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼과 강조 표시는 시스템 강조 색을 따라요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Knapper og utheving følger systemets aksentfarge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knoppen en markeringen volgen je systeemaccentkleur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyciski i podświetlenia podążają za kolorem akcentu systemu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Botões e destaques seguem a cor de destaque do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопки и выделения следуют системному цвету акцента."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačidlá a zvýraznenia nasledujú farbu zvýraznenia systému."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Knappar och markeringar följer systemets accentfärg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มและส่วนที่เน้นจะทำตามสีเน้นของระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düğmeler ve vurgular sistem vurgu renginizi izler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопки і підсвітлення слідують за системним акцентним кольором."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nút và điểm nhấn theo màu nhấn của hệ thống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按钮和高亮跟随系统强调色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鈕與強調會跟隨系統的強調色。"
          }
        }
      }
    },
    "Buttons and highlights use your custom color everywhere in the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم الأزرار والتمييزات لونك المخصص في كل مكان بالتطبيق."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačítka a zvýraznění používají vaši vlastní barvu všude v aplikaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Knapper og fremhævninger bruger din egen farve overalt i appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltflächen und Hervorhebungen verwenden überall in der App deine eigene Farbe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los botones y los resaltados usan tu color personalizado en toda la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Painikkeet ja korostukset käyttävät omaa väriäsi kaikkialla sovelluksessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les boutons et les surbrillances utilisent votre couleur personnalisée partout dans l'app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כפתורים והדגשות משתמשים בצבע המותאם שלך בכל מקום באפליקציה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gombok és kiemelések mindenhol az egyéni színt használják az alkalmazásban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol dan sorotan memakai warna kustom Anda di seluruh aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsanti ed evidenziazioni usano il tuo colore personalizzato in tutta l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンとハイライトは、アプリ内のどこでもあなたのカスタム色を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼과 강조 표시는 앱 전체에서 사용자 지정 색을 사용해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Knapper og utheving bruker din egendefinerte farge overalt i appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knoppen en markeringen gebruiken je eigen kleur overal in de app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyciski i podświetlenia używają twojego własnego koloru w całej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Botões e destaques usam sua cor personalizada em todo o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопки и выделения используют ваш цвет везде в приложении."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačidlá a zvýraznenia používajú vašu vlastnú farbu všade v aplikácii."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Knappar och markeringar använder din egen färg överallt i appen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มและส่วนที่เน้นจะใช้สีที่คุณกำหนดทุกที่ในแอป"
