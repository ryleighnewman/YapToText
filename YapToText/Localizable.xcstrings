          }
        }
      }
    },
    "The panel has pause, stop, and cancel buttons while you dictate.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي اللوحة على أزرار إيقاف مؤقت وإيقاف وإلغاء أثناء الإملاء."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel má během diktování tlačítka pozastavit, zastavit a zrušit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Panelet har knapper til pause, stop og annuller, mens du diktererer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Feld hat während des Diktierens Schaltflächen zum Pausieren, Beenden und Abbrechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El panel tiene botones de pausar, detener y cancelar mientras dictas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paneelissa on keskeytys-, lopeta- ja peruuta-painikkeet sanelun aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le panneau affiche des boutons pause, arrêt et annulation pendant la dictée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפאנל כולל כפתורים להשהיה, עצירה וביטול בזמן ההכתבה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A panelen diktálás közben szünet, leállítás és megszakítás gombok vannak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel memiliki tombol jeda, hentikan, dan batalkan saat Anda mendikte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pannello ha i pulsanti pausa, stop e annulla durante la dettatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディクテーション中は、パネルに一時停止、停止、キャンセルのボタンが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰는 동안 패널에는 일시 정지, 중지, 취소 버튼이 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Panelet har knapper for pause, stopp og avbryt mens du diktere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het paneel heeft knoppen voor pauzeren, stoppen en annuleren terwijl je dicteert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel ma przyciski wstrzymania, zatrzymania i anulowania podczas dyktowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O painel tem botões de pausar, parar e cancelar enquanto você dita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время диктовки на панели есть кнопки паузы, остановки и отмены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel má počas diktovania tlačidlá pozastavenia, zastavenia a zrušenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Panelen har knappar för paus, stopp och avbryt medan du diktera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผงมีปุ่มหยุดชั่วคราว หยุด และยกเลิกขณะพิมพ์ด้วยเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte ederken panelde duraklat, durdur ve iptal düğmeleri bulunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час диктовки на панелі є кнопки паузи, зупинки і скасування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảng có các nút tạm dừng, dừng và hủy khi bạn đang đọc chính tả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听写时，面板上有暂停、停止和取消按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽寫時，面板會顯示暫停、停止與取消按鈕。"
          }
        }
      }
    },
    "The panel's glass is washed with your accent color.": {
      "localizations": {
