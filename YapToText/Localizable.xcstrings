    "That shortcut is already in use by another app. Pick a different one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الاختصار مستخدم بالفعل من تطبيق آخر. اختر اختصاراً مختلفاً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto zkratku už používá jiná aplikace. Vyberte jinou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genvejen bruges allerede af en anden app. Vælg en anden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kurzbefehl wird bereits von einer anderen App verwendet. Wähle einen anderen."
