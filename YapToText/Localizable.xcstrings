            "state": "translated",
            "value": "模式、自動與 AI 清理會在每次轉錄後執行。"
          }
        }
      }
    },
    "Modes, dictionaries, commands, AI actions, and history are kept.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ الأوضاع والقواميس والأوامر وإجراءات الذكاء الاصطناعي والسجل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Režimy, slovníky, příkazy, akce AI a historie zůstanou zachovány."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilstande, ordbøger, kommandoer, AI-handlinger og historik bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modi, Wörterbücher, Befehle, KI-Aktionen und Verlauf bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservan los modos, diccionarios, comandos, acciones de IA e historial."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilat, sanastot, komennot, AI-toiminnot ja historia säilytetään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modes, dictionnaires, commandes, actions IA et l'historique sont conservés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצבים, מילונים, פקודות, פעולות AI והיסטוריה יישמרו."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módok, szótárak, parancsok, AI műveletek és az előzmények megmaradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode, kamus, perintah, aksi AI, dan riwayat tetap disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità, dizionari, comandi, azioni IA e cronologia vengono conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モード、辞書、コマンド、AI アクション、履歴は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모드, 사전, 명령, AI 작업, 기록은 유지돼요."
          }
        },
