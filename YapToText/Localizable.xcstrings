        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטקסט המעוצב שלך מגיע לכאן."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A formázott szöveged itt jelenik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang sudah diformat masuk di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo testo formattato appare qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "整形されたテキストがここに入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서식이 적용된 텍스트가 여기에 나타나요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den formaterte teksten din havner her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je opgemaakte tekst komt hier terecht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój sformatowany tekst pojawi się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu texto formatado cai aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш оформленный текст появится здесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš naformátovaný text sa objaví tu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din formaterade text landar här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความที่จัดรูปแบบแล้วจะปรากฏที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biçimlendirilmiş metniniz burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш відформатований текст з'являється тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản đã định dạng của bạn hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你格式化后的文字会出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排版後的文字會出現在這裡。"
          }
        }
      }
    },
    "Your last 30 days, your words and speaking time, your real words per minute, and the time saved over typing. Computed on your Mac from your own history, and nothing leaves the machine.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر 30 يوماً، وكلماتك ووقت الكلام، وعدد كلماتك الفعلي في الدقيقة، والوقت الموفّر مقارنة بالكتابة. تُحسب على Mac من سجلك أنت، ولا يغادر أي شيء الجهاز."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše posledních 30 dní, vaše slova a čas mluvení, vaše skutečná rychlost ve slovech za minutu a čas ušetřený oproti psaní. Vše se počítá na vašem Macu z vaší vlastní historie a nic zařízení neopouští."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine sidste 30 dage, dine ord og taletid, dine reelle ord pr. minut og den tid, der spares i forhold til at skrive. Beregnes på din Mac ud fra din egen historik, og intet forlader maskinen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine letzten 30 Tage, deine Worte und Sprechzeit, deine tatsächlichen Wörter pro Minute und die Zeit, die gegenüber dem Tippen gespart wurde. Auf deinem Mac aus deinem eigenen Verlauf berechnet, und nichts verlässt das Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus últimos 30 días: tus palabras y tu tiempo hablando, tus palabras reales por minuto y el tiempo ahorrado frente a escribir. Se calcula en tu Mac a partir de tu propio historial, y nada sale de la máquina."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeiset 30 päivää, sanasi ja puheaikasi, todelliset sanat minuutissa ja kirjoittamiseen verrattuna säästetty aika. Lasketaan Macilla omasta historiastasi, eikä mikään poistu koneelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos 30 derniers jours, vos mots et votre temps de parole, votre vitesse réelle en mots par minute, et le temps gagné par rapport à la frappe. Calculé sur votre Mac à partir de votre propre historique, rien ne quitte la machine."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "30 הימים האחרונים שלך: המילים ושעות הדיבור שלך, קצב המילים האמיתי שלך, והזמן שנחסך לעומת הקלדה. מחושב במחשב שלך מההיסטוריה שלך, ושום דבר לא יוצא מהמכונה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elmúlt 30 napod, a kimondott szavaid és beszédidőd, a valódi szó/perc értéked és a gépeléshez képest megspórolt idő. A Macen számítjuk ki a saját előzményeidből, és semmi nem hagyja el a gépet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "30 hari terakhir Anda, kata dan waktu bicara, kata per menit yang sebenarnya, dan waktu yang dihemat dibanding mengetik. Dihitung di Mac Anda dari riwayat Anda sendiri, dan tidak ada yang keluar dari mesin ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli ultimi 30 giorni, le tue parole e il tempo di parlato, le tue parole al minuto reali e il tempo risparmiato rispetto alla digitazione. Calcolato sul tuo Mac a partire dalla tua cronologia, senza che nulla lasci il dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近 30 日間の言葉数と話した時間、実際の 1 分あたりの単語数、タイピングと比べた節約時間です。すべて Mac 上で、あなたの履歴から計算され、外部には送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 30일 동안 말한 단어와 말한 시간, 실제 분당 단어 수, 타이핑 대비 절약한 시간이에요. 내 기록을 바탕으로 이 Mac에서 계산되며, 어떤 데이터도 기기 밖으로 나가지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine siste 30 dager, dine ord og taletid, dine faktiske ord per minutt, og tiden spart mot å skrive. Beregnet på din Mac fra din egen historikk, og ingenting forlater maskinen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je laatste 30 dagen, je woorden en spreektijd, je echte woorden per minuut, en de tijd die je bespaart ten opzichte van typen. Berekend op je Mac uit je eigen geschiedenis, en niets verlaat het apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje ostatnie 30 dni, Twoje słowa i czas mówienia, Twoje realne słowa na minutę i czas zaoszczędzony względem pisania. Liczone na Twoim Macu z Twojej własnej historii, nic nie opuszcza urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus últimos 30 dias, suas palavras e tempo de fala, suas palavras por minuto reais e o tempo economizado em relação à digitação. Calculado no seu Mac a partir do seu próprio histórico; nada sai da máquina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За последние 30 дней: ваши слова и время речи, реальная скорость в словах в минуту и время, сэкономленное по сравнению с печатью. Вычисляется на вашем Mac по вашей истории, и ничего не покидает устройство."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaších posledných 30 dní, vaše slová a čas rozprávania, vaša skutočná rýchlosť v slovách za minútu a čas ušetrený oproti písaniu. Vypočítané vo vašom Macu z vašej vlastnej histórie a nič neopustí zariadenie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina senaste 30 dagar, dina ord och talad tid, dina verkliga ord per minut och tiden som sparats jämfört med att skriva. Beräknas på din Mac utifrån din egen historik, och inget lämnar maskinen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "30 วันที่ผ่านมา จำนวนคำและเวลาพูดของคุณ ความเร็วคำต่อนาทีจริง และเวลาที่ประหยัดได้เมื่อเทียบกับการพิมพ์ คำนวณบน Mac จากประวัติของคุณเอง ไม่มีข้อมูลใดออกจากเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 30 gününüz, sözcükleriniz ve konuşma süreniz, gerçek dakikadaki sözcük sayınız ve yazmaya kıyasla kazandığınız süre. Mac'inizde kendi geçmişinizden hesaplanır, hiçbir şey cihazdan çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші останні 30 днів: слова і час мовлення, справжня швидкість слів за хвилину і час, зекономлений порівняно з друком. Обчислюється на вашому Mac за вашою власною історією, і нічого не залишає пристрій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "30 ngày gần đây, số từ và thời gian nói của bạn, số từ mỗi phút thực tế và thời gian tiết kiệm so với gõ phím. Được tính trên Mac của bạn từ lịch sử của chính bạn, không có gì rời khỏi máy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你最近 30 天的情况：你的字数和说话时长、实际每分钟字数，以及相比打字节省的时间。这些均在你的 Mac 上根据你自己的历史记录计算，数据不会离开这台机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你最近 30 天的字數與說話時間、實際的每分鐘字數，以及比打字節省的時間。這些都在你的 Mac 上根據你自己的紀錄計算，不會傳送到機器外。"
          }
        }
      }
    },
    "Your mic is heard clearly, well above the room noise. Transcription will be at its best.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُسمع ميكروفونك بوضوح، وأعلى بكثير من ضوضاء الغرفة. سيكون النسخ في أفضل حالاته."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš mikrofon je slyšet zřetelně, výrazně nad hlukem v místnosti. Přepis bude v nejlepší kvalitě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din mikrofon høres tydeligt, langt over rumstøjen. Transskriptionen bliver på sit bedste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mikrofon ist klar zu hören, deutlich über dem Raumrauschen. Die Transkription wird bestmöglich sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu micrófono se oye claramente, muy por encima del ruido de la habitación. La transcripción será la mejor posible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonisi kuuluu selvästi, selvästi huoneen kohinan yläpuolella. Litteroinnista tulee parhaimmillaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre micro est bien audible, nettement au-dessus du bruit de la pièce. La transcription sera au mieux."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המיקרופון שלך נשמע בבירור, הרבה מעל רעש החדר. התמלול יהיה במיטבו."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mikrofonod tisztán hallatszik, jóval a szobazaj fölött. Az átírás a legjobb lesz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon Anda terdengar jelas, jauh di atas kebisingan ruangan. Transkripsi akan berada di kualitas terbaiknya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo microfono si sente chiaramente, ben sopra il rumore della stanza. La trascrizione sarà al meglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクの音は部屋のノイズよりはるかに大きく、はっきり聞き取れています。書き起こしの精度は最高になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 소리가 방 소음보다 훨씬 크게 잘 들려요. 전사가 가장 좋은 상태일 거예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen din høres tydelig, godt over romstøyen. Transkripsjonen blir på sitt beste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je microfoon wordt duidelijk gehoord, ruim boven het ruisniveau. Transcriptie zal op zijn best zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój mikrofon jest słyszany wyraźnie, znacznie ponad szumem pokoju. Transkrypcja będzie najlepsza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu microfone é ouvido com clareza, bem acima do ruído do ambiente. A transcrição vai estar no seu melhor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш микрофон слышно отчётливо, заметно громче шума комнаты. Расшифровка будет на высоте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš mikrofón sa počuje jasne, výrazne nad šumom miestnosti. Prepis bude na svojom najlepšom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din mikrofon hörs tydligt, långt över rumsbruset. Transkriberingen blir som bäst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไมค์ของคุณได้ยินชัดเจน สูงกว่าเสียงรบกวนในห้องมาก การถอดเสียงจะดีที่สุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonunuz odadaki gürültünün çok üstünde net duyuluyor. Yazıya dökme en iyi haline gelecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш мікрофон чується чітко, значно вище за шум кімнати. Транскрибація буде найкращою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Micrô của bạn được nghe rõ, cao hơn nhiều so với tiếng ồn phòng. Phiên âm sẽ đạt chất lượng tốt nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的麦克风声音清晰，远高于房间噪音。转写效果将达到最佳。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的麥克風聲音清楚，遠高於房間噪音。轉錄會達到最佳效果。"
          }
        }
      }
    },
    "Your microphone signal has dropped: %.0fdB now, %.0fdB before.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انخفضت إشارة ميكروفونك: %.0fdB الآن، و%.0fdB سابقاً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Signál vašeho mikrofonu klesl: nyní %1$.0f dB, předtím %2$.0f dB."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit mikrofonsignal er faldet: %.0fdB nu, %.0fdB før."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Signal deines Mikrofons ist gesunken: jetzt %.0f dB, vorher %.0f dB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La señal de tu micrófono ha bajado: %.0fdB ahora, %.0fdB antes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonisi signaali on heikentynyt: nyt .0fdB, aiemmin .0fdB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le signal de votre microphone a baissé : %.0f dB maintenant, %.0f dB auparavant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
