    "hey um can you send over the q3 numbers before friday thanks": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحباً، هل يمكنك إرسال أرقام الربع الثالث قبل يوم الجمعة، شكراً"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
