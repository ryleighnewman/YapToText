    "Excellent multilingual cleanup, especially for non-English dictation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظيف متعدد اللغات ممتاز، خاصة للإملاء بغير الإنجليزية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výborná vícejazyčná úprava, zejména pro diktát v jiných jazycích než angličtině."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fremragende flersproget oprydning, især til diktering på andre sprog end engelsk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hervorragende mehrsprachige Bereinigung, besonders für Diktate in anderen Sprachen als Englisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Excelente limpieza multilingüe, sobre todo para dictados en otros idiomas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinomainen monikielinen siistintä, erityisesti muille kuin englanninkielisille sanelulle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Excellent nettoyage multilingue, surtout pour les dictées dans une autre langue que l'anglais."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניקוי רב-לשוני מצוין, במיוחד להכתבה שאינה באנגלית."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiváló többnyelvű tisztítás, különösen nem angol nyelvű diktáláshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembersihan multibahasa yang sangat baik, terutama untuk dikte selain bahasa Inggris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottima pulizia multilingue, soprattutto per le dettature in lingue diverse dall'inglese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特に英語以外のディクテーションに対して、優れた多言語のクリーンアップができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특히 영어가 아닌 받아쓰기에 뛰어난 다국어 정리예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utmerket flerspråklig opprydding, spesielt for diktering på andre språk enn engelsk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitstekende meertalige opschoning, vooral voor niet-Engels dicteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doskonałe wielojęzyczne czyszczenie, zwłaszcza dla dyktowania w językach innych niż angielski."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excelente limpeza multilíngue, especialmente para ditado em outros idiomas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отличная многоязычная очистка, особенно для диктовки не на английском."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Výborná viacjazyčná úprava, najmä pri diktovaní v iných jazykoch než v angličtine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utmärkt flerspråkig rensning, särskilt för diktering på andra språk än engelska."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทำความสะอาดหลายภาษาที่ยอดเยี่ยม โดยเฉพาะการพิมพ์ด้วยเสียงที่ไม่ใช่ภาษาอังกฤษ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özellikle İngilizce dışındaki dikteler için mükemmel çok dilli temizlik."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чудове багатомовне очищення, особливо для диктовки неанглійською."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm sạch đa ngôn ngữ xuất sắc, đặc biệt cho đọc chính tả không phải tiếng Anh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出色的多语言清理，尤其适用于非英语听写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "優秀的多語言清理，特別適合非英文的聽寫。"
          }
        }
      }
    },
