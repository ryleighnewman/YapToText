    "Teach the recognizer your names and jargon.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علّم المُتعرّف أسماءك ومصطلحاتك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naučte rozpoznávání vaše jména a odborné výrazy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lær genkenderen dine navne og fagudtryk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringe der Erkennung deine Namen und Fachbegriffe bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enseña al reconocedor tus nombres y tu jerga."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Opeta tunnistimelle nimesi ja erikoissanasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprenez à la reconnaissance vocale vos noms et votre jargon."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למד את מזהה הדיבור את השמות והמונחים שלך."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanítsd meg a felismerőnek a neveidet és szakkifejezéseidet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajari pengenal suara nama dan istilah Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Insegna al riconoscitore i tuoi nomi e i tuoi termini tecnici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前や専門用語を認識エンジンに覚えさせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인식기에 이름과 전문 용어를 알려 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lær gjenkjenneren navnene og fagordene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer de herkenner je namen en jargon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naucz rozpoznawanie twoich nazw i żargonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensine ao reconhecedor seus nomes e jargões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Научите распознавание вашим именам и терминам."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naučte rozpoznávač vaše mená a odborné výrazy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lär igenkänningen dina namn och facktermer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สอนระบบจดจำให้รู้จักชื่อและศัพท์เฉพาะของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanıyıcıya adlarınızı ve terimlerinizi öğretin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навчіть розпізнавач ваших імен і термінів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dạy cho bộ nhận dạng tên và thuật ngữ của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教会识别器你的名字和行话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "教辨識器認識你的名字與專業術語。"
          }
        }
      }
    },
