    "Let the app read each dictation and pick the right format by itself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دع التطبيق يقرأ كل إملاء ويختار التنسيق المناسب بنفسه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechte aplikaci přečíst každý diktát a sama zvolit správný formát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad appen læse hver diktering og vælge det rette format af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass die App jedes Diktat lesen und das passende Format selbstständig wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que la app lea cada dictado y elija por sí sola el formato adecuado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna sovelluksen lukea jokainen sanelu ja valita oikea muoto itse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez l'app lire chaque dictée et choisir seule le bon format."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תן לאפליקציה לקרוא כל הכתבה ולבחור את העיצוב הנכון לבד."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagyd, hogy az alkalmazás minden diktálást elolvasson, és magától válassza ki a megfelelő formátumot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan aplikasi membaca setiap dikte dan memilih format yang tepat sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia che l'app legga ogni dettatura e scelga da sola il formato giusto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが各ディクテーションを読み取り、適した形式を自動で選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 각 받아쓰기를 읽고 알맞은 형식을 스스로 고르게 하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La appen lese hver diktering og velge riktig format av seg selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de app elk dictee lezen en zelf de juiste opmaak kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól aplikacji przeczytać każde dyktowanie i samodzielnie wybrać odpowiedni format."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o app ler cada ditado e escolher o formato certo sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть приложение читает каждую диктовку и само выбирает подходящий формат."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechajte aplikáciu prečítať každý diktát a sama vybrať správny formát."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt appen läsa varje diktering och välja rätt format på egen hand."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้แอปอ่านการพิมพ์ด้วยเสียงแต่ละครั้งและเลือกรูปแบบที่เหมาะสมด้วยตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın her dikteyi okuyup doğru biçimi kendisinin seçmesine izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нехай програма читає кожну диктовку і сама обирає правильний формат."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để ứng dụng tự đọc từng lần đọc chính tả và chọn định dạng phù hợp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让应用阅读每次听写的内容，并自动选择合适的格式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 App 閱讀每次的聽寫內容，並自動選擇正確的格式。"
          }
        }
      }
    },
