          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri satu emoji beberapa frasa, seperti “fire emoji, flame emoji, lit emoji”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna a un'emoji più frasi, ad esempio “fire emoji, flame emoji, lit emoji”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 つの絵文字に複数の言い方を設定できます。例: 「fire emoji, flame emoji, lit emoji」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이모지 하나에 여러 문구를 연결하세요. 예: “fire emoji, flame emoji, lit emoji”."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi én emoji flere fraser, som «fire emoji, flame emoji, lit emoji»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef één emoji meerdere zinnen, zoals “fire emoji, flame emoji, lit emoji”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypisz jednemu emoji kilka fraz, na przykład „emoji ognia, emoji płomienia, emoji płonącego”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê a um emoji várias frases, como “emoji de fogo, emoji de chama, emoji de labareda”."
