    },
    "The pop-up above follows every change here as you make it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع النافذة المنبثقة أعلاه كل تغيير هنا أثناء إجرائه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyskakovací okno výše sleduje každou změnu, kterou zde uděláte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop op-vinduet ovenfor følger hver ændring her, efterhånden som du laver den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Pop-up oben folgt jeder Änderung hier, sobald du sie machst."
          }
