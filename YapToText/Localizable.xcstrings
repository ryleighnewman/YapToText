    "Defaults restored. Undo brings back exactly what you had, until you quit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت استعادة الإعدادات الافتراضية. التراجع يعيد بالضبط ما كان لديك، حتى تُغلق التطبيق."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výchozí hodnoty obnoveny. Vrácení zpět obnoví přesně to, co jste měli, dokud aplikaci neukončíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standarder gendannet. Fortryd henter præcis det, du havde, indtil du afslutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardwerte wiederhergestellt. Mit Rückgängig holst du genau das Vorherige zurück, bis du die App beendest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores predeterminados restaurados. Deshacer devuelve exactamente lo que tenías, hasta que cierres la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletukset palautettu. Kumoa palauttaa täsmälleen aiemmat asetukset, kunnes lopetat sovelluksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeurs par défaut rétablies. Annuler restaure exactement ce que vous aviez, jusqu'à la fermeture de l'app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברירות המחדל שוחזרו. ביטול מחזיר בדיוק את מה שהיה לך, עד שתצא מהאפליקציה."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alapértékek visszaálltak. A visszavonással pontosan a korábbi állapot tér vissza, amíg ki nem lépsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Default dipulihkan. Batalkan akan mengembalikan persis seperti sebelumnya, sampai Anda keluar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni predefinite ripristinate. Annulla riporta esattamente ciò che avevi, fino alla chiusura dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期値に戻しました。終了するまで、取り消しで元の状態に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값을 복원했어요. 앱을 종료하기 전까지는 실행 취소로 이전 설정을 그대로 되돌릴 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardinnstillingene er gjenopprettet. Angre henter tilbake nøyaktig det du hadde, til du avslutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaardwaarden hersteld. Ongedaan maken herstelt precies wat je had, totdat je afsluit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywrócono domyślne. Cofnij przywróci dokładnie to, co było, do momentu zamknięcia aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Padrões restaurados. Desfazer traz de volta exatamente o que você tinha, até você sair do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения по умолчанию восстановлены. Отмена вернёт ровно то, что было, до выхода из приложения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predvolené nastavenia obnovené. Vrátenie späť obnoví presne to, čo ste mali, kým aplikáciu neukončíte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardinställningarna återställdes. Ångra återställer exakt det du hade, tills du avslutar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนค่าเริ่มต้นแล้ว การยกเลิกจะนำค่าเดิมทั้งหมดกลับมาจนกว่าจะออกจากแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılanlar geri yüklendi. Geri al, çıkana kadar sahip olduklarınızı tam olarak geri getirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Типові значення відновлено. Скасування поверне саме те, що було, доки ви не вийдете з програми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã khôi phục mặc định. Hoàn tác sẽ đưa lại đúng những gì bạn có trước đó, cho đến khi thoát ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已恢复默认设置。在退出应用之前，撤销可以还原你原来的全部设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已還原預設值。在結束 App 之前，復原可以恢復先前的設定。"
          }
        }
      }
    },
