    "Disabled - post-transcription analysis is off. Activate to turn it on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معطّل: تحليل ما بعد النسخ مُعطّل. فعّله لتشغيله."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnuto, analýza po přepisu je vypnutá. Aktivujte pro zapnutí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiveret - analyse efter transskription er slået fra. Aktivér for at slå den til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviert, die Analyse nach der Transkription ist aus. Aktiviere sie, um sie einzuschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: el análisis posterior a la transcripción está apagado. Actívalo para encenderlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pois käytöstä, litteroinnin jälkeinen analyysi on pois päältä. Aktivoi kytkeäksesi sen päälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : l'analyse après transcription est désactivée. Activez pour l'activer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מושבת - ניתוח אחרי תמלול כבוי. הפעל כדי להדליק."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Letiltva, az átírás utáni elemzés ki van kapcsolva. Aktiváld a bekapcsoláshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonaktif, analisis pascatranskripsi dimatikan. Aktifkan untuk menyalakannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato: l'analisi dopo la trascrizione è spenta. Attivalo per accenderla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効。書き起こし後の分析がオフです。有効にするには操作してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 안 함. 전사 후 분석이 꺼져 있어요. 눌러서 켜세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivert - analyse etter transkripsjon er av. Aktiver for å slå den på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgeschakeld, analyse na transcriptie staat uit. Activeer om hem aan te zetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączone, analiza po transkrypcji jest wyłączona. Aktywuj, aby ją włączyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado: a análise pós-transcrição está desligada. Ative para ligá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключено: анализ после расшифровки выключен. Нажмите, чтобы включить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnuté, analýza po prepise je vypnutá. Aktivujte ju na zapnutie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaktiverad - analys efter transkribering är av. Aktivera för att slå på den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดใช้งาน การวิเคราะห์หลังถอดเสียงปิดอยู่ เปิดใช้งานเพื่อเปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devre dışı - yazıya dökme sonrası analiz kapalı. Açmak için etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнено: аналіз після транскрибації вимкнено. Активуйте, щоб увімкнути."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tắt, phân tích sau phiên âm đang tắt. Kích hoạt để bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停用：转写后分析已关闭。点击即可开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停用：轉錄後分析已關閉。啟用即可開啟。"
          }
        }
      }
    },
