    "Help is always at the bottom of the sidebar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المساعدة متوفرة دائماً في أسفل الشريط الجانبي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nápověda je vždy dole v postranním panelu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjælp findes altid nederst i sidepanelet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilfe findest du immer unten in der Seitenleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ayuda siempre está al final de la barra lateral."
          }
