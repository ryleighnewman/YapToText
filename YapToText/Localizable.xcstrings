        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a parancsikont már egy másik alkalmazás használja. Válassz másikat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan itu sudah dipakai aplikasi lain. Pilih yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa scorciatoia è già usata da un'altra app. Scegline una diversa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのショートカットは別のアプリで使われています。別のものを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 단축키는 이미 다른 앱에서 사용 중이에요. 다른 것을 고르세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den snarveien er allerede i bruk av en annen app. Velg en annen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sneltoets wordt al door een andere app gebruikt. Kies een andere."
