    "Recommended, so the app can hear your voice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مُوصى به، حتى يتمكن التطبيق من سماع صوتك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doporučeno, aby vás aplikace slyšela."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anbefales, så appen kan høre din stemme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfohlen, damit die App deine Stimme hören kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendado, para que la app pueda oír tu voz."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suositus, jotta sovellus kuulee äänesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommandé, pour que l'app puisse entendre votre voix."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מומלץ, כדי שהאפליקציה תוכל לשמוע את הקול שלך."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajánlott, hogy az alkalmazás hallhassa a hangodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkomendasikan, agar aplikasi bisa mendengar suara Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigliato, così l'app può sentire la tua voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリがあなたの声を聞き取れるよう、推奨します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 목소리를 들을 수 있도록 권장해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anbefalt, så appen kan høre stemmen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanbevolen, zodat de app je stem kan horen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalecany, aby aplikacja mogła usłyszeć Twój głos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendado, para que o app possa ouvir sua voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендуется, чтобы приложение могло слышать ваш голос."
          }
        },
        "sk": {
          "stringUnit": {
