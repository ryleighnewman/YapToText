        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk %@ untuk mulai, ketuk lagi untuk berhenti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca %@ per avviare, toccalo di nuovo per fermare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
