          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדיוק הגבוה ביותר, רב-לשוני. הגדול והאיטי ביותר."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legnagyobb pontosság, többnyelvű. A legnagyobb és a leglassabb."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akurasi tertinggi, multibahasa. Paling besar dan paling lambat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Massima precisione, multilingue. Il più grande e il più lento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最高精度で多言語に対応します。最も大きく、最も遅いモデルです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 높은 정확도, 다국어 지원. 가장 크고 가장 느려요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyest nøyaktighet, flerspråklig. Størst og tregest."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoogste nauwkeurigheid, meertalig. Grootste en traagste."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najwyższa dokładność, wiele języków. Największy i najwolniejszy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Maior precisão, multilíngue. O maior e o mais lento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимальная точность, поддержка множества языков. Самая большая и самая медленная."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najvyššia presnosť, viac jazykov. Najväčší a najpomalší."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högsta träffsäkerhet, flerspråkig. Störst och långsammast."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม่นยำที่สุด รองรับหลายภาษา มีขนาดใหญ่และช้าที่สุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En yüksek doğruluk, çok dilli. En büyük ve en yavaş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найвища точність, багатомовність. Найбільша і найповільніша."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ chính xác cao nhất, đa ngôn ngữ. Lớn nhất và chậm nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准确率最高，支持多语言。体积最大，速度最慢。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "準確度最高，支援多語言。體積最大、速度最慢。"
          }
        }
      }
    },
    "Highlight the words to change - the edit starts by itself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد الكلمات المراد تغييرها، ويبدأ التحرير تلقائياً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte slova ke změně, úprava se spustí sama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markér ordene, der skal ændres - redigeringen starter af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere die Worte, die geändert werden sollen, die Bearbeitung startet von selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resalta las palabras que quieres cambiar: la edición empieza sola."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korosta muutettavat sanat, muokkaus alkaa itsestään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez les mots à modifier : la modification démarre toute seule."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סמן את המילים לשינוי - העריכה מתחילה לבד."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelöld ki a módosítandó szavakat, a szerkesztés magától elindul."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorot kata yang ingin diubah, suntingan akan mulai sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evidenzia le parole da cambiare: la modifica parte da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更したい単語を選択してください。編集は自動的に始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바꿀 단어를 선택하세요. 편집은 자동으로 시작돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Marker ordene som skal endres - redigeringen starter av seg selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer de woorden die je wilt wijzigen, de bewerking start vanzelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz słowa do zmiany, edycja rozpocznie się sama."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione as palavras a mudar; a edição começa sozinha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите слова для изменения, правка начнётся сама."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte slová na zmenu, úprava sa spustí sama."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera orden som ska ändras, redigeringen startar av sig själv."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฮไลต์คำที่ต้องการเปลี่ยน การแก้ไขจะเริ่มเองโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirilecek sözcükleri vurgulayın - düzenleme kendiliğinden başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виділіть слова для зміни: редагування запускається саме."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn các từ cần đổi, chỉnh sửa tự bắt đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中要更改的词语，编辑会自动开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "反白要變更的文字，編輯會自動開始。"
          }
        }
      }
    },
    "Highlight the words you want to change, then hold %@ and say the edit - like “capitalize this”.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد الكلمات التي تريد تغييرها، ثم اضغط مطولاً على %@ وقل التعديل، مثل “capitalize this”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte slova, která chcete změnit, pak podržte %@ a řekněte úpravu, třeba „capitalize this“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markér de ord, du vil ændre, hold derefter %@ nede og sig redigeringen - f.eks. “capitalize this”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere die Worte, die du ändern möchtest, halte dann %@ und sprich die Bearbeitung, etwa „capitalize this“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resalta las palabras que quieres cambiar, luego mantén %@ y di la edición, como “pon esto en mayúscula”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korosta sanat, jotka haluat muuttaa, pidä %@ pohjassa ja sano muokkaus, kuten ”capitalize this”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez les mots à modifier, puis maintenez %@ et dites la modification, par exemple “mets ça en majuscules”."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סמן את המילים שאתה רוצה לשנות, ואז החזק %@ ואמור את העריכה, כמו “capitalize this”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelöld ki a módosítani kívánt szavakat, majd tartsd lenyomva a(z) %@ billentyűt, és mondd el a szerkesztést, például „capitalize this”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorot kata yang ingin diubah, lalu tahan %@ dan ucapkan suntingannya, misalnya “capitalize this”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evidenzia le parole da cambiare, poi tieni premuto %@ e di' la modifica, ad esempio “capitalize this”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更したい単語を選択し、%@ を押し続けて編集内容を話してください。例: 「capitalize this」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바꾸고 싶은 단어를 선택한 다음 %@을(를) 누르고 편집 내용을 말하세요. 예: “capitalize this”."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Marker ordene du vil endre, hold deretter %@ og si redigeringen - som «capitalize this»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer de woorden die je wilt wijzigen, houd dan %@ ingedrukt en zeg de bewerking, zoals “capitalize this”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz słowa, które chcesz zmienić, a potem przytrzymaj %@ i powiedz edycję, na przykład „zapisz to wielką literą”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione as palavras que quer mudar, depois segure %@ e diga a edição, como “colocar isto em maiúscula”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите слова, которые хотите изменить, затем удерживайте %@ и скажите правку, например «сделай это заглавным»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte slová, ktoré chcete zmeniť, potom podržte %@ a povedzte úpravu, napríklad „toto veľkým písmenom“."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera orden du vill ändra, håll sedan ned %@ och säg redigeringen, till exempel ”skriv det här med versal”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฮไลต์คำที่ต้องการเปลี่ยน แล้วกด %@ ค้างไว้และพูดการแก้ไข เช่น “ทำเป็นตัวพิมพ์ใหญ่”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirmek istediğiniz kelimeleri vurgulayın, sonra %@ tuşunu basılı tutun ve düzenlemeyi söyleyin - örneğin “bunu büyük harfle yaz”."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виділіть слова, які хочете змінити, потім утримуйте %@ і скажіть редагування, наприклад «зроби це з великої літери»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn các từ bạn muốn đổi, rồi giữ %@ và nói chỉnh sửa, như “viết hoa cái này”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中你想更改的词语，然后按住 %@ 说出编辑指令，例如“capitalize this”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "反白要變更的文字，然後按住 %@ 並說出編輯內容，例如「capitalize this」。"
          }
        }
      }
    },
    "His speech bubble turns red while recording, spins while transcribing, and flashes green when text was inserted. He also blinks. He is alive.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتحول فقاعة كلامه إلى الأحمر أثناء التسجيل، وتدور أثناء النسخ، وتومض بالأخضر عند إدراج النص. وهو يرمش أيضاً. إنه حي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho bublina řeči se při nahrávání zbarví červeně, při přepisu se točí a když se text vloží, zablikne zeleně. Taky mrká. Je živý."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hans talebobbel bliver rød, mens der optages, snurrer, mens der transskriberes, og blinker grønt, når tekst er indsat. Han blinker også. Han er levende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Sprechblase wird beim Aufnehmen rot, dreht sich beim Transkribieren und blinkt grün, sobald Text eingefügt wurde. Außerdem blinzelt er. Er lebt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su globo de diálogo se pone rojo al grabar, gira mientras transcribe y parpadea en verde cuando se inserta el texto. También parpadea. Está vivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hänen puhekuplansa muuttuu punaiseksi nauhoituksen aikana, pyörii litteroinnin aikana ja välähtää vihreänä, kun teksti on lisätty. Hän myös räpyttelee silmiään. Hän on elävä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa bulle de parole devient rouge pendant l'enregistrement, tourne pendant la transcription et clignote en vert quand du texte est inséré. Il cligne aussi des yeux. Il est vivant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בועת הדיבור שלו הופכת לאדומה בזמן הקלטה, מסתובבת בזמן תמלול, ומהבהבת בירוק כשטקסט הוכנס. הוא גם מצמץ. הוא חי."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszédbuborékja pirosra vált felvétel közben, forog az átírás alatt, és zölden villan, ha szöveg került beszúrásra. Pislog is. Él."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelembung ucapannya berubah merah saat merekam, berputar saat mentranskripsi, dan berkedip hijau saat teks disisipkan. Dia juga berkedip. Dia hidup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo fumetto diventa rosso durante la registrazione, gira durante la trascrizione e lampeggia di verde quando il testo viene inserito. Sbatte anche le palpebre. È vivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "吹き出しは録音中に赤くなり、書き起こし中は回転し、テキストが挿入されると緑に点滅します。まばたきもします。生きています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말풍선은 녹음 중에는 빨간색, 전사 중에는 회전하고, 텍스트가 삽입되면 초록색으로 번쩍여요. 눈도 깜박여요. 살아 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snakkeboblen hans blir rød under opptak, snurrer under transkribering og blinker grønt når tekst er satt inn. Han blinker også. Han er levende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zijn spraakbel wordt rood tijdens het opnemen, draait tijdens het transcriberen en knippert groen wanneer tekst is ingevoegd. Hij knippert ook. Hij leeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego dymek mowy robi się czerwony podczas nagrywania, kręci się podczas transkrypcji i błyska na zielono, gdy tekst zostanie wstawiony. Mruga też. Żyje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O balão de fala dele fica vermelho enquanto grava, gira enquanto transcreve e pisca em verde quando o texto é inserido. Ele também pisca. Ele está vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его речевой пузырь краснеет во время записи, вращается при расшифровке и вспыхивает зелёным, когда текст вставлен. Он также моргает. Он живой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeho bublina s rečou sa pri nahrávaní sfarbí na červeno, pri prepise sa točí a pri vložení textu zablikne na zeleno. Aj mrká. Je živý."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hans pratbubbla blir röd när han spelar in, snurrar när han transkriberar och blinkar grönt när text har infogats. Han blinkar också. Han lever."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟองพูดของเขาจะเป็นสีแดงขณะบันทึก หมุนขณะถอดเสียง และกะพริบสีเขียวเมื่อแทรกข้อความแล้ว เขายังกระพริบตาด้วย เขามีชีวิตอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşma balonu kayıt sırasında kırmızıya döner, yazıya dökülürken döner ve metin eklendiğinde yeşil yanar. Ayrıca göz kırpar. O yaşıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його мовна бульбашка стає червоною під час запису, обертається під час транскрибації і блимає зеленим, коли текст вставлено. Він також моргає. Він живий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bong bóng lời nói của cậu ấy chuyển đỏ khi đang ghi, quay khi đang phiên âm và nhấp nháy xanh lá khi văn bản đã được chèn. Cậu ấy cũng chớp mắt. Cậu ấy đang sống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音时他的语音气泡变红，转写时旋转，文字插入后闪烁绿光。他还会眨眼。他是活的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "他的語音泡泡在錄音時會變紅，轉錄時會旋轉，文字插入時會閃綠光。他還會眨眼。他是活的。"
          }
        }
      }
    },
