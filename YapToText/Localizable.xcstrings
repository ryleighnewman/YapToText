    "Our official privacy policy can be read": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن قراءة سياسة الخصوصية الرسمية لدينا"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naše oficiální zásady ochrany osobních údajů lze přečíst"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vores officielle privatlivspolitik kan læses"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsere offizielle Datenschutzerklärung kannst du lesen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuestra política de privacidad oficial se puede leer"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Virallinen tietosuojakäytäntömme on luettavissa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notre politique de confidentialité officielle peut être lue"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לקרוא את מדיניות הפרטיות הרשמית שלנו"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hivatalos adatvédelmi szabályzatunk itt olvasható"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebijakan privasi resmi kami dapat dibaca"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nostra informativa sulla privacy ufficiale può essere letta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公式のプライバシーポリシーは次で読めます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공식 개인 정보 보호 정책은 다음에서 읽을 수 있어요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vår offisielle personvernerklæring kan leses"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ons officiële privacybeleid is te lezen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naszą oficjalną politykę prywatności można przeczytać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nossa política de privacidade oficial pode ser lida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С нашей официальной политикой конфиденциальности можно ознакомиться"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naše oficiálne zásady ochrany osobných údajov si môžete prečítať"
