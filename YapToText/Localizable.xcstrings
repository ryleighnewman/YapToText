    "Cancel. Nothing is typed; the words stay in History": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء. لا يُكتب شيء، وتبقى الكلمات في السجل"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušit. Nic se nenapíše; slova zůstanou v Historii"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuller. Intet skrives; ordene bliver i historikken"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen. Nichts wird getippt; die Worte bleiben im Verlauf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar. No se escribe nada; las palabras se quedan en el Historial"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Peruuta. Mitään ei kirjoiteta, sanat jäävät historiaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler. Rien n'est tapé ; les mots restent dans l'historique"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול. שום דבר לא מוקלד; המילים נשארות בהיסטוריה"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megszakítás. Semmi sem kerül begépelésre; a szavak az előzményekben maradnak"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan. Tidak ada yang diketik; kata-katanya tetap ada di Riwayat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla. Non viene scritto nulla; le parole restano nella Cronologia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル。何も入力されず、言葉は履歴に残ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소. 아무것도 입력되지 않고, 말한 내용은 기록에 남아요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbryt. Ingenting skrives; ordene blir i Historikk"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuleren. Er wordt niets getypt; de woorden blijven in Geschiedenis"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuluj. Nic nie zostaje wpisane; słowa zostają w historii"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar. Nada é digitado; as palavras ficam no Histórico"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена. Ничего не печатается, слова остаются в истории"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušiť. Nič sa nenapíše; slová ostanú v histórii"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbryt. Inget skrivs; orden finns kvar i historiken"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิก ไม่มีอะไรถูกพิมพ์ คำจะคงอยู่ในประวัติ"
          }
        },
        "tr": {
