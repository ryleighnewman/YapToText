          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディクテーションせずに、サンプルにこのモードを適用した結果をプレビューします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰지 않고 샘플에 이 모드가 어떻게 적용되는지 미리 보세요."
          }
        },
        "nb": {
          "stringUnit": {
