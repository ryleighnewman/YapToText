    "Copied to clipboard. Grant Accessibility in Settings to paste automatically.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم النسخ إلى الحافظة. امنح إمكانية الوصول في الإعدادات للصق تلقائياً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkopírováno do schránky. Pro automatické vkládání udělte Přístupnost v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieret til udklipsholderen. Giv Tilgængelighed under Indstillinger for at indsætte automatisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In die Zwischenablage kopiert. Erlaube die Bedienungshilfen in den Einstellungen, um automatisch einzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado al portapapeles. Concede Accesibilidad en Ajustes para pegar automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioitu leikepöydälle. Myönnä saavutettavuus Asetuksissa, jotta liittäminen tapahtuu automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copié dans le presse-papiers. Accordez l'accès Accessibilité dans Réglages pour coller automatiquement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הועתק ללוח. הענק נגישות בהגדרות כדי להדביק אוטומטית."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vágólapra másolva. Az automatikus beillesztéshez add meg az Akadálymentesítés engedélyt a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disalin ke papan klip. Berikan Aksesibilitas di Pengaturan untuk menempel otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiato negli appunti. Concedi l'Accessibilità nelle Impostazioni per incollare automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードにコピーしました。自動でペーストするには、設定でアクセシビリティを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드에 복사했어요. 자동으로 붙여넣으려면 설정에서 손쉬운 사용을 허용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert til utklippstavlen. Gi Tilgjengelighet i Innstillinger for å lime inn automatisk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekopieerd naar het klembord. Verleen Toegankelijkheid in Instellingen om automatisch te plakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiowano do schowka. Przyznaj Dostępność w Ustawieniach, aby wklejać automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado para a área de transferência. Conceda a Acessibilidade nos Ajustes para colar automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировано в буфер обмена. Выдайте «Универсальный доступ» в настройках, чтобы вставка была автоматической."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
