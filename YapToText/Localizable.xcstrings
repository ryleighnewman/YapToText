    "One press of Escape cancels the dictation immediately.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضغطة واحدة على Escape تلغي الإملاء فوراً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno stisknutí klávesy Esc diktát okamžitě zruší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét tryk på Escape annullerer diktaten med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Druck auf Escape bricht das Diktat sofort ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pulsación de Escape cancela el dictado de inmediato."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi Escape-painallus peruuttaa sanelun heti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pression sur Escape annule immédiatement la dictée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחיצה אחת על Escape מבטלת את ההכתבה מיד."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Escape egyszeri lenyomása azonnal megszakítja a diktálást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekali tekan Escape langsung membatalkan dikte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pressione di Esc annulla subito la dettatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Escape を 1 回押すと、ディクテーションをすぐにキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Escape를 한 번 누르면 받아쓰기가 바로 취소돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett trykk på Escape avbryter dikteringen med en gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén keer Escape annuleert het dictee meteen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno naciśnięcie Escape natychmiast anuluje dyktowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque em Esc cancela o ditado na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно нажатие Escape сразу отменяет диктовку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno stlačenie Escape okamžite zruší diktovanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett tryck på Escape avbryter dikteringen direkt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กด Escape ครั้งเดียวเพื่อยกเลิกการพิมพ์ด้วยเสียงทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Escape'e bir kez basmak dikteyi hemen iptal eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне натискання Escape одразу скасовує диктовку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lần nhấn Escape sẽ hủy đọc chính tả ngay lập tức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按一次 Escape 即可立即取消听写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一次 Esc 即可立即取消聽寫。"
          }
        }
      }
    },
    "One thing Auto mode needs: your name, so emails are signed by you and never with a made-up placeholder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شيء واحد يحتاجه الوضع التلقائي: اسمك، حتى تُوقَّع رسائلك باسمك ولا تظهر بعنصر نائب مختلق."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatický režim potřebuje jednu věc: vaše jméno, aby e-maily byly podepsané vámi a nikdy s vymyšleným zástupným textem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-tilstand har brug for én ting: dit navn, så e-mails underskrives af dig og aldrig med en opdigtet pladsholder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eines braucht der Automatikmodus noch: deinen Namen, damit E-Mails von dir signiert werden und nie mit einem erfundenen Platzhalter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo único que necesita el modo automático es tu nombre, para que los correos estén firmados por ti y nunca con un marcador inventado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaattitila tarvitsee yhden asian: nimesi, jotta sähköpostit allekirjoitetaan sinun nimelläsi eikä keksitystä paikanpitäjästä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule chose est nécessaire au mode automatique : votre nom, pour que vos e-mails soient signés par vous et jamais avec un espace réservé inventé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דבר אחד שמצב אוטומטי צריך: השם שלך, כך שאימיילים ייחתמו על ידך ולעולם לא עם מציין מקום מומצא."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az automatikus módnak egy dologra van szüksége: a neved, hogy az e-mailek a te aláírásoddal menjenek, és soha ne legyen kitalált helyettesítő."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu hal yang diperlukan Mode otomatis: nama Anda, agar email ditandatangani oleh Anda dan tidak pernah dengan placeholder karangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cosa che serve alla modalità automatica: il tuo nome, così le email sono firmate da te e mai con un segnaposto inventato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動モードに必要なのは名前だけです。メールにはあなたの名前で署名され、架空のプレースホルダーが入ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 모드에 필요한 것은 이름 하나예요. 그래야 이메일에 내 이름으로 서명되고, 지어낸 자리표시자가 쓰이지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én ting Auto-modus trenger: navnet ditt, så e-poster signeres av deg og aldri med en oppdiktet plassholder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén ding dat de automatische modus nodig heeft: je naam, zodat e-mails door jou worden ondertekend en nooit met een verzonnen plaatsaanduiding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb automatyczny potrzebuje jednej rzeczy: twojego imienia, żeby e-maile były podpisane przez ciebie, a nie zmyślonym symbolem zastępczym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma coisa que o modo automático precisa: seu nome, para que os e-mails sejam assinados por você e nunca com um marcador inventado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматическому режиму нужно одно: ваше имя, чтобы письма подписывались вами, а не выдуманной заглушкой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatický režim potrebuje jednu vec: vaše meno, aby e-maily podpisovala vaša osoba a nikdy nie vymyslený zástupný text."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En sak som Automatiskt läge behöver: ditt namn, så att e-post signeras av dig och aldrig med en påhittad platshållare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งเดียวที่โหมดอัตโนมัติต้องการคือชื่อของคุณ เพื่อให้อีเมลลงชื่อโดยคุณและไม่ใช้ตัวยึดที่สร้างขึ้นเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik modun ihtiyaç duyduğu tek şey adınız. Böylece e-postalar sizin adınızla imzalanır, uydurma bir yer tutucuyla asla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режиму «Авто» потрібне одне: ваше ім'я, щоб листи підписувалися вашим іменем, а не вигаданим заповнювачем."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ tự động cần một thứ: tên của bạn, để email được ký đúng tên bạn chứ không dùng chỗ giữ chỗ giả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动模式需要一项信息：你的名字，这样邮件才会以你的名义署名，而不会使用虚构的占位符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動模式還需要一項資訊：你的名字，這樣電子郵件才會以你的名義簽署，而不會出現虛構的佔位符。"
          }
        }
      }
    },
