    "Paste rough text and reformat it through any mode, like turning notes into an email.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق نصاً خاماً وأعد تنسيقه عبر أي وضع، مثل تحويل الملاحظات إلى بريد إلكتروني."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložte hrubý text a přeformátujte jej libovolným režimem, třeba přeměnou poznámek na e-mail."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt rå tekst og formater den igen med en vilkårlig tilstand, f.eks. for at gøre noter til en e-mail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge groben Text ein und formatiere ihn mit einem beliebigen Modus neu, etwa um Notizen in eine E-Mail zu verwandeln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega un texto en bruto y dale formato con cualquier modo, por ejemplo para convertir notas en un correo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä karkea teksti ja muotoile se uudelleen millä tahansa tilalla, esimerkiksi muuttamalla muistiinpanot sähköpostiksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez un texte brut et remettez-le en forme avec n'importe quel mode, par exemple pour transformer des notes en e-mail."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדבק טקסט גס ועצב אותו מחדש דרך כל מצב, כמו הפיכת הערות לאימייל."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Illessz be nyers szöveget, és formázd át bármelyik móddal, például jegyzetből e-mailt készítve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempel teks mentah dan format ulang dengan mode apa pun, misalnya mengubah catatan menjadi email."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla un testo grezzo e riformattalo con una modalità, ad esempio per trasformare appunti in un'email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きのテキストを貼り付けて、任意のモードで整え直せます。たとえばメモをメールに変えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거친 텍스트를 붙여넣고 아무 모드로나 다시 서식화하세요. 예를 들어 메모를 이메일로 바꿀 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn grov tekst og formater den på nytt med en hvilken som helst modus, for eksempel å gjøre notater til en e-post."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak ruwe tekst en formatteer die opnieuw via een modus, zoals notities omzetten in een e-mail."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej surowy tekst i sformatuj go dowolnym trybem, na przykład zamieniając notatki w e-mail."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole um texto bruto e reformate-o com qualquer modo, como transformar anotações em um e-mail."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте черновой текст и переоформите его любым режимом, например превратите заметки в письмо."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložte hrubý text a preformátujte ho ľubovoľným režimom, napríklad poznámky na e-mail."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in grov text och formatera om den via valfritt läge, till exempel för att göra anteckningar till ett e-postmeddelande."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางข้อความร่างแล้วจัดรูปแบบใหม่ด้วยโหมดใดก็ได้ เช่น เปลี่ยนโน้ตให้เป็นอีเมล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaba bir metni yapıştırın ve notları bir e-postaya dönüştürmek gibi herhangi bir modla yeniden biçimlendirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте чорновий текст і переформатуйте його будь-яким режимом, наприклад перетворивши нотатки на лист."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán văn bản thô và định dạng lại qua bất kỳ chế độ nào, ví dụ biến ghi chú thành email."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴粗略的文字，并通过任意模式重新整理格式，例如把笔记变成邮件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上粗略的文字，並透過任一模式重新排版，例如將筆記改寫為電子郵件。"
          }
        }
      }
    },
