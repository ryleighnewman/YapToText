    "Noticeably more accurate; a good quality/speed balance.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدق بوضوح، وتوازن جيد بين الجودة والسرعة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výrazně přesnější; dobrý poměr kvality a rychlosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mærkbart mere præcis; en god balance mellem kvalitet og hastighed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deutlich genauer, eine gute Balance aus Qualität und Geschwindigkeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notablemente más preciso; un buen equilibrio entre calidad y velocidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selvästi tarkempi. Hyvä laadun ja nopeuden tasapaino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettement plus précis ; un bon équilibre entre qualité et vitesse."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מדויק משמעותית; איזון טוב בין איכות למהירות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Észrevehetően pontosabb, jó minőség és sebesség egyensúlya."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelas lebih akurat; keseimbangan kualitas dan kecepatan yang baik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensibilmente più preciso; un buon equilibrio tra qualità e velocità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はっきり精度が高く、品質と速度のバランスが良いモデルです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈에 띄게 더 정확하고, 품질과 속도의 균형이 좋아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkbart mer nøyaktig; en god balanse mellom kvalitet og hastighet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkbaar nauwkeuriger; een goede balans tussen kwaliteit en snelheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zauważalnie dokładniejszy; dobry balans jakości i szybkości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visivelmente mais preciso; um bom equilíbrio entre qualidade e velocidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметно точнее, хороший баланс качества и скорости."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Výrazne presnejší; dobrá rovnováha medzi kvalitou a rýchlosťou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Märkbart mer träffsäker; en bra balans mellan kvalitet och hastighet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม่นยำขึ้นอย่างเห็นได้ชัด คุณภาพและความเร็วสมดุลกันดี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirgin şekilde daha doğru; iyi bir kalite ve hız dengesi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помітно точніша; добрий баланс якості й швидкості."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chính xác hơn rõ rệt; cân bằng tốt giữa chất lượng và tốc độ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准确率明显更高，质量与速度兼顾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "準確度明顯提升，品質與速度取得良好平衡。"
          }
        }
      }
    },
