    "Hold %@ while you speak the change; release to apply.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مع الاستمرار على %@ أثناء نطق التغيير، ثم اتركه لتطبيقه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte %@, dokud mluvíte o změně; uvolněním použijete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold %@ nede, mens du siger ændringen; slip for at anvende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte %@, während du die Änderung sprichst; loslassen zum Anwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén %@ mientras dices el cambio; suéltala para aplicarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä %@ pohjassa puhuessasi muutoksen. Vapauta ottaaksesi sen käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez %@ pendant que vous dites la modification ; relâchez pour l'appliquer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזק את %@ בזמן שאתה אומר את השינוי; שחרר כדי להחיל."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd lenyomva a(z) %@ billentyűt, amíg kimondod a módosítást; engedd el az alkalmazáshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan %@ sambil mengucapkan perubahan; lepas untuk menerapkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto %@ mentre dici la modifica; rilascia per applicarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更内容を話している間は %@ を押し続け、離すと適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바꿀 내용을 말하는 동안 %@을(를) 누르고 있다가 떼면 적용돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold %@ mens du sier endringen; slipp for å bruke den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd %@ ingedrukt terwijl je de wijziging uitspreekt; laat los om toe te passen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj %@, mówiąc zmianę; puść, aby zastosować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure %@ enquanto fala a mudança; solte para aplicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте %@, пока произносите правку, и отпустите, чтобы применить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte %@, kým hovoríte zmenu; pustením ju použijete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll ned %@ medan du säger ändringen; släpp för att tillämpa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กด %@ ค้างไว้ขณะพูดการเปลี่ยนแปลง แล้วปล่อยเพื่อใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişikliği söylerken %@ tuşunu basılı tutun; uygulamak için bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте %@, поки говорите зміну; відпустіть, щоб застосувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ %@ khi bạn nói thay đổi; thả ra để áp dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说出更改内容时按住 %@；松开即应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說出變更內容時按住 %@；放開即套用。"
          }
        }
      }
    },
    "Hold %@ while you speak; release to stop.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولاً على %@ أثناء الكلام، واتركه للإيقاف."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte %@, dokud mluvíte; uvolněním zastavíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold %@ nede, mens du taler; slip for at stoppe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte %@, während du sprichst; loslassen zum Beenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén %@ mientras hablas; suéltala para detener."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä %@ pohjassa puhuessasi, vapauta lopettaaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez %@ pendant que vous parlez ; relâchez pour arrêter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזק %@ בזמן שאתה מדבר; שחרר כדי לעצור."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd lenyomva a(z) %@ billentyűt beszéd közben; engedd el a leállításhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan %@ saat bicara; lepas untuk berhenti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto %@ mentre parli; rilascia per fermare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話している間は %@ を押し続け、離すと停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하는 동안 %@을(를) 누르고 있다가 떼면 중지해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold %@ mens du snakker; slipp for å stoppe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd %@ ingedrukt terwijl je spreekt; laat los om te stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj %@, mówiąc; puść, aby zatrzymać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure %@ enquanto fala; solte para parar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте %@, пока говорите. Отпустите, чтобы остановить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte %@, kým hovoríte; pustením zastavíte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll ned %@ medan du pratar; släpp för att stoppa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กด %@ ค้างไว้ขณะพูด แล้วปล่อยเพื่อหยุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşurken %@ tuşunu basılı tutun; durdurmak için bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте %@, поки говорите; відпустіть, щоб зупинити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ %@ khi bạn nói; thả ra để dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话时按住 %@；松开即停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說話時按住 %@；放開即停止。"
          }
        }
      }
    },
    "Hold Right Option…": {
