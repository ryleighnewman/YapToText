    "Stops and discards it. Nothing is inserted or saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقفه ويتجاهله. لا يُدرج شيء ولا يُحفظ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaví a zahodí. Nic se nevloží ani neuloží."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopper og kasserer den. Intet indsættes eller gemmes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet es und verwirft es. Nichts wird eingefügt oder gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo detiene y lo descarta. No se inserta ni se guarda nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysäyttää ja hylkää sen. Mitään ei lisätä tai tallenneta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête et supprime. Rien n'est inséré ni enregistré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוצר ומשליך אותה. שום דבר לא מוכנס או נשמר."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Leállítja és elveti. Semmi sem kerül beszúrásra vagy mentésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghentikan dan membuangnya. Tidak ada yang disisipkan atau disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ferma e la scarta. Non viene inserito né salvato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止して破棄します。何も挿入・保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중지하고 버려요. 아무것도 삽입되거나 저장되지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopper og forkaster den. Ingenting settes inn eller lagres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopt en verwerpt het. Er wordt niets ingevoegd of opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymuje i odrzuca. Nic nie zostaje wstawione ani zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para e descarta. Nada é inserido ou salvo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Останавливает и удаляет. Ничего не вставляется и не сохраняется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaví a zahodí ju. Nič sa nevloží ani neuloží."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppar och kasserar den. Inget infogas eller sparas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดและทิ้งการพิมพ์นี้ จะไม่มีการแทรกหรือบันทึกอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durdurur ve atar. Hiçbir şey eklenmez ya da kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиняє і відхиляє її. Нічого не вставляється і не зберігається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng và bỏ nó. Không chèn hay lưu gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止并舍弃。不插入也不保存任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止並捨棄。不會插入或儲存任何內容。"
          }
        }
      }
    },
