          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp này không phải mô hình được hỗ trợ. Mô hình giọng nói là tệp GGML .bin của whisper.cpp; mô hình làm sạch là tệp GGUF của llama.cpp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
