        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Juga memetakan 1 kata yang mirip bunyinya ke “%@”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho associato anche 1 parola simile a “%@”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ響きの言葉 1 件を「%@」に割り当てました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발음이 비슷한 단어 1개도 “%@”(으)로 연결했어요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koblet også 1 lydlikt ord til «%@»"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ook 1 gelijkklinkend woord gekoppeld aan “%@”"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatkowo przypisano 1 podobnie brzmiące słowo do „%@”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também associei 1 palavra parecida a “%@”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также сопоставлено 1 похожее слово с «%@»"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ďalší podobne znejúci výraz bol priradený k „%@“"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappade även 1 likaljudande ord till ”%@”"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มคำที่ออกเสียงคล้ายกันอีก 1 คำเป็น “%@” แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
