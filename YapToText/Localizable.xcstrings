    "Turbo model at higher-fidelity quantization. Great accuracy, still compact.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نموذج Turbo بتكميم بدقة أعلى. دقة ممتازة، وما زال مدمجاً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbo model s vyšší věrností kvantizace. Vysoká přesnost, stále kompaktní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbomodel med højere kvantiseringskvalitet. Stor præcision, stadig kompakt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbo-Modell mit höherer Quantisierungsgüte. Sehr genau und trotzdem kompakt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo turbo con cuantización de mayor fidelidad. Gran precisión y aún compacto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbo-malli tarkemmalla kvantisoinnilla. Erinomainen tarkkuus, silti kompakti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèle turbo à quantification de meilleure fidélité. Très bonne précision, toujours compact."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מודל Turbo בכימות באיכות גבוהה יותר. דיוק מצוין, עדיין קומפקטי."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbo modell magasabb hűségű kvantálással. Kiváló pontosság, továbbra is kompakt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model turbo dengan kuantisasi fidelitas lebih tinggi. Akurasi sangat baik, tetap ringkas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modello turbo con quantizzazione di fedeltà superiore. Ottima precisione, ancora compatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbo モデルを高忠実度で量子化したものです。高精度で、コンパクトなままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 높은 충실도로 양자화한 Turbo 모델이에요. 훌륭한 정확도에 여전히 작아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbo-modell med kvantisering av høyere kvalitet. Svært god nøyaktighet, fortsatt kompakt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbo-model met hogere kwantisering. Zeer goede nauwkeurigheid, nog steeds compact."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model turbo w wyższej jakości kwantyzacji. Świetna dokładność, nadal kompaktowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo turbo com quantização de maior fidelidade. Ótima precisão, ainda compacto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель Turbo с квантованием повышенной точности. Высокая точность, при этом компактная."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Model turbo s vyššou kvalitou kvantizácie. Výborná presnosť, stále kompaktný."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbomodell med högre kvantiseringskvalitet. Mycket bra träffsäkerhet, fortfarande kompakt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดล turbo ที่ควอนไทซ์ให้คุณภาพสูงขึ้น แม่นยำมาก และยังกะทัดรัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yüksek kaliteli nicemlemeli turbo modeli. Harika doğruluk, yine de kompakt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbo-модель з вищою точністю квантування. Чудова точність, але компактна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình turbo với lượng tử hóa độ trung thực cao hơn. Độ chính xác tốt, vẫn gọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采用更高保真量化的 Turbo 模型。准确率很高，体积依然紧凑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以更高保真度量化的 Turbo 模型。準確度很高，體積仍然小巧。"
          }
        }
      }
    },
