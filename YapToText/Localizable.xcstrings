            "value": "Model yang mengikuti colokan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelli che seguono l'alimentazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源に合わせて切り替わるモデル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전원 연결 상태에 따라 바뀌는 모델."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Modeller som følger strømkontakten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
