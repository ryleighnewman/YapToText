    "Didn't catch that. Nothing was transcribed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم أسمع ذلك. لم يُنسخ شيء."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezachytil jsem to. Nic nebylo přepsáno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fangede ikke det. Intet blev transskriberet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das habe ich nicht verstanden. Es wurde nichts transkribiert."
          }
        },
        "es": {
          "stringUnit": {
