    "Search the sidebar to jump to any setting in seconds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث في الشريط الجانبي للانتقال إلى أي إعداد خلال ثوانٍ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledejte v postranním panelu a během sekund přejděte na libovolné nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søg i sidepanelet for at hoppe til en vilkårlig indstilling på få sekunder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuche die Seitenleiste, um in Sekunden zu jeder Einstellung zu springen."
          }
        },
        "es": {
