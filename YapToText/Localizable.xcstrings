    "Why did I build this?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لماذا صنعت هذا؟"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proč jsem to vytvořil?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor byggede jeg det her?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum habe ich das gebaut?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué creé esto?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miksi rakensin tämän?"
          }
        },
