            "value": "Máte %lld-dňovú sériu. Vaša najlepšia je %lld dní."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har en %lld-dagars svit. Din bästa är %lld dagar."
