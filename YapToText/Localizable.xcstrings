            "state": "translated",
            "value": "Stačí jeden kláves"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tangent räcker"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ปุ่มเดียวก็พอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir tuş yeter"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Достатньо однієї клавіші"
          }
        },
        "vi": {
