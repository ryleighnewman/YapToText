        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij %@, aby zacząć, naciśnij ponownie, aby zatrzymać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em %@ para começar, toque de novo para parar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите %@, чтобы начать, и ещё раз, чтобы остановить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na %@ na spustenie, ďalším ťuknutím zastavte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på %@ för att starta, tryck igen för att stoppa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ %@ เพื่อเริ่ม แตะอีกครั้งเพื่อหยุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlatmak için %@ tuşuna dokunun, durdurmak için tekrar dokunun."
