        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מודל הניקוי לא הצליח להתחיל (אולי אין מספיק זיכרון?)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
