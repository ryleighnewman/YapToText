          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het modelbestand kon niet worden geladen. Probeer het opnieuw te downloaden op de pagina AI-modellen."
          }
        },
        "pl": {
          "stringUnit": {
