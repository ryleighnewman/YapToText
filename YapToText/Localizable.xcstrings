        }
      }
    },
    "The pop-up stays wherever you drag it, across dictations and launches.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى النافذة المنبثقة حيث تسحبها، عبر الإملاءات وعمليات التشغيل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyskakovací okno zůstane, kam ho přetáhnete, napříč diktáty a spuštěními."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop op-vinduet bliver, hvor du trækker det hen, på tværs af dikteringer og starter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Pop-up bleibt dort, wo du es hinziehst, über Diktate und Starts hinweg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana emergente se queda donde la arrastres, entre dictados y aperturas de la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponnahdusikkuna pysyy siinä, minne vedät sen, sanelujen ja käynnistysten välillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre reste là où vous la faites glisser, d'une dictée et d'un lancement à l'autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלון הקופץ נשאר בכל מקום שגררת אותו, לאורך הכתבות והפעלות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felugró ablak ott marad, ahová húzod, diktálások és indítások között is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop-up tetap di mana pun Anda menyeretnya, di seluruh dikte dan saat dibuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pop-up resta dove lo trascini, tra una dettatura e l'altra e tra un avvio e l'altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポップアップは、ディクテーションや起動をまたいでも、ドラッグした場所に留まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기와 실행을 거쳐도 팝업은 끌어다 놓은 곳에 그대로 남아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Popupen blir der du drar den, på tvers av dikteringer og oppstarter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De pop-up blijft staan waar je hem sleept, over dictees en starts heen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dymek zostaje tam, gdzie go przeciągniesz, w czasie dyktowań i kolejnych uruchomień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pop-up fica onde você o arrastar, entre ditados e aberturas do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всплывающее окно остаётся там, куда вы его перетащили, между диктовками и запусками."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyskakovacie okno zostane tam, kam ho presuniete, naprieč diktátmi a spusteniami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Popupen stannar där du drar den, över dikteringar och starter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป๊อปอัปจะคงอยู่ตรงที่คุณลากไปไม่ว่าจะพิมพ์ด้วยเสียงกี่ครั้งหรือเปิดแอปกี่ครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılır pencere, dikteler ve açılışlar boyunca sürüklediğiniz yerde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спливаюче вікно лишається там, куди ви його перетягнули, між диктовками та запусками."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cửa sổ nổi ở yên nơi bạn kéo đến, qua các lần đọc chính tả và các lần mở ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论听写和启动多少次，弹出窗口都会停留在你拖动到的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "彈出視窗會保留在你拖曳到的位置，跨越每次聽寫與每次啟動。"
          }
        }
      }
    },
    "The pop-up stays wherever you drag it, across edits and launches.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى النافذة المنبثقة حيث تسحبها، عبر التعديلات وعمليات التشغيل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyskakovací okno zůstane tam, kam ho přetáhnete, napříč úpravami a spuštěními."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop op-vinduet bliver, hvor du trækker det hen, på tværs af redigeringer og starter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Pop-up bleibt dort, wo du es hinziehst, über Bearbeitungen und Starts hinweg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana emergente se queda donde la arrastres, entre ediciones y aperturas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponnahdusikkuna pysyy siinä, minne vedät sen, muokkausten ja käynnistysten välillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre reste là où vous la faites glisser, d'une modification à l'autre et d'un lancement à l'autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלון הקופץ נשאר בכל מקום שגררת אותו, לאורך עריכות והפעלות."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felugró ablak ott marad, ahová húzod, szerkesztések és indítások között is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop-up tetap di mana pun Anda menyeretnya, di seluruh suntingan dan saat dibuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pop-up resta dove lo trascini, tra una modifica e l'altra e tra un avvio e l'altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポップアップは、編集や起動をまたいでも、ドラッグした場所に留まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집과 실행을 거쳐도 팝업은 끌어다 놓은 곳에 그대로 남아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Popupen blir der du drar den, på tvers av redigeringer og oppstarter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De pop-up blijft staan waar je hem sleept, over bewerkingen en starts heen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dymek zostaje tam, gdzie go przeciągniesz, w czasie edycji i kolejnych uruchomień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pop-up fica onde você o arrastar, entre edições e aberturas do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всплывающее окно остаётся там, куда вы его перетащили, между правками и запусками."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyskakovacie okno zostane tam, kam ho presuniete, naprieč úpravami a spusteniami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Popupen stannar där du drar den, över redigeringar och starter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป๊อปอัปจะคงอยู่ตรงที่คุณลากไป ตลอดการแก้ไขและการเปิดแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılır pencere, düzenlemeler ve açılışlar boyunca sürüklediğiniz yerde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спливаюче вікно лишається там, куди ви його перетягнули, між редагуваннями і запусками."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cửa sổ nổi ở yên nơi bạn kéo đến, qua các lần chỉnh sửa và mở ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论编辑和启动多少次，弹出窗口都会停留在你拖动到的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論經過多少次編輯與啟動，彈出視窗都會保留在你拖曳到的位置。"
          }
        }
      }
    },
    "The pop-up's layout, position, and colors are on the [Dictation page](yap://dictation).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخطيط النافذة المنبثقة وموضعها وألوانها موجودة في [صفحة الإملاء](yap://dictation)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozložení, poloha a barvy vyskakovacího okna jsou na [stránce Diktování](yap://dictation)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop op-vinduets layout, position og farver findes på [siden Diktering](yap://dictation)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout, Position und Farben des Pop-ups findest du auf der [Seite Diktat](yap://dictation)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diseño, la posición y los colores de la ventana emergente están en la [página Dictado](yap://dictation)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponnahdusikkunan asettelu, sijainti ja värit ovat [Sanelu-sivulla](yap://dictation)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposition, la position et les couleurs de la fenêtre se trouvent sur la [page Dictée](yap://dictation)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריסה, המיקום והצבעים של החלון הקופץ נמצאים ב[דף ההכתבה](yap://dictation)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felugró ablak elrendezése, pozíciója és színei a [Diktálás oldalon](yap://dictation) találhatók."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tata letak, posisi, dan warna pop-up ada di [halaman Dikte](yap://dictation)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout, posizione e colori del pop-up si trovano nella [pagina Dettatura](yap://dictation)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポップアップのレイアウト、位置、色は [ディクテーションページ](yap://dictation) にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팝업의 레이아웃, 위치, 색상은 [받아쓰기 페이지](yap://dictation)에 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Popup-vinduets oppsett, posisjon og farger finnes på [Diktering-siden](yap://dictation)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De indeling, positie en kleuren van de pop-up staan op de [pagina Dicteren](yap://dictation)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Układ, położenie i kolory dymka znajdują się na [stronie Dyktowanie](yap://dictation)."
          }
