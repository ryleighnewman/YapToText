          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แปลงเสียงเป็นข้อความอย่างรวดเร็วและตรงตัว มีเครื่องหมายวรรคตอนพื้นฐาน ไม่ใช้ AI"
          }
