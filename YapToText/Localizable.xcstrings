        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De pop-up opent hier elke keer, ook nadat je hem hebt versleept."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dymek otwiera się tutaj za każdym razem, nawet po jego przeciągnięciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pop-up abre aqui toda vez, mesmo depois que você o arrasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всплывающее окно каждый раз открывается здесь, даже после перетаскивания."
