          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Signál vášho mikrofónu klesol: teraz %1$.0fdB, predtým %2$.0fdB."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din mikrofonsignal har sjunkit: %.0fdB nu, %.0fdB tidigare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัญญาณไมโครโฟนของคุณลดลง: ตอนนี้ %.0fdB ก่อนหน้า %.0fdB"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon sinyaliniz düştü: şimdi %1$.0fdB, önce %2$.0fdB."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигнал вашого мікрофона впав: зараз %1$.0f дБ, раніше %2$.0f дБ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tín hiệu micrô của bạn đã giảm: hiện %.0fdB, trước đó %.0fdB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的麦克风信号已下降：现在为 %1$.0fdB，之前为 %2$.0fdB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
